{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "foks-desktop",
  "identifier": "org.foks.desktop",
  "build": {
    "beforeDevCommand": "pnpm run foks:dev:frontend",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm run foks:build:frontend",
    "frontendDist": "../foks-ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FOKS Desktop",
        "width": 960,
        "height": 640,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 24 },
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "Desktop client for FOKS federated identity and secure vaults.",
    "longDescription": "Manage FOKS servers, accounts, groups, devices, and encrypted vault items securely from your desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "../packaging/foks-desktop/macos/entitlements.plist"
    }
  }
}
