<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Tauri app's canonical AppStream metadata.

  The .deb's launcher entry is generated by tauri's bundler from the package
  product name. The component id stays org.foks.Desktop; AppStream does not
  require the component id and desktop-id to agree.
-->
<component type="desktop-application">
  <id>org.foks.Desktop</id>
  <name>FOKS</name>
  <summary>Standalone client for FOKS identity, teams, and encrypted KV</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <launchable type="desktop-id">foks-desktop.desktop</launchable>
  <developer_name>FOKS contributors</developer_name>
</component>
