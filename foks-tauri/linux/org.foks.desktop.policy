<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  The polkit action behind the FOKS desktop app lock.

  Install to /usr/share/polkit-1/actions/org.foks.desktop.policy. Without it
  the action is unregistered and polkit silently denies it, so the app must
  report its lock as unavailable rather than offer a lock nobody could open.
  Modelled on src-tauri/src/applock/com.aka.desktop.policy; the app lock itself
  is wired up in Phase 5.

  Only a package that can write outside $HOME can install this. A .deb can; an
  AppImage cannot, which is why .deb is the only Linux target (see README.md).

  allow_active is auth_self, not auth_admin: this authenticates the person
  already at the console as themselves, exactly as Touch ID or the account
  password does on macOS. It grants no privilege — the only thing it decides
  is whether this app's own window unlocks. allow_inactive and allow_any are
  no, because an app lock is about the person in front of the machine.
-->
<policyconfig>
  <vendor>FOKS</vendor>
  <vendor_url>https://github.com/aka-com/multitool</vendor_url>

  <action id="org.foks.desktop.unlock">
    <description>Unlock FOKS</description>
    <message>Authenticate to unlock FOKS and reach your vault.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
