<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.foks.agent</string>
  <key>ProgramArguments</key><array>
    <string>__APP_PATH__/Contents/Helpers/foks-agent</string>
    <string>--state-dir</string><string>__STATE_DIR__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardErrorPath</key><string>__STATE_DIR__/agent.log</string>
</dict></plist>
