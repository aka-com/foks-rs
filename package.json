{
  "name": "foks-desktop",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "format": "prettier --write '**/*.{js,mjs,ts,tsx,json,css}'",
    "lint": "eslint . && cargo fmt --all -- --check",
    "start": "cd apps/desktop/src-tauri && tauri dev",
    "dev": "bash scripts/foks-dev.sh",
    "dev:frontend": "vite --config apps/desktop/vite.config.ts",
    "dev:tauri": "cd apps/desktop/src-tauri && tauri dev",
    "build:frontend": "vite build --config apps/desktop/vite.config.ts",
    "build": "node scripts/build-desktop.mjs",
    "build:release": "node scripts/build-macos-release.mjs",
    "stage-agent": "bash scripts/stage-foks-agent.sh",
    "bundle:macos": "npm run stage-agent && cd apps/desktop/src-tauri && tauri build --bundles app,dmg --config tauri.bundle.macos.conf.json -- --locked",
    "bundle:deb": "npm run stage-agent && cd apps/desktop/src-tauri && tauri build --bundles deb --config tauri.bundle.linux.conf.json -- --locked",
    "sign:macos": "bash scripts/sign-macos-app.sh",
    "notarize:macos": "bash scripts/notarize-macos-app.sh",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "test": "npm run test:core",
    "test:foks-ui": "npm run test:foks-ui:fast && npm run test:foks-ui:scale",
    "test:foks-desktop:real-agent": "bash scripts/test-foks-desktop-real-agent.sh",
    "test:rust:core": "cargo test --locked",
    "test:rust:full": "bash scripts/test-rust-full.sh",
    "test:core": "npm run test:rust:core && npm run test:foks-ui",
    "test:full": "npm run test:rust:full && npm run test:foks-ui",
    "test:foks-desktop:packaged": "bash scripts/test-packaged-startup.sh",
    "test:foks-ui:fast": "tsx --test apps/desktop/tests/*.test.ts apps/desktop/tests/*.test.tsx",
    "test:foks-ui:scale": "FOKS_TEST_SCALE=1 tsx --test --test-name-pattern=\"^scale:\" apps/desktop/tests/notification-scheduling.test.ts",
    "test:rust:scale": "bash scripts/test-rust-scale.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide": "^1.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=22.22.3",
    "npm": "11.12.1"
  },
  "type": "module"
}
