load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@npm//:tsx/package_json.bzl", tsx_bin = "bin")
load("@npm//:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm//:vite/package_json.bzl", vite_bin = "bin")

# Sources owned by this frontend. ui/kit is an explicit input below rather
# than part of this glob: it remains a separate Bazel package and the only
# source seam shared with AKA.
FOKS_SRCS = ["app.tsx"] + glob([
    "src/**/*.ts",
    "src/**/*.tsx",
])

FOKS_STYLES = glob(["src/styles/**/*.css"])

APP_DEPS = [
    "//:node_modules/@tauri-apps/api",
    "//:node_modules/@vitejs/plugin-react",
    "//:node_modules/lucide",
    "//:node_modules/react",
    "//:node_modules/react-dom",
    "//:node_modules/vite",
]

APP_DATA = FOKS_SRCS + FOKS_STYLES + [
    "index.html",
    "package.json",
    "tsconfig.json",
    "vite.config.ts",
    "//ui:kit_srcs",
] + APP_DEPS

# Vite is intentional here rather than a parallel esbuild-only bundle. The
# checked-in HTML imports both CSS entry points, shell.css imports /kit tokens,
# and vite.config.ts owns the /src and /kit aliases. Running that same graph is
# what keeps the Bazel frontendDist byte-for-byte equivalent in structure to
# `pnpm run foks:build:frontend`.
vite_bin.vite_binary(name = "vite")

js_run_binary(
    name = "dir",
    srcs = APP_DATA,
    args = [
        "build",
        "--config",
        "vite.config.ts",
        "--outDir",
        "dist",
    ],
    chdir = package_name(),
    env = {"VITE_FOKS_MOCK": "0"},
    mnemonic = "FoksViteBuild",
    out_dirs = ["dist"],
    progress_message = "Building the FOKS frontend %{label}",
    tool = ":vite",
    visibility = ["//visibility:public"],
)

# The acceptance harness selects its fixture bridge at Vite build time. Keep a
# hermetic mocked bundle in the graph even though the Playwright walk remains a
# host test: Chromium is intentionally supplied by the CI/acceptance machine,
# not downloaded by Bazel.
js_run_binary(
    name = "acceptance_dir",
    srcs = APP_DATA,
    args = [
        "build",
        "--config",
        "vite.config.ts",
        "--outDir",
        "acceptance-dist",
    ],
    chdir = package_name(),
    env = {"VITE_FOKS_MOCK": "1"},
    mnemonic = "FoksViteAcceptanceBuild",
    out_dirs = ["acceptance-dist"],
    progress_message = "Building the mocked FOKS frontend %{label}",
    tool = ":vite",
    visibility = ["//visibility:public"],
)

TEST_FILES = glob([
    "tests/*.test.ts",
    "tests/*.test.tsx",
])

TEST_DEPS = [
    "//:node_modules/@testing-library/react",
    "//:node_modules/jsdom",
]

TEST_DATA = APP_DATA + TEST_FILES + glob(["tests/lib/*.ts"]) + TEST_DEPS + [
    "//foks-tauri:wire_contract",
]

LINT_SRCS = FOKS_SRCS + ["vite.config.ts"] + glob([
    "tests/**/*.mjs",
    "tests/**/*.ts",
    "tests/**/*.tsx",
])

# These tests boot Vite and share its module graph. As in //ui:test_vite_boot,
# disabling the rules_js fs patch prevents Vite's dependency optimizer from
# repeatedly resolving the output-tree node_modules symlinks.
VITE_BOOT_TESTS = [
    "tests/app-root.render.test.tsx",
]

# bridge.test.ts reads the exported Rust/Tauri wire golden through TEST_DATA,
# so command-shape drift is part of the hermetic Bazel gate too.
BAZEL_TESTS = [
    test
    for test in TEST_FILES
    if test not in VITE_BOOT_TESTS
]

tsx_bin.tsx_test(
    name = "test_vite_boot",
    size = "medium",
    args = [
        "--tsconfig",
        "tsconfig.json",
        "--test",
        # Node otherwise runs the two Vite-backed files in parallel inside one
        # process. Their independent SSR module graphs can exhaust the small
        # test sandbox and be killed without an assertion failure.
        "--test-concurrency=1",
    ] + VITE_BOOT_TESTS,
    chdir = package_name(),
    data = TEST_DATA,
    patch_node_fs = False,
    # Vite watches tsconfig through runfile symlinks. Running beside the tsc
    # test can make it observe that other sandbox's link and invalidate the
    # SSR module graph mid-suite, duplicating React contexts. Serialize this
    # one watcher-based target; the pure tests remain parallel.
    tags = ["exclusive"],
)

tsx_bin.tsx_test(
    name = "test_other",
    size = "small",
    args = [
        "--tsconfig",
        "tsconfig.json",
        "--test",
    ] + BAZEL_TESTS,
    chdir = package_name(),
    data = TEST_DATA,
)

tsc_bin.tsc_test(
    name = "typecheck",
    size = "medium",
    args = [
        "--noEmit",
        "-p",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = TEST_DATA + [
        "//:node_modules/@types/jsdom",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
    ],
)

test_suite(
    name = "test",
    tests = [
        ":test_other",
        ":test_vite_boot",
        ":typecheck",
    ],
)

# The eslint aspect visits js_library targets, not loose source globs. Keep the
# lint target local to foks-ui; //ui:lint_srcs already owns the shared kit.
js_library(
    name = "lint_srcs",
    srcs = LINT_SRCS,
    deps = [":lint_program"],
)

# Type-aware eslint needs the same project files and imported type packages as
# tsc. These are deps rather than data because the lint aspect gathers its
# sandbox inputs from dependency providers.
js_library(
    name = "lint_program",
    srcs = [
        "package.json",
        "tsconfig.json",
    ],
    deps = [
        "//:node_modules/@tauri-apps/api",
        "//:node_modules/@testing-library/react",
        "//:node_modules/@types/jsdom",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/@vitejs/plugin-react",
        "//:node_modules/jsdom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vite",
        "//ui:kit_srcs",
    ],
)
