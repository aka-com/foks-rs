+#[cfg(feature = "foks-guarded-node-qualification")]
+fn observation_line<T: serde::Serialize>(
+    encoded: &mut Vec<u8>,
+    writer: &mut impl std::io::Write,
+    total: &mut usize,
+    limit: usize,
+    value: &T,
+) -> anyhow::Result<()> {
+    struct Bounded<'a> {
+        bytes: &'a mut Vec<u8>,
+        limit: usize,
+    }
+    impl std::io::Write for Bounded<'_> {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if self
+                .bytes
+                .len()
+                .checked_add(bytes.len())
+                .is_none_or(|next| next >= self.limit || next >= 65_536)
+            {
+                return Err(std::io::Error::other("guarded observation record overflow"));
+            }
+            self.bytes.extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    anyhow::ensure!(
+        limit <= 65_536 && encoded.capacity() == 65_536,
+        "guarded observation buffer changed"
+    );
+    encoded.clear();
+    serde_json::to_writer(
+        Bounded {
+            bytes: encoded,
+            limit,
+        },
+        value,
+    )?;
+    encoded.push(b'\n');
+    *total = total
+        .checked_add(encoded.len())
+        .filter(|value| *value <= 264_192)
+        .ok_or_else(|| anyhow::anyhow!("guarded observation stream overflow"))?;
+    writer.write_all(encoded)?;
+    Ok(())
+}
