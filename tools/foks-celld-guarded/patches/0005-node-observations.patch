+        .unwrap();
+    assert!(!b4_observation(&driver).has(ObservationEvent::PrimaryDurableSuccess));
+    registry
+        .observe_proof(
+            &driver,
+            View::Durable {
+                op,
+                result: Ok(11),
+                source: ProofSource::Bucket,
+            },
+        )
+        .unwrap();
+    registry
+        .observe_proof(
+            &driver,
+            View::Ownership {
+                op,
+                result: Err(Failure::Definite),
+            },
+        )
+        .unwrap();
+    let partial = b4_observation(&driver);
+    assert!(partial.has(ObservationEvent::PrimaryDurableSuccess));
+    assert!(!partial.has(ObservationEvent::PrimaryOwnershipSuccess));
+    assert_eq!(
+        (
+            partial.proof_sources[0],
+            partial.durable_positions[0],
+            partial.ownership_verdicts[0]
+        ),
+        (2, 11, 2)
+    );
+    assert!(!partial.has(ObservationEvent::PrimaryOutputReleased));
+    assert_eq!(partial.roots_disposed, 0);
+    drop((wait, activity)); // Lost component consumers are held, not Free.
+
+    // A separate actual canonical host task proves payload disposition and
+    // that a reentrant C7 notification sees the published disposed state.
+    // Final Request destruction remains authoritative for notification aliases.
+    crate::actor::guarded_test_runtime().block_on(async {
+        let fixture = b2_fixture();
+        // Real F3 kind reaches the legitimate C7 consumer branch. The generic
+        // Control body is a task-cell fixture, not a NodeDriverWork result.
+        let context = fixture
+            .registry()
+            .reserve(
+                0,
+                JobRole::Forward(ForwardLane::Driver),
+                RootKind::Driver,
+                None,
+            )
+            .unwrap();
+        let cancel = b2_root(&fixture, JobRole::Cleanup(CleanupLane::Cancel));
+        b2_consumer(&fixture, &context);
+        fixture
+            .registry()
+            .spawn_root(
+                &context,
+                0,
+                async { Ok::<_, Refusal>(()) },
+                RootResult::Control,
+            )
+            .unwrap();
+        let mut join = std::pin::pin!(std::future::poll_fn(|cx| fixture
+            .registry()
+            .poll_root(&context, cx, false)));
+        let (bounded, result) = match tokio::time::timeout(Duration::from_secs(5), &mut join).await
+        {
+            Ok(value) => (true, value),
+            Err(_) => (false, join.await),
+        };
+        assert!(matches!(result, Ok(RootResult::Control(Ok(())))));
+        struct Reentrant {
+            cancel: JobContext,
+            saw: Arc<AtomicBool>,
+        }
+        impl futures_util::task::ArcWake for Reentrant {
+            fn wake_by_ref(value: &Arc<Self>) {
+                use futures_util::FutureExt as _;
+                // The real C7 waiter must observe the published disposed F3,
+                // not re-register under Delivered and lose its only wake.
+                value.saw.store(
+                    matches!(
+                        value.cancel.take_driver_for_cancel().now_or_never(),
+                        Some(Err(Refusal::NotReady))
+                    ),
+                    Ordering::Release,
+                );
+            }
+        }
+        let record = b2_record(&fixture, 0);
+        let saw = Arc::new(AtomicBool::new(false));
+        let wake = futures_util::task::waker(Arc::new(Reentrant {
+            cancel,
+            saw: saw.clone(),
+        }));
+        record.state.lock().unwrap().roots[context.role.index()].waker = Some(wake);
+        drop(record);
+        fixture.registry().finish_root(&context).unwrap();
+        assert!(bounded && saw.load(Ordering::Acquire));
+        assert_ne!(
+            b4_observation(&context).roots_disposed & (1u16 << context.role.index()),
+            0
+        );
+    });
+    b4_sequential_auxiliary_observations();
+}
+// The actual auxiliary producer/control cycle below is deliberately a
+// component core/JS fixture; the semantic views do not certify storage.
+fn b4_sequential_auxiliary_observations() {
+    use crate::actor::GuardedProofObservation as View;
+    use futures_util::FutureExt as _;
+    crate::actor::guarded_test_runtime().block_on(async {
+        let mut fixture = b2_fixture();
+        let (mut core, _activation, driver) = b2_core(&mut fixture);
+        let sample = b2_ticket(driver.epoch().unwrap(), 7);
+        let origin = b2_sync_origin(&driver, sample).unwrap();
+        let (mut future, origin, scalar) =
+            crate::js::guarded_sync_component_for_test(origin).unwrap();
+        let route = origin.submit().unwrap();
+        b2_deliver(&fixture, b2_request_transition(&fixture, &mut core));
+        let (_, activity) = route.now_or_never().unwrap().unwrap().into_parts();
+        let output = activity.output(sample).unwrap();
+        let effects = b2_request_transition(&fixture, &mut core);
+        let op = operation(&effects, |effect| match effect {
+            Effect::AwaitDurable { op, .. } => Some(*op),
+            _ => None,
+        });
+        fixture
+            .registry()
+            .observe_proof(
+                &driver,
+                View::Durable {
+                    op,
+                    result: Ok(7),
+                    source: celld_logic::ProofSource::Bucket,
+                },
+            )
+            .unwrap();
+        fixture
+            .registry()
+            .observe_proof(&driver, View::Ownership { op, result: Ok(()) })
+            .unwrap();
+        b2_deliver(&fixture, b2_prove(&mut core, op, 7));
+        assert_eq!(output.now_or_never(), Some(Ok(())));
+        b2_finish_component(&fixture, &mut core, activity).await;
+        scalar.send(Ok(())).unwrap();
+        assert!(future.as_mut().now_or_never().unwrap().is_ok());
+        drop(future);
+        let previous = b4_observation(&driver);
+        assert!(
+            previous.has(ObservationEvent::AuxLocal)
+                && previous.has(ObservationEvent::AuxDurableSuccess)
+                && previous.has(ObservationEvent::AuxOwnershipSuccess)
+                && previous.has(ObservationEvent::AuxOutputReleased)
+                && previous.has(ObservationEvent::AuxFinishDisposed)
+                && previous.has(ObservationEvent::AuxSyncDisposed)
+        );
+        let successor = b2_sync_origin(&driver, sample).unwrap();
+        let current = b4_observation(&driver);
+        assert!(current.requests[1] > previous.requests[1]);
+        assert_eq!(current.ordinal, previous.ordinal);
+        assert_eq!(
+            (
+                current.durable_ops[1],
+                current.ownership_ops[1],
+                current.positions[1],
+                current.durable_positions[1]
+            ),
+            (0, 0, 0, 0)
+        );
+        assert_eq!(
+            (
+                current.durable_verdicts[1],
+                current.ownership_verdicts[1],
+                current.proof_sources[1],
+                current.release_verdicts[1]
+            ),
+            (0, 0, 0, 0)
+        );
+        for event in [
+            ObservationEvent::AuxLocal,
+            ObservationEvent::AuxOutputSubmitted,
+            ObservationEvent::AuxDurableSuccess,
+            ObservationEvent::AuxOwnershipSuccess,
+            ObservationEvent::AuxOutputReleased,
+            ObservationEvent::AuxFinishProcessed,
+            ObservationEvent::AuxInactive,
+            ObservationEvent::AuxFinishDisposed,
+            ObservationEvent::AuxSyncDisposed,
+        ] {
+            assert!(!current.has(event));
+            assert_eq!(current.first[event as usize], 0);
+        }
+        drop(successor); // Unsubmitted successor is held, not fake-completed.
+    });
+}
