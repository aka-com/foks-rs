+impl OwnedEffectRegistry {
+    fn observe_proof(
+        &self,
+        context: &JobContext,
+        view: crate::actor::GuardedProofObservation,
+    ) -> Result<(), Refusal> {
+        use crate::actor::GuardedProofObservation;
+        let record = self.record(context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let op = match view {
+            GuardedProofObservation::Durable { op, .. }
+            | GuardedProofObservation::Ownership { op, .. } => op,
+        };
+        // C0's terminal handoff is not a primary/aux publication proof.
+        if context.role == JobRole::Cleanup(CleanupLane::EnsureDurable) {
+            return Ok(());
+        }
+        let index = state
+            .activities
+            .iter()
+            .position(|activity| activity.proof_op == Some(op))
+            .ok_or(Refusal::Invalid)?;
+        match view {
+            GuardedProofObservation::Durable { result, source, .. } => {
+                state.observation.durable_ops[index] = op;
+                state.observation.durable_verdicts[index] = if result.is_ok() { 1 } else { 2 };
+                state.observation.proof_sources[index] = match source {
+                    celld_logic::ProofSource::Fleet => 1,
+                    celld_logic::ProofSource::Bucket => 2,
+                };
+                if let Ok(position) = result {
+                    state.observation.durable_positions[index] = position;
+                    if position >= state.observation.positions[index] {
+                        state.observation.mark(if index == 0 {
+                            ObservationEvent::PrimaryDurableSuccess
+                        } else {
+                            ObservationEvent::AuxDurableSuccess
+                        })?;
+                    }
+                }
+            }
+            GuardedProofObservation::Ownership { result, .. } => {
+                state.observation.ownership_ops[index] = op;
+                state.observation.ownership_verdicts[index] = if result.is_ok() { 1 } else { 2 };
+                if result.is_ok() {
+                    state.observation.mark(if index == 0 {
+                        ObservationEvent::PrimaryOwnershipSuccess
+                    } else {
+                        ObservationEvent::AuxOwnershipSuccess
+                    })?;
+                }
+            }
+        }
+        Ok(())
+    }
+}
