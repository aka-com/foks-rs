+    let counter = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let guard =
+        crate::actor::PublicRequestGuard::acquire_for_test(&AtomicBool::new(false), &counter)
+            .unwrap();
+    let owner = child(&node.factory, OwnerRole::Invocation);
+    let weak = Arc::downgrade(&component::request(&owner));
+    let context = b3_begin_context(
+        node.effects
+            .register_owned(owner, 0, None, Some(guard))
+            .unwrap(),
+        &node.effects,
+    );
+    let sequence = context.token.invocation;
+    b3_empty_pending(&node.effects, &context);
+    struct WakeAfterGuard {
+        counter: Arc<std::sync::atomic::AtomicUsize>,
+        observed: Arc<AtomicBool>,
+    }
+    impl futures_util::task::ArcWake for WakeAfterGuard {
+        fn wake_by_ref(value: &Arc<Self>) {
+            value
+                .observed
+                .store(value.counter.load(Ordering::SeqCst) == 0, Ordering::Release);
+        }
+    }
+    let observed = Arc::new(AtomicBool::new(false));
+    let wake = futures_util::task::waker(Arc::new(WakeAfterGuard {
+        counter: counter.clone(),
+        observed: observed.clone(),
+    }));
