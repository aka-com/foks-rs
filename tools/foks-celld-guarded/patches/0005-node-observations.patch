+    }
+    fn latest_observation(&self, tenant: usize) -> Result<InvocationObservation, Refusal> {
+        if tenant >= CELL_SCOPES.len() {
+            return Err(Refusal::Invalid);
+        }
+        let index = {
+            let bank = self.bank.try_lock().map_err(|_| Refusal::Contended)?;
+            bank.archive[..bank.next as usize]
+                .iter()
+                .rposition(|entry| entry.tenant as usize == tenant)
+        };
+        match index {
+            Some(index) => self.observation_by_index(index),
+            None => {
+                let mut value = InvocationObservation::empty();
+                value.tenant = tenant as u8;
+                Ok(value)
+            }
+        }
+    }
