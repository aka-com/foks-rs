+    let mut retirement = RetirementObservation {
+        registry: node.effects.clone(),
+        slot: 0,
+        sequence,
+    };
+    node.effects.retire_completed_records();
+    assert_eq!(counter.load(Ordering::SeqCst), 1);
+    assert!(Pin::new(&mut retirement).poll(&mut cx).is_pending());
+    drop(context);
+    node.effects.retire_completed_records();
+    assert_eq!(counter.load(Ordering::SeqCst), 0);
+    assert!(weak.upgrade().is_none());
+    assert!(observed.load(Ordering::Acquire));
+    assert_eq!(Pin::new(&mut retirement).poll(&mut cx), Poll::Ready(Ok(())));
+    let value = node
+        .effects
+        .observation_by_index(sequence as usize - 1)
