+impl BankState {
+    fn reserve_observation(&mut self, mut value: InvocationObservation) -> Result<u64, Refusal> {
+        if self.next >= OBSERVATION_LIMIT as u64 {
+            return Err(Refusal::Exhausted);
+        }
+        let next = self.next.checked_add(1).ok_or(Refusal::Exhausted)?;
+        value.sequence = next;
+        self.archive[self.next as usize] = value;
+        self.next = next;
+        Ok(next)
+    }
