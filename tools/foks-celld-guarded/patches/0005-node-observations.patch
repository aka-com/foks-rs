+            2 => invalid.accepted_bytes = 7,
+            3 => invalid.accepted_bytes = 33,
+            4 => invalid.positive_pending_bytes = 0,
+            5 => invalid.positive_pending_bytes = 7,
+            6 => invalid.write_polls = 2,
