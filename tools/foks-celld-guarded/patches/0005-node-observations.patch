+#[derive(Clone, Copy, Debug)]
+pub(crate) struct WriteProgress {
+    pub(crate) frame_bytes: u32,
+    pub(crate) accepted_bytes: u32,
+    pub(crate) positive_pending_bytes: u32,
+    pub(crate) write_polls: u32,
+    pub(crate) pending_polls: u32,
+    pub(crate) zero_pending: bool,
+}
+impl WriteProgress {
+    fn new(bytes: usize) -> Result<Self, Refusal> {
+        if bytes == 0 || bytes > FrameKind::Backpressure.bytes() {
+            return Err(Refusal::Bounds);
+        }
+        Ok(Self {
+            frame_bytes: u32::try_from(bytes).map_err(|_| Refusal::Bounds)?,
+            accepted_bytes: 0,
+            positive_pending_bytes: 0,
+            write_polls: 0,
+            pending_polls: 0,
+            zero_pending: false,
+        })
+    }
+    fn written(&mut self, bytes: usize, offered: usize) -> Result<(), Refusal> {
+        if bytes > offered {
+            return Err(Refusal::Bounds);
+        }
+        let next = self
+            .accepted_bytes
+            .checked_add(u32::try_from(bytes).map_err(|_| Refusal::Bounds)?)
+            .filter(|next| *next <= self.frame_bytes)
+            .ok_or(Refusal::Bounds)?;
+        self.accepted_bytes = next;
+        Ok(())
+    }
+    fn pending(&mut self) -> Result<(), Refusal> {
+        self.pending_polls = self.pending_polls.checked_add(1).ok_or(Refusal::Bounds)?;
+        if self.accepted_bytes == 0 {
+            self.zero_pending = true;
+        } else if self.accepted_bytes < self.frame_bytes && self.positive_pending_bytes == 0 {
+            self.positive_pending_bytes = self.accepted_bytes;
+        }
+        Ok(())
     }
 }
 
