+#[derive(Clone, Copy, Debug, serde::Serialize)]
+pub struct ObservationLayouts {
+    record: [usize; 2],
+    archive: [usize; 2],
+    held: [usize; 2],
+    a2_chunk: [usize; 2],
+    report: [usize; 2],
+    retained_bytes: usize,
+}
+fn observation_layouts() -> Result<ObservationLayouts, Refusal> {
+    fn row<T>() -> [usize; 2] {
+        let value = std::alloc::Layout::new::<T>();
+        [value.size(), value.align()]
+    }
+    let value = ObservationLayouts {
+        record: row::<InvocationObservation>(),
+        archive: row::<[InvocationObservation; OBSERVATION_LIMIT]>(),
+        held: row::<HeldRetirement>(),
+        a2_chunk: row::<super::NodeEventChunk>(),
+        report: row::<GuardedNodeReport>(),
+        retained_bytes: 0,
+    };
+    // Archive is physically inside the charged registry Arc. Active/held copies
+    // use existing actual record/registry charges. One encoding Vec and one
+    // chunk/record scratch overlap are included; no second full event Vec.
+    let registry_bytes = control::arc_bytes::<OwnedEffectRegistry>()?;
+    let progress = std::alloc::Layout::new::<output::WriteProgress>();
+    if registry_bytes > 65_536 || progress.size() > 64 || progress.align() > 16 {
+        return Err(Refusal::Bounds);
+    }
+    let retained = value.archive[0]
+        .checked_add(65_536)
+        .and_then(|v| v.checked_add(value.a2_chunk[0]))
+        .and_then(|v| v.checked_add(6 * value.record[0]))
+        .and_then(|v| v.checked_add(value.report[0] + 1024))
+        .and_then(|v| v.checked_add(super::node_event_storage_bytes()))
+        .ok_or(Refusal::Bounds)?;
+    if value.record[0] > OBSERVATION_BYTES
+        || value.record[1] > 8
+        || value.archive[0] > 32_768
+        || value.a2_chunk[0] > 4096
+        || value.report[0] > 4096
+        || value.held[0] > 1024
+        || value.held[1] > 16
+        || value.archive[1] > 8
+        || value.a2_chunk[1] > 16
+        || value.report[1] > 16
+        || OBSERVATION_STREAM_BYTES != OBSERVATION_LIMIT * 2048 + 8 * 16_384 + 2048
+        || retained > 131_072
+    {
+        return Err(Refusal::Bounds);
+    }
+    Ok(ObservationLayouts {
+        retained_bytes: retained,
+        ..value
+    })
+}
