+    for positive in [false, true] {
+        let mut empty = InvocationObservation::empty();
+        let invalid = output::WriteProgress {
+            frame_bytes: 32,
+            accepted_bytes: 8,
+            positive_pending_bytes: if positive { 8 } else { 0 },
+            write_polls: 1,
