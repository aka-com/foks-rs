+impl Capacity {
+    fn node_event_count(&self) -> Result<usize, node::Refusal> {
+        Ok(self
+            .ledger
+            .try_lock()
+            .map_err(|_| node::Refusal::Contended)?
+            .events
+            .len())
+    }
+    fn node_event_chunk(
+        &self,
+        start: usize,
+        cutoff: usize,
+    ) -> Result<NodeEventChunk, node::Refusal> {
+        if cutoff > EVENT_LIMIT || start > cutoff || start % 64 != 0 {
+            return Err(node::Refusal::Invalid);
+        }
+        let ledger = self
+            .ledger
+            .try_lock()
+            .map_err(|_| node::Refusal::Contended)?;
+        if cutoff > ledger.events.len() {
+            return Err(node::Refusal::Invalid);
+        }
+        let count = (cutoff - start).min(64);
+        let mut chunk = NodeEventChunk {
+            start,
+            count,
+            cutoff,
+            observation_failed: ledger.observation_failed,
+            events: [None; 64],
+        };
+        for (destination, event) in chunk
+            .events
+            .iter_mut()
+            .zip(&ledger.events[start..start + count])
+        {
+            *destination = Some(*event);
+        }
+        // This Copy chunk is returned only after releasing the physical ledger.
+        Ok(chunk)
+    }
+}
