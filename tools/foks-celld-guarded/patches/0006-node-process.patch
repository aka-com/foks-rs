+impl Qualification {
+    pub fn cancel_processed(&self, id: Identity) -> Result<(), Refusal> {
+        let mut s = self.state()?;
+        if s.journal.sealed {
+            return Ok(());
+        }
+        if s.case == 0 {
+            return Ok(());
+        }
+        let c = case(s.case)?;
+        if !matches!(
+            c.reaction,
+            Action::CanonicalParentCancel | Action::CanonicalReleaseAll | Action::ForceReloadSwap
+        ) {
+            return Ok(());
+        }
+        if c.reaction == Action::ForceReloadSwap
+            && (s.reload.new == 0 || s.reload.processed != s.reload.new)
+        {
+            return Err(Refusal::Invalid);
+        }
+        for b in &mut s.barriers {
+            if b.entered && b.advance_seen && b.identity.is_some_and(|i| i.same_invocation(id)) {
+                b.advanced = true;
+            }
+        }
+        let wakes = Self::take_wakes(&mut s);
+        drop(s);
+        self.notify(wakes);
+        Ok(())
+    }
+}
