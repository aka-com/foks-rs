+            }
+            let case = s.case;
+            s.journal
+                .append(CheckpointRecord::process(case, 9, u64::from(mode), 0))?;
+            s.notice = true;
+            notices = Self::take_wakes(&mut s);
+        }
+        for w in wakes {
+            drop_wake(w)
+        }
+        self.notify(notices);
+        Ok(())
