+// Component evidence: Shared finite reload process state validates requested/adopted/processed/drained scalar relationships and Begin gating; no actual RuntimeManager checked ID/Generation lookup/removal is executed.
+// P3 required: Actual sole canonical retained reload build/adopt+core processed, actual runtime old/current ID observation/removal and exact genuine old generation pin NotReady. Source review must additionally audit checked maximum+checked_add helper and no fallback.
+#[test]
+fn b4_process_binding_drained_generation_state_and_selector() {
+    let (q, id) = b4_process_component(101);
+    assert!(q.permit_begin().is_err());
+    q.process(1, 7, 0, false).unwrap();
+    q.reload_request().unwrap();
+    q.process(6, 7, 8, false).unwrap();
+    q.process(7, 8, 0, true).unwrap();
+    q.process(8, 7, 8, false).unwrap();
+    assert!(q.permit_begin().is_ok());
+    assert!(b4_validator_report(&q, 101, id, Some(7), Refusal::NotReady).is_err());
+    assert!(b4_process_poll(&q, id, 101).is_pending());
+    assert!(b4_validator_report(&q, 101, id, Some(7), Refusal::NotReady).is_err());
+    q.advance(q.entered_for_test(0).unwrap()).unwrap();
+    assert!(b4_process_poll(&q, id, 101).is_ready());
+    let before = q.count().unwrap().0;
+    for reason in [Refusal::Invalid, Refusal::Failed, Refusal::Contended] {
+        assert!(b4_validator_report(&q, 101, id, Some(7), reason).is_err());
+    }
+    assert!(b4_validator_report(&q, 101, id, None, Refusal::NotReady).is_err());
+    assert!(b4_validator_report(&q, 101, id, Some(8), Refusal::NotReady).is_err());
+    for field in 0..5 {
+        let mut wrong = id;
+        match field {
+            0 => wrong.op += 1,
+            1 => wrong.a2 += 1,
+            2 => wrong.root.sequence += 1,
+            3 => wrong.auxiliary_sequence += 1,
+            _ => wrong.invocation += 1,
+        };
+        assert!(b4_validator_report(&q, 101, wrong, Some(7), Refusal::NotReady).is_err());
+    }
+    assert_eq!(q.count().unwrap().0, before);
+    // Supplied reason tests only the observer contract. Actual pin NotReady is P3.
+    b4_validator_report(&q, 101, id, Some(7), Refusal::NotReady).unwrap();
+    let row = serde_json::to_value(q.row(before).unwrap().unwrap()).unwrap();
+    assert_eq!(row["state"], "failed");
+    assert_eq!(row["checkpoint"], 21);
+    assert_eq!(row["root_sequence"], id.root.sequence);
+    assert_eq!(row["operation"], id.op);
+    assert!(b4_validator_report(&q, 101, id, Some(7), Refusal::NotReady).is_err());
+    q.seal().unwrap();
+    assert!(b4_validator_report(&q, 101, id, Some(7), Refusal::NotReady).is_err());
+    let absent = qualification::Qualification::new();
+    absent.install(101).unwrap();
+    assert!(b4_validator_report(&absent, 101, id, Some(7), Refusal::NotReady).is_err());
+    let (full, full_id) = b4_process_component(100);
+    assert!(b4_process_poll(&full, full_id, 100).is_pending());
+    full.advance(full.entered_for_test(0).unwrap()).unwrap();
+    assert!(b4_process_poll(&full, full_id, 100).is_ready());
+    while full.count().unwrap().0 < 64 {
+        full.process(2, 0, 0, false).unwrap();
+    }
+    assert!(b4_validator_report(&full, 100, full_id, None, Refusal::Invalid).is_err());
+    assert_eq!(full.count().unwrap().0, 64);
+}
+#[test]
+fn b4_process_process_layouts_and_stream_caps() {
+    use std::io::Write;
+    let (worst, process, end) = qualification::worst_records_for_test();
+    assert!(serde_json::to_vec(&worst).unwrap().len() + 1 <= 512);
+    assert!(serde_json::to_vec(&process).unwrap().len() + 1 <= 512);
+    assert!(serde_json::to_vec(&end).unwrap().len() + 1 <= 1024);
+    assert!(std::mem::size_of::<ProcessLayouts>() <= 1024);
+    assert!(std::mem::size_of::<qualification::CheckpointEnd>() <= 1024);
+    assert!(std::mem::size_of::<qualification::CheckpointRecord>() <= 1024);
+    let actual = process_layouts_for(0).unwrap();
+    assert_eq!(actual.rows.len(), 13);
+    assert_eq!(
+        actual.retained_bytes,
+        actual.retained_terms.p1_retained_bytes
+            + actual.retained_terms.qualification_bytes
+            + actual.retained_terms.main_work_bytes
+            + actual.retained_terms.extra_scratch_bytes
+            + actual.retained_terms.sync_mutex_bytes
+            + actual.retained_terms.sync_condvar_bytes
+    );
+    assert!(
+        actual.retained_terms.sync_mutex_bytes > 0 && actual.retained_terms.sync_condvar_bytes > 0
+    );
+    assert!(
+        actual.retained_terms.sync_mutex_bytes + actual.retained_terms.sync_condvar_bytes <= 256
+    );
+    assert!(actual.retained_bytes <= 131072);
+    assert!(process_layouts_for(8193).is_err());
+    assert!(qualification::Qualification::layouts()[1].0 <= 8192);
+    let value = serde_json::to_string(&actual).unwrap();
+    let line = format!("FOKS_B4_PROCESS_LAYOUT={value}\n");
+    assert!(line.len() <= 4096);
+    let mut stderr = std::io::stderr().lock();
+    stderr.write_all(line.as_bytes()).unwrap();
+    stderr.flush().unwrap();
+    let (q, id) = b4_process_component(17);
+    assert!(b4_process_poll(&q, id, 17).is_pending());
+    let row = serde_json::to_vec(&q.row(0).unwrap().unwrap()).unwrap();
+    assert!(row.len() + 1 <= 512);
+    q.seal().unwrap();
+    assert!(
+        serde_json::to_vec(&q.end(q.count().unwrap().0).unwrap())
+            .unwrap()
+            .len()
+            + 1
+            <= 1024
+    );
+}
