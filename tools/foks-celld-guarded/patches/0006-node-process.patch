+}
+
+impl Drop for Run {
+    fn drop(&mut self) {
+        #[cfg(feature = "foks-guarded-node-qualification")]
+        if let Some(enabled) = self.enabled.take() {
+            // Protect the actual aggregate FIRST. Even an unexpected panic in
+            // diagnostic serialization cannot detach the real build or thread.
+            let mut retained = std::mem::ManuallyDrop::new(enabled);
+            if !std::thread::panicking() && !retained.checkpoint_ended {
+                // Narrow synchronous diagnostic-only catch: it polls no Future,
+                // touches no V8 and resumes no state after an unwind. Both the
+                // actual owner and any panic/error carrier survive until exit.
+                let reported = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    report_enabled(&mut retained, "failed", false)
+                }));
+                std::mem::forget(reported);
+            }
+            // Covers every inherited main `?`, channel failure and unwind.
+            // Later-declared ordinary locals may already have been dropped; this
+            // claims retention of these guarded owners, not all-node teardown.
+            super::exit_flushed(3);
+        }
+    }
