+// P2 component evidence. Native/Rust boundary selector tests below validate the
+// real shared qualification guard and actual owner validators. They do not
+// substitute for P3's actual assembled Run/Worker/native/catch process cuts.
+fn b4_process_component(case_id: u16) -> (qualification::Qualification, qualification::Identity) {
+    let q = qualification::Qualification::new();
+    q.install(case_id).unwrap();
+    let c = qualification::case(case_id).unwrap();
+    let lane = if case_id == 95 { 3 } else { c.lane };
+    let id = qualification::Identity {
+        invocation: 1,
+        a2: 5,
+        root: RootToken {
+            slot: 0,
+            invocation: 1,
+            lane,
+            sequence: if lane == 255 { 0 } else { 1 },
+        },
+        child: if c.native == 255 { 0 } else { 1 },
+        op: if lane == 255 || case_id == 95 { 0 } else { 7 },
+        tenant: 0,
+        a2_slot: 1,
+        native: c.native,
+        activity: c.activity,
+        connection: 0,
+        connection_generation: 1,
+        auxiliary_request: if c.activity == 1 { 8 } else { 0 },
+        auxiliary_sequence: if c.activity == 1 { 1 } else { 0 },
+    };
+    q.admit(id, Instant::now() + Duration::from_secs(15))
+        .unwrap();
+    (q, id)
+}
+fn b4_process_poll(
+    q: &qualification::Qualification,
+    id: qualification::Identity,
+    case_id: u16,
+) -> Poll<Result<qualification::Action, Refusal>> {
+    let c = qualification::case(case_id).unwrap();
+    let cut = if matches!(case_id,84..=88|93..=101) {
+        case_id
+    } else {
+        0
+    };
+    let mut cx = Context::from_waker(std::task::Waker::noop());
+    q.poll(id, c.checkpoint, cut, &mut cx)
+}
