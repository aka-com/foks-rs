+#[cfg(feature = "foks-guarded-node-qualification")]
+impl RuntimeManager {
+    pub fn checked_guarded_next_generation_id(
+        &self,
+    ) -> Result<u64, crate::guarded_execution::node::Refusal> {
+        use crate::guarded_execution::node::Refusal;
+        let g = self
+            .core
+            .generations
+            .try_read()
+            .map_err(|_| Refusal::Contended)?;
+        g.draining
+            .iter()
+            .map(|v| v.id)
+            .chain(std::iter::once(g.current.id))
+            .max()
+            .ok_or(Refusal::Invalid)?
+            .checked_add(1)
+            .ok_or(Refusal::Exhausted)
+    }
+    pub fn guarded_generation_presence(
+        &self,
+        old: u64,
+    ) -> Result<(u64, bool), crate::guarded_execution::node::Refusal> {
+        use crate::guarded_execution::node::Refusal;
+        let g = self
+            .core
+            .generations
+            .try_read()
+            .map_err(|_| Refusal::Contended)?;
+        Ok((
+            g.current.id,
+            g.current.id == old || g.draining.iter().any(|v| v.id == old),
+        ))
+    }
+}
