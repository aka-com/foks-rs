+            && (c.activity == 255 || id.activity == c.activity)
+            && (c.lane == 255 || id.root.lane == c.lane)
+            && (c.native == 255 || id.native == c.native)
+    }
+    pub fn poll(
+        &self,
+        id: Identity,
+        checkpoint: u8,
+        cut: u16,
+        cx: &mut Context<'_>,
+    ) -> Poll<Result<Action, Refusal>> {
+        let incoming = cx.waker().clone();
+        let mut old = None;
+        let mut wakes = std::array::from_fn(|_| None);
+        let result = (|| {
+            let mut s = self.state()?;
+            if s.journal.sealed {
+                return Ok(None);
+            }
+            if s.case == 0 {
+                return Ok(Some(Action::Continue));
+            }
+            let c = case(s.case)?;
+            if !Self::matches(c, id, checkpoint, cut) {
+                return Ok(Some(Action::Continue));
+            }
+            let Some(index) = s
+                .barriers
+                .iter()
+                .position(|b| b.identity.is_some_and(|i| i.same_invocation(id)))
+            else {
+                return Ok(Some(Action::Continue));
+            };
+            if s.barriers[index].consumed {
+                return Ok(Some(Action::Continue));
+            }
+            if s.barriers[index].entered
+                && !s.barriers[index]
+                    .identity
+                    .is_some_and(|v| v.same_checkpoint(id))
+            {
+                return Err(Refusal::Invalid);
+            }
+            if !s.barriers[index].entered {
+                let ordinal = s.ordinal.checked_add(1).ok_or(Refusal::Exhausted)?;
+                s.ordinal = ordinal;
+                s.barriers[index].entered = true;
+                s.barriers[index].ordinal = ordinal;
+                let mut selected = id;
+                if let Some(initial) = s.barriers[index].identity {
+                    selected.connection = initial.connection;
+                    selected.connection_generation = initial.connection_generation;
+                }
+                s.barriers[index].identity = Some(selected);
+                s.journal.append(CheckpointRecord::invocation(
+                    c.id, checkpoint, 1, selected, ordinal,
+                ))?;
+                s.notice = true;
+            }
+            let ready = s.barriers[index].advanced
+                || matches!(
+                    c.reaction,
+                    Action::Continue | Action::PeerDrain | Action::PeerClose
+                )
+                || s.barriers[index].expired && c.reaction == Action::OriginalExpiry;
+            let answer = if ready {
+                let b = &mut s.barriers[index];
+                b.consumed = true;
+                let identity = b.identity.ok_or(Refusal::Invalid)?;
+                let ordinal = b.ordinal;
+                let expired = b.expired;
+                s.journal.append(CheckpointRecord::invocation(
+                    c.id, checkpoint, 4, identity, ordinal,
+                ))?;
+                s.notice = true;
+                Ok(Some(if expired && c.reaction == Action::OriginalExpiry {
+                    Action::OriginalExpiry
+                } else {
+                    c.reaction
+                }))
+            } else {
+                old = s.barriers[index].waker.replace(incoming);
+                Ok(None)
+            };
+            wakes = Self::take_wakes(&mut s);
+            answer
+        })();
+        drop(old);
+        self.notify(wakes);
+        match result {
+            Ok(Some(v)) => Poll::Ready(Ok(v)),
+            Ok(None) => Poll::Pending,
+            Err(e) => Poll::Ready(Err(e)),
+        }
+    }
