+        cut: u16,
+        kind: NativeKind,
+    ) -> Result<qualification::Action, Refusal> {
+        let registry = self.registry()?;
+        let id = self.qualification_identity(0, Some(kind))?;
+        let action = registry.qualification.blocking(id, checkpoint, cut)?;
+        if action == qualification::Action::OriginalExpiry {
+            return Err(Refusal::Expired);
+        }
+        if matches!(self.role, JobRole::Forward(_)) {
+            self.check_forward()?
+        }
+        Ok(action)
+    }
+    pub(crate) fn qualification_clear_required_generation(
+        &self,
+        expected: u64,
+    ) -> Result<(), Refusal> {
+        if self.qualification_case() != Some(100) || expected == 0 {
+            return Err(Refusal::Invalid);
+        }
+        self.require_role(JobRole::Forward(ForwardLane::Activation))?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        if state.generation != Some(expected)
+            || state.generation_pin.is_some()
+            || state.runtime.is_some()
+        {
+            return Err(Refusal::Invalid);
+        }
+        state.generation = None;
+        Ok(())
+    }
+    pub(crate) fn qualification_drained_generation(&self) -> Result<Option<u64>, Refusal> {
+        self.registry()?.qualification.drained_generation()
+    }
