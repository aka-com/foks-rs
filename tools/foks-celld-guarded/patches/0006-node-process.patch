+fn b4_validator_contract(case: u16) {
+    let (q, id) = b4_process_component(case);
+    let generation = if matches!(case, 95..=98) {
+        Some(3)
+    } else {
+        None
+    };
+    assert!(q.capture_validator(case, id, Some(1), generation).is_err());
+    assert!(b4_process_poll(&q, id, case).is_pending());
+    assert!(q.capture_validator(case, id, Some(1), generation).is_err());
+    q.advance(q.entered_for_test(0).unwrap()).unwrap();
+    assert!(b4_process_poll(&q, id, case).is_ready());
+    let ticket = q.capture_validator(case, id, Some(1), generation).unwrap();
+    let before = q.count().unwrap().0;
+    for reason in [Refusal::Failed, Refusal::Contended, Refusal::NotReady] {
+        assert!(q.validator_refused(ticket, reason).is_err());
+    }
+    for field in 0..8 {
+        let mut wrong = id;
+        match field {
+            0 => wrong.op += 1,
+            1 => wrong.a2 += 1,
+            2 => wrong.root.sequence += 1,
+            3 => wrong.invocation += 1,
+            4 => wrong.auxiliary_request += 1,
+            5 => wrong.auxiliary_sequence += 1,
+            6 => wrong.child += 1,
+            _ => wrong.root.lane = 0,
+        };
+        assert!(q
+            .capture_validator(case, wrong, Some(1), generation)
+            .is_err());
+    }
+    assert!(q
+        .validator_refused(
+            qualification::wrong_validator_ordinal_for_test(ticket),
+            Refusal::Invalid
+        )
+        .is_err());
+    assert_eq!(q.count().unwrap().0, before);
+    q.validator_refused(ticket, Refusal::Invalid).unwrap();
+    let row = serde_json::to_value(q.row(before).unwrap().unwrap()).unwrap();
+    assert_eq!(row["state"], "failed");
+    assert_eq!(row["checkpoint"], 21);
+    assert_eq!(row["invocation"], id.invocation);
+    assert_eq!(
+        row["root_sequence"],
+        if id.root.sequence == 0 {
+            serde_json::Value::Null
+        } else {
+            serde_json::Value::from(id.root.sequence)
+        }
+    );
+    assert!(q.validator_refused(ticket, Refusal::Invalid).is_err());
+    q.seal().unwrap();
+    assert!(q.validator_refused(ticket, Refusal::Invalid).is_err());
+    let absent = qualification::Qualification::new();
+    absent.install(case).unwrap();
+    assert!(absent
+        .capture_validator(case, id, Some(1), generation)
+        .is_err());
+    let (full, full_id) = b4_process_component(case);
+    assert!(b4_process_poll(&full, full_id, case).is_pending());
+    full.advance(full.entered_for_test(0).unwrap()).unwrap();
+    assert!(b4_process_poll(&full, full_id, case).is_ready());
+    let full_ticket = full
+        .capture_validator(case, full_id, Some(1), generation)
+        .unwrap();
+    while full.count().unwrap().0 < 64 {
+        full.process(2, 0, 0, false).unwrap();
+    }
+    assert!(full
+        .validator_refused(full_ticket, Refusal::Invalid)
+        .is_err());
+    assert_eq!(full.count().unwrap().0, 64);
