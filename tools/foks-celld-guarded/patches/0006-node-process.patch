+impl Qualification {
+    pub fn seal(&self) -> Result<usize, Refusal> {
+        let mut s = self.state()?;
+        s.journal.sealed = true;
+        Ok(s.journal.len)
+    }
+    pub fn selected(&self, id: Identity, checkpoint: u8, cut: u16) -> Result<bool, Refusal> {
+        let s = self.state()?;
+        Ok(s.case != 0
+            && Self::matches(case(s.case)?, id, checkpoint, cut)
+            && s.barriers
+                .iter()
+                .any(|b| b.identity.is_some_and(|v| v.same_invocation(id))))
+    }
+    pub fn layouts() -> [(usize, usize); 4] {
+        fn pair<T>() -> (usize, usize) {
+            let l = std::alloc::Layout::new::<T>();
+            (l.size(), l.align())
+        }
+        [
+            pair::<Qualification>(),
+            pair::<Journal>(),
+            pair::<Barrier>(),
+            pair::<ReloadRequest>(),
+        ]
+    }
+}
