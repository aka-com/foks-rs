+            return Err(Refusal::Busy);
+        }
+        s.reload.issued = true;
+        s.reload.requested = false;
+        Ok(Some(1))
+    }
+    pub fn processed_generation(&self) -> Result<u64, Refusal> {
+        Ok(self.state()?.reload.processed)
+    }
+    pub fn drained_generation(&self) -> Result<Option<u64>, Refusal> {
+        let s = self.state()?;
+        Ok((s.case == 101 && s.reload.drained).then_some(s.reload.old))
+    }
+    pub fn shutdown(&self, mode: u8) -> Result<(), Refusal> {
