+impl Publication {
+    fn qualification_local_close(&self) -> Result<(), Refusal> {
+        let registry = self.registry.upgrade().ok_or(Refusal::Failed)?;
+        let record = self.record.upgrade().ok_or(Refusal::Failed)?;
+        let (id, deadline, kind) = {
+            let mut state = lock_owned(&record.state)?;
+            let root = OwnedEffectRegistry::root(&mut state, self.token)?;
+            let kind = root.child.kind;
+            let op = root.op.unwrap_or(0);
+            let child = root.child.sequence;
+            let o = state.observation;
+            (
+                qualification::Identity {
+                    invocation: record.sequence,
+                    a2: o.a2_generation,
+                    root: self.token,
+                    child,
+                    op,
+                    tenant: o.tenant,
+                    a2_slot: o.a2_slot,
+                    native: kind.map_or(255, |k| k.observation_index() as u8),
+                    activity: 0,
+                    connection: 255,
+                    connection_generation: 0,
+                    auxiliary_request: 0,
+                    auxiliary_sequence: 0,
+                },
+                record.control.deadline()?,
+                kind,
+            )
+        };
+        let _ = deadline;
+        if kind == Some(NativeKind::LocalClose) {
+            registry.qualification.blocking(id, 16, 0)?;
+        }
+        Ok(())
+    }
