+#[derive(Clone, Copy, serde::Serialize)]
+pub struct ProcessLayouts {
+    schema: u8,
+    rows: [ProcessLayoutRow; 13],
+    retained_bytes: usize,
+    retained_terms: ProcessRetainedTerms,
+}
+fn process_layouts_for(main_work_bytes: usize) -> Result<ProcessLayouts, Refusal> {
+    let q = qualification::Qualification::layouts();
+    let output = output::qualification_layouts();
+    let foundation = control::layouts()?;
+    let h = std::alloc::Layout::new::<control::HeaderLease>();
+    let pairs = [
+        q[0],
+        q[1],
+        q[2],
+        q[3],
+        foundation[5],
+        (h.size(), h.align()),
+        output[0],
+        output[1],
+        output[2],
+        output[3],
+        output[4],
+        output[5],
+        (
+            control::arc_bytes::<crate::js::WorkerConfig>()?,
+            std::mem::align_of::<crate::js::WorkerConfig>(),
+        ),
+    ];
+    let caps = [
+        16384,
+        qualification::JOURNAL_BYTES,
+        1024,
+        8192,
+        256,
+        4096,
+        49152,
+        49152,
+        49152,
+        49152,
+        4096,
+        49152,
+        4096,
+    ];
+    let rows = std::array::from_fn(|i| ProcessLayoutRow {
+        id: (i + 1) as u8,
+        size: pairs[i].0,
+        align: pairs[i].1,
+    });
+    if rows
+        .iter()
+        .zip(caps)
+        .any(|(row, cap)| row.size > cap || row.align > 16)
+        || main_work_bytes > 8192
+    {
+        return Err(Refusal::Bounds);
+    }
+    measured_frontend_constructors()?;
+    output::measured_socket_constructor()?;
+    let p1_retained_bytes = observation_layouts()?.retained_bytes;
+    let scratch = std::mem::size_of::<ProcessLayouts>()
+        .max(std::mem::size_of::<qualification::CheckpointEnd>())
+        .max(std::mem::size_of::<qualification::CheckpointRecord>());
+    if scratch > 1024 {
+        return Err(Refusal::Bounds);
+    }
+    let extra_scratch_bytes = 0;
+    let qualification_bytes = q[0].0;
+    let (sync_mutex_bytes, sync_condvar_bytes) = qualification::Qualification::sync_backing_bytes();
+    if sync_mutex_bytes == 0
+        || sync_condvar_bytes == 0
+        || sync_mutex_bytes
+            .checked_add(sync_condvar_bytes)
+            .ok_or(Refusal::Bounds)?
+            > 256
+    {
+        return Err(Refusal::Bounds);
+    }
+    let retained_bytes = p1_retained_bytes
+        .checked_add(qualification_bytes)
+        .and_then(|v| v.checked_add(main_work_bytes))
+        .and_then(|v| v.checked_add(extra_scratch_bytes))
+        .and_then(|v| v.checked_add(sync_mutex_bytes))
+        .and_then(|v| v.checked_add(sync_condvar_bytes))
+        .ok_or(Refusal::Bounds)?;
+    if retained_bytes > qualification::PROCESS_RETAINED_BYTES
+        || qualification::PROCESS_STREAM_BYTES
+            != qualification::JOURNAL_LIMIT * qualification::CHECKPOINT_LINE_BYTES + 2048
+    {
+        return Err(Refusal::Bounds);
+    }
+    Ok(ProcessLayouts {
+        schema: 1,
+        rows,
+        retained_bytes,
+        retained_terms: ProcessRetainedTerms {
+            p1_retained_bytes,
+            qualification_bytes,
+            main_work_bytes,
+            extra_scratch_bytes,
+            sync_mutex_bytes,
+            sync_condvar_bytes,
+        },
+    })
+}
+impl GuardedNode {
+    pub fn process_layouts(&self) -> Result<ProcessLayouts, Refusal> {
