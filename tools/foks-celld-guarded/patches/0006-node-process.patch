+pub(super) struct Advance {
+    pub tenant: u8,
+    pub checkpoint: u8,
+    pub invocation: u64,
+    pub ordinal: u64,
+    pub case: u16,
+}
+impl Advance {
+    pub fn parse(bytes: &[u8]) -> Result<Self, Refusal> {
+        if bytes.len() != 32
+            || &bytes[..8] != b"FOKSGN01"
+            || bytes[8] != 2
+            || bytes[9] != 3
+            || bytes[10] > 2
+            || !(1..=CHECKPOINT_COUNT as u8).contains(&bytes[11])
+            || bytes[30..] != [0, 0]
+        {
+            return Err(Refusal::Invalid);
+        }
+        let value = Self {
+            tenant: bytes[10],
+            checkpoint: bytes[11],
+            invocation: u64::from_le_bytes(bytes[12..20].try_into().map_err(|_| Refusal::Invalid)?),
+            ordinal: u64::from_le_bytes(bytes[20..28].try_into().map_err(|_| Refusal::Invalid)?),
+            case: u16::from_le_bytes(bytes[28..30].try_into().map_err(|_| Refusal::Invalid)?),
+        };
+        case(value.case)?;
+        if value.invocation == 0 || value.ordinal == 0 {
+            return Err(Refusal::Invalid);
+        }
+        Ok(value)
+    }
+    pub fn reply(self, accepted: bool) -> [u8; 32] {
+        let mut b = [0; 32];
+        b[..8].copy_from_slice(b"FOKSGA02");
+        b[8] = 2;
+        b[9] = u8::from(!accepted);
+        b[10] = self.tenant;
+        b[11] = self.checkpoint;
+        b[12..20].copy_from_slice(&self.invocation.to_le_bytes());
+        b[20..28].copy_from_slice(&self.ordinal.to_le_bytes());
+        b[28..30].copy_from_slice(&self.case.to_le_bytes());
+        b
+    }
+}
