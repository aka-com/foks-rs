+fn state_name(state: u8) -> &'static str {
+    match state {
+        1 => "entered",
+        2 => "advanced",
+        3 => "consumer_dropped",
+        4 => "continued",
+        5 => "expired",
+        6 => "failed",
+        7 => "cut",
+        _ => "invalid",
+    }
+}
+fn process_name(state: u8) -> &'static str {
+    match state {
+        1 => "ReadyInitialSnapshotComplete",
+        2 => "ProbeEntered",
+        3 => "ProbeRefused",
+        4 => "ReloadRequested",
+        5 => "ReloadBuildRetained",
+        6 => "ReloadAdopted",
+        7 => "GenerationChangedProcessed",
+        8 => "DrainedOldGeneration",
+        9 => "ShutdownStarted",
+        10 => "ActorExit",
+        11 => "CanonicalCut",
+        12 => "ProbeSucceeded",
+        13 => "ReloadFailed",
+        14 => "MainWorkCharged",
+        15 => "HeaderEntered",
+        16 => "HeaderExpired",
+        _ => "invalid",
+    }
+}
+impl Serialize for CheckpointRecord {
+    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        let mut m = s.serialize_map(Some(if self.process { 10 } else { 19 }))?;
+        m.serialize_entry(
+            "kind",
+            if self.process {
+                "b4_process_checkpoint"
+            } else {
+                "b4_checkpoint"
+            },
+        )?;
+        m.serialize_entry("record_sequence", &self.sequence)?;
+        m.serialize_entry("case", &self.case)?;
+        m.serialize_entry("checkpoint", &self.checkpoint)?;
+        if self.process {
+            m.serialize_entry(
+                "process_operation",
+                &matches!(self.state, 4 | 5 | 6 | 7 | 8 | 13).then_some(1u64),
+            )?;
+            m.serialize_entry("state", process_name(self.state))?;
+            m.serialize_entry(
+                "from_generation",
+                &matches!(self.state, 6 | 8).then_some(self.first),
+            )?;
+            m.serialize_entry(
+                "to_generation",
+                &matches!(self.state, 1 | 5 | 6 | 7 | 8).then_some(
+                    if matches!(self.state, 1 | 7) {
+                        self.first
+                    } else {
+                        self.second
+                    },
+                ),
+            )?;
+            m.serialize_entry("first", &self.first)?;
+            m.serialize_entry("second", &self.second)?;
+        } else {
+            m.serialize_entry("state", state_name(self.state))?;
+            m.serialize_entry("tenant", &self.tenant)?;
+            m.serialize_entry("bank_slot", &self.bank)?;
+            m.serialize_entry("a2_slot", &self.a2_slot)?;
+            m.serialize_entry("a2_token", &self.a2)?;
+            m.serialize_entry("invocation", &self.invocation)?;
+            m.serialize_entry("lane", &self.lane)?;
+            m.serialize_entry("root_sequence", &((self.lane != 255).then_some(self.root)))?;
+            m.serialize_entry("native_kind", &self.native)?;
+            m.serialize_entry(
+                "native_child_sequence",
+                &(self.child != 0).then_some(self.child),
+            )?;
+            m.serialize_entry("activity", &self.activity)?;
+            m.serialize_entry("operation", &(self.op != 0).then_some(self.op))?;
+            m.serialize_entry(
+                "control_ordinal",
+                &(self.ordinal != 0).then_some(self.ordinal),
+            )?;
+            m.serialize_entry(
+                "auxiliary_request",
+                &(self.activity == 1).then_some(self.auxiliary_request),
+            )?;
+            m.serialize_entry(
+                "auxiliary_sequence",
+                &(self.activity == 1).then_some(self.auxiliary_sequence),
+            )?;
+        }
+        m.end()
+    }
+}
