+        Ok(pointer) => {
+            super::adopt_deployment(
+                &context.app,
+                &context.bucket,
+                &context.node,
+                &context.region,
+                pointer,
+                true,
+                &context.qualification,
+            )
+            .await
+        }
+        Err(error) => ReloadOutcome::Failed {
+            version: String::new(),
+            prefix: String::new(),
+            error: format!("{error:#}"),
+        },
+    }
