+impl Qualification {
+    pub fn reply_poll(&self, id: Identity, cx: &mut Context<'_>) -> Result<bool, Refusal> {
+        let incoming = cx.waker().clone();
+        let mut old = None;
+        {
+            let mut s = self.state()?;
+            let selected = s.case != 0
+                && case(s.case).is_ok_and(|c| {
+                    matches!(
+                        c.reaction,
+                        Action::DropActualReplyConsumer | Action::AbandonOwnedProducerBeforeSend
+                    )
+                });
+            if selected {
+                if let Some(b) = s
+                    .barriers
+                    .iter_mut()
+                    .find(|b| !b.consumed && b.identity.is_some_and(|v| v.same_invocation(id)))
+                {
+                    old = b.sync_waker.replace(incoming);
+                }
+            }
+        }
+        drop(old);
+        self.reply_drop(id)
+    }
+    pub fn connection_dropped(&self, slot: u8, generation: u64) -> Result<(), Refusal> {
+        let mut s = self.state()?;
+        let b = s
+            .barriers
+            .iter()
+            .find(|b| {
+                b.identity
+                    .is_some_and(|i| i.connection == slot && i.connection_generation == generation)
+            })
+            .ok_or(Refusal::Invalid)?;
+        let id = b.identity.ok_or(Refusal::Invalid)?;
+        let ordinal = b.ordinal;
+        let c = case(s.case)?;
+        s.journal.append(CheckpointRecord::invocation(
+            c.id,
+            c.checkpoint,
+            3,
+            id,
+            ordinal,
+        ))?;
+        s.notice = true;
+        let wakes = Self::take_wakes(&mut s);
+        drop(s);
+        self.notify(wakes);
+        Ok(())
+    }
+}
