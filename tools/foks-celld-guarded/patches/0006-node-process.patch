+    pub fn poll_notice(&self, cx: &mut Context<'_>) -> Poll<Result<(), Refusal>> {
+        let incoming = cx.waker().clone();
+        let mut old = None;
+        let out = {
+            let mut s = match self.state() {
+                Ok(s) => s,
+                Err(e) => return Poll::Ready(Err(e)),
+            };
+            if s.notice {
+                s.notice = false;
+                Poll::Ready(Ok(()))
+            } else {
+                old = s.main_waker.replace(incoming);
+                Poll::Pending
+            }
+        };
+        drop(old);
+        out
+    }
+    pub fn tick(&self, now: Instant) -> Result<(), Refusal> {
+        let mut wakes = [None, None];
+        let notices;
+        {
+            let mut s = self.state()?;
+            if s.journal.sealed {
+                return Ok(());
+            }
+            let c = if s.case == 0 {
+                return Ok(());
+            } else {
+                case(s.case)?
+            };
+            if s.case == 60 && !s.header_expired && s.header_deadline.is_some_and(|d| now >= d) {
+                s.header_expired = true;
+                let (connection, generation) = s.header_connection.ok_or(Refusal::Invalid)?;
+                s.journal.append(CheckpointRecord::process(
+                    60,
+                    16,
+                    u64::from(connection),
+                    generation,
+                ))?;
+                s.notice = true;
+            }
+            for (i, wake) in wakes.iter_mut().enumerate() {
+                let b = &mut s.barriers[i];
+                if matches!(
+                    c.reaction,
+                    Action::OriginalExpiry | Action::CanonicalShutdownKeepNativeHold
+                ) && b.entered
+                    && !b.expired
+                    && b.deadline.is_some_and(|d| now >= d)
+                {
+                    b.expired = true;
+                    let id = b.identity.ok_or(Refusal::Invalid)?;
+                    let ordinal = b.ordinal;
+                    *wake = b.waker.take();
+                    s.journal.append(CheckpointRecord::invocation(
+                        c.id,
+                        c.checkpoint,
+                        5,
+                        id,
+                        ordinal,
+                    ))?;
+                    s.notice = true;
+                }
+            }
+            notices = Self::take_wakes(&mut s);
+        }
+        for w in wakes {
+            drop_wake(w)
+        }
+        self.notify(notices);
+        Ok(())
+    }
+    pub fn next_deadline(&self) -> Result<Option<Instant>, Refusal> {
+        let s = self.state()?;
+        if s.case == 60 {
+            return Ok(if s.header_expired {
+                None
+            } else {
+                s.header_deadline
+            });
+        }
+        if s.case == 0
+            || !matches!(
+                case(s.case)?.reaction,
+                Action::OriginalExpiry | Action::CanonicalShutdownKeepNativeHold
+            )
+        {
+            return Ok(None);
+        }
+        Ok(s.barriers
+            .iter()
+            .filter(|b| b.entered && !b.expired && !b.consumed)
+            .filter_map(|b| b.deadline)
+            .min())
+    }
+    pub fn count(&self) -> Result<(usize, u64, bool), Refusal> {
+        let s = self.state()?;
+        Ok((
+            s.journal.len,
+            s.journal.next,
+            s.failed || s.journal.overflow,
+        ))
+    }
+    pub fn row(&self, index: usize) -> Result<Option<CheckpointRecord>, Refusal> {
+        let s = self.state()?;
+        Ok((index < s.journal.len).then(|| s.journal.rows[index]))
+    }
+    pub fn process(
+        &self,
+        kind: u8,
+        first: u64,
+        second: u64,
+        internal: bool,
+    ) -> Result<(), Refusal> {
+        let mut s = self.state()?;
+        if s.journal.sealed {
+            return Err(Refusal::NotReady);
+        }
+        if s.case == 0 {
+            return if kind == 7 && internal {
+                Ok(())
+            } else {
+                Err(Refusal::NotReady)
+            };
+        }
+        if !(1..=14).contains(&kind) || !internal && matches!(kind, 7 | 9 | 14) {
+            return Err(Refusal::Invalid);
+        }
+        if kind == 1 && matches!(s.case, 12 | 101) {
+            if s.reload.requested || s.reload.issued {
+                return Err(Refusal::Busy);
+            }
+            s.reload.old = first;
+            s.reload.requested = true;
+        }
+        if kind == 6 {
+            s.reload.old = first;
+            s.reload.new = second;
+        }
+        if kind == 7 {
+            if first == 0 {
+                return Err(Refusal::Invalid);
+            }
+            s.reload.processed = first;
+            if s.reload.new == first
+                && case(s.case).is_ok_and(|c| c.reaction == Action::ForceReload)
+            {
+                for b in &mut s.barriers {
+                    if b.entered && b.advance_seen {
+                        b.advanced = true;
+                    }
+                }
+            }
+        }
+        if kind == 8 {
+            if s.case != 101
+                || first == 0
+                || first == second
+                || first != s.reload.old
+                || second != s.reload.processed
+            {
+                return Err(Refusal::Invalid);
+            }
+            s.reload.drained = true;
+        }
+        let case = s.case;
+        s.journal
+            .append(CheckpointRecord::process(case, kind, first, second))?;
+        s.notice = true;
+        let wakes = Self::take_wakes(&mut s);
+        drop(s);
+        self.notify(wakes);
+        Ok(())
+    }
+    pub fn reload_request(&self) -> Result<Option<u64>, Refusal> {
