+    len: usize,
+    next: u64,
+    overflow: bool,
+    sealed: bool,
+}
+impl Journal {
+    fn new() -> Self {
+        Self {
+            rows: [CheckpointRecord::EMPTY; JOURNAL_LIMIT],
+            len: 0,
+            next: 0,
+            overflow: false,
+            sealed: false,
+        }
+    }
+    fn append(&mut self, mut row: CheckpointRecord) -> Result<(), Refusal> {
+        if self.sealed {
+            return Err(Refusal::NotReady);
+        }
+        if self.len == JOURNAL_LIMIT {
+            self.overflow = true;
+            return Err(Refusal::Exhausted);
+        }
+        self.next = self.next.checked_add(1).ok_or(Refusal::Exhausted)?;
+        row.sequence = self.next;
+        self.rows[self.len] = row;
+        self.len += 1;
+        Ok(())
+    }
+}
