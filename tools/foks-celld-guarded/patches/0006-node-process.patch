+impl Qualification {
+    pub fn end(&self, emitted: usize) -> Result<CheckpointEnd, Refusal> {
+        let s = self.state()?;
+        if !s.journal.sealed || emitted != s.journal.len {
+            return Err(Refusal::Invalid);
+        }
+        let mut states = [0; 7];
+        let mut process = 0;
+        for row in &s.journal.rows[..s.journal.len] {
+            if row.process {
+                process += 1
+            } else if (1..=7).contains(&row.state) {
+                states[row.state as usize - 1] += 1
+            } else {
+                return Err(Refusal::Invalid);
+            }
+        }
+        Ok(CheckpointEnd {
+            kind: "b4_checkpoint_end",
+            recorded_count: s.journal.len,
+            emitted_count: emitted,
+            highest_record_sequence: s.journal.next,
+            barrier_count: s.barriers.iter().filter(|b| b.entered).count(),
+            consumed_control_count: s.controls,
+            failed: s.failed,
+            overflow: s.journal.overflow,
+            state_counts: states,
+            process_record_count: process,
+            sealed: true,
+            cutoff_scope: "diagnostic-frontier-no-task-termination",
+        })
+    }
+}
