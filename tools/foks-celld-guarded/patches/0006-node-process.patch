+#[derive(Clone, Copy, serde::Serialize)]
+pub struct CheckpointEnd {
+    kind: &'static str,
+    recorded_count: usize,
+    emitted_count: usize,
+    highest_record_sequence: u64,
+    barrier_count: usize,
+    consumed_control_count: u8,
+    failed: bool,
+    overflow: bool,
+    state_counts: [usize; 7],
+    process_record_count: usize,
+    sealed: bool,
+    cutoff_scope: &'static str,
