+impl GuardedNodeScenario {
+    pub fn for_process_case(id: u16) -> Result<Self, Refusal> {
+        qualification::case(id)?;
+        Ok(match id {
+            8 => Self::FailedTurnGated,
+            9 | 59 | 66 => Self::TcpWriteHeld,
+            10 => Self::TcpDisconnect,
+            89 | 91 => Self::ShutdownComplete,
+            90 | 92 => Self::ShutdownCut,
+            _ => Self::ColdSyncRetire,
+        })
+    }
+    pub fn parse_process_case(name: &str) -> Result<(Self, u16), Refusal> {
+        let id = qualification::CASES
+            .iter()
+            .find(|c| c.name == name)
+            .map(|c| c.id)
+            .or_else(|| match name {
+                "shutdown-complete" => Some(89),
+                "shutdown-cut" => Some(90),
+                _ => None,
+            })
+            .ok_or(Refusal::Invalid)?;
+        Ok((Self::for_process_case(id)?, id))
+    }
