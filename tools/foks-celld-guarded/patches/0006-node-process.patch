+    pub fn blocking(&self, id: Identity, checkpoint: u8, cut: u16) -> Result<Action, Refusal> {
+        let w = std::task::Waker::noop();
+        let mut cx = Context::from_waker(w);
+        loop {
+            match self.poll(id, checkpoint, cut, &mut cx) {
+                Poll::Ready(v) => return v,
+                Poll::Pending => {
+                    let s = self.state.lock().map_err(|_| Refusal::Failed)?;
+                    let ready = s.barriers.iter().any(|b| {
+                        b.identity.is_some_and(|v| v.same_invocation(id))
+                            && (b.advanced
+                                || b.expired
+                                    && case(s.case)
+                                        .is_ok_and(|c| c.reaction == Action::OriginalExpiry))
+                    });
+                    if !ready {
+                        let _guard = self.changed.wait(s).map_err(|_| Refusal::Failed)?;
+                    }
+                }
+            }
+        }
+    }
+    #[cfg(test)]
+    pub fn advance(&self, a: Advance) -> Result<(), Refusal> {
+        self.advance_inner(a, None)
+    }
+    pub fn advance_admitted(
+        &self,
+        a: Advance,
+        process: &super::control::OriginalOwner,
+        control: &super::control::OriginalOwner,
+        accepting: &std::sync::atomic::AtomicBool,
+    ) -> Result<(), Refusal> {
+        self.advance_inner(a, Some((process, control, accepting)))
+    }
+    fn advance_inner(
+        &self,
+        a: Advance,
+        admission: Option<(
+            &super::control::OriginalOwner,
+            &super::control::OriginalOwner,
+            &std::sync::atomic::AtomicBool,
+        )>,
+    ) -> Result<(), Refusal> {
+        let wakes = {
+            let mut s = self.state()?;
+            if s.journal.sealed {
+                return Err(Refusal::NotReady);
+            }
+            if let Some((process, control, accepting)) = admission {
+                process.check_admission_scalar()?;
+                control.check_admission_scalar()?;
+                if !accepting.load(std::sync::atomic::Ordering::Acquire) {
+                    return Err(Refusal::Cancelled);
+                }
+            }
+            if s.case != a.case || s.stopped || s.failed || s.controls >= 64 {
+                return Err(Refusal::Invalid);
+            }
+            let c = case(s.case)?;
+            let i = s
+                .barriers
+                .iter()
+                .position(|b| {
+                    b.entered
+                        && !b.advance_seen
+                        && !b.consumed
+                        && b.ordinal == a.ordinal
+                        && b.identity.is_some_and(|id| {
+                            id.tenant == a.tenant && id.invocation == a.invocation
+                        })
+                })
+                .ok_or(Refusal::Invalid)?;
+            if c.checkpoint != a.checkpoint
+                || matches!(
+                    c.reaction,
+                    Action::CanonicalShutdownKeepNativeHold | Action::OriginalExpiry
+                )
+            {
+                return Err(Refusal::Invalid);
+            }
+            if matches!(c.reaction, Action::ForceReload | Action::ForceReloadSwap)
+                && (s.reload.issued || s.reload.requested)
+            {
+                return Err(Refusal::Busy);
+            }
+            s.barriers[i].advance_seen = true;
+            s.controls = s.controls.checked_add(1).ok_or(Refusal::Exhausted)?;
+            let id = s.barriers[i].identity.ok_or(Refusal::Invalid)?;
+            s.journal.append(CheckpointRecord::invocation(
+                c.id,
+                a.checkpoint,
+                2,
+                id,
+                a.ordinal,
+            ))?;
+            match c.reaction {
+                Action::ForceReload | Action::ForceReloadSwap => {
+                    if s.reload.issued || s.reload.requested {
+                        return Err(Refusal::Busy);
+                    }
+                    s.reload.requested = true;
+                }
+                Action::ActualActorExit => s.actor_exit = true,
+                Action::CanonicalReleaseAll => s.release_all = true,
+                Action::CanonicalShutdownThenRelease => {}
+                Action::CanonicalParentCancel => s.barriers[i].cancel = true,
+                Action::DropActualReplyConsumer | Action::AbandonOwnedProducerBeforeSend => {
+                    s.barriers[i].drop_reply = true;
+                }
+                Action::DropActualConnectionConsumer => {
+                    s.barriers[i].drop_connection = true;
+                    s.barriers[i].advanced = true
+                }
+                Action::DropActualEffectConsumer => {
+                    s.barriers[i].drop_effect = true;
+                    s.barriers[i].advanced = true
+                }
+                Action::CanonicalShutdownKeepNativeHold | Action::OriginalExpiry => {
+                    return Err(Refusal::Invalid)
+                }
+                _ => s.barriers[i].advanced = true,
+            };
+            s.notice = true;
+            Self::take_wakes(&mut s)
+        };
+        self.notify(wakes);
+        Ok(())
+    }
+    fn take_wakes(s: &mut State) -> [Option<Waker>; 5] {
+        let mut wakes = std::array::from_fn(|_| None);
+        if s.notice {
+            wakes[0] = s.main_waker.take();
+        }
+        for i in 0..2 {
+            if s.barriers[i].advanced || s.barriers[i].consumed {
+                wakes[i + 1] = s.barriers[i].waker.take();
+            }
+            if s.barriers[i].drop_reply || s.barriers[i].advanced || s.barriers[i].consumed {
+                wakes[i + 3] = s.barriers[i].sync_waker.take();
+            }
+        }
+        wakes
+    }
+    fn notify(&self, wakes: [Option<Waker>; 5]) {
+        for wake in wakes {
+            drop_wake(wake)
+        }
+        self.changed.notify_all();
+    }
