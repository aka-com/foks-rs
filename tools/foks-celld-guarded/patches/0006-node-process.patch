+fn b4_process_boundary_selector(case: u16) {
+    let (q, id) = b4_process_component(case);
+    let native = matches!(case, 84 | 88);
+    if matches!(case, 84 | 85 | 86 | 88) {
+        assert!(q.failed_join(id, true, native).is_err());
+    }
+    let mut foreign = id;
+    foreign.native = if id.native == 255 { 0 } else { 255 };
+    if id.native != 255 {
+        assert!(matches!(
+            b4_process_poll(&q, foreign, case),
+            Poll::Ready(Ok(qualification::Action::Continue))
