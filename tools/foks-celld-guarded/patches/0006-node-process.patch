+#[cfg(feature = "foks-guarded-node-qualification")]
+fn report_enabled(
+    enabled: &mut Enabled,
+    _event: &'static str,
+    _ordinary_drained: bool,
+) -> anyhow::Result<()> {
+    anyhow::ensure!(enabled.snapshots < 2, "guarded snapshot count overflow");
+    // Reserve the attempt before any byte is written. Partial output/flush failure
+    // cannot renew this bounded allocation/output credit on a later failure report.
+    enabled.snapshots += 1;
+    if _event != "ready" {
+        if let Some(reload) = &enabled.reload {
+            reload.context.qualification.stop();
+        }
+        enabled.node.stop_admission();
+        if let Some(frontend) = &enabled.frontend {
+            frontend.stop_admission();
+        }
+    }
+    drain_checkpoints(enabled, false)?;
+    use std::io::Write;
+    #[derive(serde::Serialize)]
+    struct Header {
+        kind: &'static str,
+        version: u8,
+        event: &'static str,
+        ordinary_drained: bool,
+        guarded: celld::GuardedNodeReport,
+        invocations: usize,
+        a2_events: usize,
+        atomic_snapshot: bool,
+    }
+    #[derive(serde::Serialize)]
+    struct Item<T: serde::Serialize> {
+        kind: &'static str,
+        index: usize,
+        value: T,
+    }
+    #[derive(serde::Serialize)]
+    struct End {
+        kind: &'static str,
+        invocations: usize,
+        a2_events: usize,
+        a2_chunks: usize,
+    }
+    let frontend = enabled
+        .frontend
+        .as_ref()
+        .ok_or_else(|| anyhow::anyhow!("guarded report before readiness"))?;
+    let (invocations, a2_events) = frontend.observation_counts().map_err(refused)?;
+    anyhow::ensure!(
+        invocations <= 64 && a2_events <= 512,
+        "guarded observation count overflow"
+    );
+    let mut stdout = std::io::stdout().lock();
+    let mut total = 0usize;
+    observation_line(
+        &mut enabled.encoded,
+        &mut stdout,
+        &mut total,
+        1024,
+        &Header {
+            kind: "guarded-observation-header",
+            version: 1,
+            event: _event,
+            ordinary_drained: _ordinary_drained,
+            guarded: frontend.report(),
+            invocations,
+            a2_events,
+            atomic_snapshot: false,
+        },
+    )?;
+    for index in 0..invocations {
+        // All temporary owning observation aliases have died before
+        // encoding or I/O. The returned value contains scalars only.
+        let value = frontend.observation_record(index).map_err(refused)?;
+        observation_line(
+            &mut enabled.encoded,
+            &mut stdout,
+            &mut total,
+            2048,
+            &Item {
+                kind: "guarded-invocation",
+                index,
+                value,
+            },
+        )?;
+    }
+    let mut chunks = 0;
+    for start in (0..a2_events).step_by(64) {
+        let value = frontend
+            .observation_events(start, a2_events)
+            .map_err(refused)?;
+        observation_line(
+            &mut enabled.encoded,
+            &mut stdout,
+            &mut total,
+            16384,
+            &Item {
+                kind: "guarded-a2-events",
+                index: chunks,
+                value,
+            },
+        )?;
+        chunks += 1;
+    }
+    observation_line(
+        &mut enabled.encoded,
+        &mut stdout,
+        &mut total,
+        1024,
+        &End {
+            kind: "guarded-observation-end",
+            invocations,
+            a2_events,
+            a2_chunks: chunks,
+        },
+    )?;
+    stdout.flush()?;
+    drop(stdout);
+    if _event != "ready" {
+        drain_checkpoints(enabled, true)?;
+    }
+    Ok(())
