+impl Qualification {
+    pub fn poll_effect_drop_ready(
+        &self,
+        id: Identity,
+        cx: &mut Context<'_>,
+    ) -> Poll<Result<bool, Refusal>> {
+        let s = match self.state() {
+            Ok(s) => s,
+            Err(Refusal::Contended) => {
+                cx.waker().wake_by_ref();
+                return Poll::Pending;
+            }
+            Err(e) => return Poll::Ready(Err(e)),
+        };
+        if s.journal.sealed {
+            return Poll::Pending;
+        }
+        if s.case == 0 {
+            return Poll::Ready(Ok(false));
+        }
+        let c = match case(s.case) {
+            Ok(c) => c,
+            Err(e) => return Poll::Ready(Err(e)),
+        };
+        if c.reaction != Action::DropActualEffectConsumer {
+            return Poll::Ready(Ok(false));
+        }
+        let Some(b) = s.barriers.iter().find(|b| {
+            b.entered
+                && b.identity
+                    .is_some_and(|v| v.same_invocation(id) && v.root == id.root)
+        }) else {
+            return Poll::Ready(Ok(false));
+        };
+        if !b.identity.is_some_and(|v| v.same_checkpoint(id)) {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        Poll::Ready(Ok(b.advance_seen
+            && b.advanced
+            && b.consumed
+            && b.drop_effect))
+    }
+    pub fn effect_dropped(&self, id: Identity) -> Result<(), Refusal> {
+        let mut s = self.state()?;
+        if s.journal.sealed {
+            return Err(Refusal::NotReady);
+        }
+        let c = case(s.case)?;
+        if c.reaction != Action::DropActualEffectConsumer {
+            return Err(Refusal::Invalid);
+        }
+        let index = s
+            .barriers
+            .iter()
+            .position(|b| {
+                b.entered
+                    && b.advance_seen
+                    && b.advanced
+                    && b.consumed
+                    && b.drop_effect
+                    && b.identity.is_some_and(|v| v.same_checkpoint(id))
+            })
+            .ok_or(Refusal::Invalid)?;
+        let ordinal = s.barriers[index].ordinal;
+        s.journal.append(CheckpointRecord::invocation(
+            c.id,
+            c.checkpoint,
+            3,
+            id,
+            ordinal,
+        ))?;
+        s.barriers[index].drop_effect = false;
+        s.notice = true;
+        let wakes = Self::take_wakes(&mut s);
+        drop(s);
+        self.notify(wakes);
+        Ok(())
+    }
+    fn validator_ticket(
+        s: &State,
+        expected: u16,
+        id: Identity,
+        epoch: Option<u64>,
+        generation: Option<u64>,
+    ) -> Result<ValidatorObservation, Refusal> {
+        if s.journal.sealed {
+            return Err(Refusal::NotReady);
+        }
+        if s.case != expected || !(93..=101).contains(&expected) {
+            return Err(Refusal::Invalid);
+        }
+        let c = case(expected)?;
+        if c.checkpoint != 21
+            || c.reaction != Action::InvalidBindingAtRealValidator
+            || !Self::matches(c, id, 21, expected)
+        {
+            return Err(Refusal::Invalid);
+        }
+        let lane = match expected {
+            93 => 255,
+            95 | 96 => 3,
+            _ => 6,
+        };
+        if id.root.lane != lane
+            || id.activity != u8::from(expected == 95)
+            || id.native != if expected == 97 { 6 } else { 255 }
+            || lane == 255 && id.root.sequence != 0
+            || lane != 255 && id.root.sequence == 0
+            || expected == 97 && id.child == 0
+        {
+            return Err(Refusal::Invalid);
+        }
+        if expected != 93 && epoch.is_none_or(|v| v == 0) {
+            return Err(Refusal::Invalid);
+        }
+        match expected {
+            94 | 99 | 100 if generation.is_some() => return Err(Refusal::Invalid),
+            95..=98 if generation.is_none_or(|v| v == 0) => return Err(Refusal::Invalid),
+            101 if !s.reload.drained
+                || s.reload.old == 0
+                || s.reload.old == s.reload.new
+                || s.reload.new != s.reload.processed
+                || generation != Some(s.reload.old) =>
+            {
+                return Err(Refusal::Invalid)
+            }
+            _ => {}
+        }
+        let b = s
+            .barriers
+            .iter()
+            .find(|b| {
+                b.entered
+                    && b.advance_seen
+                    && b.advanced
+                    && b.consumed
+                    && b.ordinal != 0
+                    && b.identity.is_some_and(|v| v.same_checkpoint(id))
+            })
+            .ok_or(Refusal::Invalid)?;
+        Ok(ValidatorObservation {
+            case: expected,
+            id,
+            epoch,
+            generation,
+            ordinal: b.ordinal,
+        })
+    }
+    pub fn capture_validator(
+        &self,
+        expected: u16,
+        id: Identity,
+        epoch: Option<u64>,
+        generation: Option<u64>,
+    ) -> Result<ValidatorObservation, Refusal> {
+        let s = self.state()?;
+        Self::validator_ticket(&s, expected, id, epoch, generation)
+    }
+    // Observation hint only. Never changes ordinary Route validation, including
+    // when diagnostics contend. A selected missing witness is incomplete proof.
+    pub fn route_validator_observation_hint(&self, original: RootToken) -> bool {
+        self.state().is_ok_and(|s| {
+            s.case == 95
+                && !s.journal.sealed
+                && s.barriers.iter().any(|b| {
+                    b.entered
+                        && b.identity.is_some_and(|id| {
+                            id.invocation == original.invocation && id.root.slot == original.slot
+                        })
+                })
+        })
+    }
+    pub fn capture_optional_validator(
+        &self,
+        expected: u16,
+        id: Identity,
+        epoch: Option<u64>,
+        generation: Option<u64>,
+    ) -> Result<Option<ValidatorObservation>, Refusal> {
+        let s = self.state()?;
+        if s.case != expected
+            || !s
+                .barriers
+                .iter()
+                .any(|b| b.identity.is_some_and(|v| v.same_invocation(id)))
+        {
+            return Ok(None);
+        }
+        Self::validator_ticket(&s, expected, id, epoch, generation).map(Some)
+    }
+    pub fn validator_refused(
+        &self,
+        ticket: ValidatorObservation,
+        actual: Refusal,
+    ) -> Result<(), Refusal> {
+        let mut s = self.state()?;
+        let checked =
+            Self::validator_ticket(&s, ticket.case, ticket.id, ticket.epoch, ticket.generation)?;
+        if checked.ordinal != ticket.ordinal
+            || !matches!(
+                (ticket.case, actual),
+                (93..=100, Refusal::Invalid) | (101, Refusal::NotReady)
+            )
+        {
+            return Err(Refusal::Invalid);
+        }
+        if s.journal.rows[..s.journal.len].iter().any(|r| {
+            !r.process
+                && r.case == ticket.case
+                && r.checkpoint == 21
+                && r.state == 6
+                && r.ordinal == ticket.ordinal
+        }) {
+            return Err(Refusal::Invalid);
+        }
+        // Exclusive actual returned validator-leaf witness, never fault intent.
+        s.journal.append(CheckpointRecord::invocation(
+            ticket.case,
+            21,
+            6,
+            ticket.id,
+            ticket.ordinal,
+        ))?;
+        s.notice = true;
+        let wakes = Self::take_wakes(&mut s);
+        drop(s);
+        self.notify(wakes);
+        Ok(())
+    }
+    pub fn failed_join(
+        &self,
+        id: Identity,
+        actual_is_panic: bool,
+        native_branch: bool,
+    ) -> Result<(), Refusal> {
+        let mut s = self.state()?;
+        if !matches!(s.case, 84 | 85 | 86 | 88)
+            || !s
+                .barriers
+                .iter()
+                .any(|b| b.identity.is_some_and(|v| v.same_invocation(id)))
+        {
+            return Ok(());
+        }
+        if s.journal.sealed {
+            return Err(Refusal::NotReady);
+        }
+        let c = case(s.case)?;
+        if !actual_is_panic
+            || !Self::matches(c, id, 22, c.id)
+            || native_branch != matches!(c.id, 84 | 88)
+            || id.native != if native_branch { c.native } else { 255 }
+            || native_branch && id.child == 0
+        {
+            return Err(Refusal::Invalid);
+        }
+        let b = s
+            .barriers
+            .iter()
+            .find(|b| {
+                b.entered
+                    && b.advance_seen
+                    && b.advanced
+                    && b.consumed
+                    && b.ordinal != 0
+                    && b.identity.is_some_and(|v| v.same_checkpoint(id))
+            })
+            .ok_or(Refusal::Invalid)?;
+        let ordinal = b.ordinal;
+        if s.journal.rows[..s.journal.len].iter().any(|r| {
+            !r.process
+                && r.case == c.id
+                && r.checkpoint == 22
+                && r.state == 6
+                && r.ordinal == ordinal
+        }) {
+            return Err(Refusal::Invalid);
+        }
+        s.journal
+            .append(CheckpointRecord::invocation(c.id, 22, 6, id, ordinal))?;
+        s.notice = true;
+        let wakes = Self::take_wakes(&mut s);
+        drop(s);
+        self.notify(wakes);
+        Ok(())
+    }
+    pub fn failed_cut(&self, id: Identity, checkpoint: u8) -> Result<(), Refusal> {
+        let mut s = self.state()?;
+        let case = s.case;
+        let ordinal = s
+            .barriers
+            .iter()
+            .find(|b| b.identity.is_some_and(|v| v.same_invocation(id)))
+            .map_or(0, |b| b.ordinal);
+        s.journal.append(CheckpointRecord::invocation(
+            case, checkpoint, 6, id, ordinal,
+        ))?;
+        s.notice = true;
+        let wakes = Self::take_wakes(&mut s);
+        drop(s);
+        self.notify(wakes);
+        Ok(())
+    }
+}
