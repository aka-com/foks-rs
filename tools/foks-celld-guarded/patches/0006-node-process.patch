+        }
+    }
+    fn process(case: u16, kind: u8, first: u64, second: u64) -> Self {
+        Self {
+            case,
+            checkpoint: if matches!(kind, 15 | 16) {
+                1
+            } else if matches!(kind, 2 | 3 | 12) {
+                23
+            } else {
+                20
+            },
+            state: kind,
+            first,
+            second,
+            process: true,
+            ..Self::EMPTY
+        }
+    }
