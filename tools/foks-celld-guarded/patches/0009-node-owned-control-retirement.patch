 fn retire_factory(factory: OwnerFactory, process: OriginalOwner) {
     drop(factory);
     retire(process);
+}
+
+// Real foundation owners only. The notice is emitted by lock_owned after an
+// actual WouldBlock; every verdict is delayed until the registry guard is
+// released and the worker is joined. No timing sleeps or admission retry.
+fn b1_owned_retirement_contends(role: OwnerRole) {
+    let (factory, process) = fixture_factory();
+    let available = component::role_available(&factory, role);
+    let owner = child(&factory, role);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let (notice_tx, notice_rx) = std::sync::mpsc::sync_channel(1);
+    let (done_tx, done_rx) = std::sync::mpsc::sync_channel(1);
+    let (observed, completed, joined) = std::thread::scope(|scope| {
+        let (worker, observed) = component::with_registry_guard(&process, || {
+            let worker = scope.spawn(move || {
+                let _notice = control::contention_notice(notice_tx);
+                let result = owner.retire_unstarted();
+                let posted = done_tx.try_send(()).is_ok();
+                (result, posted)
+            });
+            let noticed = notice_rx
+                .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                .is_ok();
+            let pending = matches!(
+                done_rx.try_recv(),
+                Err(std::sync::mpsc::TryRecvError::Empty)
+            );
+            let occupied = component::role_available(&factory, role) == available - 1;
+            let healthy = process.check().is_ok();
+            // New admission remains one-shot try-only while the same real
+            // metadata guard delays already-admitted owner cleanup.
+            let admission =
+                AcceptedStamp::capture().and_then(|stamp| factory.try_owner(role, Some(stamp)));
+            let refused = matches!(admission, Err(Refusal::Contended));
+            (worker, noticed && pending && occupied && healthy && refused)
+        });
+        let completed = done_rx
+            .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+            .is_ok();
+        let joined = worker.join();
+        (observed, completed, joined)
+    });
+    let (retired, posted) = match joined {
+        Ok((result, posted)) => (result.is_ok(), posted),
+        Err(_) => (false, false),
+    };
+    let returned = component::role_available(&factory, role) == available;
+    let healthy = process.check().is_ok();
+    let replacement = if retired && returned && healthy {
+        match AcceptedStamp::capture().and_then(|stamp| factory.try_owner(role, Some(stamp))) {
+            Ok(owner) => owner.retire_unstarted().is_ok(),
+            Err(_) => false,
+        }
+    } else {
+        false
+    };
+    if retired && replacement {
+        retire_factory(factory, process);
+    } else {
+        drop(factory);
+        drop(process);
+    }
+    assert!(observed && completed && retired && posted && returned && healthy && replacement);
+}
