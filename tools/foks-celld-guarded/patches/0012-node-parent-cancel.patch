+        let watch_notice = make_notice();
+        let qualifier_notice = make_notice();
+        let mut watch = record.cancellation.subscribe();
+        let mut changed = std::pin::pin!(watch.changed());
+        let watch_waker = Waker::from(watch_notice.clone());
+        let mut watch_cx = Context::from_waker(&watch_waker);
+        assert!(changed.as_mut().poll(&mut watch_cx).is_pending());
+        let qualifier_waker = Waker::from(qualifier_notice.clone());
+        let mut qualifier_cx = Context::from_waker(&qualifier_waker);
+        assert!(registry.qualification.poll(id, 5, 0, &mut qualifier_cx).is_pending());
+        assert!(!watch_notice.observed.load(Ordering::SeqCst));
+        assert!(!qualifier_notice.observed.load(Ordering::SeqCst));
+        b4_parent_cancel_core(&mut core, &control);
+        control.processed(&core);
+        assert!(watch_notice.observed.load(Ordering::SeqCst));
+        assert!(watch_notice.valid.load(Ordering::SeqCst));
+        assert!(qualifier_notice.observed.load(Ordering::SeqCst));
+        assert!(qualifier_notice.valid.load(Ordering::SeqCst));
+        assert!(matches!(changed.as_mut().poll(&mut watch_cx), Poll::Ready(Ok(()))));
+        assert!(matches!(
+            registry.qualification.poll(id, 5, 0, &mut qualifier_cx),
+            Poll::Ready(Ok(qualification::Action::CanonicalParentCancel))
+        ));
+        assert_eq!(record.state.lock().unwrap().observation.seen
+            & ((1u64 << ObservationEvent::BankFree as usize)
+                | (1u64 << ObservationEvent::PublicGuardDropped as usize)), 0);
+    });
+}
