+async fn b4_parent_cancel_setup_slot(
+    fixture: &mut lifetimes::ActorFixture,
+    slot: usize,
+    existing: Option<State>,
+) -> (State, ActorJobPermit, JobContext, OwnedGateOrigin) {
+    let mut core = if let Some(core) = existing {
+        core
+    } else {
+        let mut core = State::new("node", model_config(false));
+        on_event(
+            &mut core,
+            Event::GenerationChanged {
+                generation: 1,
+                now_mono_ms: 0,
+                max_age_ms: 1000,
+                eager_classes: vec![],
+            },
+        );
+        core
+    };
+    let admission = fixture.begin_core_for_test(slot).unwrap();
+    let request = fixture.primary_request(slot);
+    let effects = on_event(&mut core, admission.into_event(0));
+    let epoch = activate_from_effects(&mut core, fixture.cell(slot), request, 1, effects);
+    let activation = fixture.claim_cas_for_component(slot, epoch).unwrap();
+    activation.context().bind_generation(1).unwrap();
+    let completed = Arc::new(Mutex::new(None));
+    let captured = completed.clone();
+    fixture
+        .run_component(
+            slot,
+            JobRole::Forward(ForwardLane::Driver),
+            move |context| async move {
+                let origin = b2_sync_origin(&context, b2_ticket(epoch, 17))?;
+                *captured.lock().unwrap() = Some((context, origin));
+                Ok(())
+            },
+        )
+        .await
+        .unwrap();
+    let (driver, origin) = completed.lock().unwrap().take().unwrap();
+    assert!(b2_record(fixture, slot).state.lock().unwrap().roots
+        [ForwardLane::Driver as usize]
+        .disposed());
+    (core, activation, driver, origin)
