+impl JobContext {
+    // Both callers validate the full original context before taking this lock.
+    // Capture the exact invocation while the record is guarded, before failing
+    // forward admission. A core output gate may still pin the cancelled request.
+    fn prepare_cancel_locked(
+        &self,
+        record: &InvocationRecord,
+        state: &mut InvocationState,
+    ) -> Result<(tokio::sync::watch::Sender<bool>, qualification::Identity), Refusal> {
+        let (identity, _) = self.qualification_snapshot_locked(record, state, 0, None)?;
+        state.observation.mark(ObservationEvent::CancelProcessed)?;
+        state.cancel_requested = true;
+        state.roots[ForwardLane::Driver as usize].cancel = true;
+        if let Some(runtime) = &state.runtime {
+            runtime.cancel();
+        }
+        record.control.fail();
+        Ok((record.cancellation.clone(), identity))
+    }
+    // Watch/qualifier callbacks may re-enter the bank. No record or bank guard
+    // may cross this boundary; notify cancellation before resuming held work.
+    fn complete_cancel(
+        &self,
+        registry: &Arc<OwnedEffectRegistry>,
+        cancellation: (tokio::sync::watch::Sender<bool>, qualification::Identity),
+    ) -> Result<(), Refusal> {
+        let (sender, identity) = cancellation;
+        sender.send_replace(true);
+        drop(sender);
+        registry.qualification.cancel_processed(identity)?;
+        registry.start_cancel_if_needed(self)
     }
