+// This separate binary-unit process measures the real main future and owner,
+// rather than the library-only main_work=0 projection. Actual Run kind14 and
+// the all101 process suite remain separate integration requirements.
+#[cfg(all(test, feature = "foks-guarded-node-qualification"))]
+mod tests {
+    use super::*;
+    use celld::{GuardedNode, GuardedNodeRefusal};
+
+    #[test]
+    fn guarded_reload_main_work_fits_qualified_fixture() {
+        // Fixed all101 controller fixture maxima: node34, us-east-1=9,
+        // IPv4 loopback with5-digit port15, bucket32, case-NNN prefix23.
+        // These lengths do not qualify arbitrary operator-supplied strings.
+        let (bytes, align) = reload_work_layout([34, 9, 15, 32, 23]).unwrap();
+        assert!(bytes > 0 && bytes <= GuardedNode::PROCESS_MAIN_WORK_BYTES);
+        assert!(align > 0 && align <= 16);
+        let (without_strings, same_align) = reload_work_layout([0; 5]).unwrap();
+        assert_eq!(bytes, without_strings + 2 * 113);
+        assert_eq!(align, same_align);
+        // This is the actual opaque production future, not a synthetic pending
+        // future or a hardcoded size from the previously accepted binary.
+        assert!(without_strings >= reload_future_layout().size() * 2);
+        assert!(matches!(
+            reload_work_layout([usize::MAX, 1, 0, 0, 0]),
+            Err(GuardedNodeRefusal::Bounds)
+        ));
+        assert!(matches!(
+            reload_work_layout([usize::MAX / 2 + 1, 0, 0, 0, 0]),
+            Err(GuardedNodeRefusal::Bounds)
+        ));
+
+        // Installation is once-only, so the native supervisor runs this exact
+        // binary test in its own process. No worker/SDK/native Ready is faked.
+        let node = GuardedNode::install().unwrap();
+        node.install_process_case(1).unwrap();
+        let initial = serde_json::to_value(node.process_layouts().unwrap()).unwrap();
+        assert_eq!(initial["retained_terms"]["main_work_bytes"], 0);
+        let initial_count = node.checkpoint_counts().unwrap();
+        let initial_debt = node.foundation().unwrap().debt;
+        let (too_large, _) =
+            reload_work_layout([GuardedNode::PROCESS_MAIN_WORK_BYTES, 0, 0, 0, 0]).unwrap();
+        for (charge, alignment) in [
+            (GuardedNode::PROCESS_MAIN_WORK_BYTES + 1, align),
+            (too_large, align),
+            (bytes, 0),
+            (bytes, 32),
+        ] {
+            assert!(matches!(
+                node.charge_process_work(charge, alignment),
+                Err(GuardedNodeRefusal::Bounds)
+            ));
+            assert_eq!(node.checkpoint_counts().unwrap(), initial_count);
+            assert_eq!(node.foundation().unwrap().debt, initial_debt);
+            assert_eq!(
+                serde_json::to_value(node.process_layouts().unwrap()).unwrap(),
+                initial
+            );
+        }
+        node.charge_process_work(bytes, align).unwrap();
+        let charged = serde_json::to_value(node.process_layouts().unwrap()).unwrap();
+        assert_eq!(charged["retained_terms"]["main_work_bytes"], bytes);
+        assert_eq!(
+            charged["retained_bytes"].as_u64().unwrap(),
+            initial["retained_bytes"].as_u64().unwrap() + bytes as u64
+        );
+        let retained_terms = &charged["retained_terms"];
+        let retained_sum: u64 = [
+            "p1_retained_bytes",
+            "qualification_bytes",
+            "main_work_bytes",
+            "extra_scratch_bytes",
+            "sync_mutex_bytes",
+            "sync_condvar_bytes",
+        ]
+        .into_iter()
+        .map(|key| retained_terms[key].as_u64().unwrap())
+        .sum();
+        assert_eq!(charged["retained_bytes"].as_u64().unwrap(), retained_sum);
+        assert!(retained_sum <= 131072);
+        assert_eq!(node.foundation().unwrap().debt, initial_debt + bytes);
+        let after_count = node.checkpoint_counts().unwrap();
+        assert_eq!(after_count.0, initial_count.0 + 1);
+        let actual =
+            serde_json::to_value(node.checkpoint_record(initial_count.0).unwrap().unwrap())
+                .unwrap();
+        assert_eq!(actual["kind"], "b4_process_checkpoint");
+        assert_eq!(actual["case"], 1);
+        assert_eq!(actual["state"], "MainWorkCharged");
+        assert_eq!(actual["first"], bytes);
+        assert_eq!(actual["second"], align);
+        assert!(node.charge_process_work(bytes, align).is_err());
+        assert_eq!(node.checkpoint_counts().unwrap(), after_count);
+        assert_eq!(
+            serde_json::to_value(node.process_layouts().unwrap()).unwrap(),
+            charged
+        );
+    }
