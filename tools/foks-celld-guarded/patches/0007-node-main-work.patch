+#[cfg(feature = "foks-guarded-node-qualification")]
+fn reload_work_layout(
+    string_lengths: [usize; 5],
+) -> Result<(usize, usize), celld::GuardedNodeRefusal> {
+    use celld::GuardedNodeRefusal::Bounds;
+    use std::alloc::Layout;
+    let capture = Layout::new::<ReloadContext>();
+    let future = reload_future_layout();
+    let owner = Layout::new::<ReloadOwner>();
+    let result = Layout::new::<celld::generation::ReloadOutcome>();
+    let stop_arc = Layout::new::<StopArcAllocation>();
+    let thread = Layout::new::<Option<std::thread::JoinHandle<()>>>();
+    let align = capture
+        .align()
+        .max(future.align())
+        .max(owner.align())
+        .max(result.align())
+        .max(stop_arc.align())
+        .max(thread.align());
+    let strings = string_lengths
+        .into_iter()
+        .try_fold(0usize, |sum, length| sum.checked_add(length))
+        .ok_or(Bounds)?;
+    // The stored context and transient construction capture can coexist with
+    // both the concrete stack future and its requested Box storage. Result
+    // storage and both cloned-string sets remain separately charged. Opaque
+    // SDK/graph/engine allocations remain runtime overhead, not a typed RSS bound.
+    let bytes = capture
+        .size()
+        .checked_add(owner.size())
+        .and_then(|n| future.size().checked_mul(2).and_then(|v| n.checked_add(v)))
+        .and_then(|n| n.checked_add(result.size()))
+        .and_then(|n| strings.checked_mul(2).and_then(|v| n.checked_add(v)))
+        .and_then(|n| n.checked_add(stop_arc.size()))
+        .and_then(|n| n.checked_add(thread.size()))
+        .ok_or(Bounds)?;
+    Ok((bytes, align))
+}
