+pub fn lifecycle_layouts() -> LifecycleLayouts {
+    // Every spawned concrete payload/future is checked against the 16KiB typed
+    // bound before spawn. Two allowances conservatively cover capture/result
+    // overlap; runtime task headers/allocator overhead are separately excluded.
+    let task = 16 * 1024;
+    LifecycleLayouts {
+        process_control_bytes: std::mem::size_of::<ArcLayout<Capacity>>() + 2 * DIRECTORY_BYTES,
+        report_retained_bytes: std::mem::size_of::<LifecycleReport>()
+            + EVENT_LIMIT * std::mem::size_of::<Event>()
+            + 32 * std::mem::size_of::<Cycle>(),
+        serialization_bytes: 65_536,
+        invocation_control_bytes: std::mem::size_of::<ArcLayout<Control>>()
+            + 4 * std::mem::size_of::<ArcLayout<Gate>>()
+            + 2 * std::mem::size_of::<ArcLayout<AtomicBool>>() // cancellation and optional turn-restoration witness
+            + std::mem::size_of::<ArcLayout<TaskCell>>()
+            + 2 * task + NATIVE_SCRATCH_BYTES
+            + std::mem::size_of::<Runtime>() + std::mem::size_of::<BuildWork>()
+            + std::mem::size_of::<DriverWork>() + std::mem::size_of::<Lease>(),
+        largest_task_payload_bytes: named_layouts()
+            .iter()
+            .map(|(_, bytes, _)| *bytes)
