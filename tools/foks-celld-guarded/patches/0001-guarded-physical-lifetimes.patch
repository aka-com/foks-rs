+impl RetireWork {
+    fn run(self) -> Result<(), Failure> {
+        self.runtime.destroy(self.hold, self.panic_teardown)
+    }
+}
+fn retire_closure(work: RetireWork) -> impl FnOnce() -> Result<(), Failure> {
+    move || work.run()
+}
+fn spawn_retire(
+    runtime: Runtime,
+    hold: Option<Arc<Gate>>,
+    panic_teardown: bool,
