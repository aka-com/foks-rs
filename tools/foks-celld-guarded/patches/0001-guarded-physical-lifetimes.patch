+pub(crate) fn program() -> crate::guarded_execution::qualification::LifecycleProgram {
+    crate::guarded_execution::qualification::LifecycleProgram {
+        js_sha256: Sha256::digest(JS.as_bytes()).into(),
+        js_bytes: JS.len(),
