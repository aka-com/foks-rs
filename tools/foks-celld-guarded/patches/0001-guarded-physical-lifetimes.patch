+fn fixture_rejections() -> Result<(), Failure> {
+    let js = js::guarded::JS.as_bytes();
+    let wasm = js::guarded::WASM;
+    ensure(js::guarded::validate_fixture(js, wasm))?;
+    let memory = wasm
+        .windows(8)
+        .position(|v| v == [5, 6, 1, 1, 128, 8, 128, 8])
+        .ok_or(Failure::Fixture)?;
+    // All supplied bytes are private finite variants of the approved artifact;
+    // exact byte policy refuses before invoking V8. No generic decoder exists.
+    for (offset, value) in [
+        (0, 1),            // magic/hash
+        (memory + 3, 3),   // shared
+        (memory + 3, 5),   // memory64
+        (memory + 2, 2),   // multiple memories
+        (memory + 3, 0),   // absent max
+        (memory + 6, 129), // larger max
+    ] {
+        let mut altered = wasm.to_vec();
+        altered[offset] = value;
+        ensure(!js::guarded::validate_fixture(js, &altered))?;
+    }
+    let mut imported = wasm.to_vec();
+    imported.splice(8..8, [2, 1, 0]);
+    ensure(!js::guarded::validate_fixture(js, &imported))?;
+    let mut extra_export = wasm.to_vec();
+    extra_export.extend_from_slice(&[7, 1, 0]);
+    ensure(!js::guarded::validate_fixture(js, &extra_export))?;
+    let mut altered_js = js.to_vec();
+    altered_js.push(b' ');
+    ensure(!js::guarded::validate_fixture(&altered_js, wasm))
+}
+
+pub async fn qualify_lifecycle(
+    scenario: LifecycleScenario,
+    process_owner: LifecycleProcessOwner,
+    inputs: [LifecycleInput; 3],
+) -> Result<LifecycleReport, LifecycleFailure> {
+    use LifecycleScenario as S;
+    // No input owner may masquerade as the separate process charge or another
+    // invocation. Actual FOKS type/admission is verified by the closed caller.
+    for i in 0..3 {
+        ensure(!Arc::ptr_eq(&process_owner.owner, &inputs[i].owner))?;
+        for j in 0..i {
+            ensure(!Arc::ptr_eq(&inputs[i].owner, &inputs[j].owner))?;
+        }
+    }
+    ensure(
+        named_layouts()
+            .iter()
+            .all(|(_, bytes, alignment)| *bytes <= 16 * 1024 && *alignment <= 16),
+    )?;
+    ensure(scratch_bound() <= NATIVE_SCRATCH_BYTES)?;
+    ensure(
+        std::mem::align_of::<Option<Result<crate::engine_api::HttpResponse, anyhow::Error>>>()
+            <= 16,
+    )?;
+    let capacity = Capacity::install(process_owner)?;
+    let [input0, input1, input2] = inputs;
+    let controls = [
+        Control::from_input(input0, 0),
+        Control::from_input(input1, 1),
+        Control::from_input(input2, 2),
+    ];
+    let mut cycles = Vec::with_capacity(32);
+    let before = rss();
+    let mut peak = before;
+    match scenario {
+        S::FixtureRejections => {
+            fixture_rejections()?;
+            occupied(&capacity, 0, 0)?;
+        }
+        S::DeadlinePreAdmit => {
+            refuse(&capacity, &tenant(1), &controls[0], Refusal::Expired)?;
+            occupied(&capacity, 0, 0)?;
+        }
+        S::AdmissionRefusals => {
+            refuse(&capacity, "INVALID", &controls[0], Refusal::Invalid)?;
+            {
+                let guard = capacity.ledger.lock().map_err(|_| Failure::Observation)?;
+                ensure(matches!(
+                    capacity.try_admit(&tenant(1), controls[0].clone()),
+                    Err(Refusal::Contended)
+                ))?;
+                drop(guard);
+            }
+            capacity.refused()?;
+            capacity
+                .ledger
+                .lock()
+                .map_err(|_| Failure::Observation)?
+                .next = u64::MAX;
+            refuse(&capacity, &tenant(1), &controls[0], Refusal::Exhausted)?;
+            // The poison diagnostic needs only this mutex. Capturing the
+            // whole Capacity would also capture the unrelated opaque owner.
+            let ledger_to_poison = &capacity.ledger;
+            let poison = std::panic::catch_unwind(move || {
+                let _held = ledger_to_poison.lock().expect("diagnostic poison lock");
+                panic!("guarded ledger poison");
+            });
+            ensure(poison.is_err())?;
+            ensure(matches!(
+                capacity.try_admit(&tenant(1), controls[0].clone()),
+                Err(Refusal::Poisoned)
+            ))?;
+            let mut ledger = capacity.ledger.lock().unwrap_or_else(|p| p.into_inner());
+            ledger.refused = ledger.refused.checked_add(1).ok_or(Failure::Observation)?;
+            ledger.event(
+                Token {
+                    index: 0,
+                    generation: 0,
+                },
+                EventKind::Refused,
+            );
+        }
+        S::Admission | S::SaturationDrain => {
+            if scenario == S::Admission {
+                ensure(
+                    Capacity::install(LifecycleProcessOwner::new(capacity._process_owner.clone()))
+                        .is_err(),
+                )?;
+            }
+            let rounds = if scenario == S::Admission { 1 } else { 4 };
+            for round in 0..rounds {
+                let first = capacity
+                    .try_admit(&tenant(1), controls[0].clone())
+                    .map_err(|_| Failure::Admission)?;
+                let second = capacity
+                    .try_admit(&tenant(2), controls[1].clone())
+                    .map_err(|_| Failure::Admission)?;
+                occupied(&capacity, 2, 2 * WASM_BYTES)?;
+                refuse(&capacity, &tenant(3), &controls[2], Refusal::Capacity)?;
+                let mut peak1 = peak;
+                let mut peak2 = peak;
+                let (a, b) = futures_util::future::join(
+                    one(
+                        first,
+                        controls[0].clone(),
+                        &controls[2],
+                        S::Normal,
+                        1,
+                        round + 1,
+                        &mut peak1,
+                    ),
+                    one(
+                        second,
+                        controls[1].clone(),
+                        &controls[2],
+                        S::Normal,
+                        2,
+                        round + 1,
+                        &mut peak2,
+                    ),
+                )
+                .await;
+                cycles.push(a?);
+                cycles.push(b?);
+                peak = peak1.max(peak2);
+                occupied(&capacity, 0, 0)?;
+            }
+        }
+        S::ColdCycles => {
+            for i in 0..32u16 {
+                let id = if i < 16 { 1 } else { i };
+                let expected = if i < 16 { u32::from(i) + 1 } else { 1 };
+                let lease = capacity
+                    .try_admit(&tenant(id), controls[0].clone())
+                    .map_err(|_| Failure::Admission)?;
+                let cycle = one(
+                    lease,
+                    controls[0].clone(),
+                    &controls[2],
+                    S::Normal,
+                    id,
+                    expected,
+                    &mut peak,
+                )
+                .await?;
+                ensure(cycle.normal_completion && cycle.fresh_wasm && cycle.counter == expected)?;
+                cycles.push(cycle);
+                occupied(&capacity, 0, 0)?;
+                if i == 0 {
+                    capacity
+                        .ledger
+                        .lock()
+                        .map_err(|_| Failure::Observation)?
+                        .detailed = false;
+                }
+            }
+        }
+        _ => {
+            let lease = capacity
+                .try_admit(&tenant(1), controls[0].clone())
+                .map_err(|_| Failure::Admission)?;
+            cycles.push(
+                one(
+                    lease,
+                    controls[0].clone(),
+                    &controls[2],
+                    scenario,
+                    1,
+                    1,
+                    &mut peak,
+                )
+                .await?,
+            );
+        }
+    }
+    let quarantine = matches!(
+        scenario,
+        S::PanicBuild | S::PanicTurn | S::PanicPayloadDrop | S::PanicTeardown | S::PanicTask
+    );
+    let snapshots = capacity.snapshots();
+    if quarantine {
+        ensure(
+            snapshots[0].state == State::Quarantined
+                && snapshots[0].memory_reserved
+                && snapshots[0].owner == Some(0),
+        )?;
+        ensure(snapshots[1].state == State::Free)?;
+    } else {
+        occupied(&capacity, 0, 0)?;
+    }
+    {
+        let ledger = capacity.ledger.lock().unwrap_or_else(|p| p.into_inner());
+        ensure(ledger.records.iter().all(|r| r.task.is_none()))?;
+        ensure(!ledger.observation_failed && ledger.peak_reserved <= 2 * WASM_BYTES as u64)?;
+    }
+    // Quarantined file ownership remains in the static inventory. Never unlink
+    // a possibly live SQLite file merely because a task returned a report.
+    if !quarantine {
+        drop(
+            capacity
+                .directory
+                .lock()
+                .map_err(|_| Failure::Setup)?
+                .take(),
+        );
+    }
+    drop(controls);
+    let after = rss();
+    peak = peak.max(after);
+    let mut ledger = capacity.ledger.lock().unwrap_or_else(|p| p.into_inner());
+    const KINDS: [&str; 19] = [
+        "admitted",
+        "worker-built",
+        "adopted",
+        "driver-started",
+        "reply-received",
+        "driver-joined",
+        "backing-observed",
+        "retiring",
+        "cell-closed",
+        "slot-consumed",
+        "worker-dropped",
+        "probe-dropped",
+        "memory-released",
+        "output-dropped",
+        "payloads-dropped",
+        "owner-dropped",
+        "freed",
+        "quarantined",
+        "refused",
+    ];
+    let event_totals = std::array::from_fn(|i| (KINDS[i], ledger.event_counts[i]));
+    let detailed_trace_cycles = if scenario == S::ColdCycles {
+        1
+    } else {
+        cycles.len()
+    };
+    Ok(LifecycleReport {
+        format: 1, claim: "a2-physical-lifetimes-local-fixture", scenario, program: js::guarded::program(),
+        slots: SLOTS, accessible_bytes_per_slot: WASM_BYTES, layouts: lifecycle_layouts(),
+        typed_layouts: named_layouts(), typed_task_charge_bound: 16 * 1024,
+        native_scratch_charge_bound: NATIVE_SCRATCH_BYTES, native_scratch_observed_bound: scratch_bound(),
+        original_owner_identity_preserved: true, original_deadlines_preserved: true,
+        trace_mode: if scenario == S::ColdCycles { "first-cycle-plus-exact-aggregates" } else { "complete" },
+        detailed_trace_cycles, events: std::mem::take(&mut ledger.events), event_totals, cycles,
+        final_records: snapshots, peak_observed_live_workers: ledger.peak_workers, peak_observed_live_stores: ledger.peak_stores,
+        peak_occupied: ledger.peak_occupied, peak_reserved_bytes: ledger.peak_reserved, refused: ledger.refused,
+        sampled_rss_before: before, sampled_rss_peak: peak, sampled_rss_after: after,
+        timing_policy: "instantiate_us is unmeasured/null: compile and instantiate are included in execute_us (native fetch dispatch through driver join, including probe/barrier time); JS performance.now is fixed per I/O turn",
+        virtual_mapping: "unmeasured; unchanged initializer does not enable Wasm trap-handler guard regions",
+        limitations: "accessible capacity excludes V8/native/RSS overhead; typed control charges exclude unchanged engine/config internals, Tokio scheduling, stacks and allocator overhead; local SQL and diagnostic disposal only; no S3 acknowledgment, serving, whole-node shutdown, density or 15-second recovery claim",
+    })
+}
