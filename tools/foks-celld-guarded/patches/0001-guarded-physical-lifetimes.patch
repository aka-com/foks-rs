+    use LifecycleScenario as S;
+    let capacity = lease.capacity.clone();
+    let token = lease.token;
+    let id = tenant(tenant_number);
+    let mut cycle = Cycle {
+        tenant: tenant_number,
+        ..Cycle::default()
+    };
+    if scenario == S::TenantBusy {
+        refuse(&capacity, &id, other, Refusal::Busy)?;
+    }
+    let build_gate = matches!(scenario, S::CancelDuringBuild | S::DeadlineBuild).then(Gate::new);
+    let mode = match scenario {
+        S::LoadErrorBeforeIsolate => js::guarded::BuildMode::ErrorBefore,
+        S::LoadErrorAfterIsolate => js::guarded::BuildMode::ErrorAfter,
+        S::PanicBuild => js::guarded::BuildMode::PanicAfter,
+        _ => build_gate
+            .as_ref()
+            .map(|g| js::guarded::BuildMode::HoldAfter(g.clone()))
+            .unwrap_or(js::guarded::BuildMode::Normal),
+    };
+    let (completion, waiter) = tokio::sync::oneshot::channel::<()>();
+    let mut waiter = Some(waiter);
