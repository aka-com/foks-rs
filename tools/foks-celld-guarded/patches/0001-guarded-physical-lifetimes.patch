+pub(crate) fn validate_fixture(js: &[u8], wasm: &[u8]) -> bool {
+    // Closed exact-byte policy, not a permissive general Wasm parser. Every
+    // altered artifact is refused before constructing a Worker or isolate.
+    js == JS.as_bytes() && wasm == WASM
+}
