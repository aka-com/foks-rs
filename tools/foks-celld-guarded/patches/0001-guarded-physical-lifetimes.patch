+        (
+            "gate-arc",
+            std::mem::size_of::<ArcLayout<Gate>>(),
+            std::mem::align_of::<ArcLayout<Gate>>(),
+        ),
+        (
+            "output",
+            std::mem::size_of::<Output>(),
