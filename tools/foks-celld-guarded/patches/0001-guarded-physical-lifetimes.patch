+}
+impl std::error::Error for InjectedAfterIsolate {}
+pub(crate) enum LoadFailure {
+    CleanBefore,
+    CleanAfter,
+    Uncertain,
+}
+
+pub(crate) fn after_isolate() -> Result<()> {
+    let mode = BUILD.with_borrow(Clone::clone);
+    match mode {
+        Some(BuildMode::ErrorAfter) => return Err(anyhow::Error::new(InjectedAfterIsolate)),
+        Some(BuildMode::PanicAfter) => panic!("guarded build unwind"),
+        Some(BuildMode::HoldAfter(gate)) => gate.block(),
+        _ => {}
+    }
+    Ok(())
+}
+
+pub(crate) fn load(mode: BuildMode) -> std::result::Result<Worker, LoadFailure> {
+    if !validate_fixture(JS.as_bytes(), WASM) {
+        return Err(LoadFailure::Uncertain);
+    }
+    let expected_after = matches!(mode, BuildMode::ErrorAfter);
+    if matches!(mode, BuildMode::ErrorBefore) {
+        return Err(LoadFailure::CleanBefore);
+    }
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            BUILD.set(None);
+        }
+    }
+    BUILD.with_borrow_mut(|active| {
+        assert!(active.is_none(), "nested guarded construction");
+        *active = Some(mode);
+    });
+    let _reset = Reset;
+    let mut config = WorkerConfig::new(WorkerConfigOptions {
+        src: JS.into(),
+        script_name: "foks-guarded-fixture".into(),
+        do_classes: vec![CLASS.into()],
+        bindings: vec![],
+        r2_bindings: vec![],
+        d1_bindings: vec![],
+        kv_bindings: vec![],
+        queue_bindings: vec![],
+        queue_consumers: vec![],
+        workflow_bindings: vec![],
+        vars: vec![],
+        node: "foks-guarded-local".into(),
+        modules: vec![],
+        compat: Compat::default(),
+    });
+    config.egress = EgressPolicy::Deny;
+    match Worker::load_config(Arc::new(config)) {
+        Ok(worker) => Ok(worker),
+        // Only this unique marker can prove the deliberately audited immediate
+        // post-Isolate::new return. All local isolate destruction has completed.
+        Err(error) if expected_after && error.is::<InjectedAfterIsolate>() => {
+            Err(LoadFailure::CleanAfter)
+        }
+        Err(_) => Err(LoadFailure::Uncertain),
+    }
+}
