+/// A fixed native handshake. No timer or sleep supplies readiness/completion.
+pub(crate) struct Gate {
+    entered: AtomicBool,
+    released: AtomicBool,
+    notification: tokio::sync::Notify,
+    mutex: Mutex<()>,
+    condition: Condvar,
+}
+impl Gate {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            entered: AtomicBool::new(false),
+            released: AtomicBool::new(false),
+            notification: tokio::sync::Notify::new(),
+            mutex: Mutex::new(()),
+            condition: Condvar::new(),
+        })
+    }
+    fn enter(&self) {
+        self.entered.store(true, Ordering::Release);
+        self.notification.notify_waiters();
+    }
+    async fn entered(&self) {
+        loop {
+            let notified = self.notification.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if self.entered.load(Ordering::Acquire) {
+                return;
+            }
+            notified.await;
+        }
+    }
+    async fn wait(&self) {
+        self.enter();
+        loop {
+            let notified = self.notification.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if self.released.load(Ordering::Acquire) {
+                return;
+            }
+            notified.await;
+        }
+    }
+    pub(crate) fn block(&self) {
+        let mut guard = self.mutex.lock().expect("guarded gate mutex");
+        self.enter();
+        while !self.released.load(Ordering::Acquire) {
+            guard = self.condition.wait(guard).expect("guarded gate condition");
+        }
+    }
+    fn release(&self) {
+        let _guard = self.mutex.lock().expect("guarded gate mutex");
+        self.released.store(true, Ordering::Release);
+        self.condition.notify_all();
+        self.notification.notify_waiters();
+    }
+}
+
+struct Storage {
+    path: String,
+    scope: String,
+}
+struct Runtime {
+    slot: Arc<pool::Slot>,
+    residency: Option<pool::Residency>,
+    probe: Option<js::guarded::Probe>,
+    storage: Storage,
+    adopted: bool,
+    control: Arc<Control>,
+    capacity: Arc<Capacity>,
+    token: Token,
+}
+struct BuildWork {
+    storage: Storage,
+    mode: js::guarded::BuildMode,
+    completion: Option<tokio::sync::oneshot::Sender<()>>,
+    control: Arc<Control>,
+    capacity: Arc<Capacity>,
+    token: Token,
+}
+enum Built {
+    Runtime(Runtime),
+    CleanError,
+}
+impl BuildWork {
+    fn run(mut self) -> Result<Built, Failure> {
+        let completion = self.completion.take();
+        let result = self.run_inner();
+        if let Some(completion) = completion {
+            let _ = completion.send(());
+        }
+        result
+    }
+    fn run_inner(self) -> Result<Built, Failure> {
+        let guard = Taint::new(&self.capacity, self.token);
+        self.capacity.check_control(self.token, &self.control)?;
+        // Entry cancellation is a clean pre-allocation refusal; no Worker exists.
+        if self.control.check().is_err() {
+            guard.normal();
+            return Ok(Built::CleanError);
+        }
+        let loaded = js::guarded::load(self.mode);
+        let worker = match loaded {
+            Ok(worker) => worker,
+            Err(js::guarded::LoadFailure::CleanBefore | js::guarded::LoadFailure::CleanAfter) => {
+                guard.normal();
+                return Ok(Built::CleanError);
+            }
+            Err(js::guarded::LoadFailure::Uncertain) => return Err(Failure::Driver),
+        };
+        let (slot, residency) = pool::Slot::guarded(worker);
+        self.capacity
+            .change(self.token, EventKind::WorkerBuilt, |r| {
+                r.worker_live = true;
+                Ok(())
+            })?;
+        let runtime = Runtime {
+            slot,
+            residency: Some(residency),
+            probe: None,
+            storage: self.storage,
+            adopted: false,
+            control: self.control,
+            capacity: self.capacity,
+            token: self.token,
+        };
+        guard.normal();
+        Ok(Built::Runtime(runtime))
+    }
+}
+fn checked_payload<T>(value: &T) -> Result<(), Failure> {
+    if std::mem::size_of_val(value) > 16 * 1024 || std::mem::align_of_val(value) > 16 {
+        return Err(Failure::OwnerBound);
+    }
+    Ok(())
+}
+fn build_closure(work: BuildWork) -> impl FnOnce() -> Result<Built, Failure> {
+    move || work.run()
+}
+fn spawn_build(work: BuildWork) -> Result<Job, Failure> {
+    let mut job = Job::new(work.capacity.clone(), work.token)?;
+    if let js::guarded::BuildMode::HoldAfter(gate) = &work.mode {
+        job.release = Some(gate.clone());
+    }
+    let closure = build_closure(work);
+    checked_payload(&closure)?;
+    job.set(Task::Build(tokio::task::spawn_blocking(closure)));
+    Ok(job)
+}
+impl Runtime {
+    async fn adopt(&mut self) -> Result<(), Failure> {
+        let guard = Taint::new(&self.capacity, self.token);
+        self.capacity.check_control(self.token, &self.control)?;
+        self.control.check().map_err(|_| Failure::Admission)?;
+        let residency = self.residency.take().ok_or(Failure::Observation)?;
+        let (residency, _) = residency
+            .adopt(
+                &self.storage.scope,
+                js::CellStorage {
+                    path: &self.storage.path,
+                    epoch: 1,
+                    replicated_wake: false,
+                    vfs: None,
+                },
+            )
+            .await
+            .map_err(|_| Failure::Driver)?;
+        self.residency = Some(residency);
+        self.adopted = true;
+        self.capacity.change(self.token, EventKind::Adopted, |r| {
+            r.state = State::Running;
+            Ok(())
+        })?;
+        guard.normal();
+        Ok(())
+    }
+    async fn probe(&mut self, growth: bool) -> Result<(), Failure> {
+        let guard = Taint::new(&self.capacity, self.token);
+        self.capacity.check_control(self.token, &self.control)?;
+        self.control.check().map_err(|_| Failure::Admission)?;
+        self.probe = Some(
+            self.slot
+                .turn(|worker| worker.guarded_probe(growth))
+                .await
+                .map_err(|_| Failure::Observation)?,
+        );
+        self.capacity
+            .change(self.token, EventKind::BackingObserved, |r| {
+                r.store_live = true;
+                Ok(())
+            })?;
+        guard.normal();
+        Ok(())
+    }
+    async fn close(&mut self) -> Result<(), Failure> {
+        let guard = Taint::new(&self.capacity, self.token);
+        self.capacity.check_control(self.token, &self.control)?;
+        self.capacity.change(self.token, EventKind::Retiring, |r| {
+            r.state = State::Retiring;
+            Ok(())
+        })?;
+        // Cleanup is allowed after the original deadline, while still charged;
+        // it does not gain permission to publish or start new fixture work.
+        if self.adopted {
+            self.slot
+                .turn(|worker| worker.own_cell(&self.storage.scope, None))
+                .await
+                .map_err(|_| Failure::Retirement)?;
+            self.adopted = false;
+            self.capacity.event(self.token, EventKind::CellClosed)?;
+        }
+        drop(self.residency.take());
+        guard.normal();
+        Ok(())
+    }
+    fn destroy(self, hold_probe: Option<Arc<Gate>>, panic_teardown: bool) -> Result<(), Failure> {
+        let guard = Taint::new(&self.capacity, self.token);
+        self.capacity.check_control(self.token, &self.control)?;
+        if panic_teardown {
+            panic!("guarded teardown unwind");
+        }
+        let Runtime {
+            slot,
+            residency,
+            probe,
+            storage,
+            adopted,
+            control,
+            capacity,
+            token,
+        } = self;
+        if residency.is_some() || adopted {
+            return Err(Failure::Retirement);
+        }
+        let worker = match slot.guarded_consume() {
+            Ok(worker) => worker,
+            Err(slot) => {
+                capacity.change(token, EventKind::Quarantined, |r| {
+                    r.uncertain_slot = Some(slot);
+                    Ok(())
+                })?;
+                return Err(Failure::Retirement);
+            }
+        };
+        capacity.event(token, EventKind::SlotConsumed)?;
+        drop(worker);
+        capacity.change(token, EventKind::WorkerDropped, |r| {
+            r.worker_live = false;
+            Ok(())
+        })?;
+        if let Some(gate) = hold_probe {
+            gate.block();
+        }
+        if let Some(probe) = probe {
+            probe.finish();
+            capacity.event(token, EventKind::ProbeDropped)?;
+        }
+        capacity.change(token, EventKind::MemoryReleased, |r| {
+            r.store_live = false;
+            r.memory = false;
+            r.runtime_done = true;
+            Ok(())
+        })?;
+        drop(storage);
+        drop(control);
+        guard.normal();
+        Ok(())
+    }
+}
+struct DriverWork {
+    slot: Arc<pool::Slot>,
+    job: js::CellJob,
+    affiliation: pool::Affiliation,
+    hold: Option<Arc<Gate>>,
+    panic_after: bool,
+    panic_payload: bool,
+    control: Arc<Control>,
+    capacity: Arc<Capacity>,
+    token: Token,
+}
+impl DriverWork {
+    async fn run(self) -> Result<(), Failure> {
+        let guard = Taint::new(&self.capacity, self.token);
+        self.capacity.check_control(self.token, &self.control)?;
+        let budget = self.control.remaining()?;
+        self.capacity.event(self.token, EventKind::DriverStarted)?;
+        crate::runtime::drive_guarded_cell(self.affiliation, self.job, budget)
+            .await
+            .map_err(|_| Failure::Driver)?;
+        if let Some(gate) = &self.hold {
+            gate.wait().await;
+        }
+        if self.panic_after {
+            panic!("guarded driver task unwind");
+        }
+        if self.panic_payload {
+            drop(PanicPayload);
+        }
+        drop(self.slot);
+        drop(self.hold);
+        drop(self.control);
+        guard.normal();
+        Ok(())
+    }
+}
+struct Output {
+    bytes: Vec<u8>,
+    control: Arc<Control>,
+    capacity: Arc<Capacity>,
+    token: Token,
+}
+impl Output {
+    /// The A2 diagnostic consumer can observe bytes only through this path.
+    /// A3 replaces this borrowed native edge with actual owned socket framing.
+    fn publish(&self) -> Result<&[u8], Refusal> {
+        self.control.check()?;
+        Ok(&self.bytes)
+    }
+    fn dispose(self) -> Result<(), Failure> {
+        let guard = Taint::new(&self.capacity, self.token);
+        self.capacity.check_control(self.token, &self.control)?;
+        let Self {
+            bytes,
+            control,
+            capacity,
+            token,
+        } = self;
+        drop(bytes);
+        drop(control);
+        capacity.change(token, EventKind::OutputDropped, |r| {
+            r.output_done = true;
+            Ok(())
+        })?;
+        guard.normal();
+        Ok(())
+    }
+}
+
+struct PanicPayload;
+impl Drop for PanicPayload {
+    fn drop(&mut self) {
+        if !std::thread::panicking() {
+            panic!("guarded native payload drop");
+        }
+    }
+}
+
+// The ledger retains the actual handle cell before a task is spawned. Losing
+// the supervisor/waiter leaves both that handle and original owner quarantined,
+// never a detached task accompanied by refunded capacity.
+struct TaskCell {
+    task: tokio::sync::Mutex<Option<Task>>,
+}
+enum Task {
+    Build(tokio::task::JoinHandle<Result<Built, Failure>>),
+    Driver(tokio::task::JoinHandle<Result<(), Failure>>),
+    Retire(tokio::task::JoinHandle<Result<(), Failure>>),
+    Turn(tokio::task::JoinHandle<()>),
+}
+enum Joined {
+    Build(Result<Built, Failure>),
+    Unit(Result<(), Failure>),
+}
+struct Job {
+    cell: Arc<TaskCell>,
+    capacity: Arc<Capacity>,
+    token: Token,
+    release: Option<Arc<Gate>>,
+    joined: bool,
+}
+impl Job {
+    fn new(capacity: Arc<Capacity>, token: Token) -> Result<Self, Failure> {
+        let cell = Arc::new(TaskCell {
+            task: tokio::sync::Mutex::new(None),
+        });
+        {
+            let mut ledger = capacity.ledger.lock().map_err(|_| Failure::Observation)?;
+            let r = &mut ledger.records[token.index];
+            if r.generation != token.generation
+                || r.state == State::Free
+                || r.tainted
+                || r.task.is_some()
+            {
+                return Err(Failure::Observation);
+            }
+            r.task = Some(cell.clone());
+        }
+        Ok(Self {
+            cell,
+            capacity,
+            token,
+            release: None,
+            joined: false,
+        })
+    }
+    fn set(&self, task: Task) {
+        let mut held = self.cell.task.try_lock().expect("new owned task cell");
+        assert!(held.is_none(), "task installed twice");
+        *held = Some(task);
+    }
+    fn is_finished(&self) -> bool {
+        let Ok(held) = self.cell.task.try_lock() else {
+            return false;
+        };
+        match held.as_ref() {
+            Some(Task::Build(h)) => h.is_finished(),
+            Some(Task::Driver(h) | Task::Retire(h)) => h.is_finished(),
+            Some(Task::Turn(h)) => h.is_finished(),
+            None => false,
+        }
+    }
+    async fn join(mut self) -> Result<Joined, Failure> {
+        let result = {
+            let mut held = self.cell.task.lock().await;
+            let result = match held.as_mut().ok_or(Failure::Observation)? {
+                Task::Build(h) => h.await.map(Joined::Build),
+                Task::Driver(h) | Task::Retire(h) => h.await.map(Joined::Unit),
+                Task::Turn(h) => h.await.map(|()| Joined::Unit(Ok(()))),
+            };
+            drop(held.take()); // Completed real handle/result payload is no longer retained.
+            result
+        };
+        // A failed task may already have tainted the record; removal is only a
+        // diagnostic cleanup update and cannot clear taint or grant credit.
+        {
+            let mut ledger = self
+                .capacity
+                .ledger
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            let record = &mut ledger.records[self.token.index];
+            if record.generation != self.token.generation
+                || !record
+                    .task
+                    .as_ref()
+                    .is_some_and(|c| Arc::ptr_eq(c, &self.cell))
+            {
+                return Err(Failure::Observation);
+            }
+            drop(record.task.take());
+        }
+        self.joined = true;
+        match result {
+            Ok(result) => Ok(result),
+            Err(_) => {
+                self.capacity.quarantine(self.token);
