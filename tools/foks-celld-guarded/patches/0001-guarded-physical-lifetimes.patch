+async fn one(
+    lease: Lease,
+    control: Arc<Control>,
+    other: &Arc<Control>,
+    scenario: LifecycleScenario,
+    tenant_number: u16,
+    expected_counter: u32,
+    peak_rss: &mut Option<u64>,
