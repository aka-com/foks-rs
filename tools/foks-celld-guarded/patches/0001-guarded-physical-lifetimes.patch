+    let mut job = Job::new(runtime.capacity.clone(), runtime.token)?;
+    job.release = hold.clone();
+    let closure = retire_closure(RetireWork {
+        runtime,
+        hold,
+        panic_teardown,
+    });
+    checked_payload(&closure)?;
+    job.set(Task::Retire(tokio::task::spawn_blocking(closure)));
+    Ok(job)
