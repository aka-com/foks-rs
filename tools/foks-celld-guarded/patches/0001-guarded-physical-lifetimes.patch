+const NATIVE_SCRATCH_BYTES: usize = 8192;
+fn channel_bound<T>() -> usize {
+    // Tokio 1.53.1 oneshot::Inner<T> is one AtomicUsize, one
+    // UnsafeCell<Option<T>>, and two UnsafeCell<MaybeUninit<Waker>> fields;
+    // its Arc adds two counters. Six full maximum-alignment padding terms
+    // conservatively cover every field boundary and the outer allocation.
+    std::mem::size_of::<Option<T>>()
+        + 3 * std::mem::size_of::<usize>()
+        + 2 * std::mem::size_of::<std::task::Waker>()
+        + 6 * 16
+}
+fn scratch_bound() -> usize {
+    let channels = channel_bound::<()>()
+        + channel_bound::<Result<crate::engine_api::HttpResponse, anyhow::Error>>();
+    // Native strings explicitly owned by this adapter: bounded path copies,
+    // fixed scope/id/URL/method/config strings. Fixture mutation scratch runs
+    // without a Worker or channels; Vec growth may retain old+new allocations.
+    // This is not an accounting proof for unchanged celld engine internals.
+    let strings_and_channels =
+        4 * STORAGE_PATH_BYTES + 8 * 128 + 2 * js::guarded::JS.len() + channels;
+    let fixture_mutations = 3 * js::guarded::JS.len() + 8 * js::guarded::WASM.len() + 64;
+    strings_and_channels.max(fixture_mutations)
+}
+fn produced_layout<A, B>(_: fn(A) -> B) -> (usize, usize) {
+    (std::mem::size_of::<B>(), std::mem::align_of::<B>())
