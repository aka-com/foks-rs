+        let _ = build.join().await; // Retain quarantine on failed observation or join.
+        return Err(Failure::Observation);
+    }
+    if scenario == S::PanicBuild {
+        let result = build.join().await;
+        ensure(result.is_err())?;
+        ensure(capacity.snapshots()[token.index].state == State::Quarantined)?;
+        drop(lease);
+        return Ok(cycle);
+    }
+    let built = join_build(build).await?;
+    if let Some(waiter) = waiter {
+        waiter.await.map_err(|_| Failure::Observation)?;
+    }
