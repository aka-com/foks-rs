+    // its sender; losing the receiver never owns or aborts the job handle.
+    if scenario == S::CancelBeforePoll {
+        drop(waiter.take());
+        control.cancelled.store(true, Ordering::Release);
+    }
+    let start = Instant::now();
+    let build = spawn_build(work)?;
+    let build_observation = if let Some(gate) = &build_gate {
+        let observed = async {
+            at_gate(gate, &control).await?;
+            occupied(&capacity, 1, WASM_BYTES)?;
+            ensure(!build.is_finished())?;
+            if scenario == S::DeadlineBuild {
+                expire(&control).await?;
+            } else {
