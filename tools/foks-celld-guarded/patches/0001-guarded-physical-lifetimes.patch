+#[derive(Clone)]
+pub(crate) enum BuildMode {
+    Normal,
+    ErrorBefore,
+    ErrorAfter,
+    PanicAfter,
+    HoldAfter(Arc<Gate>),
+}
+thread_local! {
+    static BUILD: RefCell<Option<BuildMode>> = const { RefCell::new(None) };
+}
+
+#[derive(Debug)]
+struct InjectedAfterIsolate;
+impl std::fmt::Display for InjectedAfterIsolate {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("guarded injected post-isolate error")
