+//! Closed A2 process ledger. Logical lease Drop never returns physical credit.
+use crate::{js, pool};
+use qualification::{LifecycleFailure as Failure, LifecycleInput, LifecycleProcessOwner};
+use serde::Serialize;
+use std::{
+    any::Any,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc, Condvar, Mutex, OnceLock, TryLockError,
+    },
+    time::{Duration, Instant},
+};
+
+pub(crate) mod qualification;
+const SLOTS: usize = 2;
+const EVENT_LIMIT: usize = 512;
+const WASM_BYTES: usize = js::guarded::CAPACITY;
+const DIRECTORY_BYTES: usize = 64;
+const STORAGE_PATH_BYTES: usize = DIRECTORY_BYTES + 1 + 64 + 7;
+type Owner = Arc<dyn Any + Send + Sync>;
+static CAPACITY: OnceLock<Arc<Capacity>> = OnceLock::new();
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "kebab-case")]
+enum State {
+    Free,
+    Building,
+    Running,
+    Retiring,
+    Quarantined,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "kebab-case")]
+enum Refusal {
+    Busy,
+    Capacity,
+    Contended,
+    Poisoned,
+    Invalid,
+    Exhausted,
+    Expired,
+    Cancelled,
+}
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "kebab-case")]
+enum EventKind {
+    Admitted,
+    WorkerBuilt,
+    Adopted,
+    DriverStarted,
+    ReplyReceived,
+    DriverJoined,
+    BackingObserved,
+    Retiring,
+    CellClosed,
+    SlotConsumed,
+    WorkerDropped,
+    ProbeDropped,
+    MemoryReleased,
+    OutputDropped,
+    PayloadsDropped,
+    OwnerDropped,
+    Freed,
+    Quarantined,
+    Refused,
+}
+#[derive(Clone, Copy, Serialize)]
+// Compact bounded tuple: sequence, record, generation, kind, occupied, reserved.
+struct Event(u32, u8, u64, EventKind, u8, u64);
+#[derive(Clone, Copy, Serialize)]
+struct Snapshot {
+    state: State,
+    generation: u64,
+    memory_reserved: bool,
+    output_done: bool,
+    runtime_done: bool,
+    tainted: bool,
+    owner: Option<u8>,
+}
+#[derive(Clone, Copy, Eq, PartialEq)]
+struct Key([u8; 32]);
+impl Key {
+    fn parse(value: &str) -> Result<Self, Refusal> {
+        if value.len() != 64 {
+            return Err(Refusal::Invalid);
+        }
+        let mut key = [0; 32];
+        for (to, pair) in key.iter_mut().zip(value.as_bytes().chunks_exact(2)) {
+            let nibble = |v| match v {
+                b'0'..=b'9' => Some(v - b'0'),
+                b'a'..=b'f' => Some(v - b'a' + 10),
+                _ => None,
+            };
+            *to = nibble(pair[0]).ok_or(Refusal::Invalid)? * 16
+                + nibble(pair[1]).ok_or(Refusal::Invalid)?;
+        }
+        Ok(Self(key))
+    }
+}
+struct Control {
+    deadline: Instant,
+    cancelled: Arc<AtomicBool>,
+    owner: Owner,
+    ordinal: u8,
+}
+impl Control {
+    fn from_input(value: LifecycleInput, ordinal: u8) -> Arc<Self> {
+        Arc::new(Self {
+            deadline: value.deadline,
+            cancelled: value.cancelled,
+            owner: value.owner,
+            ordinal,
+        })
+    }
+    fn check(&self) -> Result<(), Refusal> {
+        if self.cancelled.load(Ordering::Acquire) {
+            return Err(Refusal::Cancelled);
+        }
+        if Instant::now() >= self.deadline {
+            return Err(Refusal::Expired);
+        }
+        Ok(())
+    }
+    fn remaining(&self) -> Result<Duration, Failure> {
+        self.check().map_err(|_| Failure::Admission)?;
+        Ok(self.deadline.saturating_duration_since(Instant::now()))
+    }
+}
+struct Record {
+    state: State,
+    generation: u64,
+    key: Option<Key>,
+    memory: bool,
+    output_done: bool,
+    runtime_done: bool,
+    payloads_done: bool,
+    tainted: bool,
+    worker_live: bool,
+    store_live: bool,
+    control: Option<Arc<Control>>,
+    uncertain_slot: Option<Arc<pool::Slot>>,
+    task: Option<Arc<TaskCell>>,
+}
+impl Default for Record {
+    fn default() -> Self {
+        Self {
+            state: State::Free,
+            generation: 0,
+            key: None,
+            memory: false,
+            output_done: false,
+            runtime_done: false,
+            payloads_done: false,
+            tainted: false,
+            worker_live: false,
+            store_live: false,
+            control: None,
+            uncertain_slot: None,
+            task: None,
+        }
+    }
+}
+impl Record {
+    fn snapshot(&self) -> Snapshot {
+        Snapshot {
+            state: self.state,
+            generation: self.generation,
+            memory_reserved: self.memory,
+            output_done: self.output_done,
+            runtime_done: self.runtime_done,
+            tainted: self.tainted,
+            owner: self.control.as_ref().map(|c| c.ordinal),
+        }
+    }
+}
+struct Ledger {
+    records: [Record; SLOTS],
+    next: u64,
+    events: Vec<Event>,
+    observation_failed: bool,
+    peak_workers: u8,
+    peak_stores: u8,
+    peak_occupied: u8,
+    peak_reserved: u64,
+    refused: u32,
+    event_counts: [u32; 19],
+    detailed: bool,
+}
+impl Ledger {
+    fn event(&mut self, token: Token, kind: EventKind) {
+        let occupied = self
+            .records
+            .iter()
+            .filter(|r| r.state != State::Free)
+            .count() as u8;
+        let reserved = self.records.iter().filter(|r| r.memory).count() as u64 * WASM_BYTES as u64;
+        let workers = self.records.iter().filter(|r| r.worker_live).count() as u8;
+        let stores = self.records.iter().filter(|r| r.store_live).count() as u8;
+        self.peak_workers = self.peak_workers.max(workers);
+        self.peak_stores = self.peak_stores.max(stores);
+        self.peak_occupied = self.peak_occupied.max(occupied);
+        self.peak_reserved = self.peak_reserved.max(reserved);
+        let count = &mut self.event_counts[kind as usize];
+        if let Some(next) = count.checked_add(1) {
+            *count = next;
+        } else {
+            self.observation_failed = true;
+        }
+        if !self.detailed {
+            return;
+        } // Explicit cold-cycle aggregate mode, reported as such.
+        if self.events.len() == EVENT_LIMIT {
+            self.observation_failed = true;
+            return;
+        }
+        self.events.push(Event(
+            self.events.len() as u32,
+            token.index as u8,
+            token.generation,
+            kind,
+            occupied,
+            reserved,
+        ));
+    }
+}
+struct Capacity {
+    ledger: Mutex<Ledger>,
+    directory: Mutex<Option<tempfile::TempDir>>,
+    // Process Request is separate from every invocation owner. The OnceLock
+    // deliberately retains it and its report/serialization charge until exit.
+    _process_owner: Owner,
+}
+#[derive(Clone, Copy)]
+struct Token {
+    index: usize,
+    generation: u64,
+}
+impl Capacity {
+    fn install(owner: LifecycleProcessOwner) -> Result<Arc<Self>, Failure> {
+        if CAPACITY.get().is_some() {
+            return Err(Failure::Setup);
+        }
+        let capacity = Arc::new(Self {
+            ledger: Mutex::new(Ledger {
+                records: std::array::from_fn(|_| Record::default()),
+                next: 0,
+                events: Vec::with_capacity(EVENT_LIMIT),
+                observation_failed: false,
+                peak_workers: 0,
+                peak_stores: 0,
+                peak_occupied: 0,
+                peak_reserved: 0,
+                refused: 0,
+                event_counts: [0; 19],
+                detailed: true,
+            }),
+            directory: Mutex::new(None),
+            _process_owner: owner.owner,
+        });
+        CAPACITY.set(capacity.clone()).map_err(|_| Failure::Setup)?;
+        Ok(capacity)
+    }
+    fn try_admit(self: &Arc<Self>, id: &str, control: Arc<Control>) -> Result<Lease, Refusal> {
+        let key = Key::parse(id)?;
+        control.check()?;
+        let mut ledger = match self.ledger.try_lock() {
+            Ok(ledger) => ledger,
+            Err(TryLockError::WouldBlock) => return Err(Refusal::Contended),
+            Err(TryLockError::Poisoned(_)) => return Err(Refusal::Poisoned),
+        };
+        if ledger
+            .records
+            .iter()
+            .any(|r| r.state != State::Free && r.key == Some(key))
+        {
+            return Err(Refusal::Busy);
+        }
+        let Some(index) = ledger.records.iter().position(|r| r.state == State::Free) else {
+            return Err(Refusal::Capacity);
+        };
+        let generation = ledger.next.checked_add(1).ok_or(Refusal::Exhausted)?;
+        ledger.next = generation;
+        ledger.records[index] = Record {
+            state: State::Building,
+            generation,
+            key: Some(key),
+            memory: true,
+            control: Some(control),
+            ..Record::default()
+        };
+        let token = Token { index, generation };
+        ledger.event(token, EventKind::Admitted);
+        Ok(Lease {
+            capacity: self.clone(),
+            token,
+            finished: false,
+        })
+    }
+    fn change(
+        &self,
+        token: Token,
+        kind: EventKind,
+        f: impl FnOnce(&mut Record) -> Result<(), Failure>,
+    ) -> Result<(), Failure> {
+        let mut ledger = self.ledger.lock().map_err(|_| Failure::Observation)?;
+        let record = &mut ledger.records[token.index];
+        if record.generation != token.generation || record.state == State::Free || record.tainted {
+            return Err(Failure::Observation);
+        }
+        f(record)?;
+        ledger.event(token, kind);
+        if ledger.observation_failed {
+            return Err(Failure::ReportBound);
+        }
+        Ok(())
+    }
+    fn quarantine(&self, token: Token) {
+        let mut ledger = self
+            .ledger
+            .lock()
+            .unwrap_or_else(|poison| poison.into_inner());
+        let record = &mut ledger.records[token.index];
+        if record.generation == token.generation && record.state != State::Free {
+            record.tainted = true;
+            record.state = State::Quarantined;
+            ledger.event(token, EventKind::Quarantined);
+        }
+    }
+    fn check_control(&self, token: Token, control: &Arc<Control>) -> Result<(), Failure> {
+        let ledger = self.ledger.lock().map_err(|_| Failure::Observation)?;
+        let record = &ledger.records[token.index];
+        let original = record.control.as_ref().ok_or(Failure::Observation)?;
+        if record.generation != token.generation
+            || !Arc::ptr_eq(original, control)
+            || !Arc::ptr_eq(&original.owner, &control.owner)
+            || original.deadline != control.deadline
+            || !Arc::ptr_eq(&original.cancelled, &control.cancelled)
+        {
+            return Err(Failure::Observation);
+        }
+        Ok(())
+    }
+    fn event(&self, token: Token, kind: EventKind) -> Result<(), Failure> {
+        self.change(token, kind, |_| Ok(()))
+    }
+    fn refused(&self) -> Result<(), Failure> {
+        let mut ledger = self.ledger.lock().map_err(|_| Failure::Observation)?;
+        ledger.refused = ledger.refused.checked_add(1).ok_or(Failure::Observation)?;
+        ledger.event(
+            Token {
+                index: 0,
+                generation: 0,
+            },
+            EventKind::Refused,
+        );
+        Ok(())
+    }
+    fn finish(&self, token: Token) -> Result<(), Failure> {
+        let control = {
+            let mut ledger = self.ledger.lock().map_err(|_| Failure::Observation)?;
+            let r = &mut ledger.records[token.index];
+            if r.generation != token.generation
+                || r.tainted
+                || r.state != State::Retiring
+                || r.memory
+                || !r.runtime_done
+                || !r.output_done
+                || !r.payloads_done
+                || r.worker_live
+                || r.store_live
+                || r.uncertain_slot.is_some()
+                || r.task.is_some()
+            {
+                return Err(Failure::Retirement);
+            }
+            r.control.take().ok_or(Failure::Retirement)?
+        };
+        // No bookkeeping lock is held across arbitrary native owner destruction.
+        let dropped = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| drop(control)));
+        if dropped.is_err() {
+            self.quarantine(token);
+            return Err(Failure::Retirement);
+        }
+        self.change(token, EventKind::OwnerDropped, |_| Ok(()))?;
+        self.change(token, EventKind::Freed, |r| {
+            *r = Record {
+                generation: token.generation,
+                ..Record::default()
+            };
+            Ok(())
+        })
+    }
+    fn snapshots(&self) -> [Snapshot; SLOTS] {
+        let ledger = self
+            .ledger
+            .lock()
+            .unwrap_or_else(|poison| poison.into_inner());
+        std::array::from_fn(|i| ledger.records[i].snapshot())
+    }
+    fn storage_path(&self, id: &str) -> Result<String, Failure> {
+        Key::parse(id).map_err(|_| Failure::Setup)?;
+        let mut owner = self.directory.lock().map_err(|_| Failure::Setup)?;
+        if owner.is_none() {
+            // Closed local qualification directory, independent of TMPDIR.
+            // tempfile atomically creates a new private directory; no existing
+            // path is opened or deleted by this fixture.
+            let directory = tempfile::Builder::new()
+                .prefix("foks-a2-")
+                .tempdir_in("/tmp")
+                .map_err(|_| Failure::Setup)?;
+            if directory.path().as_os_str().len() > DIRECTORY_BYTES {
+                return Err(Failure::OwnerBound);
+            }
+            *owner = Some(directory);
+        }
+        let root = owner.as_ref().ok_or(Failure::Setup)?.path();
+        let mut path = String::with_capacity(STORAGE_PATH_BYTES);
+        path.push_str(root.to_str().ok_or(Failure::Setup)?);
+        path.push('/');
+        path.push_str(id);
+        path.push_str(".sqlite");
+        if path.len() > STORAGE_PATH_BYTES {
+            return Err(Failure::OwnerBound);
+        }
+        Ok(path)
+    }
+}
+struct Lease {
+    capacity: Arc<Capacity>,
+    token: Token,
+    finished: bool,
+}
+impl Lease {
+    fn finish(mut self) -> Result<(), Failure> {
+        self.capacity.finish(self.token)?;
+        self.finished = true;
+        Ok(())
+    }
+}
+impl Drop for Lease {
+    fn drop(&mut self) {
+        if !self.finished {
+            self.capacity.quarantine(self.token);
+        }
+    }
+}
+struct Taint {
+    capacity: Arc<Capacity>,
+    token: Token,
+    armed: bool,
+}
+impl Taint {
+    fn new(capacity: &Arc<Capacity>, token: Token) -> Self {
+        Self {
+            capacity: capacity.clone(),
+            token,
+            armed: true,
+        }
+    }
+    fn normal(mut self) {
+        self.armed = false;
+    }
+}
+impl Drop for Taint {
+    fn drop(&mut self) {
+        if self.armed {
+            self.capacity.quarantine(self.token);
+        }
+    }
+}
