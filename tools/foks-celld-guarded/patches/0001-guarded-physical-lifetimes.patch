+        slot: runtime.slot.clone(),
+        affiliation: runtime.slot.affiliate(),
+        job: js::CellJob::Fetch {
+            request_id: None,
+            scope: runtime.storage.scope.clone(),
+            name: None,
+            url: "https://foks.invalid/closed".into(),
+            method: "GET".into(),
+            body: Vec::new().into(),
+            headers: vec![],
+            reply,
+            order: None,
+        },
+        hold: held_driver.clone(),
+        panic_after: scenario == S::PanicTask,
+        panic_payload: scenario == S::PanicPayloadDrop,
+        control: control.clone(),
+        capacity: capacity.clone(),
+        token,
+    };
+    let start = Instant::now();
+    let driver = spawn_driver(work)?;
+    let mut output = None;
+    let driver_observation = async {
+        let received = tokio::time::timeout_at(
+            tokio::time::Instant::from_std(control.deadline),
+            &mut response,
+        )
+        .await
+        .map_err(|_| Failure::Driver)?
+        .map_err(|_| Failure::Driver)?
+        .map_err(|_| Failure::Driver)?;
+        if !matches!(scenario, S::PanicTask | S::PanicPayloadDrop) {
+            capacity.event(token, EventKind::ReplyReceived)?;
+        }
+        ensure(
+            received.status == 200
+                && received.body.len() == 12
+                && received.body.capacity() == 12
+                && received.stream.is_none()
+                && received.websocket.is_none(),
+        )?;
+        let counter = u32::from_le_bytes(
+            received.body[0..4]
+                .try_into()
+                .map_err(|_| Failure::Observation)?,
+        );
+        let fresh = u32::from_le_bytes(
+            received.body[4..8]
+                .try_into()
+                .map_err(|_| Failure::Observation)?,
+        ) == 1;
+        let bytes = u32::from_le_bytes(
+            received.body[8..12]
+                .try_into()
+                .map_err(|_| Failure::Observation)?,
+        ) as usize;
+        ensure(
+            counter == expected_counter
+                && fresh
+                && bytes == WASM_BYTES
+                && received.write_position.is_some(),
+        )?;
+        output = Some(Output {
+            bytes: received.body,
+            control: control.clone(),
+            capacity: capacity.clone(),
+            token,
+        });
+        drop(received.headers);
+        drop(received.stream);
+        drop(received.websocket);
+        cycle.counter = counter;
+        cycle.fresh_wasm = fresh;
+        // Capture the actual store while the original deadline is still live.
+        if !matches!(scenario, S::PanicTask | S::PanicPayloadDrop) {
+            runtime.probe(scenario == S::MemoryGrowth).await?;
+            *peak_rss = (*peak_rss).max(rss());
+        }
+        if let Some(gate) = &held_driver {
+            at_gate(gate, &control).await?;
+            ensure(!driver.is_finished())?;
+            ensure(Arc::strong_count(&runtime.slot) > 1)?; // Diagnostic only, no retry/extraction protocol.
+            if scenario == S::DeadlineRun {
+                expire(&control).await?;
+            }
+            if matches!(scenario, S::CancelAfterReply | S::Shutdown) {
+                // Finite shutdown initiation while the real driver is pending.
+                control.cancelled.store(true, Ordering::Release);
+            }
+        }
+        Ok::<(), Failure>(())
+    }
+    .await;
+    drop(response);
+    // Observation errors never discard supervision. Release the real gate,
+    // await the actual driver, and drop its handle before propagating either.
+    if let Some(gate) = &held_driver {
+        gate.release();
+    }
+    let driven = join_unit(driver).await;
+    driver_observation?;
+    if matches!(scenario, S::PanicTask | S::PanicPayloadDrop) {
+        ensure(driven.is_err())?;
+        ensure(capacity.snapshots()[token.index].state == State::Quarantined)?;
+        drop(output);
+        drop(runtime);
+        drop(control);
+        drop(lease);
+        return Ok(cycle);
+    }
+    driven?;
+    capacity.event(token, EventKind::DriverJoined)?;
+    cycle.execute_us = micros(start)?;
+    if matches!(scenario, S::DeadlineRun | S::CancelAfterReply | S::Shutdown) {
+        ensure(control.check().is_err())?;
+    }
+    if scenario == S::OutputBeforeRuntime {
+        cycle.diagnostic_bytes_observed = output
+            .as_ref()
+            .ok_or(Failure::Observation)?
+            .publish()
+            .map_err(|_| Failure::Observation)?
+            .len();
+        output.take().ok_or(Failure::Observation)?.dispose()?;
+        occupied(&capacity, 1, WASM_BYTES)?;
+    }
+    let start = Instant::now();
+    runtime.close().await?;
+    cycle.close_us = micros(start)?;
+    if scenario == S::TenantBusy {
+        refuse(&capacity, &id, other, Refusal::Busy)?;
+    }
+    let probe_gate = matches!(scenario, S::HeldBacking | S::DeadlineRetire).then(Gate::new);
+    let start = Instant::now();
+    let destruction = spawn_retire(runtime, probe_gate.clone(), scenario == S::PanicTeardown)?;
+    let retire_observation = if let Some(gate) = &probe_gate {
+        let observed = async {
+            at_gate(gate, &control).await?;
+            let snapshots = capacity.snapshots();
+            ensure(snapshots[token.index].memory_reserved && !snapshots[token.index].runtime_done)?;
+            ensure(!destruction.is_finished())?;
+            if scenario == S::DeadlineRetire {
+                expire(&control).await?;
+            }
+            Ok::<(), Failure>(())
+        }
+        .await;
+        gate.release();
+        observed
+    } else {
+        Ok(())
+    };
+    let destroyed = join_unit(destruction).await;
+    retire_observation?;
+    if scenario == S::PanicTeardown {
+        ensure(destroyed.is_err())?;
+        drop(output);
+        drop(control);
+        drop(lease);
+        return Ok(cycle);
+    }
+    destroyed?;
+    cycle.drop_us = micros(start)?;
+    let snapshot = capacity.snapshots()[token.index];
+    ensure(
+        !snapshot.memory_reserved && snapshot.runtime_done && snapshot.state == State::Retiring,
+    )?;
+    if scenario == S::TenantBusy {
+        refuse(&capacity, &id, other, Refusal::Busy)?;
+    }
+    if matches!(scenario, S::RuntimeBeforeOutput | S::DeadlineOutput) {
+        ensure(!snapshot.output_done)?;
+        occupied(&capacity, 1, 0)?;
+    }
+    if scenario == S::DeadlineOutput {
+        expire(&control).await?;
+        ensure(control.check().is_err())?;
+    }
+    if let Some(output) = output {
+        let publication = output.publish();
+        if matches!(
+            scenario,
+            S::DeadlineRun | S::DeadlineRetire | S::DeadlineOutput
+        ) {
+            ensure(publication == Err(Refusal::Expired))?;
+            cycle.publication_denied = true;
+        } else if matches!(scenario, S::CancelAfterReply | S::Shutdown) {
+            ensure(publication == Err(Refusal::Cancelled))?;
+            cycle.publication_denied = true;
+        } else {
+            cycle.diagnostic_bytes_observed = publication.map_err(|_| Failure::Observation)?.len();
+        }
+        output.dispose()?;
+    }
+    drop(build_gate);
+    drop(held_driver);
+    drop(probe_gate);
+    drop(id);
+    drop(control);
+    payloads_complete(lease)?;
+    cycle.normal_completion = true;
+    Ok(cycle)
+}
