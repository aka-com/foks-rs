+        (
+            "build-payload",
+            std::mem::size_of::<BuildWork>(),
+            std::mem::align_of::<BuildWork>(),
+        ),
+        ("build-closure", build.0, build.1),
+        (
+            "build-result",
+            std::mem::size_of::<Result<Built, Failure>>(),
+            std::mem::align_of::<Result<Built, Failure>>(),
+        ),
+        (
+            "runtime",
+            std::mem::size_of::<Runtime>(),
+            std::mem::align_of::<Runtime>(),
+        ),
+        (
+            "driver-payload",
+            std::mem::size_of::<DriverWork>(),
+            std::mem::align_of::<DriverWork>(),
+        ),
+        ("driver-future", driver.0, driver.1),
+        (
+            "retire-payload",
+            std::mem::size_of::<RetireWork>(),
+            std::mem::align_of::<RetireWork>(),
+        ),
+        ("retire-closure", retire.0, retire.1),
+        ("turn-future", turn.0, turn.1),
+        (
