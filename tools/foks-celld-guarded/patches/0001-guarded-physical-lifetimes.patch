+        refuse(&capacity, &id, other, Refusal::Busy)?;
+    }
+    if scenario == S::PanicTurn {
+        let observed = Arc::new(AtomicBool::new(false));
+        let work = TurnFaultWork {
+            slot: runtime.slot.clone(),
+            observed_restore: observed.clone(),
+            control: control.clone(),
+            capacity: capacity.clone(),
+            token,
+        };
