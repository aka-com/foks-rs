+fn spawn_driver(work: DriverWork) -> Result<Job, Failure> {
+    let mut job = Job::new(work.capacity.clone(), work.token)?;
+    job.release = work.hold.clone();
+    let future = work.run();
+    checked_payload(&future)?;
+    job.set(Task::Driver(tokio::spawn(future)));
+    Ok(job)
