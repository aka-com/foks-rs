+        Built::CleanError => {
+            ensure(matches!(
+                scenario,
+                S::LoadErrorBeforeIsolate | S::LoadErrorAfterIsolate | S::CancelBeforePoll
+            ))?;
+            drop(id);
+            drop(build_gate);
+            drop(control);
+            clean_build(lease)?;
+            cycle.normal_completion = true;
+            return Ok(cycle);
+        }
+        Built::Runtime(runtime) => runtime,
+    };
+    if matches!(scenario, S::CancelDuringBuild | S::DeadlineBuild) {
+        ensure(control.check().is_err())?;
+        runtime.close().await?;
+        join_unit(spawn_retire(runtime, None, false)?).await?;
+        capacity.change(token, EventKind::OutputDropped, |r| {
+            r.output_done = true;
+            Ok(())
+        })?;
+        drop(id);
+        drop(build_gate);
+        drop(control);
+        payloads_complete(lease)?;
+        cycle.normal_completion = true;
+        return Ok(cycle);
+    }
+    let start = Instant::now();
+    runtime.adopt().await?;
+    cycle.adopt_us = micros(start)?;
