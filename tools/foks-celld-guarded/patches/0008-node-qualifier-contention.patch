+// Observe the real owned-lock WouldBlock boundary before releasing Q. The
+// operation itself keeps its actual metadata owner; no timing sleep proves it.
+fn b4_owned_qualification_wait<T: Send + 'static>(
+    q: &Arc<qualification::Qualification>,
+    operation: impl FnOnce(Arc<qualification::Qualification>) -> T + Send + 'static,
+) -> T {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let (notice_tx, notice_rx) = std::sync::mpsc::sync_channel(1);
+    let (result_tx, result_rx) = std::sync::mpsc::sync_channel(1);
+    let worker_q = q.clone();
+    let (observed, worker) = q.with_guard_for_test(|| {
+        let worker = std::thread::spawn(move || {
+            let _notice = control::contention_notice(notice_tx);
+            let result = operation(worker_q);
+            let _ = result_tx.send(result);
+        });
+        let observed = notice_rx.recv_timeout(deadline.saturating_duration_since(Instant::now()));
+        (observed, worker)
+    });
+    let result = result_rx.recv_timeout(deadline.saturating_duration_since(Instant::now()));
+    let joined = worker.join();
+    // All actual locks are released and helpers joined before assertions.
+    assert!(observed.is_ok());
+    assert!(joined.is_ok());
+    result.unwrap()
+}
+fn b4_poison_qualification(q: &Arc<qualification::Qualification>) {
+    let worker_q = q.clone();
+    let result = std::thread::spawn(move || {
+        worker_q.with_guard_for_test(|| panic!("private qualifier poison regression"));
+    })
+    .join();
+    assert!(result.is_err());
+    drop(result); // Dispose the real panic payload after the mutex guard unwound.
+}
