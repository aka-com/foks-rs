+        owner: &OriginalOwner,
+        stamp: AcceptedStamp,
+    ) -> Result<usize, Refusal> {
+        owner.check()?;
+        let mut state = owner
+            .registry
+            .state
+            .try_lock()
+            .map_err(|_| Refusal::Contended)?;
+        let (index, cell) = state
+            .headers
+            .iter_mut()
+            .enumerate()
+            .find(|(_, cell)| cell.stamp.is_none())
+            .ok_or(Refusal::Busy)?;
+        cell.stamp = Some(stamp);
+        Ok(index)
+    }
+
+    pub(in crate::guarded_execution::node) fn take_header(
+        owner: &OriginalOwner,
+        index: usize,
+    ) -> Result<AcceptedStamp, Refusal> {
+        let mut state = owner
+            .registry
+            .state
+            .try_lock()
+            .map_err(|_| Refusal::Contended)?;
+        state
+            .headers
+            .get_mut(index)
+            .ok_or(Refusal::Invalid)?
+            .stamp
+            .take()
+            .ok_or(Refusal::Invalid)
+    }
+
+    pub(in crate::guarded_execution::node) fn exact_generation(
+        ids: &[u64],
+        expected: u64,
+    ) -> Option<usize> {
+        (expected != 0)
+            .then(|| ids.iter().position(|id| *id == expected))
+            .flatten()
+    }
+
+    pub(in crate::guarded_execution::node) fn next_generation(
+        current: u64,
+    ) -> Result<u64, Refusal> {
+        current
+            .checked_add(1)
+            .filter(|next| *next != 0)
+            .ok_or(Refusal::Exhausted)
+    }
