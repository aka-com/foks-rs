+            owner.fail();
+            return Err(Refusal::Invalid);
+        }
+        let result = owner
+            .control
+            .cleanup
+            .try_lock()
+            .map_err(|_| Refusal::Contended)?
+            .consume_closed(kind);
+        if result.is_err() {
+            owner.fail();
+        }
+        result
+    }
