+#[test]
+fn b1_layout_and_role_ledger() {
+    let layout = GuardedNode::layouts().unwrap();
+    let node_layout = component::arc_layout::<GuardedNode>();
+    assert_eq!(node_layout.0, layout.node_arc_bytes);
+    assert!(node_layout.1 <= 16);
+    assert_eq!(layout.cleanup_reserve, 200 * 1024);
+    assert_eq!(layout.weak_limit, 66);
+    assert!(layout
+        .native
+        .iter()
+        .all(|(bytes, align)| *bytes > 0 && *bytes <= 64 * 1024 && *align <= 16));
+    assert!(layout.node_arc_bytes <= 64 * 1024);
+    let (factory, process) = fixture_factory();
+    let observed = process.observation().unwrap();
+    assert_eq!(
+        observed.role_caps,
+        [control::MIB, 8 * control::MIB, 64 * 1024]
+    );
+    assert_eq!(
+        observed.debt,
+        layout.native[0].0 + layout.native[1].0 + layout.native[2].0 + 66 * layout.native[0].0
+    );
+    assert!(
+        observed
+            .role_caps
+            .iter()
+            .zip(observed.role_counts)
+            .map(|(cap, count)| cap * count)
+            .sum::<usize>()
+            < 48 * control::MIB
+    );
+    // Each completed invocation leaves one separately precharged Weak backing
+    // witness. Exhaustion does not forget a witness or reuse a request ID.
+    for _ in 0..64 {
+        retire(child(&factory, OwnerRole::Invocation));
+    }
+    assert_eq!(process.observation().unwrap().summaries, 64);
+    assert!(matches!(
+        factory.try_owner(
+            OwnerRole::Invocation,
+            Some(AcceptedStamp::capture().unwrap())
+        ),
+        Err(Refusal::Exhausted)
+    ));
+    retire(child(&factory, OwnerRole::Control));
+    retire_factory(factory, process);
+
+    // Record actual compiled layouts after all assertions and fixture cleanup.
+    // Direct stderr writes bypass libtest's success-output capture without
+    // changing the exact 21-test stdout/serial-command contract. Nested/stack
+    // observations are nonadditive and do not describe allocator or RSS cost.
+    let names = [
+        "request_arc",
+        "control_arc",
+        "registry_arc",
+        "owner_factory",
+        "original_owner",
+        "header_cell",
+        "cleanup_credits",
+        "control_observation",
+    ];
+    let mut layouts = serde_json::Map::new();
+    for (name, (bytes, alignment)) in names
+        .into_iter()
+        .zip(layout.native)
+        .chain(std::iter::once(("node_arc", node_layout)))
+    {
+        layouts.insert(
+            name.into(),
+            serde_json::json!({"bytes": bytes, "alignment": alignment}),
+        );
+    }
+    let record = serde_json::json!({
+        "format": 1,
+        "claim": "b1-native-layouts-only",
+        "arc_convention": "repr-c-two-atomic-usize",
+        "layouts": layouts,
+        "role_caps": observed.role_caps,
+        "role_counts": observed.role_counts,
+        "initial_process_debt": observed.debt,
+        "cleanup_reserve": layout.cleanup_reserve,
+        "weak_limit": layout.weak_limit,
+    });
+    let mut line = b"FOKS_B1_LAYOUT ".to_vec();
+    serde_json::to_writer(&mut line, &record).expect("serialize compiled layouts");
+    line.push(b'\n');
+    assert!(line.len() <= 4096);
+    let mut stderr = std::io::stderr().lock();
+    std::io::Write::write_all(&mut stderr, &line).expect("record compiled layouts");
+    std::io::Write::flush(&mut stderr).expect("flush compiled layouts");
+}
