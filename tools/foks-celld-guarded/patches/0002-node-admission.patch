+    let replacement = child(&factory, OwnerRole::Invocation);
+    retire(replacement);
+    drop(held);
+    drop(factory);
+    drop(process);
+    assert!(weak.upgrade().is_none());
+    // This Weak can still retain Arc backing; no allocator-free claim is made.
+    drop(weak);
