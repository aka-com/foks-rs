+#[test]
+fn b1_resident_gate_duplicate_is_inert() {
+    let (mut state, id, epoch) = resident();
+    resident_gate(&mut state, 2, 1, &id, epoch, 1, 10);
+    // One real in-flight cold operation and one queued activation ensure this
+    // event cannot accidentally run the ordinary event tail's pumps/timers.
+    on_event(
+        &mut state,
+        Event::Request {
+            request: 90,
+            cell: "unrelated-live".into(),
+        },
+    );
+    on_event(
+        &mut state,
+        Event::Request {
+            request: 91,
+            cell: "unrelated-queued".into(),
+        },
+    );
+    let phase = state.phase("unrelated-live").cloned();
+    let queued = state.activation_waiting();
+    let census = state.phase_census();
+    for (request, parent) in [(2, 1), (1, 1), (90, 1)] {
+        assert!(resident_gate(&mut state, request, parent, &id, epoch, 1, 2_000).is_empty());
+        assert_eq!(state.phase("unrelated-live").cloned(), phase);
+        assert_eq!(state.activation_waiting(), queued);
+        assert_eq!(state.phase_census(), census);
+    }
+    assert_refused(
+        &resident_gate(&mut state, 92, 999, &id, epoch, 1, 2_000),
+        92,
+    );
+    assert_eq!(state.activation_waiting(), queued);
+    assert_eq!(state.phase_census(), census);
+    // Duplicate identity still advances the normal monotonic clock. A later
+    // untimed cold operation receives its deadline from that retained clock.
+    let (mut clock_state, id, epoch) = resident();
+    assert!(resident_gate(&mut clock_state, 1, 1, &id, epoch, 1, 2_000).is_empty());
+    let effects = on_event(
+        &mut clock_state,
+        Event::Request {
+            request: 99,
+            cell: "clock-proof".into(),
+        },
+    );
+    assert!(effects.iter().any(|e| matches!(
+        e,
+        Effect::ScheduleTimer {
+            timer: celld_logic::Timer::OperationDeadline { .. },
+            at_mono_ms: 3_000
+        }
+    )));
+    state.validate().unwrap();
+    clock_state.validate().unwrap();
+}
