+        assert!(state.request_inactive(2));
+        assert_eq!(state.phase(&id).cloned(), before);
+        state.validate().unwrap();
+    }
+    let mut unavailable = State::new("node", model_config(true));
+    assert_refused(&resident_gate(&mut unavailable, 2, 1, "absent", 1, 1, 0), 2);
+    assert_eq!(unavailable.phase("absent"), None);
+    // An actual acquired lease may expire while the parent remains resident.
+    let mut state = State::new("node", model_config(true));
+    let effects = on_event(
+        &mut state,
+        Event::StartNodeLease {
