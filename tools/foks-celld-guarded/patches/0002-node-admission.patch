+fn b1_resident_gate_accepts_exact_parent() {
+    let (mut state, id, epoch) = resident();
+    let effects = resident_gate(&mut state, 2, 1, &id, epoch, 1, 10);
+    assert_eq!(
+        effects,
+        vec![Effect::Complete {
+            request: 2,
+            result: Ok(Route::Local)
+        }]
+    );
+    assert!(!state.request_inactive(1));
+    assert!(!state.request_inactive(2));
+    assert_eq!(state.cell_generation(&id), Some(1));
+    on_event(&mut state, Event::ActivityFinished { request: 2 });
+    assert!(state.request_inactive(2));
+    assert!(!state.request_inactive(1));
+    state.validate().unwrap();
+}
