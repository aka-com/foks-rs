+    let op = operation(&effects, |e| {
+        if let Effect::ReadSelfNodeLease { op } = e {
+            Some(*op)
+        } else {
+            None
+        }
+    });
+    let effects = on_event(
+        &mut state,
+        Event::SelfNodeLeaseRead {
+            op,
+            now_ms: 100,
+            now_mono_ms: 100,
+            result: Ok(None),
