+    let (factory, process) = fixture_factory();
+    assert!(matches!(
+        factory.try_owner(OwnerRole::Process, None),
+        Err(Refusal::Busy)
+    ));
+    let first = child(&factory, OwnerRole::Invocation);
+    let second = child(&factory, OwnerRole::Invocation);
+    let control = child(&factory, OwnerRole::Control);
+    let observed = process.observation().unwrap();
+    assert_eq!(observed.role_counts, [1, 2, 1]);
+    assert_eq!(observed.occupied_owners, 4);
+    assert!(matches!(
+        factory.try_owner(
+            OwnerRole::Invocation,
+            Some(AcceptedStamp::capture().unwrap())
+        ),
+        Err(Refusal::Busy)
+    ));
+    assert!(matches!(
+        factory.try_owner(OwnerRole::Control, Some(AcceptedStamp::capture().unwrap())),
+        Err(Refusal::Busy)
+    ));
+    retire(control);
+    retire(second);
+    retire(first);
+    assert_eq!(process.observation().unwrap().occupied_owners, 1);
+    process.cancel();
+    assert!(matches!(
+        factory.try_owner(OwnerRole::Control, Some(AcceptedStamp::capture().unwrap())),
+        Err(Refusal::Cancelled)
+    ));
+    retire_factory(factory, process);
+
+    let (factory, process) = fixture_factory();
+    let existing = child(&factory, OwnerRole::Invocation);
+    let existing_request = component::request(&existing);
+    let (ready_tx, ready_rx) = std::sync::mpsc::sync_channel(1);
+    let (resume_tx, resume_rx) = std::sync::mpsc::sync_channel(1);
+    std::thread::scope(|scope| {
+        let borrowed = &factory;
+        let paused = scope.spawn(move || {
+            component::try_owner_before_commit(borrowed, AcceptedStamp::capture().unwrap(), &|| {
+                ready_tx.try_send(()).unwrap();
+                resume_rx
+                    .recv_timeout(Duration::from_secs(5))
+                    .expect("bounded resume handshake");
+            })
+        });
