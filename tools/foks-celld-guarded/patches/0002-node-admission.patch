+fn deployment(guarded: bool) -> LoadedDeployment {
+    let (script, src, version, prefix) = if guarded {
+        (
+            program::FIXTURE,
+            program::FIXTURE_JS,
+            program::FIXTURE_VERSION,
+            program::FIXTURE_PREFIX,
+        )
+    } else {
+        (
+            program::PRIMARY,
+            program::PRIMARY_JS,
+            program::PRIMARY_VERSION,
+            program::PRIMARY_PREFIX,
+        )
+    };
+    LoadedDeployment {
+        options: crate::js::WorkerConfigOptions {
+            src: src.into(),
+            script_name: script.into(),
+            node: "b1-node".into(),
+            do_classes: if guarded {
+                vec![program::CLASS.into()]
+            } else {
+                vec![]
+            },
+            bindings: if guarded {
+                vec![("OBJECTS".into(), program::CLASS.into())]
+            } else {
+                vec![]
+            },
+            r2_bindings: vec![],
+            d1_bindings: vec![],
+            kv_bindings: vec![],
+            queue_bindings: vec![],
+            queue_consumers: vec![],
+            workflow_bindings: vec![],
+            vars: vec![],
+            modules: vec![],
+            compat: crate::js::Compat {
+                delete_all_deletes_alarm: false,
+                js_rpc: false,
+                fetcher_get_put_delete: false,
+                sqlite_vec: false,
+                websocket_standard_binary_type: false,
+                queue_json_messages: true,
+            },
+        },
+        script_name: script.into(),
+        version: version.into(),
+        prefix: prefix.into(),
+        asset_binding: None,
+        loader_bindings: vec![],
+        assets: None,
+        services: if guarded {
+            vec![]
+        } else {
+            vec![("GUARDED".into(), program::FIXTURE.into(), None)]
+        },
+        crons: vec![],
+        containers: vec![],
+        fence_image: None,
+    }
+}
+
+fn graph() -> DeploymentGraph {
+    DeploymentGraph {
+        primary: deployment(false),
+        cohosted: vec![deployment(true)],
+    }
+}
