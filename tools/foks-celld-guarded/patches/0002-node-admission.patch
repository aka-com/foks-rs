+#[test]
+fn b1_inactive_observation_is_not_processed_finish() {
+    let (mut state, id, epoch) = resident();
+    assert!(state.request_inactive(999)); // unknown is not a processed acknowledgement
+    on_event(
+        &mut state,
+        Event::Request {
+            request: 2,
+            cell: id.clone(),
+        },
+    );
+    let proof = hold_output(&mut state, 1, epoch);
+    on_event(
+        &mut state,
+        Event::Output {
+            request: 2,
+            channel: Channel::Response,
+            position: None,
+            observed: Some(1),
+            epoch: Some(epoch),
+        },
+    );
+    for request in [1, 2] {
+        on_event(&mut state, Event::ActivityFinished { request });
+        assert!(
+            !state.request_inactive(request),
+            "held owner/follower is still pinned"
+        );
+    }
+    let effects = on_event(
+        &mut state,
+        Event::DurableReached {
+            op: proof,
+            result: Ok(1),
+            source: celld_logic::ProofSource::Fleet,
+        },
+    );
+    for request in [1, 2] {
+        assert!(effects.contains(&Effect::Release {
+            request,
+            channel: Channel::Response,
+            result: Ok(())
+        }));
+        assert!(state.request_inactive(request));
+    }
+    on_event(
+        &mut state,
+        Event::Request {
+            request: 99,
+            cell: "pending".into(),
+        },
+    );
+    assert!(!state.request_inactive(99));
+    on_event(&mut state, Event::Cancel { request: 99 });
+    assert!(state.request_inactive(99));
+    state.validate().unwrap();
+}
