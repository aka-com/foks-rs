+pub(crate) struct ValidatedGraph {
+    node_sha256: [u8; 32],
+    descriptor_sha256: [u8; 32],
+}
+
+impl DescriptorPolicy {
+    fn new() -> Self {
+        Self {
+            program: program::identities(),
+        }
+    }
+
+    pub(crate) fn is_guarded_scope(scope: &str) -> bool {
+        scope == program::CLASS
+            || scope
+                .strip_prefix(program::CLASS)
+                .is_some_and(|suffix| suffix.starts_with(':'))
+    }
+
+    pub(crate) fn is_guarded_script(script: &str) -> bool {
+        script == program::FIXTURE
+    }
+
+    pub(crate) fn validate_graph(
+        &self,
+        graph: &DeploymentGraph,
+        expected_node: &str,
+    ) -> Result<ValidatedGraph, Refusal> {
+        if expected_node.is_empty() || expected_node.len() > 256 || graph.cohosted.len() != 1 {
+            return Err(Refusal::Invalid);
+        }
+        validate_loaded(&graph.primary, ScriptClass::OrdinaryPrimary, expected_node)?;
+        validate_loaded(&graph.cohosted[0], ScriptClass::Guarded, expected_node)?;
+        let node_sha256 = Sha256::digest(expected_node.as_bytes()).into();
+        let mut digest = Sha256::new();
+        digest.update(b"foks-celld-node-descriptor-b1\0");
+        for (hash, bytes) in self.program {
+            digest.update(hash);
+            digest.update((bytes as u64).to_le_bytes());
+        }
+        digest.update(node_sha256);
+        digest.update(program::PRIMARY_PREFIX.as_bytes());
+        digest.update(program::FIXTURE_PREFIX.as_bytes());
+        for tenant in program::TENANT_IDS {
+            digest.update(tenant.as_bytes());
+        }
+        Ok(ValidatedGraph {
+            node_sha256,
+            descriptor_sha256: digest.finalize().into(),
+        })
+    }
+}
+
+impl ValidatedGraph {
+    pub(crate) fn check_node(&self, node: &str) -> Result<(), Refusal> {
+        if node.is_empty()
+            || node.len() > 256
+            || <[u8; 32]>::from(Sha256::digest(node.as_bytes())) != self.node_sha256
+        {
+            return Err(Refusal::Invalid);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn classify(
+        &self,
+        index: usize,
+        loaded: &LoadedDeployment,
+    ) -> Result<ScriptClass, Refusal> {
+        self.check_node(&loaded.options.node)?;
+        let class = program::class_for(index)?;
+        validate_loaded(loaded, class, &loaded.options.node)?;
+        Ok(class)
+    }
+
+    pub(crate) fn digest(&self) -> [u8; 32] {
+        self.descriptor_sha256
+    }
+}
+
+fn validate_loaded(
+    loaded: &LoadedDeployment,
+    class: ScriptClass,
+    node: &str,
+) -> Result<(), Refusal> {
+    let guarded = class == ScriptClass::Guarded;
+    let (script, source, version, prefix) = if guarded {
+        (
+            program::FIXTURE,
+            program::FIXTURE_JS,
+            program::FIXTURE_VERSION,
+            program::FIXTURE_PREFIX,
+        )
+    } else {
+        (
+            program::PRIMARY,
+            program::PRIMARY_JS,
+            program::PRIMARY_VERSION,
+            program::PRIMARY_PREFIX,
+        )
+    };
+    let options = &loaded.options;
+    if loaded.script_name != script
+        || options.script_name != script
+        || options.src != source
+        || loaded.version != version
+        || loaded.prefix != prefix
+        || options.node != node
+        || !program::compat_matches(options.compat)
+        || !options.modules.is_empty()
+        || !options.r2_bindings.is_empty()
+        || !options.d1_bindings.is_empty()
+        || !options.kv_bindings.is_empty()
+        || !options.queue_bindings.is_empty()
+        || !options.queue_consumers.is_empty()
+        || !options.workflow_bindings.is_empty()
+        || !options.vars.is_empty()
+        || loaded.asset_binding.is_some()
+        || !loaded.loader_bindings.is_empty()
+        || loaded.assets.is_some()
+        || !loaded.crons.is_empty()
+        || !loaded.containers.is_empty()
+        || loaded.fence_image.is_some()
+    {
+        return Err(Refusal::Invalid);
+    }
+    if guarded {
+        if options.do_classes.as_slice() != [program::CLASS]
+            || options.bindings.len() != 1
+            || options.bindings[0].0 != "OBJECTS"
+            || options.bindings[0].1 != program::CLASS
+            || !loaded.services.is_empty()
+        {
+            return Err(Refusal::Invalid);
+        }
+    } else if !options.do_classes.is_empty()
+        || !options.bindings.is_empty()
+        || loaded.services.len() != 1
+        || loaded.services[0].0 != "GUARDED"
+        || loaded.services[0].1 != program::FIXTURE
+        || loaded.services[0].2.is_some()
+    {
+        return Err(Refusal::Invalid);
+    }
+    Ok(())
+}
