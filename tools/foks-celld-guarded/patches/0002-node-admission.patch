+            7 => {
+                on_event(&mut state, Event::NodeFenced);
+            }
+            8 => {
+                on_event(&mut state, Event::ReleaseAll);
+            }
+            9 => {
+                on_event(
+                    &mut state,
+                    Event::GenerationChanged {
