+    role: OwnerRole,
+    stamp: Option<AcceptedStamp>,
+    deadline: Option<Instant>,
+    debt: AtomicUsize,
+    cancelled: AtomicBool,
+    cleanup: Mutex<CleanupCredits>,
+    // Same real process Request, not a fresh allowance or registry back edge.
+    process_request: Option<Arc<Request>>,
+    request: Arc<Request>,
