+pub(crate) struct GuardedConfigMarker {
+    class: ScriptClass,
+    _descriptor_sha256: [u8; 32],
+}
+
+pub(crate) fn mark_validated(
+    mut config: WorkerConfig,
+    validated: &ValidatedGraph,
+) -> std::result::Result<WorkerConfig, Refusal> {
+    validated.check_node(&config.node)?;
+    let class = validate_config_projection(&config)?;
+    config.guarded_node = Some(GuardedConfigMarker {
+        class,
+        _descriptor_sha256: validated.digest(),
+    });
+    Ok(config)
+}
+
+// WorkerConfig builders consume and return their value. Rechecking this
+// borrowed projection at ordinary load prevents a retained private marker from
+// authorizing capabilities added by a later with_* builder.
+fn validate_config_projection(config: &WorkerConfig) -> std::result::Result<ScriptClass, Refusal> {
+    let guarded = config.script_name == FIXTURE;
+    let source = if guarded { FIXTURE_JS } else { PRIMARY_JS };
+    if (!guarded && config.script_name != PRIMARY)
+        || config.src != source
+        || config.origin != WorkerOrigin::Deployment
+        || !compat_matches(config.compat)
+        || !config.modules.is_empty()
+        || !config.r2_bindings.is_empty()
+        || !config.d1_bindings.is_empty()
+        || !config.kv_bindings.is_empty()
+        || !config.queue_bindings.is_empty()
+        || !config.queue_consumers.is_empty()
+        || !config.workflow_bindings.is_empty()
+        || !config.vars.is_empty()
+        || config.asset_binding.is_some()
+        || !config.loader_bindings.is_empty()
+        || config.loader_env.is_some()
+        || config.resource_limits.is_some()
+        || config.tail_reporting
+        || !matches!(&config.egress, EgressPolicy::Allow)
+        || config.main_module_name != ENTRY_MODULE_NAME
+        || config.declares_queue_consumer
+        || !config.crons.is_empty()
+        || !config.containers.is_empty()
+    {
+        return Err(Refusal::Invalid);
+    }
+    if guarded {
+        if config.do_classes.as_slice() != [CLASS]
+            || config.bindings.len() != 1
+            || config.bindings[0].0 != "OBJECTS"
+            || config.bindings[0].1 != CLASS
+            || !config.services.is_empty()
+        {
+            return Err(Refusal::Invalid);
+        }
+    } else if !config.do_classes.is_empty()
+        || !config.bindings.is_empty()
+        || config.services.len() != 1
+        || config.services[0].0 != "GUARDED"
+        || config.services[0].1 != FIXTURE
+        || config.services[0].2.is_some()
+    {
+        return Err(Refusal::Invalid);
+    }
+    Ok(if guarded {
+        ScriptClass::Guarded
+    } else {
+        ScriptClass::OrdinaryPrimary
+    })
+}
+
+pub(crate) fn ordinary_load_allowed(config: &WorkerConfig) -> std::result::Result<(), Refusal> {
+    match &config.guarded_node {
+        Some(marker) if marker.class == ScriptClass::Guarded => return Err(Refusal::NotReady),
+        Some(marker) => {
+            if marker.class != ScriptClass::OrdinaryPrimary
+                || validate_config_projection(config)? != ScriptClass::OrdinaryPrimary
+            {
+                return Err(Refusal::Invalid);
+            }
+        }
+        None if node::policy_installed() => return Err(Refusal::Invalid),
+        None => {}
+    }
+    if let Some(error) = node::ordinary_script_refusal(&config.script_name) {
+        return Err(error);
+    }
+    Ok(())
+}
+
+pub(crate) fn can_warm(config: &WorkerConfig) -> bool {
+    config
+        .guarded_node
+        .as_ref()
+        .is_none_or(|marker| marker.class == ScriptClass::OrdinaryPrimary)
+}
+
+pub(crate) fn class_for(index: usize) -> std::result::Result<ScriptClass, Refusal> {
+    match index {
+        0 => Ok(ScriptClass::OrdinaryPrimary),
+        1 => Ok(ScriptClass::Guarded),
+        _ => Err(Refusal::Invalid),
+    }
+}
+
+pub(crate) fn identities() -> [([u8; 32], usize); 5] {
+    [
+        PRIMARY_JS.as_bytes(),
+        FIXTURE_JS.as_bytes(),
+        WASM,
+        PRIMARY_METADATA.as_bytes(),
+        FIXTURE_METADATA.as_bytes(),
+    ]
+    .map(|bytes| (Sha256::digest(bytes).into(), bytes.len()))
+}
