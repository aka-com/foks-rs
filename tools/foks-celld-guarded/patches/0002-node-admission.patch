+//! Closed foundation. Installation is not readiness or permission to execute.
+use crate::fleet::LoadedDeployment;
+use crate::generation::DeploymentGraph;
+use crate::js::guarded_node as program;
+use sha2::{Digest, Sha256};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc, OnceLock,
+};
+
+#[path = "guarded_node/control.rs"]
+mod control;
+#[cfg(test)]
+#[path = "guarded_node/tests.rs"]
+mod tests;
+
+static INSTALL_STARTED: AtomicBool = AtomicBool::new(false);
+static INSTALLED: OnceLock<Arc<GuardedNode>> = OnceLock::new();
+
+/// Fixed admission reasons. An error grants no owner or runtime capability.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Refusal {
+    Capacity,
+    Busy,
+    Contended,
+    Expired,
+    Cancelled,
+    Failed,
+    Bounds,
+    Invalid,
+    Exhausted,
+    NotReady,
+}
+
+impl std::fmt::Display for Refusal {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            Self::Capacity => "guarded capacity exhausted",
+            Self::Busy => "guarded owner occupied",
+            Self::Contended => "guarded control contended",
+            Self::Expired => "guarded original deadline expired",
+            Self::Cancelled => "guarded operation cancelled",
+            Self::Failed => "guarded original owner failed",
+            Self::Bounds => "guarded bound exceeded",
+            Self::Invalid => "guarded closed profile refused",
+            Self::Exhausted => "guarded counter exhausted",
+            Self::NotReady => "guarded execution is unavailable",
+        })
+    }
+}
+impl std::error::Error for Refusal {}
+
+pub struct GuardedNode {
+    policy: DescriptorPolicy,
+    // Bootstrap-owned pools and the process registry are dropped before owner.
+    factory: control::OwnerFactory,
+    owner: control::OriginalOwner,
+}
+
+impl GuardedNode {
+    /// Once-only foundation installation. No Action, bucket or Ready exists.
+    pub fn install() -> Result<Arc<Self>, Refusal> {
+        if INSTALL_STARTED.swap(true, Ordering::AcqRel) {
+            return Err(Refusal::Busy);
+        }
+        let factory = control::OwnerFactory::new()?;
+        let owner = factory.try_owner(control::OwnerRole::Process, None)?;
+        let admitted = control::arc_bytes::<Self>().and_then(|bytes| owner.charge(bytes));
+        if let Err(error) = admitted {
+            drop(factory);
+            let _held = owner.retire_unstarted();
+            return Err(error);
+        }
+        let node = Arc::new(Self {
+            policy: DescriptorPolicy::new(),
+            factory,
+            owner,
+        });
+        // A failed installation remains a tombstone. An uninstalled policy is
+        // ordinary only when installation has never been attempted.
+        if INSTALLED.set(node.clone()).is_err() {
+            node.stop_admission();
+            return Err(Refusal::Busy);
+        }
+        Ok(node)
+    }
+
+    pub fn stop_admission(&self) {
+        self.owner.fail();
+    }
+
+    /// Scalar observations of native foundation storage, not physical leases.
+    pub fn foundation(&self) -> Result<FoundationObservation, Refusal> {
+        let control = self.owner.observation()?;
+        Ok(FoundationObservation {
+            claim: "b1-foundation-only",
+            layouts: Self::layouts()?,
+            role_caps: control.role_caps,
+            role_counts: control.role_counts,
+            debt: control.debt,
+            occupied_owners: control.occupied_owners,
+            occupied_headers: control.occupied_headers,
+            header_bytes: control.header_bytes,
+            summaries: control.summaries,
+            cleanup_tasks_used: control.cleanup_tasks_used,
+            cleanup_controls_used: control.cleanup_controls_used,
+            original_stamp_present: control.original_stamp_present,
+            program: self.policy.program,
+            tenant_ids: program::TENANT_IDS,
+            // Reading this real factory verifies the observation is attached to
+            // the same bounded process registry, not a separate model counter.
+            factory_installed: self.factory.process_installed(),
+            ready: false,
+        })
+    }
+
+    pub fn layouts() -> Result<FoundationLayouts, Refusal> {
+        let native = control::layouts()?;
+        let node_arc_bytes = control::arc_bytes::<Self>()?;
+        if native
+            .iter()
+            .any(|(size, align)| *size > 64 * 1024 || *align > 16)
+            || node_arc_bytes > 64 * 1024
+        {
+            return Err(Refusal::Bounds);
+        }
+        Ok(FoundationLayouts {
+            native,
+            node_arc_bytes,
+            cleanup_reserve: control::CLEANUP_BYTES,
+            weak_limit: control::SUMMARY_LIMIT + 2,
+        })
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct FoundationLayouts {
+    /// Request Arc, control Arc, registry Arc, factory, owner, header, cleanup,
+    /// observation. Nested/stack sizes are nonadditive observations.
+    pub native: [(usize, usize); 8],
+    pub node_arc_bytes: usize,
+    pub cleanup_reserve: usize,
+    pub weak_limit: usize,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct FoundationObservation {
+    pub claim: &'static str,
+    pub layouts: FoundationLayouts,
+    pub role_caps: [usize; 3],
+    pub role_counts: [usize; 3],
+    pub debt: usize,
+    pub occupied_owners: usize,
+    pub occupied_headers: usize,
+    pub header_bytes: usize,
+    pub summaries: usize,
+    pub cleanup_tasks_used: u32,
+    pub cleanup_controls_used: u32,
+    pub original_stamp_present: bool,
+    pub program: [([u8; 32], usize); 5],
+    pub tenant_ids: [&'static str; 3],
+    pub factory_installed: bool,
