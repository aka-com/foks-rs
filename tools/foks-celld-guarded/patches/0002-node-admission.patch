+                on_event(&mut state, Event::ActivityFinished { request: 1 });
+                assert!(
+                    !state.request_inactive(1),
+                    "processed finish retains the output pin"
+                );
+            }
+            _ => unreachable!(),
+        }
+        let before = state.phase(&id).cloned();
+        assert_refused(
+            &resident_gate(&mut state, 2, parent, &target, target_epoch, generation, 10),
+            2,
