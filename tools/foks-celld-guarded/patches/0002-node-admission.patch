+#[test]
+fn b1_owner_construction_and_payload_drop_order() {
+    struct Payload {
+        request: std::sync::Weak<foks_hosted_transport::memory::Request>,
+        dropped: Arc<AtomicBool>,
+    }
+    impl Drop for Payload {
+        fn drop(&mut self) {
+            assert!(
+                self.request.upgrade().is_some(),
+                "payload outlived its original Request"
+            );
+            self.dropped.store(true, Ordering::Release);
+        }
+    }
+    let (factory, process) = fixture_factory();
+    let invocation = child(&factory, OwnerRole::Invocation);
+    invocation.charge(std::mem::size_of::<Payload>()).unwrap();
+    let request = component::request(&invocation);
+    let weak = Arc::downgrade(&request);
+    let dropped = Arc::new(AtomicBool::new(false));
+    let payload = Box::new(Payload {
+        request: weak.clone(),
+        dropped: dropped.clone(),
+    });
+    drop(request);
+    drop(payload);
+    assert!(dropped.load(Ordering::Acquire));
+    assert!(weak.upgrade().is_some());
+    retire(invocation);
+    assert!(weak.upgrade().is_none());
+    let replacement = child(&factory, OwnerRole::Invocation);
+    retire(replacement);
+    // An owned, unstarted payload unwinds before the private retirement call.
+    // This fixture proves foundation Request ordering, not Worker disposal.
+    struct Prepared {
+        payload: Option<Box<Payload>>,
+        owner: Option<OriginalOwner>,
+    }
+    impl Drop for Prepared {
+        fn drop(&mut self) {
+            drop(self.payload.take());
+            retire(self.owner.take().expect("unstarted original owner"));
+        }
+    }
+    let invocation = child(&factory, OwnerRole::Invocation);
+    invocation.charge(std::mem::size_of::<Payload>()).unwrap();
+    let unwind_weak = Arc::downgrade(&component::request(&invocation));
+    let unwind_dropped = Arc::new(AtomicBool::new(false));
+    let prepared = Prepared {
+        payload: Some(Box::new(Payload {
+            request: unwind_weak.clone(),
+            dropped: unwind_dropped.clone(),
+        })),
+        owner: Some(invocation),
+    };
+    let panicked = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || {
+        let _unstarted = prepared;
+        panic!("deliberate unstarted fixture unwind");
+    }));
+    assert!(panicked.is_err());
+    assert!(unwind_dropped.load(Ordering::Acquire));
+    assert!(unwind_weak.upgrade().is_none());
+    assert_eq!(
+        component::role_available(&factory, OwnerRole::Invocation),
+        2
+    );
+    assert!(matches!(
+        factory.try_owner(OwnerRole::Process, Some(AcceptedStamp::capture().unwrap())),
+        Err(Refusal::Invalid)
+    ));
+    let process_weak = Arc::downgrade(&component::request(&process));
+    retire_factory(factory, process);
+    assert!(
+        process_weak.upgrade().is_none(),
+        "local fixture leaked a process-reference cycle"
+    );
+
+    // Saturate actual A0 primary permits before child construction. Refusal
+    // returns its role permit and publishes neither Control nor a Weak/cell.
+    let (factory, process) = fixture_factory();
+    let request = component::request(&process);
+    assert!(request.reserve_retained(48 * control::MIB - component::debt(&process)));
+    assert!(matches!(
+        factory.try_owner(
+            OwnerRole::Invocation,
+            Some(AcceptedStamp::capture().unwrap())
+        ),
+        Err(Refusal::Capacity)
+    ));
+    assert_eq!(
+        component::role_available(&factory, OwnerRole::Invocation),
+        2
+    );
+    assert_eq!(process.observation().unwrap().summaries, 0);
+    assert_eq!(process.observation().unwrap().occupied_owners, 1);
+    drop(request);
+    retire_factory(factory, process);
+}
