+fn operation(effects: &[Effect], select: fn(&Effect) -> Option<u64>) -> u64 {
+    effects
+        .iter()
+        .find_map(select)
+        .expect("expected exact core effect")
+}
+
+fn activate(state: &mut State, id: &str, request: u64, generation: u64) -> u64 {
+    let effects = on_event(
+        state,
+        Event::Request {
+            request,
+            cell: id.into(),
+        },
+    );
+    let op = operation(&effects, |e| {
+        if let Effect::ReadOwner { op, .. } = e {
+            Some(*op)
+        } else {
+            None
+        }
+    });
+    let effects = on_event(
+        state,
+        Event::OwnerRead {
+            op,
+            now_ms: 0,
+            result: Ok(None),
+        },
+    );
+    let op = operation(&effects, |e| {
+        if let Effect::CasOwner { op, .. } = e {
+            Some(*op)
+        } else {
+            None
+        }
+    });
+    let effects = on_event(
+        state,
+        Event::OwnerCasCompleted {
+            op,
+            result: Ok(CasOutcome::Applied),
+        },
+    );
+    let op = operation(&effects, |e| {
+        if let Effect::Restore { op, .. } = e {
+            Some(*op)
+        } else {
+            None
+        }
+    });
+    let effects = on_event(
+        state,
+        Event::RestoreCompleted {
+            op,
+            result: Ok(celld_logic::RestoreOutcome {
+                restored: false,
+                alarm: None,
+            }),
+        },
+    );
+    let op = operation(&effects, |e| {
+        if let Effect::StartRuntime { op, .. } = e {
+            Some(*op)
+        } else {
+            None
+        }
+    });
+    let effects = on_event(
+        state,
+        Event::RuntimeStarted {
+            op,
+            isolate: Some(celld_logic::isolate::HeapId::new(request)),
+            generation,
+            result: Ok(()),
+        },
+    );
+    let op = operation(&effects, |e| {
+        if let Effect::Publish { op, .. } = e {
+            Some(*op)
+        } else {
+            None
+        }
+    });
+    let effects = on_event(state, Event::Published { op, result: Ok(()) });
+    assert!(effects.contains(&Effect::Complete {
+        request,
+        result: Ok(Route::Local)
+    }));
+    assert!(!state.request_inactive(request));
+    state.validate().unwrap();
+    match state.phase(id).unwrap() {
+        Phase::Resident { epoch } => *epoch,
+        phase => panic!("unexpected {phase:?}"),
+    }
+}
+
+fn resident() -> (State, String, u64) {
+    let mut state = State::new("node", model_config(false));
+    on_event(
+        &mut state,
+        Event::GenerationChanged {
+            generation: 1,
+            now_mono_ms: 0,
+            max_age_ms: 1_000,
+            eager_classes: vec![],
+        },
+    );
+    let id = format!("{}:{}", program::CLASS, program::TENANT_IDS[0]);
+    let epoch = activate(&mut state, &id, 1, 1);
+    (state, id, epoch)
+}
+
+fn resident_gate(
+    state: &mut State,
+    request: u64,
+    parent: u64,
+    cell: &str,
+    epoch: u64,
+    generation: u64,
+    now: u64,
+) -> Vec<Effect> {
+    on_event(
+        state,
+        Event::ResidentGateRequestAt {
+            request,
+            parent,
+            cell: cell.into(),
+            epoch,
+            generation,
+            now_mono_ms: now,
+        },
+    )
+}
+
+fn assert_refused(effects: &[Effect], request: u64) {
+    assert!(
+        matches!(effects, [Effect::Complete { request:actual,result:Err(RequestError::NodeUnavailable | RequestError::NodeFenced) }] if *actual==request)
+    );
+}
+
+fn hold_output(state: &mut State, request: u64, epoch: u64) -> u64 {
+    let effects = on_event(
+        state,
+        Event::Output {
+            request,
+            channel: Channel::Response,
+            position: Some(1),
+            observed: None,
+            epoch: Some(epoch),
+        },
+    );
+    operation(&effects, |effect| {
+        if let Effect::AwaitDurable { op, .. } = effect {
+            Some(*op)
+        } else {
+            None
+        }
+    })
+}
