+#[test]
+fn b1_descriptor_accepts_exact_projection() {
+    let policy = DescriptorPolicy::new();
+    let graph = graph();
+    let validated = policy.validate_graph(&graph, "b1-node").unwrap();
+    assert_eq!(
+        validated.classify(0, &graph.primary).unwrap(),
+        ScriptClass::OrdinaryPrimary
+    );
+    assert_eq!(
+        validated.classify(1, &graph.cohosted[0]).unwrap(),
+        ScriptClass::Guarded
+    );
+    assert!(validated.classify(2, &graph.cohosted[0]).is_err());
+    assert!(validated.check_node("another-node").is_err());
+    assert_ne!(validated.digest(), [0; 32]);
+    let primary = program::mark_validated(config(deployment(false)), &validated).unwrap();
+    let fixture = program::mark_validated(config(deployment(true)), &validated).unwrap();
+    assert!(program::can_warm(&primary));
+    assert!(!program::can_warm(&fixture));
+    for (source, metadata, version) in [
+        (
+            program::PRIMARY_JS,
+            program::PRIMARY_METADATA,
+            program::PRIMARY_VERSION,
+        ),
+        (
+            program::FIXTURE_JS,
+            program::FIXTURE_METADATA,
+            program::FIXTURE_VERSION,
+        ),
+    ] {
+        let mut hash = Sha256::new();
+        hash.update(b"index.js\0");
+        hash.update(source.as_bytes());
+        hash.update(metadata.as_bytes());
+        let hex = format!("{:x}", hash.finalize());
+        assert_eq!(&hex[..16], version);
+    }
+    assert_eq!(program::TENANT_IDS.map(str::len), [64; 3]);
+    assert!(program::TENANT_IDS.iter().all(|id| id
+        .bytes()
+        .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())));
+}
