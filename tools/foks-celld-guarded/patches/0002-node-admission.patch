+            if Arc::strong_count(&self.registry) != 1 {
+                return Err(HeldOwner::owner(self));
+            }
+            return self.retire_process();
+        };
+        let registry = self.registry.clone();
+        let mut state = match registry.state.try_lock() {
+            Ok(state) => state,
+            Err(_) => return Err(HeldOwner::owner(self)),
+        };
+        let cell = &state.cells[slot];
+        if cell.generation != self.generation
+            || cell
+                .request
+                .as_ref()
+                .is_none_or(|held| !Arc::ptr_eq(held, &self.control.request))
+        {
+            self.fail();
+            return Err(HeldOwner::owner(self));
+        }
+        let Self {
+            control,
+            registry: original_registry,
+            ..
+        } = self;
+        let control = match Arc::try_unwrap(control) {
+            Ok(control) => control,
+            Err(control) => {
+                return Err(HeldOwner::owner(Self {
+                    control,
+                    registry: original_registry,
+                    slot: Some(slot),
+                    generation: cell.generation,
+                }))
+            }
+        };
+        // All control/credit payloads die before attempting the final Request.
+        drop(control);
+        let held = state.cells[slot]
+            .request
+            .take()
+            .expect("validated owner cell");
+        match Arc::try_unwrap(held) {
+            Ok(request) => {
+                drop(request); // actual Request and role permit, while guarded
+                drop(state);
+                drop(original_registry);
+                Ok(())
+            }
+            Err(held) => {
+                state.cells[slot].request = Some(held);
+                drop(state);
+                Err(HeldOwner {
+                    _owner: None,
+                    _registry: Some(original_registry),
+                    _request: None,
+                })
+            }
+        }
+    }
+
+    fn retire_process(self) -> Result<(), HeldOwner> {
+        let Self {
+            control, registry, ..
+        } = self;
+        let registry = match Arc::try_unwrap(registry) {
+            Ok(registry) => registry,
+            Err(registry) => {
+                return Err(HeldOwner::owner(Self {
+                    control,
+                    registry,
+                    slot: None,
+                    generation: 1,
+                }))
+            }
+        };
+        let mut state = match registry.state.try_lock() {
+            Ok(state) => state,
+            Err(_) => {
+                return Err(HeldOwner {
+                    _owner: None,
+                    _registry: None,
+                    _request: Some(control.request.clone()),
+                })
+            }
+        };
+        if state.cells.iter().any(|cell| cell.request.is_some())
+            || state
+                .headers
+                .iter()
+                .any(|cell| cell.stamp.is_some() || cell._socket.is_some())
+        {
+            return Err(HeldOwner {
+                _owner: None,
+                _registry: None,
+                _request: Some(control.request.clone()),
+            });
+        }
+        // The unique registry allocation is already gone; dispose its concrete
+        // witnesses and controls before the final process Request, under lock.
+        state.summaries = std::array::from_fn(|_| None);
+        state.control_witness = None;
+        state.process_witness = None;
+        drop(control);
+        let held = state.process.take().expect("unique process owner");
+        match Arc::try_unwrap(held) {
+            Ok(request) => {
+                drop(request);
+                Ok(())
+            }
+            Err(request) => Err(HeldOwner {
+                _owner: None,
+                _registry: None,
+                _request: Some(request),
+            }),
+        }
+    }
+
+    pub(super) fn observation(&self) -> Result<ControlObservation, Refusal> {
+        let state = self
+            .registry
+            .state
+            .try_lock()
+            .map_err(|_| Refusal::Contended)?;
+        let cleanup = self
+            .control
+            .cleanup
+            .try_lock()
+            .map_err(|_| Refusal::Contended)?;
+        Ok(ControlObservation {
+            role_caps: ROLES.map(|(role, _)| role.cap()),
+            role_counts: ROLES.map(|(_, count)| count),
+            debt: self.control.debt.load(Ordering::Acquire),
+            occupied_owners: usize::from(state.process.is_some())
+                + state
+                    .cells
+                    .iter()
+                    .filter(|cell| cell.request.is_some())
+                    .count(),
+            occupied_headers: state
+                .headers
+                .iter()
+                .filter(|cell| cell.stamp.is_some())
+                .count(),
+            header_bytes: state.headers.iter().map(|cell| cell.bytes.len()).sum(),
+            summaries: state.summary_count,
+            cleanup_tasks_used: cleanup.used_tasks.count_ones(),
+            cleanup_controls_used: cleanup.used_controls.count_ones(),
+            original_stamp_present: self.control.stamp.is_some(),
+        })
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct ControlObservation {
+    pub role_caps: [usize; 3],
+    pub role_counts: [usize; 3],
+    pub debt: usize,
+    pub occupied_owners: usize,
+    pub occupied_headers: usize,
+    pub header_bytes: usize,
+    pub summaries: usize,
+    pub cleanup_tasks_used: u32,
+    pub cleanup_controls_used: u32,
+    pub original_stamp_present: bool,
+}
+
+pub(super) fn layouts() -> Result<[(usize, usize); 8], Refusal> {
+    Ok([
+        (request_bytes()?, align_of::<ArcAllocation<Request>>()),
+        (
+            arc_bytes::<Control>()?,
+            align_of::<ArcAllocation<Control>>(),
+        ),
+        (
+            arc_bytes::<Registry>()?,
+            align_of::<ArcAllocation<Registry>>(),
+        ),
+        (size_of::<OwnerFactory>(), align_of::<OwnerFactory>()),
+        (size_of::<OriginalOwner>(), align_of::<OriginalOwner>()),
+        (size_of::<HeaderCell>(), align_of::<HeaderCell>()),
+        (size_of::<CleanupCredits>(), align_of::<CleanupCredits>()),
+        (
+            size_of::<ControlObservation>(),
+            align_of::<ControlObservation>(),
+        ),
+    ])
+}
