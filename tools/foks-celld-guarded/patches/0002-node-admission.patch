+fn b1_generic_refusal_inventory() {
+    installed();
+    for generation in [1, 2] {
+        let mut invalid = graph();
+        invalid.cohosted[0].crons.push("* * * * *".into());
+        let result = crate::generation::Generation::build(
+            generation,
+            invalid,
+            crate::generation::GenerationOptions {
+                node: "b1-node".into(),
+                region: "test".into(),
+            },
+        );
+        assert_eq!(
+            result
+                .err()
+                .expect("pre-engine projection refusal")
+                .downcast_ref::<Refusal>(),
+            Some(&Refusal::Invalid)
+        );
+    }
+    let validated = preflight(&graph(), "b1-node").unwrap().unwrap();
+    let primary = program::mark_validated(config(deployment(false)), &validated).unwrap();
+    assert!(program::ordinary_load_allowed(&primary).is_ok());
+    assert_eq!(
+        program::ordinary_load_allowed(&config(deployment(false))),
+        Err(Refusal::Invalid)
+    );
+    for scope in [
+        program::CLASS.to_string(),
+        format!("{}:{}", program::CLASS, program::TENANT_IDS[0]),
+        format!("{}:unknown", program::CLASS),
+        format!("{}:{}:facet", program::CLASS, program::TENANT_IDS[1]),
+        "Other:cell".into(),
+    ] {
+        assert!(ordinary_scope_refusal(&scope).is_some());
+    }
+    assert_eq!(
+        ordinary_script_refusal(program::FIXTURE),
+        Some(Refusal::NotReady)
+    );
+    assert_eq!(ordinary_script_refusal("unknown"), Some(Refusal::Invalid));
+    assert_eq!(ordinary_script_refusal(program::PRIMARY), None);
+    // These are source-bound coverage assertions, not an imitation runtime or
+    // an assertion that a predicate test exercised every real frontend.
+    fn entry_body<'a>(source: &'a str, method: &str) -> &'a str {
+        let signature = format!("fn {method}");
+        let start = source
+            .match_indices(&signature)
+            .find(|(offset, _)| {
+                matches!(
+                    source.as_bytes().get(*offset + signature.len()).copied(),
+                    Some(b'(' | b'<')
+                )
+            })
+            .map(|(offset, _)| offset)
+            .expect("exact method identifier");
+        let tail = &source[start..];
+        &tail[tail.find('{').expect("method body") + 1..]
+    }
+    assert!(
+        entry_body("fn rpc_service() { script } fn rpc() { cell }", "rpc").starts_with(" cell")
+    );
+    assert!(entry_body(
+        "fn cell_eventual() { other } fn cell_event<T>() { event }",
+        "cell_event"
+    )
+    .starts_with(" event"));
+    let source = include_str!("../runtime.rs");
+    for method in [
+        "fetch_worker_on_cell",
+        "restore_cell",
+        "start_cell",
+        "publish_cell",
+        "fetch_cell",
+        "fire_alarm",
+        "ws_open",
+        "rpc",
+        "ws_message",
+        "ws_closed",
+        "cell_isolate",
+        "admit_cell_request",
+        "cell_event",
+    ] {
+        let body = entry_body(source, method);
+        let guard = body.find("refuse_ordinary_cell").unwrap();
+        assert!(guard < 120, "entry refusal is not first: {method}");
+    }
+    for method in [
+        "facet_ws_open",
+        "facet_ws_message",
+        "facet_ws_closed",
+        "facet_event",
+    ] {
+        let body = entry_body(source, method);
+        let scope_guard = if method == "facet_event" {
+            "refuse_ordinary_cell(scope)"
+        } else {
+            "refuse_ordinary_cell(&scope)"
+        };
+        assert!(body.find(scope_guard).unwrap() < 120);
+        assert!(body.find("refuse_ordinary_cell(&facet.root)").unwrap() < 220);
+    }
+    for (method, guard) in [
+        ("fetch_service", "refuse_ordinary_script(&call.script)"),
+        ("rpc_service", "refuse_ordinary_script(script)"),
+        ("queue_service", "refuse_ordinary_script(script)"),
+    ] {
+        let body = entry_body(source, method);
+        assert!(body.find(guard).unwrap() < 120);
+    }
+    // This helper steps the real actor with no host and never drains queued
+    // futures. Its final scan-refusal checks irreversibly fail this installation;
+    // no other test requires a healthy process-global policy.
+    crate::actor::assert_guarded_refusal_inventory_for_test();
+    assert!(preflight(&graph(), "b1-node").is_err());
+    assert!(installed()
+        .factory
+        .try_owner(OwnerRole::Control, Some(AcceptedStamp::capture().unwrap()))
+        .is_err());
+}
