+pub struct GuardedBucket {
+    bucket: crate::bucket::Bucket,
+}
+async fn check_bucket_contract(bucket: &crate::bucket::Bucket) -> Result<(), Refusal> {
+    if bucket.backend != crate::bucket::StorageBackend::S3 {
+        return Err(Refusal::Invalid);
+    }
+    match bucket.probe_startup_storage_steps().await {
+        Ok(crate::bucket::StorageProbeVerdict::Conformant) => Ok(()),
+        Ok(crate::bucket::StorageProbeVerdict::Violation(_)) => Err(Refusal::Invalid),
+        Err(_) => Err(Refusal::Failed),
+    }
+}
