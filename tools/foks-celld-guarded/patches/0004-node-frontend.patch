+fn b3_header_eof_and_original_deadline() {
+    crate::actor::guarded_test_runtime().block_on(async {
+        use tokio::io::AsyncWriteExt as _;
+        let (mut peer, mut server) = tokio::io::duplex(32);
+        peer.write_all(&b3_header(1, 2, 0)).await.unwrap();
+        let stamp = AcceptedStamp::capture().unwrap();
+        let mut bytes = [0; 17];
+        let mut read = Box::pin(read_frontend_header(
+            &mut server,
+            &mut bytes,
+            stamp.deadline(),
+            GuardedNodeScenario::ColdSyncRetire,
+        ));
+        assert!(
+            futures_util::poll!(&mut read).is_pending(),
+            "exact16 bytes require actual peer EOF"
+        );
+        peer.shutdown().await.unwrap();
+        assert_eq!(read.await, Ok(FrontendCommand::Begin { tenant: 2 }));
+        drop(server);
+        drop(peer);
+        let (mut peer, mut server) = tokio::io::duplex(32);
+        let mut long = b3_header(1, 0, 0).to_vec();
+        long.push(0);
+        peer.write_all(&long).await.unwrap();
+        assert_eq!(
+            read_frontend_header(
+                &mut server,
+                &mut [0; 17],
+                stamp.deadline(),
+                GuardedNodeScenario::ColdSyncRetire
+            )
+            .await,
+            Err(Refusal::Invalid)
+        );
+        drop(server);
+        drop(peer);
+        let expired = AcceptedStamp::at(Instant::now() - Duration::from_secs(16)).unwrap();
+        let (_peer, mut server) = tokio::io::duplex(32);
+        assert_eq!(
+            read_frontend_header(
+                &mut server,
+                &mut [0; 17],
+                expired.deadline(),
+                GuardedNodeScenario::ColdSyncRetire
+            )
+            .await,
+            Err(Refusal::Expired)
+        );
+        let dropped = Arc::new(AtomicBool::new(false));
+        struct Payload(Arc<AtomicBool>);
+        impl Drop for Payload {
+            fn drop(&mut self) {
+                self.0.store(true, Ordering::Release);
+            }
+        }
+        let payload = Payload(dropped.clone());
+        let result = original_timeout(expired.deadline(), async move {
+            let _payload = payload;
+            std::future::pending::<()>().await
+        })
+        .await;
+        assert!(result.is_err() && dropped.load(Ordering::Acquire));
+    });
