+pub(crate) struct RetirementObservation {
+    registry: Arc<OwnedEffectRegistry>,
+    slot: usize,
+    sequence: u64,
+}
+impl Future for RetirementObservation {
+    type Output = Result<(), Refusal>;
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let incoming = cx.waker().clone();
+        let mut deferred = DeferredWaker(None);
+        let mut bank = match poll_owned(&self.registry.bank, cx) {
+            Poll::Ready(Ok(bank)) => bank,
+            Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+            Poll::Pending => return Poll::Pending,
+        };
+        if bank.retired[self.slot] >= self.sequence {
+            return Poll::Ready(Ok(()));
+        }
+        let exact = bank.records[self.slot]
+            .as_ref()
+            .is_some_and(|record| record.sequence == self.sequence)
+            || bank.held[self.slot]
+                .as_ref()
+                .is_some_and(|held| held.sequence == self.sequence);
+        if !exact {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        if bank.held[self.slot]
+            .as_ref()
+            .is_some_and(|held| held.phase == HeldPhase::Failed)
+        {
+            return Poll::Ready(Err(Refusal::Failed));
+        }
+        deferred.0 = bank.retirement_wakers[self.slot].replace(incoming);
+        drop(bank);
+        Poll::Pending
+    }
+}
