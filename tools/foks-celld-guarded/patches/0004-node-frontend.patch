+fn b3_gate_dispatch_disposal_fence() {
+    crate::actor::guarded_test_runtime().block_on(async {
+        let mut fixture = b2_fixture();
+        let (_core, permit, driver) = b2_core(&mut fixture);
+        let mut origin = b2_sync_origin(&driver, b2_ticket(driver.epoch().unwrap(), 1)).unwrap();
+        origin.mark_dispatch().unwrap();
+        let fence = origin.dispatch_fence().unwrap();
+        let record = b2_record(&fixture, 0);
+        assert!(record.state.lock().unwrap().dispatcher_sequence.is_some());
+        assert!(matches!(
+            b2_sync_origin(&driver, b2_ticket(driver.epoch().unwrap(), 2)),
+            Err(Refusal::Busy)
+        ));
+        let dropped = Arc::new(AtomicBool::new(false));
+        struct Payload(Arc<AtomicBool>);
+        impl Drop for Payload {
+            fn drop(&mut self) {
+                self.0.store(true, Ordering::Release);
+            }
+        }
+        let payload = Payload(dropped.clone());
+        let future = Box::pin(async move {
+            let _payload = payload;
+            std::future::pending::<()>().await
+        });
+        let (reply, receive) = tokio::sync::oneshot::channel();
+        let result = crate::cell_dispatch::GuardedGateResult::refused_for_test(fence, reply);
+        origin.submitted = true;
+        drop(origin);
+        crate::cell_dispatch::dispose_guarded_dispatch(future, result);
+        assert!(dropped.load(Ordering::Acquire));
+        assert_eq!(receive.await, Ok(Err(RequestError::NodeFenced)));
+        assert!(record.state.lock().unwrap().dispatcher_sequence.is_none());
+        drop(record);
+        drop(driver);
+        drop(permit);
+        // No AppHandle or successful Ready is fabricated; actual fixed-pump
+        // AppHandle capture/destruction is separately source/type measured.
+    });
+}
