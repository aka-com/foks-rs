+// Transport leaves use real admitted owners and real core cancellation. The
+// resident host results are component inputs only: no Worker/DriverOutput or
+// Run readiness is manufactured. Final healthy cleanup bypasses only canonical
+// terminal admission, using the already reviewed empty-resource physical cut.
+pub(crate) struct OutputFixture {
+    core: Mutex<State>,
+    context: Option<JobContext>,
+    registry: Arc<OwnedEffectRegistry>,
+    weak: Weak<foks_hosted_transport::memory::Request>,
+    factory: OwnerFactory,
+    process: OriginalOwner,
+}
+pub(crate) struct OutputFixtureDisposition {
+    pub(crate) retired: bool,
+    pub(crate) retained: bool,
+    pub(crate) write_pending: bool,
+}
+impl OutputFixture {
+    pub(crate) fn new() -> Result<Self, Refusal> {
+        Self::with_accepted_at(Instant::now())
+    }
+    pub(crate) fn with_accepted_at(accepted: Instant) -> Result<Self, Refusal> {
+        let (factory, process) = fixture_factory();
+        let registry = OwnedEffectRegistry::new(process.node_control())?;
+        let owner = factory.try_owner(OwnerRole::Invocation, Some(AcceptedStamp::at(accepted)?))?;
+        let weak = Arc::downgrade(&component::request(&owner));
+        let envelope = registry.register_component(owner, 0)?;
+        let admission = envelope.begin(&registry)?;
+        let context = admission.context.clone();
+        let mut core = State::new("node", model_config(false));
+        on_event(
+            &mut core,
+            Event::GenerationChanged {
+                generation: 1,
+                now_mono_ms: 0,
+                max_age_ms: 1000,
+                eager_classes: vec![],
+            },
+        );
+        let effects = on_event(&mut core, admission.into_event(0));
+        activate_from_effects(&mut core, context.cell(), context.request, 1, effects);
+        Ok(Self {
+            core: Mutex::new(core),
+            context: Some(context),
+            registry,
+            weak,
+            factory,
+            process,
+        })
+    }
+    fn origin(&self) -> Result<&JobContext, Refusal> {
+        self.context.as_ref().ok_or(Refusal::Invalid)
+    }
+    pub(crate) fn check_output(&self) -> Result<(), Refusal> {
+        self.origin()?.check_forward()
+    }
+    pub(crate) fn output_deadline(&self) -> Instant {
+        self.context.as_ref().expect("live output fixture").deadline
+    }
+    pub(crate) fn weak_owner(&self) -> Weak<foks_hosted_transport::memory::Request> {
+        self.weak.clone()
+    }
+    pub(crate) fn occupied(&self) -> Result<bool, Refusal> {
+        let bank = lock_owned(&self.registry.bank)?;
+        Ok(bank.records[0].is_some() || bank.held[0].is_some())
+    }
+    pub(crate) fn cancellation(&self) -> Result<tokio::sync::watch::Receiver<bool>, Refusal> {
+        Ok(self
+            .registry
+            .record(self.origin()?.token)?
+            .cancellation
+            .subscribe())
+    }
+    pub(crate) fn reserve_frame(&self, kind: output::FrameKind) -> Result<(), Refusal> {
+        self.check_output()?;
+        let record = self.registry.record(self.origin()?.token)?;
+        record.reserve_frame(kind)
+    }
+    pub(crate) fn observe_write_pending(&self) -> Result<(), Refusal> {
+        let record = self.registry.record(self.origin()?.token)?;
+        lock_owned(&record.state)?.write_pending = true;
+        Ok(())
+    }
+    pub(crate) fn write_pending(&self) -> Result<bool, Refusal> {
+        let record = self.registry.record(self.origin()?.token)?;
+        let pending = lock_owned(&record.state)?.write_pending;
+        Ok(pending)
+    }
+    pub(crate) fn canonical_cancel(&self) -> Result<(), Refusal> {
+        let effects = {
+            let mut core = lock_owned(&self.core)?;
+            on_event(&mut core, Event::ReleaseAll)
+        };
+        let mut delivered = false;
+        for effect in effects {
+            if matches!(effect, Effect::CancelCellActivity { .. }) {
+                match self.registry.claim_actor(&effect) {
+                    ActorClaim::Inline(permit) => {
+                        permit.deliver(effect)?;
+                        delivered = true;
+                    }
+                    _ => return Err(Refusal::Invalid),
+                }
+            }
+        }
+        if delivered && *self.cancellation()?.borrow() {
+            Ok(())
+        } else {
+            Err(Refusal::Invalid)
+        }
+    }
+    pub(crate) fn finish_after_disposal(mut self) -> Result<OutputFixtureDisposition, Refusal> {
+        let write_pending = self.write_pending()?;
+        let context = self.context.take().ok_or(Refusal::Invalid)?;
+        if context.check_forward().is_err() {
+            context.fail();
+            drop(context);
+            // Failure/cancellation is deliberately retained. This fixture does
+            // not manufacture a runtime stop or successful terminal proof.
+            return Ok(OutputFixtureDisposition {
+                retired: false,
+                retained: self.weak.upgrade().is_some(),
+                write_pending,
+            });
+        }
+        let request = context.request;
+        let mut core = self.core.into_inner().map_err(|_| Refusal::Failed)?;
+        on_event(&mut core, Event::ActivityFinished { request });
+        if !core.request_inactive(request) {
+            return Err(Refusal::Busy);
+        }
+        drop(core);
+        let generation = crate::generation::Generation::empty_guarded_for_test(71);
+        let mut pin = generation.try_guarded_pin()?;
+        pin.mark_started();
+        let record = self.registry.record(context.token)?;
+        lock_owned(&record.state)?.generation_pin = Some(pin);
+        drop(record);
+        let witness = context.runtime_witness()?;
+        witness.begin_retire()?;
+        witness.memory_released()?; // Actual empty native set in this leaf.
+        witness.output_disposed()?; // Caller has physically dropped all transport payloads.
+        drop(witness);
+        let record = {
+            let mut bank = lock_owned(&self.registry.bank)?;
+            let record = bank.records[0].take().ok_or(Refusal::Invalid)?;
+            bank.held[0] = Some(HeldRetirement::marker_for(
+                Some(record.cell),
+                record.sequence,
+            ));
+            record
+        };
+        let record = Arc::try_unwrap(record).map_err(|_| Refusal::Busy)?;
+        let held = HeldRetirement::dispose_record(record);
+        if held.phase != HeldPhase::PendingOwner {
+            return Err(Refusal::Failed);
+        }
+        let old = { lock_owned(&self.registry.bank)?.held[0].replace(held) };
+        drop(old);
+        self.registry.retire_completed_records();
+        if self.weak.upgrade().is_none() {
+            return Err(Refusal::Invalid);
+        }
+        drop(context);
+        self.registry.retire_completed_records();
+        let retired =
+            self.weak.upgrade().is_none() && lock_owned(&self.registry.bank)?.held[0].is_none();
+        let Self {
+            registry,
+            factory,
+            process,
+            weak,
+            ..
+        } = self;
+        drop(registry);
+        drop(weak);
+        retire_factory(factory, process);
+        Ok(OutputFixtureDisposition {
+            retired,
+            retained: !retired,
+            write_pending,
+        })
+    }
+}
