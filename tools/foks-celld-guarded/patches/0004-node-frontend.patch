+        self.node.effects.wake_actor();
+    }
+    pub fn stop_admission(&self) {
+        self.node.stop_admission();
+    }
+    pub fn failed(&self) -> bool {
+        self.node.owner.check().is_err()
+    }
+    pub fn report(&self) -> GuardedNodeReport {
+        let (invocations, held) = self
+            .node
+            .effects
+            .bank
+            .try_lock()
+            .map(|bank| {
+                (
+                    bank.records.iter().flatten().count(),
+                    bank.held.iter().flatten().count(),
+                )
+            })
+            .unwrap_or((usize::MAX, usize::MAX));
+        GuardedNodeReport {
+            claim: "b3-frontend-components-only",
+            scenario: self.scenario.as_str(),
+            accepting: self.node.accepting.load(Ordering::Acquire),
+            failed: self.failed(),
+            connections: self.connections.iter().flatten().count(),
+            dispatchers: self.dispatchers.iter().flatten().count(),
+            invocations,
+            held,
