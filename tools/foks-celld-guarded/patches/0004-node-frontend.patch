+// Private message carries actual installation identities; no caller can submit
+// a Boolean Ready or a fabricated recovery result.
+pub struct GuardedReadyProbe {
+    registry: Arc<OwnedEffectRegistry>,
+    runtime: crate::runtime::RuntimeManager,
+    manager: Arc<crate::node_log::NodeLogManager>,
+    reply: tokio::sync::oneshot::Sender<Result<(), Refusal>>,
+}
+impl GuardedReadyProbe {
+    pub(crate) fn resolve(
+        self,
+        core: &celld_logic::State,
+        registry: Option<&Arc<OwnedEffectRegistry>>,
+        runtime: Option<&crate::runtime::RuntimeManager>,
+        manager: Option<&Arc<crate::node_log::NodeLogManager>>,
+    ) {
+        let result = (|| {
+            self.registry.process.check()?;
+            if !registry.is_some_and(|registry| Arc::ptr_eq(registry, &self.registry))
+                || !manager.is_some_and(|manager| Arc::ptr_eq(manager, &self.manager))
+            {
+                return Err(Refusal::Invalid);
+            }
+            let runtime = runtime.ok_or(Refusal::NotReady)?;
+            if !Arc::ptr_eq(&runtime.generations, &self.runtime.generations)
+                || !Arc::ptr_eq(&runtime.data_dir, &self.runtime.data_dir)
+                || !runtime
+                    .replication
+                    .as_ref()
+                    .zip(self.runtime.replication.as_ref())
+                    .is_some_and(|(left, right)| Arc::ptr_eq(&left.ltx(), &right.ltx()))
+            {
+                return Err(Refusal::Invalid);
+            }
+            if !core.ready_to_serve() || !core.ownership_confirmed() {
+                return Err(Refusal::NotReady);
+            }
+            self.registry.process.check()
+        })();
+        let _ = self.reply.send(result);
+    }
+}
+impl GuardedNode {
+    pub fn reserve_diagnostics(&self, bytes: usize) -> Result<(), Refusal> {
+        if bytes != 65_536 || self.diagnostics_reserved.swap(true, Ordering::AcqRel) {
+            return Err(Refusal::Invalid);
+        }
+        self.owner.charge(bytes)
+    }
+    pub async fn require_bucket(
+        &self,
+        bucket: &crate::bucket::Bucket,
+    ) -> Result<GuardedBucket, Refusal> {
+        self.owner.check()?;
+        self.owner.charge(
+            std::mem::size_of::<GuardedBucket>() + bucket.name.len() + bucket.prefix.len(),
+        )?;
+        crate::asyncrt::timeout(
+            std::time::Duration::from_secs(30),
+            check_bucket_contract(bucket),
+        )
+        .await
+        .map_err(|_| Refusal::Expired)??;
+        self.owner.check()?;
+        Ok(GuardedBucket {
+            bucket: bucket.clone(),
+        })
+    }
+    pub async fn bind_running(
+        self: &Arc<Self>,
+        scenario: GuardedNodeScenario,
+        app: crate::actor::AppHandle,
+        bucket: GuardedBucket,
+        owner: &crate::node_log::DurabilityOwner,
+        manager: &Arc<crate::node_log::NodeLogManager>,
+        gate_tx: &tokio::sync::mpsc::UnboundedSender<crate::host_channels::GateReq>,
+    ) -> Result<GuardedFrontend, Refusal> {
+        self.owner.check()?;
+        if self.bound.swap(true, Ordering::AcqRel) {
+            return Err(Refusal::Busy);
+        }
+        let runtime = app.runtime.as_ref().ok_or(Refusal::NotReady)?;
+        let ltx = runtime.replication.as_ref().ok_or(Refusal::Invalid)?.ltx();
+        if !owner.guarded_matches(manager, &ltx, &bucket.bucket)
+            || !crate::host_channels::GATE_TX
+                .get()
+                .is_some_and(|installed| installed.same_channel(gate_tx))
+        {
+            self.owner.fail();
+            return Err(Refusal::Invalid);
+        }
+        measured_frontend_constructors()?;
+        // AppHandle cloning owns only its bounded advertise String; all other
+        // shared host services are existing Run-owned runtime overhead.
+        if app.advertise.len() > 256 {
+            return Err(Refusal::Bounds);
+        }
+        self.owner.charge(4 * 65_536 + 2 * 8192 + 131_072)?;
+        self.owner.charge(std::mem::size_of::<GuardedFrontend>())?;
+        // Finite bootstrap observations share one absolute deadline. Each
+        // concrete reply channel is charged before construction and disposed
+        // before the next observation; no invocation deadline is created here.
+        let deadline = Instant::now()
+            .checked_add(std::time::Duration::from_secs(30))
+            .ok_or(Refusal::Bounds)?;
+        let mut ready = false;
+        for _ in 0..300 {
+            self.owner.check()?;
+            self.owner.charge(
+                channel_bound::<Result<(), Refusal>>()?
+                    .checked_add(std::mem::size_of::<GuardedReadyProbe>())
+                    .ok_or(Refusal::Bounds)?,
+            )?;
+            let (reply, receive) = tokio::sync::oneshot::channel();
+            let probe = GuardedReadyProbe {
+                registry: self.effects.clone(),
+                runtime: runtime.clone(),
+                manager: manager.clone(),
+                reply,
+            };
+            app.tx
+                .send(crate::actor::Message::GuardedReady(probe))
+                .map_err(|_| Refusal::Failed)?;
+            let result = original_timeout(deadline, receive)
+                .await
+                .map_err(|_| Refusal::Expired)?
+                .map_err(|_| Refusal::Failed)?;
+            match result {
+                Ok(()) => {
+                    ready = true;
+                    break;
+                }
+                Err(Refusal::NotReady) => {}
+                Err(error) => return Err(error),
+            }
+            if Instant::now() >= deadline {
+                break;
+            }
+            crate::asyncrt::sleep(std::time::Duration::from_millis(100)).await;
+        }
+        if !ready {
+            self.owner.fail();
+            return Err(Refusal::NotReady);
+        }
+        self.owner.check()?;
+        drop(bucket);
+        Ok(GuardedFrontend {
+            node: self.clone(),
+            app,
+            scenario,
+            connections: std::array::from_fn(|_| None),
+            dispatchers: std::array::from_fn(|_| None),
+            completed: 0,
+            refused: 0,
+        })
+    }
+}
