+// This explicitly named empty-resource fixture bypasses only terminal
+// admission, never native/Ready authority. It uses the same physical helper.
+fn b3_empty_pending(registry: &Arc<OwnedEffectRegistry>, context: &JobContext) {
+    let record = registry.record(context.token).unwrap();
+    {
+        let state = record.state.lock().unwrap();
+        assert!(
+            state.roots.iter().all(RootCell::disposed)
+                && state.runtime.is_none()
+                && state.activation.is_none()
+                && state.attachment.is_none()
+        );
+    }
+    let generation = crate::generation::Generation::empty_guarded_for_test(72);
+    let mut pin = generation.try_guarded_pin().unwrap();
+    pin.mark_started();
+    record.state.lock().unwrap().generation_pin = Some(pin);
+    drop(record);
+    let witness = context.runtime_witness().unwrap();
+    witness.begin_retire().unwrap();
+    witness.memory_released().unwrap();
+    witness.output_disposed().unwrap();
+    drop(witness);
+    let record = {
+        let mut bank = registry.bank.lock().unwrap();
+        let record = bank.records[context.token.slot as usize].take().unwrap();
+        bank.held[context.token.slot as usize] = Some(HeldRetirement::marker_for(
+            Some(record.cell),
+            record.sequence,
+        ));
+        record
+    };
+    let record = match Arc::try_unwrap(record) {
+        Ok(record) => record,
+        Err(_) => panic!("unexpected actual record alias"),
+    };
+    let held = HeldRetirement::dispose_record(record);
+    assert!(held.phase == HeldPhase::PendingOwner);
+    assert!(generation.is_drained());
+    let marker = { registry.bank.lock().unwrap().held[context.token.slot as usize].replace(held) };
+    drop(marker);
+}
