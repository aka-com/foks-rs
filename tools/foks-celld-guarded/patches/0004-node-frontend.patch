+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum FrameKind {
+    Ordinary,
+    Backpressure,
+}
+impl FrameKind {
+    pub(crate) const fn bytes(self) -> usize {
+        match self {
+            Self::Ordinary => 32,
+            Self::Backpressure => 4 * 1024 * 1024,
+        }
+    }
+}
+
+// Resources precede the original bank owner even if this value is never polled.
+// DriverOutput's Drop retains/quarantines an abandoned native answer; the bank
+// owner then retains its exact Delivered consumer rather than publishing Free.
+pub(crate) struct GatedFrame {
+    bytes: Vec<u8>,
+    output: DriverOutput,
+    owner: OwnedNodeDriverCompletion,
+    preparation: Result<(), Refusal>,
+}
+pub(crate) struct SendDisposition {
+    pub(crate) outcome: Result<(), Refusal>,
+    pub(crate) retirement: RetirementObservation,
+}
+impl GatedFrame {
+    pub(crate) fn new(
+        mut owner: OwnedNodeDriverCompletion,
+        output: DriverOutput,
+        kind: FrameKind,
+    ) -> Result<Self, Refusal> {
+        // This inline owner/future lives in the prepaid frontend cell. Refuse
+        // an oversized actual constructor before its frame is allocated or a
+        // SocketWork future can be returned; the large bytes have their own
+        // one-shot response reservation, never the root's owned-byte allowance.
+        measured_socket_constructor()?;
+        let mut bytes = Vec::new();
+        let preparation = (|| {
+            owner.check_output()?;
+            owner.reserve_frame(kind)?;
+            bytes
+                .try_reserve_exact(kind.bytes())
+                .map_err(|_| Refusal::Capacity)?;
+            if bytes.capacity() != kind.bytes() {
+                return Err(Refusal::Bounds);
+            }
+            bytes.resize(kind.bytes(), 0);
+            output.write_frame(&mut bytes)?;
+            owner.check_output()
+        })();
+        // Expected cancellation, expiry and allocation refusal still own the
+        // proved answer. send() closes the socket before disposing that answer;
+        // no second terminal-proof claim or unowned error branch is introduced.
+        Ok(Self {
+            bytes,
+            output,
+            owner,
+            preparation,
+        })
+    }
+
+    pub(crate) fn send(
+        self,
+        socket: TcpStream,
+    ) -> impl Future<Output = Result<SendDisposition, Refusal>> {
+        // Construct the ordered aggregate before returning any future. Losing
+        // an unpolled send future closes the socket before dropping its owner.
+        SocketWork {
+            socket: Some(socket),
+            frame: Some(self),
+        }
+        .run()
+    }
+}
+
+struct SocketWork {
+    socket: Option<TcpStream>,
+    frame: Option<GatedFrame>,
+}
+
+fn socket_future_layout() -> std::alloc::Layout {
+    fn layout<F: Future>(_: fn(SocketWork) -> F) -> std::alloc::Layout {
+        std::alloc::Layout::new::<F>()
+    }
+    layout(SocketWork::run)
+}
+pub(crate) fn measured_socket_constructor() -> Result<usize, Refusal> {
+    std::mem::size_of::<SocketWork>()
+        .checked_add(socket_future_layout().size())
+        .and_then(|bytes| {
+            bytes.checked_add(std::mem::size_of::<Result<SendDisposition, Refusal>>())
+        })
+        .filter(|bytes| *bytes <= 48 * 1024)
+        .ok_or(Refusal::Bounds)
