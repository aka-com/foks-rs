+// Copyright 2026 Deno Land Inc. Apache-2.0 license.
+
+//! Optional qualification adapter for the canonical Run body. The disabled
+//! adapter neither installs a policy nor changes ordinary ingress or drain.
+
+use celld::actor::AppHandle;
+use celld::host_channels::GateReq;
+use tokio::net::TcpStream;
+
+#[derive(Default)]
+pub(super) struct Run {
+    #[cfg(feature = "foks-guarded-node-qualification")]
+    enabled: Option<Enabled>,
+}
+
+#[cfg(feature = "foks-guarded-node-qualification")]
+struct Enabled {
+    node: std::sync::Arc<celld::GuardedNode>,
+    scenario: celld::GuardedNodeScenario,
+    bucket: Option<celld::GuardedBucket>,
+    frontend: Option<celld::GuardedFrontend>,
+    // Reused for the finite startup/final records, never an unbounded log.
+    encoded: Vec<u8>,
+}
+
+#[cfg(feature = "foks-guarded-node-qualification")]
+fn refused(error: celld::GuardedNodeRefusal) -> anyhow::Error {
+    anyhow::anyhow!("guarded node refused: {error:?}")
+}
+
+#[cfg(feature = "foks-guarded-node-qualification")]
+pub(super) fn validate(settings: &super::cli::Settings) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        !settings.control_plane
+            && settings.load_deployment
+            && settings.dev_store.is_none()
+            && !settings.unsafe_public_advertise
+            && !settings.trust_forwarded_headers,
+        "guarded node requires standalone bucket deployment"
+    );
+    let spec = settings
+        .bucket
+        .as_deref()
+        .ok_or_else(|| anyhow::anyhow!("guarded node requires --bucket"))?;
+    let (backend, name, prefix) = celld::bucket::split_spec(spec);
+    anyhow::ensure!(
+        backend == celld::bucket::StorageBackend::S3 && !name.is_empty() && !prefix.is_empty(),
+        "guarded node requires a scoped S3 bucket prefix"
+    );
+    let endpoint = settings
+        .endpoint
+        .as_deref()
+        .ok_or_else(|| anyhow::anyhow!("guarded node requires an explicit local S3 endpoint"))?;
+    let endpoint = url::Url::parse(endpoint)?;
+    anyhow::ensure!(
+        endpoint.scheme() == "http"
+            && endpoint.host_str() == Some("127.0.0.1")
+            && endpoint.port().is_some()
+            && endpoint.username().is_empty()
+            && endpoint.password().is_none()
+            && endpoint.path() == "/"
+            && endpoint.query().is_none()
+            && endpoint.fragment().is_none(),
+        "guarded node S3 endpoint must be explicit IPv4 loopback HTTP"
+    );
+    for listen in [&settings.listen, &settings.internal_listen] {
+        let celld::startup::Listen::Explicit(address) = listen else {
+            anyhow::bail!("guarded node requires explicit loopback listeners");
+        };
+        let address: std::net::SocketAddr = address.parse()?;
+        anyhow::ensure!(
+            address.ip() == std::net::IpAddr::V4(std::net::Ipv4Addr::LOCALHOST)
+                && address.port() != 0,
+            "guarded node requires explicit IPv4 loopback listener ports"
+        );
+    }
+    if let Some(address) = &settings.advertise {
+        let address: std::net::SocketAddr = address.parse()?;
+        anyhow::ensure!(
+            address.ip() == std::net::IpAddr::V4(std::net::Ipv4Addr::LOCALHOST)
+                && address.port() != 0,
+            "guarded node advertise must be IPv4 loopback"
+        );
+    }
+    for (name, expected) in [
+        ("AWS_ACCESS_KEY_ID", "foks-local-dummy"),
+        ("AWS_SECRET_ACCESS_KEY", "foks-local-dummy-secret"),
+        ("AWS_CONFIG_FILE", "/dev/null"),
+        ("AWS_SHARED_CREDENTIALS_FILE", "/dev/null"),
+        ("AWS_EC2_METADATA_DISABLED", "true"),
+        ("CELLD_DURABILITY", "bucket"),
+    ] {
+        anyhow::ensure!(
+            std::env::var(name).as_deref() == Ok(expected),
+            "guarded node requires the closed local credential and durability profile ({name})"
+        );
+    }
+    for name in [
+        "AWS_SESSION_TOKEN",
+        "AWS_PROFILE",
+        "AWS_ROLE_ARN",
+        "AWS_WEB_IDENTITY_TOKEN_FILE",
+        "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
+        "AWS_CONTAINER_CREDENTIALS_FULL_URI",
+        "CELLD_TEST_SCRIPT_PATH",
+        "CELLD_WATCH",
+        "CELLD_INTERNAL_DEV_STORE",
+        "CELLD_TEST_FAIL_PUBLISH_ONCE",
+    ] {
+        anyhow::ensure!(
+            std::env::var_os(name).is_none(),
+            "guarded node refuses {name}"
+        );
+    }
+    let directory = std::env::var_os("CELLD_TEST_DATA_DIR")
+        .map(std::path::PathBuf::from)
+        .ok_or_else(|| anyhow::anyhow!("guarded node requires a fresh CELLD_TEST_DATA_DIR"))?;
+    anyhow::ensure!(
+        directory.is_absolute(),
+        "guarded node data directory must be absolute"
+    );
+    match std::fs::symlink_metadata(&directory) {
+        Ok(metadata) => anyhow::ensure!(
+            metadata.is_dir()
+                && !metadata.file_type().is_symlink()
+                && std::fs::read_dir(&directory)?.next().is_none(),
+            "guarded node data directory must be fresh and empty"
+        ),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            let parent = directory
+                .parent()
+                .ok_or_else(|| anyhow::anyhow!("guarded data directory has no parent"))?;
+            anyhow::ensure!(parent.is_dir(), "guarded data directory parent must exist");
+        }
+        Err(error) => return Err(error.into()),
+    }
+    Ok(())
+}
+
+impl Run {
+    #[cfg(feature = "foks-guarded-node-qualification")]
+    pub(super) fn install(scenario: celld::GuardedNodeScenario) -> anyhow::Result<Self> {
+        let node = celld::GuardedNode::install().map_err(refused)?;
+        node.reserve_diagnostics(65_536).map_err(refused)?;
+        let mut encoded = Vec::new();
+        encoded.try_reserve_exact(65_536)?;
+        anyhow::ensure!(
+            encoded.capacity() == 65_536,
+            "guarded diagnostic allocation exceeded its charge"
+        );
+        Ok(Self {
+            enabled: Some(Enabled {
+                node,
+                scenario,
+                bucket: None,
+                frontend: None,
+                encoded,
+            }),
+        })
+    }
+
+    pub(super) fn enabled(&self) -> bool {
+        #[cfg(feature = "foks-guarded-node-qualification")]
+        {
+            return self.enabled.is_some();
+        }
+        #[cfg(not(feature = "foks-guarded-node-qualification"))]
+        false
+    }
+
+    pub(super) async fn probe_bucket(
+        &mut self,
+        _bucket: &celld::bucket::Bucket,
+    ) -> anyhow::Result<bool> {
+        #[cfg(feature = "foks-guarded-node-qualification")]
+        if let Some(enabled) = &mut self.enabled {
+            enabled.bucket = Some(
+                enabled
+                    .node
+                    .require_bucket(_bucket)
+                    .await
+                    .map_err(refused)?,
+            );
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    pub(super) async fn ready(
+        &mut self,
+        _app: AppHandle,
+        _owner: Option<&celld::node_log::DurabilityOwner>,
+        _manager: Option<&std::sync::Arc<celld::node_log::NodeLogManager>>,
+        _gate: &tokio::sync::mpsc::UnboundedSender<GateReq>,
+    ) -> anyhow::Result<()> {
+        #[cfg(feature = "foks-guarded-node-qualification")]
+        if let Some(enabled) = &mut self.enabled {
+            let bucket = enabled
+                .bucket
+                .take()
+                .ok_or_else(|| anyhow::anyhow!("guarded bucket probe missing"))?;
+            let owner =
+                _owner.ok_or_else(|| anyhow::anyhow!("guarded durability owner missing"))?;
+            let manager =
+                _manager.ok_or_else(|| anyhow::anyhow!("guarded node log manager missing"))?;
+            enabled.frontend = Some(
+                enabled
+                    .node
+                    .bind_running(enabled.scenario, _app, bucket, owner, manager, _gate)
+                    .await
+                    .map_err(refused)?,
+            );
+        }
+        Ok(())
+    }
+
+    pub(super) fn accept(&mut self, stream: TcpStream) -> anyhow::Result<Option<TcpStream>> {
+        #[cfg(feature = "foks-guarded-node-qualification")]
+        if let Some(enabled) = &mut self.enabled {
+            let frontend = enabled
+                .frontend
+                .as_mut()
+                .ok_or_else(|| anyhow::anyhow!("guarded frontend is not ready"))?;
+            // This synchronous call captures the original acceptance deadline
+            // before the header future is constructed or any await occurs.
+            if let Err(error) = frontend.accept(stream) {
+                tracing::debug!(?error, "guarded connection refused");
+            }
+            return Ok(None);
+        }
+        Ok(Some(stream))
+    }
+
+    pub(super) fn dispatch(&mut self, req: GateReq) -> Option<GateReq> {
+        #[cfg(feature = "foks-guarded-node-qualification")]
+        if let Some(enabled) = &mut self.enabled {
+            let result = enabled
+                .frontend
+                .as_mut()
+                .ok_or(celld::GuardedNodeRefusal::NotReady)
+                .and_then(|frontend| frontend.dispatch_gate(req));
+            return match result {
+                Ok(ordinary) => ordinary,
+                Err(error) => {
+                    tracing::error!(?error, "guarded dispatcher failed; fencing process");
+                    if let Err(error) = self.report("failed", false) {
+                        tracing::error!(%error, "guarded failure report could not be written");
+                    }
+                    // Preserve canonical celld's non-unwinding exit even when
+                    // diagnostic output is broken and runtime work remains.
+                    super::exit_flushed(3);
+                }
+            };
+        }
+        Some(req)
+    }
+
+    pub(super) async fn progress(&mut self) {
+        #[cfg(feature = "foks-guarded-node-qualification")]
+        if let Some(frontend) = self
+            .enabled
+            .as_mut()
+            .and_then(|value| value.frontend.as_mut())
+        {
+            let _ = frontend.progress().await;
+            return;
+        }
