+impl SocketWork {
+    async fn run(mut self) -> Result<SendDisposition, Refusal> {
+        let frame = self.frame.as_mut().ok_or(Refusal::Invalid)?;
+        let mut cancel = None;
+        let outcome = match frame.preparation.and_then(|()| frame.owner.cancellation()) {
+            Ok(receiver) => {
+                cancel = Some(receiver);
+                transmit(
+                    self.socket.as_mut().ok_or(Refusal::Invalid)?,
+                    &frame.bytes,
+                    &mut frame.owner,
+                    cancel.as_mut().ok_or(Refusal::Invalid)?,
+                )
+                .await
+            }
+            Err(error) => Err(error),
+        };
+        // transmit's borrowed write/flush future has returned and been dropped.
+        // Closing the full owned stream is the physical abandonment witness on
+        // every error branch, and ends local socket ownership on success too.
+        drop(self.socket.take());
+        drop(cancel);
+        let GatedFrame {
+            bytes,
+            output,
+            owner,
+            preparation: _,
+        } = self.frame.take().ok_or(Refusal::Invalid)?;
+        drop(bytes);
+        let retirement = owner.finish_output(output).await?;
+        Ok(SendDisposition {
+            outcome,
+            retirement,
+        })
+    }
+}
