+pub(crate) struct DispatcherFence {
+    context: JobContext,
+    sequence: u64,
+    disposed: bool,
+}
+impl OwnedGateOrigin {
+    pub(crate) fn mark_dispatch(&self) -> Result<(), Refusal> {
+        self.context.check_forward()?;
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        if state.dispatcher_sequence.is_some() || state.activities[1].sequence != self.sequence {
+            return Err(Refusal::Busy);
+        }
+        state.dispatcher_sequence = Some(self.sequence);
+        drop(state);
+        self.context.check_forward()
+    }
+    pub(crate) fn dispatch_fence(&self) -> Result<DispatcherFence, Refusal> {
+        self.context.check_identity()?;
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        if lock_owned(&record.state)?.dispatcher_sequence != Some(self.sequence) {
+            return Err(Refusal::Invalid);
+        }
+        Ok(DispatcherFence {
+            context: self.context.clone(),
+            sequence: self.sequence,
+            disposed: false,
+        })
+    }
+}
+impl DispatcherFence {
+    pub(crate) fn complete(mut self) -> Result<(), Refusal> {
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        if state.dispatcher_sequence != Some(self.sequence) {
+            return Err(Refusal::Invalid);
+        }
+        state.dispatcher_sequence = None;
+        self.disposed = true;
+        drop(state);
+        drop(record);
+        drop(self);
+        registry.wake_actor();
+        Ok(())
+    }
+}
+impl Drop for DispatcherFence {
+    fn drop(&mut self) {
+        if !self.disposed {
+            self.context.fail();
+        }
+    }
+}
