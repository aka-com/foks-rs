+impl GuardedFrontend {
+    pub fn accept(&mut self, socket: tokio::net::TcpStream) -> Result<(), Refusal> {
+        let stamp = control::AcceptedStamp::capture()?;
+        self.node.owner.check()?;
+        if !self.node.accepting.load(Ordering::Acquire) {
+            return Err(Refusal::Cancelled);
+        }
+        let slot = self
+            .connections
+            .iter_mut()
+            .find(|cell| cell.is_none())
+            .ok_or(Refusal::Busy)?;
+        let header = self.node.owner.acquire_header(stamp)?;
+        let work = ConnectionWork {
+            socket: Some(socket),
+            header: Some(header),
+            route: None,
+            driver: None,
+            app: self.app.clone(),
+            node: self.node.clone(),
+            scenario: self.scenario,
+        };
+        *slot = Some(Box::pin(work.run()));
+        Ok(())
+    }
+    pub fn dispatch_gate(
+        &mut self,
+        req: crate::host_channels::GateReq,
+    ) -> Result<Option<crate::host_channels::GateReq>, Refusal> {
+        if req.guarded.is_none() {
+            return Ok(Some(req));
+        }
+        let Some(slot) = self.dispatchers.iter_mut().find(|slot| slot.is_none()) else {
+            self.node.owner.fail();
+            return Err(Refusal::Busy);
+        };
+        *slot = Some(Box::pin(
+            crate::cell_dispatch::GuardedGateWork {
+                app: self.app.clone(),
+                req,
+            }
+            .run(),
+        ));
+        Ok(None)
+    }
+    pub async fn progress(&mut self) -> GuardedFrontendEvent {
+        std::future::poll_fn(|cx| {
+            for slot in &mut self.dispatchers {
+                if let Some(work) = slot.as_mut() {
+                    if let Poll::Ready(result) = work.as_mut().poll(cx) {
+                        let future = slot.take().expect("polled dispatcher exists");
+                        crate::cell_dispatch::dispose_guarded_dispatch(future, result);
+                        return Poll::Ready(GuardedFrontendEvent {
+                            kind: "dispatcher-disposed",
+                            completed: self.completed,
+                            refused: self.refused,
+                            failed: self.node.owner.check().is_err(),
+                        });
+                    }
+                }
+            }
+            for slot in &mut self.connections {
+                if let Some(work) = slot.as_mut() {
+                    if let Poll::Ready(result) = work.as_mut().poll(cx) {
+                        drop(slot.take());
+                        let counter = if result.is_ok() {
+                            &mut self.completed
+                        } else {
+                            &mut self.refused
+                        };
+                        if let Some(next) = counter.checked_add(1) {
+                            *counter = next;
+                        } else {
+                            self.node.owner.fail();
+                        }
+                        return Poll::Ready(GuardedFrontendEvent {
+                            kind: "connection-disposed",
+                            completed: self.completed,
+                            refused: self.refused,
+                            failed: self.node.owner.check().is_err(),
+                        });
+                    }
+                }
+            }
+            Poll::Pending
+        })
+        .await
+    }
