+#[test]
+fn b3_header_closed_matrix() {
+    for scenario in [
+        GuardedNodeScenario::ColdSyncRetire,
+        GuardedNodeScenario::FailedTurnGated,
+        GuardedNodeScenario::TcpWriteHeld,
+        GuardedNodeScenario::TcpDisconnect,
+        GuardedNodeScenario::ShutdownComplete,
+        GuardedNodeScenario::ShutdownCut,
+    ] {
+        assert_eq!(GuardedNodeScenario::parse(scenario.as_str()), Ok(scenario));
+        for tenant in 0..3 {
+            assert_eq!(
+                parse_header(&b3_header(1, tenant, 0), scenario),
+                Ok(FrontendCommand::Begin {
+                    tenant: tenant.into()
+                })
+            );
+            assert_eq!(
+                parse_header(&b3_header(2, tenant, 0), scenario),
+                Ok(FrontendCommand::Observe {
+                    tenant: tenant.into(),
+                    pending: false
+                })
+            );
+            assert_eq!(
+                parse_header(&b3_header(2, tenant, 1), scenario).is_ok(),
+                scenario.frame() == output::FrameKind::Backpressure
+            );
+        }
+        for index in [0, 7, 8, 12, 13, 14, 15] {
+            let mut bytes = b3_header(1, 0, 0);
+            bytes[index] ^= 0x80;
+            assert_eq!(parse_header(&bytes, scenario), Err(Refusal::Invalid));
+        }
+        for command in [0, 3, 4, 255] {
+            assert!(parse_header(&b3_header(command, 0, 0), scenario).is_err());
+        }
+        for tenant in [3, 255] {
+            assert!(parse_header(&b3_header(1, tenant, 0), scenario).is_err());
+        }
+        assert!(parse_header(&b3_header(1, 0, 1), scenario).is_err());
+        assert!(parse_header(&b3_header(1, 0, 0)[..15], scenario).is_err());
+        let mut long = b3_header(1, 0, 0).to_vec();
+        long.push(0);
+        assert!(parse_header(&long, scenario).is_err());
+    }
+    assert!(GuardedNodeScenario::parse("release-any").is_err());
+}
