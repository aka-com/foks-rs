+fn current_cancel(cancel: &watch::Receiver<bool>) -> Result<(), Refusal> {
+    // A closed watch is uncertain even if its last value was false. No new
+    // sender is manufactured and an already-set cancel precedes the first byte.
+    if *cancel.borrow() || cancel.has_changed().is_err() {
+        Err(Refusal::Cancelled)
+    } else {
+        Ok(())
+    }
+}
+async fn cancelled(cancel: &mut watch::Receiver<bool>) {
+    loop {
+        let already_cancelled = *cancel.borrow_and_update();
+        if already_cancelled || cancel.changed().await.is_err() {
+            return;
+        }
+    }
+}
