+const WATCH_ALLOCATION_BOUND: usize = 4096;
+fn watch_derived_bytes() -> Result<usize, Refusal> {
+    fn padded<T>() -> Result<usize, Refusal> {
+        let layout = std::alloc::Layout::new::<T>();
+        if layout.align() > 16 {
+            return Err(Refusal::Bounds);
+        }
+        layout
+            .size()
+            .checked_add(15)
+            .map(|bytes| bytes & !15)
+            .ok_or(Refusal::Bounds)
+    }
+    // Tokio1.53.1 Shared<bool>: nine Notify, the value lock, state/refcounts,
+    // conservative optional BigNotify index and the two Arc header counters.
+    let bytes = 9 * padded::<tokio::sync::Notify>()?
+        + padded::<std::sync::RwLock<bool>>()?
+        + 6 * padded::<std::sync::atomic::AtomicUsize>()?;
+    if bytes > WATCH_ALLOCATION_BOUND {
+        Err(Refusal::Bounds)
+    } else {
+        Ok(bytes)
+    }
+}
