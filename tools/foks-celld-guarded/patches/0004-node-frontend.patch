+impl Authority for OwnedNodeDriverCompletion {
+    fn check(&self) -> Result<(), Refusal> {
+        self.check_output()
+    }
+    fn deadline(&self) -> Instant {
+        self.output_deadline()
+    }
+    fn write_pending(&self) -> Result<(), Refusal> {
+        self.observe_write_pending()
