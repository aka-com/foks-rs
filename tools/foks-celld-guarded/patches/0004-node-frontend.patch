+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GuardedNodeScenario {
+    ColdSyncRetire,
+    FailedTurnGated,
+    TcpWriteHeld,
+    TcpDisconnect,
+    ShutdownComplete,
+    ShutdownCut,
+}
+impl GuardedNodeScenario {
+    pub fn parse(value: &str) -> Result<Self, Refusal> {
+        Ok(match value {
+            "cold-sync-retire" => Self::ColdSyncRetire,
+            "failed-turn-gated" => Self::FailedTurnGated,
+            "tcp-write-held" => Self::TcpWriteHeld,
+            "tcp-disconnect" => Self::TcpDisconnect,
+            "shutdown-complete" => Self::ShutdownComplete,
+            "shutdown-cut" => Self::ShutdownCut,
+            _ => return Err(Refusal::Invalid),
+        })
+    }
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::ColdSyncRetire => "cold-sync-retire",
+            Self::FailedTurnGated => "failed-turn-gated",
+            Self::TcpWriteHeld => "tcp-write-held",
+            Self::TcpDisconnect => "tcp-disconnect",
+            Self::ShutdownComplete => "shutdown-complete",
+            Self::ShutdownCut => "shutdown-cut",
+        }
+    }
+    fn frame(self) -> output::FrameKind {
+        if matches!(
+            self,
+            Self::TcpWriteHeld | Self::TcpDisconnect | Self::ShutdownCut
+        ) {
+            output::FrameKind::Backpressure
+        } else {
+            output::FrameKind::Ordinary
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum FrontendCommand {
+    Begin { tenant: usize },
+    Observe { tenant: usize, pending: bool },
+}
+fn parse_header(bytes: &[u8], scenario: GuardedNodeScenario) -> Result<FrontendCommand, Refusal> {
+    if bytes.len() != 16
+        || &bytes[..8] != b"FOKSGN01"
+        || bytes[8] != 1
+        || bytes[10] >= 3
+        || bytes[12..] != [0; 4]
+    {
+        return Err(Refusal::Invalid);
+    }
+    let tenant = usize::from(bytes[10]);
+    match (bytes[9], bytes[11]) {
+        (1, 0) => Ok(FrontendCommand::Begin { tenant }),
+        (2, 0) => Ok(FrontendCommand::Observe {
+            tenant,
+            pending: false,
+        }),
+        (2, 1) if scenario.frame() == output::FrameKind::Backpressure => {
+            Ok(FrontendCommand::Observe {
+                tenant,
+                pending: true,
+            })
+        }
+        _ => Err(Refusal::Invalid),
+    }
+}
