+// B3 leaf proof: the actual Bucket/S3 client checks finite HTTP responses.
+// These fixtures never construct guarded Ready or claim full node startup.
+#[derive(Clone, Copy, Debug)]
+enum B3BucketCase {
+    Positive,
+    Transport,
+    Violation,
+}
+
+struct B3ProbeRequest {
+    method: String,
+    path: String,
+    condition: Option<String>,
+    absent: Option<String>,
+    range: Option<String>,
+    body: [u8; 32],
+    body_len: usize,
+}
+
+async fn b3_read_probe_request(
+    stream: &mut tokio::net::TcpStream,
+) -> Result<B3ProbeRequest, String> {
+    use tokio::io::AsyncReadExt;
+    let mut header = [0u8; 8192];
+    let mut used = 0;
+    loop {
+        if used == header.len() {
+            return Err("probe request headers exceed fixed fixture bound".into());
+        }
+        stream
+            .read_exact(&mut header[used..used + 1])
+            .await
+            .map_err(|error| format!("read probe header: {error}"))?;
+        used += 1;
+        if used >= 4 && &header[used - 4..used] == b"\r\n\r\n" {
+            break;
+        }
+    }
+    let header =
+        std::str::from_utf8(&header[..used]).map_err(|_| "probe HTTP header is not UTF-8")?;
+    let mut lines = header.split("\r\n");
+    let mut request_line = lines.next().ok_or("missing request line")?.split(' ');
+    let method = request_line.next().ok_or("missing method")?.to_owned();
+    let path = request_line.next().ok_or("missing path")?.to_owned();
+    if request_line.next() != Some("HTTP/1.1") || request_line.next().is_some() {
+        return Err("unexpected probe HTTP version/request line".into());
+    }
+    let mut condition = None;
+    let mut absent = None;
+    let mut range = None;
+    let mut length = None;
+    for line in lines.filter(|line| !line.is_empty()) {
+        let (name, value) = line.split_once(':').ok_or("malformed probe header")?;
+        let value = value.trim();
+        let target = if name.eq_ignore_ascii_case("if-match") {
+            Some(&mut condition)
+        } else if name.eq_ignore_ascii_case("if-none-match") {
+            Some(&mut absent)
+        } else if name.eq_ignore_ascii_case("range") {
+            Some(&mut range)
+        } else {
+            None
+        };
+        if let Some(target) = target {
+            if target.replace(value.to_owned()).is_some() {
+                return Err("duplicate probe condition/range".into());
+            }
+        }
+        if name.eq_ignore_ascii_case("content-length")
+            && length
+                .replace(value.parse::<usize>().map_err(|_| "bad content length")?)
+                .is_some()
+        {
+            return Err("duplicate content length".into());
+        }
+        if name.eq_ignore_ascii_case("transfer-encoding") {
+            return Err("fixture only accepts fixed-size request bodies".into());
+        }
+    }
+    let body_len = length.unwrap_or(0);
+    let mut body = [0; 32];
+    if body_len > body.len() {
+        return Err("probe body exceeds fixed fixture bound".into());
+    }
+    stream
+        .read_exact(&mut body[..body_len])
+        .await
+        .map_err(|error| format!("read probe body: {error}"))?;
+    Ok(B3ProbeRequest {
+        method,
+        path,
+        condition,
+        absent,
+        range,
+        body,
+        body_len,
+    })
+}
+
+async fn b3_probe_response(
+    stream: &mut tokio::net::TcpStream,
+    status: &str,
+    fields: &str,
+    body: &[u8],
+) -> Result<(), String> {
+    use tokio::io::AsyncWriteExt;
+    // All response fields/bodies below are closed fixture literals.
+    let header = format!(
+        "HTTP/1.1 {status}\r\nConnection: close\r\nContent-Length: {}\r\n{fields}\r\n",
+        body.len()
+    );
+    stream
+        .write_all(header.as_bytes())
+        .await
+        .map_err(|error| error.to_string())?;
+    stream
+        .write_all(body)
+        .await
+        .map_err(|error| error.to_string())?;
+    stream.flush().await.map_err(|error| error.to_string())?;
+    stream.shutdown().await.map_err(|error| error.to_string())
+}
+
+async fn b3_serve_probe(
+    listener: tokio::net::TcpListener,
+    case: B3BucketCase,
+) -> Result<usize, String> {
+    const PRECONDITION: &[u8] = b"<Error><Code>PreconditionFailed</Code><Message>fixture condition rejected</Message></Error>";
+    let count = match case {
+        B3BucketCase::Positive => 8,
+        B3BucketCase::Transport => 2,
+        B3BucketCase::Violation => 3,
+    };
+    let mut cas_path = None;
+    let mut range_path = None;
+    for index in 0..count {
+        let (mut stream, peer) = listener.accept().await.map_err(|error| error.to_string())?;
+        if !peer.ip().is_loopback() {
+            return Err("nonloopback probe peer".into());
+        }
+        let request = b3_read_probe_request(&mut stream).await?;
+        let step = match case {
+            B3BucketCase::Positive => index,
+            B3BucketCase::Transport if index == 1 => 4,
+            B3BucketCase::Violation if index == 2 => 4,
+            _ => index,
+        };
+        if step == 0 {
+            if !request.path.starts_with("/foks-b3-probe/probe/cas-") {
+                return Err("unexpected CAS fixture key".into());
+            }
+            cas_path = Some(request.path.clone());
+        } else if step == 5 {
+            if !request.path.starts_with("/foks-b3-probe/probe/range-") {
+                return Err("unexpected range fixture key".into());
+            }
+            range_path = Some(request.path.clone());
+        }
+        let expected_path = if step <= 4 {
+            cas_path.as_ref()
+        } else {
+            range_path.as_ref()
+        };
+        if expected_path != Some(&request.path) {
+            return Err("probe switched its key within one contract".into());
+        }
+        let (method, body, absent, condition, range) = match step {
+            0 => ("PUT", &b"probe-create"[..], Some("*"), None, None),
+            1 => ("PUT", &b"probe-recreate"[..], Some("*"), None, None),
+            2 => ("PUT", &b"probe-update"[..], None, Some("\"one\""), None),
+            3 => ("PUT", &b"probe-stale"[..], None, Some("\"one\""), None),
+            4 | 7 => ("DELETE", &b""[..], None, None, None),
+            5 => ("PUT", &b"celld-range-probe"[..], None, None, None),
+            6 => ("GET", &b""[..], None, None, Some("bytes=6-10")),
+            _ => return Err("unexpected fixture step".into()),
+        };
+        if request.method != method
+            || &request.body[..request.body_len] != body
+            || request.absent.as_deref() != absent
+            || request.condition.as_deref() != condition
+            || request.range.as_deref() != range
+        {
+            return Err(format!(
+                "probe request failed exact contract at step {step}"
+            ));
+        }
+        if matches!(case, B3BucketCase::Transport) && step == 0 {
+            // The actual CAS client sees an EOF after sending its request.
+            // Its real no-retry policy must proceed to cleanup DELETE next.
+            drop(stream);
+            continue;
+        }
+        match step {
+            0 => b3_probe_response(&mut stream, "200 OK", "ETag: \"one\"\r\n", b"").await?,
+            1 if matches!(case, B3BucketCase::Violation) => {
+                b3_probe_response(&mut stream, "200 OK", "ETag: \"wrong\"\r\n", b"").await?;
+            }
+            1 | 3 => b3_probe_response(&mut stream, "412 Precondition Failed", "Content-Type: application/xml\r\n", PRECONDITION).await?,
+            2 => b3_probe_response(&mut stream, "200 OK", "ETag: \"two\"\r\n", b"").await?,
+            4 | 7 => b3_probe_response(&mut stream, "204 No Content", "", b"").await?,
+            5 => b3_probe_response(&mut stream, "200 OK", "ETag: \"range\"\r\n", b"").await?,
+            6 => b3_probe_response(&mut stream, "206 Partial Content", "ETag: \"range\"\r\nLast-Modified: Wed, 21 Oct 2015 07:28:00 GMT\r\nContent-Range: bytes 6-10/17\r\n", b"range").await?,
+            _ => return Err("unexpected fixture response step".into()),
+        }
+        drop(stream);
+    }
+    drop(listener);
+    Ok(count)
+}
+
+fn b3_bucket_probe(case: B3BucketCase) {
+    crate::actor::guarded_test_runtime().block_on(async {
+        let port = std::env::var("FOKS_B3_BUCKET_PORT")
+            .expect("B3 Bucket leaf tests require the recorded loopback fixture port")
+            .parse::<u16>()
+            .expect("recorded B3 Bucket port must be numeric");
+        assert_ne!(port, 0, "no unrecorded ephemeral port fallback");
+        let address = std::net::SocketAddrV4::new(std::net::Ipv4Addr::LOCALHOST, port);
+        let listener = tokio::net::TcpListener::bind(address)
+            .await
+            .expect("owned B3 Bucket port");
+        let endpoint = format!("http://127.0.0.1:{port}");
+        let bucket = crate::bucket::Bucket::open(
+            "foks-b3-probe",
+            Some(&endpoint),
+            "us-east-1",
+            Some(crate::bucket::StaticCredentials {
+                access_key_id: "foks-b3-fixture".into(),
+                secret_access_key: "foks-b3-fixture".into(),
+                session_token: None,
+            }),
+            Some("foks-b3-probe"),
+        )
+        .expect("actual Bucket/S3 client");
+        // Both complete futures are owned inline. No fixture task or listener
+        // escapes if the eight-second test bound is reached; there is no sleep.
+        let result = tokio::time::timeout(Duration::from_secs(8), async {
+            tokio::join!(
+                super::check_bucket_contract(&bucket),
+                b3_serve_probe(listener, case)
+            )
+        })
+        .await;
+        drop(bucket);
+        let (verdict, served) = result.expect("finite actual Bucket probe and fixture completion");
+        let served = served.expect("exact scripted S3 request contract");
+        match case {
+            B3BucketCase::Positive => {
+                assert_eq!(served, 8);
+                assert_eq!(verdict, Ok(()));
+            }
+            B3BucketCase::Transport => {
+                assert_eq!(served, 2);
+                assert_eq!(verdict, Err(Refusal::Failed));
+            }
+            B3BucketCase::Violation => {
+                assert_eq!(served, 3);
+                assert_eq!(verdict, Err(Refusal::Invalid));
+            }
+        }
+        eprintln!("FOKS_B3_BUCKET_CASE case={case:?} requests={served} fixture_disposed=true");
+    });
+}
+
+#[test]
+fn b3_bucket_probe_positive() {
+    b3_bucket_probe(B3BucketCase::Positive);
+}
+
+#[test]
+fn b3_bucket_probe_transport_refusal() {
+    b3_bucket_probe(B3BucketCase::Transport);
+}
+
+#[test]
+fn b3_bucket_probe_contract_refusal() {
+    b3_bucket_probe(B3BucketCase::Violation);
+}
