+            .register_owned(owner, 0, None, Some(guard))
+            .unwrap(),
+        &node.effects,
+    );
+    assert_eq!(counter.load(Ordering::SeqCst), 1);
+    b3_empty_pending(&node.effects, &context);
+    node.effects.retire_completed_records();
+    assert_eq!(counter.load(Ordering::SeqCst), 1);
+    assert!(weak.upgrade().is_some());
+    drop(context);
+    node.effects.retire_completed_records();
+    assert_eq!(counter.load(Ordering::SeqCst), 0);
+    assert!(weak.upgrade().is_none());
+    draining.store(true, Ordering::SeqCst);
+    assert!(crate::actor::PublicRequestGuard::acquire_for_test(&draining, &counter).is_none());
+}
