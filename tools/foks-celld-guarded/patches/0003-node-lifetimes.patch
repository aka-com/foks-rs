+fn b2_h_actor_poll_under_lock<T: Send>(mutex: &Mutex<T>, registry: &Arc<OwnedEffectRegistry>) {
+    let (returned, polled, woke) = std::thread::scope(|scope| {
+        let guard = mutex.lock().unwrap();
+        let (finished, completion) = std::sync::mpsc::sync_channel(1);
+        let helper = std::thread::Builder::new()
+            .spawn_scoped(scope, move || {
+                let wake = Arc::new(B2HWake(AtomicBool::new(false)));
+                let waker = futures_util::task::waker(wake.clone());
+                let mut cx = Context::from_waker(&waker);
+                let polled = registry.poll_actor(&mut cx);
+                let _ = finished.try_send(());
+                (polled, wake.0.load(Ordering::SeqCst))
+            })
+            .expect("actor poll observation helper");
+        let returned = completion.recv_timeout(Duration::from_secs(5)).is_ok();
+        drop(guard);
+        let (polled, woke) = helper.join().expect("actor observation joined");
+        (returned, polled, woke)
+    });
+    // Unexpected returned ownership is disposed only after the actual held
+    // guard and helper are gone. The old blocking scan fails without hanging.
+    let pending = polled.is_pending();
+    drop(polled);
+    assert!(returned && pending && woke);
+}
