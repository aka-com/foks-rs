+#[test]
+fn b2_generation_pin_blocks_drained_removal() {
+    let current = crate::generation::Generation::empty_guarded_for_test(2);
+    let old = crate::generation::Generation::empty_guarded_for_test(1);
+    assert!(old.is_drained()); // reaper's optimistic zero observation
+    let generations = std::sync::RwLock::new(crate::cell_runtime::Generations {
+        current,
+        draining: vec![old.clone()],
+    });
+    let pin = {
+        let guard = generations.read().unwrap();
+        guard.draining[0].try_guarded_pin().unwrap()
+    };
+    assert!(generations
+        .write()
+        .unwrap()
+        .remove_guarded_drained(&old)
+        .is_none());
+    assert_eq!(generations.read().unwrap().draining.len(), 1);
+    pin.release_unstarted().unwrap();
+    assert_eq!(
+        generations.write().unwrap().remove_guarded_drained(&old),
