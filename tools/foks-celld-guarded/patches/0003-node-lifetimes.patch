+impl NodeControl {
+    pub(crate) fn check_identity(&self) -> Result<(), Refusal> {
+        let registry = self.registry.upgrade().ok_or(Refusal::Failed)?;
+        let state = lock_owned(&registry.state)?;
+        let actual = match self.slot {
+            Some(slot) => {
+                let cell = state.cells.get(slot).ok_or(Refusal::Invalid)?;
+                if cell.generation != self.generation {
+                    return Err(Refusal::Invalid);
+                }
+                cell.request.as_ref()
+            }
+            None => state.process.as_ref(),
+        };
+        if actual.is_none_or(|request| !Arc::ptr_eq(request, &self.control.request)) {
+            return Err(Refusal::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn check(&self) -> Result<(), Refusal> {
+        self.check_identity()?;
+        let registry = self.registry.upgrade().ok_or(Refusal::Failed)?;
+        if registry.stopped.load(Ordering::Acquire) {
+            self.fail();
+            return Err(Refusal::Cancelled);
+        }
+        self.control.check()
+    }
+
+    pub(crate) fn charge(&self, bytes: usize) -> Result<(), Refusal> {
+        self.check()?;
+        self.control.charge(bytes)?;
+        self.check()
+    }
+
+    pub(crate) fn fail(&self) {
+        self.control.request.fail();
+        self.control.cancelled.store(true, Ordering::Release);
+        if self.control.role == OwnerRole::Process {
+            if let Some(registry) = self.registry.upgrade() {
+                registry.stopped.store(true, Ordering::Release);
+            }
+        }
+    }
+
+    pub(crate) fn deadline(&self) -> Result<Instant, Refusal> {
+        self.control.deadline.ok_or(Refusal::Invalid)
+    }
+
+    pub(crate) fn same_owner(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.control, &other.control)
+            && Weak::ptr_eq(&self.registry, &other.registry)
+            && self.slot == other.slot
+            && self.generation == other.generation
+    }
+
+    pub(super) fn cleanup(&self, kind: CleanupKind) -> Result<usize, Refusal> {
+        // Reserved cleanup is independent of the expired/failed forward check.
+        self.check_identity()?;
+        if self.control.role != OwnerRole::Invocation {
+            return Err(Refusal::Invalid);
+        }
+        let mut credits = lock_owned(&self.control.cleanup)?;
+        credits.consume_closed(kind).map(|credit| credit.bytes)
+    }
+
+    pub(in crate::guarded_execution) fn a2_owner(&self) -> Arc<dyn std::any::Any + Send + Sync> {
+        // Coercion of the original Arc, not an extra pointer-sized allocation.
+        self.control.clone()
+    }
+}
+
+impl OriginalOwner {
+    pub(super) fn node_control(&self) -> NodeControl {
+        NodeControl {
+            control: self.control.clone(),
+            registry: Arc::downgrade(&self.registry),
+            slot: self.slot,
+            generation: self.generation,
+        }
+    }
+}
