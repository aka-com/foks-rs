+impl Future for ControlWait {
+    type Output = Result<(), Refusal>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        if !self.active {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        let registry = match self.context.registry() {
+            Ok(value) => value,
+            Err(error) => return Poll::Ready(Err(error)),
+        };
+        match registry.poll_root(&self.context, cx, false) {
+            Poll::Ready(Ok(RootResult::Control(result))) => {
+                self.active = false;
+                if let Err(error) = result {
+                    self.context.fail();
+                    return Poll::Ready(Err(error));
+                }
+                Poll::Ready(registry.finish_root(&self.context))
+            }
+            Poll::Ready(Ok(other)) => {
+                self.context.fail();
+                std::mem::forget(other);
+                Poll::Ready(Err(Refusal::Invalid))
+            }
+            Poll::Ready(Err(error)) => {
+                self.context.fail();
+                Poll::Ready(Err(error))
+            }
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
