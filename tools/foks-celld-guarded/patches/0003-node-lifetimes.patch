+// Fixed tombstones live in the already charged registry. Disposing is an
+// occupied marker while the sole local guard owns the concrete resources.
+// Only a completed physical cleanup may become PendingOwner; Failed never
+// retries cleanup. An unexpected registry/guard Drop retains actual owners.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum HeldPhase {
+    Disposing,
+    PendingOwner,
+    Failed,
+}
+struct HeldRetirement {
+    phase: HeldPhase,
+    owner: Option<control::OriginalOwner>,
+    held_owner: Option<control::HeldOwner>,
+    lease: Option<super::Lease>,
+}
+impl HeldRetirement {
+    fn marker() -> Self {
+        Self {
+            phase: HeldPhase::Disposing,
+            owner: None,
+            held_owner: None,
+            lease: None,
+        }
+    }
+    fn fail(&mut self) {
+        self.phase = HeldPhase::Failed;
+        if let Some(lease) = &self.lease {
+            lease.capacity.quarantine(lease.token);
+        }
+        if let Some(owner) = &self.owner {
+            owner.fail();
+        }
+    }
+    fn dispose_record(record: InvocationRecord) -> Self {
+        let InvocationRecord {
+            state,
+            control,
+            owner,
+            ..
+        } = record;
+        let (mut state, state_poisoned) = match state.into_inner() {
+            Ok(state) => (state, false),
+            Err(error) => (error.into_inner(), true),
+        };
+        let (owner, owner_poisoned) = match owner.into_inner() {
+            Ok(owner) => (owner, false),
+            Err(error) => (error.into_inner(), true),
+        };
+        let mut held = Self {
+            phase: HeldPhase::Disposing,
+            owner,
+            held_owner: None,
+            lease: state.lease.take(),
+        };
+        let pin = state.generation_pin.take();
+        // The production predicate proved all roots/results/native resources
+        // disposed. Retired attachments and all their non-issuing contexts die
+        // before the final original control. No bank/state guard is held.
+        drop(state);
+        drop(control);
+        let result = (|| {
+            if state_poisoned || owner_poisoned {
+                return Err(Refusal::Failed);
+            }
+            let pin = pin.ok_or(Refusal::Invalid)?;
+            let lease = held.lease.as_ref().ok_or(Refusal::Invalid)?;
+            lease.capacity.node_payloads_disposed(lease.token)?;
+            lease.capacity.node_detach(lease.token)?;
+            pin.release_retired(&GenerationRetirementProof { _complete: () })?;
+            Ok::<(), Refusal>(())
+        })();
+        if result.is_ok() {
+            held.phase = HeldPhase::PendingOwner;
+        } else {
+            held.fail();
+        }
+        held
+    }
+    fn advance_owner(&mut self) -> Result<bool, Refusal> {
+        if self.phase != HeldPhase::PendingOwner {
+            return Ok(false);
+        }
+        let owner = self.owner.as_ref().ok_or(Refusal::Invalid)?;
+        if !owner.ready_to_retire_started() {
+            return Ok(false);
+        }
+        // All earlier disposal steps ran exactly once. No new alias can be
+        // issued from this tombstone; the actual consuming operation remains
+        // authoritative and any unexpected alias/error becomes permanent hold.
+        let owner = self.owner.take().ok_or(Refusal::Invalid)?;
+        if let Err(owner) = owner.retire_started(RetirementProof { _complete: () }) {
+            self.held_owner = Some(owner);
+            self.fail();
+            return Err(Refusal::Failed);
+        }
+        let lease = self.lease.as_ref().ok_or(Refusal::Invalid)?;
+        if let Err(error) = lease.capacity.node_publish_free(lease.token) {
+            self.fail();
+            return Err(error);
+        }
+        let mut lease = self.lease.take().ok_or(Refusal::Invalid)?;
+        lease.finished = true;
+        drop(lease);
+        Ok(true)
+    }
+}
+impl Drop for HeldRetirement {
+    fn drop(&mut self) {
+        if let Some(lease) = self.lease.take() {
+            lease.capacity.quarantine(lease.token);
+            std::mem::forget(lease);
+        }
+        if let Some(owner) = self.owner.take() {
+            owner.fail();
+            std::mem::forget(owner);
+        }
+        if let Some(owner) = self.held_owner.take() {
+            std::mem::forget(owner);
+        }
+    }
+}
+fn terminal_conjuncts(state: &InvocationState) -> bool {
+    !state.tainted
+        && state.retiring
+        && state.lease.is_some()
+        && state.runtime.is_none()
+        && state.activation.is_none()
+        && state.generation_pin.is_some()
+        && state
+            .attachment
+            .as_ref()
+            .is_some_and(crate::ltx_repl::EpochAttachment::retired)
+        && state.eviction_result == Some(Ok(celld_logic::EvictSuccess::Evicted))
+        && state.controls[3].processed
+        && state
+            .controls
+            .iter()
+            .all(|cell| !cell.pending && !cell.delivered && (!cell.charged || cell.processed))
+        && state.roots.iter().all(RootCell::disposed)
+        && state.roots[ForwardLane::Driver as usize].sequence != 0
+        && state.roots[JobRole::Cleanup(CleanupLane::Stop).index()].state == RootState::Spent
+        && state.roots[JobRole::Cleanup(CleanupLane::Retirement).index()].state == RootState::Spent
+        && (!(state.primary_proof.is_some() || state.auxiliary_proof.is_some())
+            || state.roots[JobRole::Cleanup(CleanupLane::TerminalProof).index()].state
+                == RootState::Spent)
+        && state
+            .activities
+            .iter()
+            .enumerate()
+            .all(|(index, activity)| {
+                (!activity.issued && index == 1)
+                    || activity.finish_processed
+                        && activity.inactive
+                        && activity.finish_disposed
+                        && (index == 0 || activity.sync_disposed)
+                        && !activity.route_pending
+                        && !activity.route_consumer
+                        && activity.route.is_none()
+                        && activity.route_input.is_none()
+                        && activity.output.as_ref().is_some_and(|output| {
+                            output.done && output.result.is_none() && !output.pending
+                        })
+            })
+}
+impl OwnedEffectRegistry {
+    #[cfg(test)]
+    fn retire_completed_records(&self) {
+        self.retire_completed_records_with(None);
+    }
+    fn retire_completed_records_with(&self, mut poll: Option<&mut Context<'_>>) {
+        let mut retry = false;
+        let mut state_poisoned = false;
+        for slot in 0..2 {
+            let candidate = {
+                let mut bank = if let Some(cx) = poll.as_deref_mut() {
+                    match poll_owned(&self.bank, cx) {
+                        Poll::Ready(Ok(bank)) => bank,
+                        Poll::Ready(Err(_)) => {
+                            self.process.fail();
+                            return;
+                        }
+                        Poll::Pending => return,
+                    }
+                } else {
+                    match lock_owned(&self.bank) {
+                        Ok(bank) => bank,
+                        Err(_) => {
+                            self.process.fail();
+                            return;
+                        }
+                    }
+                };
+                if let Some(held) = &bank.held[slot] {
+                    if held.phase != HeldPhase::PendingOwner {
+                        continue;
+                    }
+                    Some(Err(bank.held[slot]
+                        .replace(HeldRetirement::marker())
+                        .expect("present pending owner")))
+                } else {
+                    let Some(record) = bank.records[slot].as_ref() else {
+                        continue;
+                    };
+                    // Exclude admitted state observers before the exceptional
+                    // terminal bank -> state inspection. The later try_unwrap
