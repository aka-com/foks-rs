+    #[cfg(test)]
+    pub(crate) fn assert_guarded_paths_for_test() {
+        // Supplements the actual managed-DB/Worker adoption assertion; these
+        // string cases alone do not establish a successful activation.
+        let directory = Path::new("/tmp/guarded-component");
+        let cell = crate::js::guarded_node::TENANT_IDS[0];
+        let expected = directory.join(cell).join("ltx/e42/db.sqlite");
+        assert!(canonical_path(&expected, directory, cell, 42));
+        assert!(!canonical_path(&expected, directory, cell, 43));
+        assert!(!canonical_path(
+            &expected,
+            directory,
+            crate::js::guarded_node::TENANT_IDS[1],
+            42
+        ));
+        assert!(!canonical_path(
+            &expected,
+            Path::new("/tmp/other"),
+            cell,
+            42
+        ));
+        for suffix in [
+            "ltx/e042/db.sqlite",
+            "ltx/e+42/db.sqlite",
+            "ltx/e42/../db.sqlite",
+            "ltx/e42/db.sqlite/extra",
+            "ltx/e18446744073709551616/db.sqlite",
+        ] {
+            assert!(!canonical_path(
+                &directory.join(cell).join(suffix),
+                directory,
+                cell,
+                42
+            ));
+        }
+    }
