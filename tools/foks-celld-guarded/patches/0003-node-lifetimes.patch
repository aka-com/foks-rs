+#[derive(Clone)]
+pub(crate) struct JobContext {
+    registry: Weak<OwnedEffectRegistry>,
+    token: RootToken,
+    role: JobRole,
+    cell: &'static str,
+    request: u64,
+    deadline: Instant,
+    control: NodeControl,
+}
+impl OwnedEffectRegistry {
+    fn new(process: NodeControl) -> Result<Arc<Self>, Refusal> {
+        process.charge(control::arc_bytes::<Self>()?)?;
+        let capacity = super::Capacity::for_node(&process)?;
+        Ok(Arc::new_cyclic(|own| Self {
+            own: own.clone(),
+            bank: Mutex::new(BankState {
+                records: [None, None],
+                held: [None, None],
+                next: 0,
+                actor_waker: None,
+            }),
+            capacity,
+            process,
+        }))
+    }
+    fn record(&self, token: RootToken) -> Result<Arc<InvocationRecord>, Refusal> {
+        let bank = lock_owned(&self.bank)?;
+        let record = bank
+            .records
+            .get(token.slot as usize)
+            .and_then(Option::as_ref)
+            .ok_or(Refusal::Invalid)?;
+        if record.sequence != token.invocation {
+            return Err(Refusal::Invalid);
+        }
+        Ok(record.clone())
+    }
+    fn wake_actor(&self) {
+        let wake = lock_owned(&self.bank)
+            .ok()
+            .and_then(|mut bank| bank.actor_waker.take());
+        if let Some(wake) = wake {
+            wake.wake();
+        }
+    }
+    fn quarantine(&self, token: RootToken) {
+        if let Ok(record) = self.record(token) {
+            record.control.fail();
+            if let Ok(mut state) = lock_owned(&record.state) {
+                state.tainted = true;
+                if let Some(lease) = &state.lease {
+                    lease.capacity.quarantine(lease.token);
+                }
+            }
+        }
+    }
+    fn root<'a>(
+        state: &'a mut InvocationState,
+        token: RootToken,
+    ) -> Result<&'a mut RootCell, Refusal> {
+        let root = state
+            .roots
+            .get_mut(token.lane as usize)
+            .ok_or(Refusal::Invalid)?;
+        if root.sequence != token.sequence
+            || matches!(root.state, RootState::Empty | RootState::Spent)
+        {
+            return Err(Refusal::Invalid);
+        }
+        Ok(root)
+    }
+    fn context(
+        self: &Arc<Self>,
+        record: &InvocationRecord,
+        slot: usize,
+        role: JobRole,
+        sequence: u64,
+    ) -> Result<JobContext, Refusal> {
+        let state = lock_owned(&record.state)?;
+        self.context_locked(record, &state, slot, role, sequence)
+    }
+    fn context_locked(
+        self: &Arc<Self>,
+        record: &InvocationRecord,
+        state: &InvocationState,
+        slot: usize,
+        role: JobRole,
+        sequence: u64,
+    ) -> Result<JobContext, Refusal> {
+        Ok(JobContext {
+            registry: Arc::downgrade(self),
+            token: RootToken {
+                slot: slot as u8,
+                invocation: record.sequence,
+                lane: role.index() as u8,
+                sequence,
+            },
+            role,
+            cell: record.cell,
+            request: state.activities[usize::from(role == JobRole::Forward(ForwardLane::AuxProof))]
+                .request,
+            deadline: record.control.deadline()?,
+            control: record.control.clone(),
+        })
+    }
+    fn reserve(
+        self: &Arc<Self>,
+        slot: usize,
+        role: JobRole,
+        kind: RootKind,
+        op: Option<OpId>,
+    ) -> Result<JobContext, Refusal> {
+        let record = {
+            let bank = if matches!(role, JobRole::Forward(_)) {
+                self.bank.try_lock().map_err(|_| Refusal::Contended)?
+            } else {
+                lock_owned(&self.bank)?
+            };
+            bank.records
+                .get(slot)
+                .and_then(Option::as_ref)
+                .cloned()
+                .ok_or(Refusal::Invalid)?
+        };
+        if matches!(role, JobRole::Forward(_)) {
+            record.control.check()?;
+        } else {
+            record.control.check_identity()?;
+        }
+        let sequence = {
+            let mut state = if matches!(role, JobRole::Forward(_)) {
+                record.state.try_lock().map_err(|_| Refusal::Contended)?
+            } else {
+                lock_owned(&record.state)?
+            };
+            if matches!(role, JobRole::Forward(_)) && (state.tainted || state.retiring) {
+                return Err(Refusal::Failed);
+            }
+            let root = &mut state.roots[role.index()];
+            if root.state != RootState::Empty || !root.child.clear() {
+                return Err(Refusal::Busy);
+            }
+            if let JobRole::Cleanup(lane) = role {
+                record
+                    .control
+                    .cleanup(control::CleanupKind::Task(lane as u8))?;
+            }
+            root.sequence = root.sequence.checked_add(1).ok_or(Refusal::Exhausted)?;
+            root.state = RootState::Reserved;
+            root.kind = Some(kind);
+            root.op = op;
+            root.owned_used = 0;
+            root.child_creations = 0;
+            root.sequence
+        };
+        self.context(&record, slot, role, sequence)
+    }
+    fn finish_root(&self, context: &JobContext) -> Result<(), Refusal> {
+        let record = self.record(context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let root = Self::root(&mut state, context.token)?;
+        if root.state != RootState::Delivered
+            || root.handle.is_some()
+            || root.receiver.is_some()
+            || root.result.is_some()
+            || !root.child.clear()
+        {
+            state.tainted = true;
+            record.control.fail();
+            return Err(Refusal::Failed);
+        }
+        root.state = if matches!(context.role, JobRole::Forward(_)) {
+            RootState::Empty
+        } else {
+            RootState::Spent
+        };
+        root.consumer = false;
+        let wake = root.waker.take();
+        let abandon = root.abandon.take();
+        root.wake = None;
+        drop(state);
+        drop(record);
+        drop(abandon);
+        if let Some(wake) = wake {
+            wake.wake();
+        }
+        self.wake_actor();
+        Ok(())
+    }
+    fn poll_record(
+        &self,
+        token: RootToken,
+        cx: &mut Context<'_>,
+    ) -> Poll<Result<Arc<InvocationRecord>, Refusal>> {
+        let bank = match poll_owned(&self.bank, cx) {
+            Poll::Ready(Ok(bank)) => bank,
+            Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+            Poll::Pending => return Poll::Pending,
+        };
+        let Some(record) = bank
+            .records
+            .get(token.slot as usize)
+            .and_then(Option::as_ref)
+        else {
+            return Poll::Ready(Err(Refusal::Invalid));
+        };
+        if record.sequence != token.invocation {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        Poll::Ready(Ok(record.clone()))
+    }
+    fn poll_root(
+        &self,
+        context: &JobContext,
+        cx: &mut Context<'_>,
+        actor: bool,
+    ) -> Poll<Result<RootResult, Refusal>> {
+        let record = match self.poll_record(context.token, cx) {
+            Poll::Ready(Ok(record)) => record,
+            Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+            Poll::Pending => return Poll::Pending,
+        };
+        let incoming = cx.waker().clone();
+        let mut previous = DeferredWaker(None);
+        let mut consumed_handle = None;
+        let mut consumed_receiver = None;
+        let mut state = match poll_owned(&record.state, cx) {
+            Poll::Ready(Ok(state)) => state,
+            Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+            Poll::Pending => return Poll::Pending,
+        };
+        let root = match Self::root(&mut state, context.token) {
+            Ok(root) => root,
+            Err(error) => return Poll::Ready(Err(error)),
+        };
+        if !actor && !root.consumer {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        previous.0 = root.waker.replace(incoming);
+        if let Some(handle) = root.handle.as_mut() {
+            match Pin::new(handle).poll_guarded(cx) {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Ok(())) => {
+                    consumed_handle = root.handle.take();
+                    root.state = RootState::Joined;
+                }
+                Poll::Ready(Err(error)) => {
+                    let handle = root.handle.take();
+                    root.state = RootState::Quarantined;
+                    state.tainted = true;
+                    drop(state);
+                    drop(record);
+                    context.fail();
+                    drop(handle);
+                    drop(error);
+                    return Poll::Ready(Err(Refusal::Failed));
+                }
+            }
+        }
+        if root.state != RootState::Joined {
+            return Poll::Pending;
+        }
+        if root.result.is_none() {
+            let Some(receiver) = root.receiver.as_mut() else {
+                return Poll::Ready(Err(Refusal::Failed));
+            };
+            match receiver.try_recv() {
+                Ok(value) => {
+                    consumed_receiver = root.receiver.take();
+                    root.result = Some(value);
+                }
+                Err(_) => {
+                    root.state = RootState::Quarantined;
+                    state.tainted = true;
+                    drop(state);
+                    drop(record);
+                    context.fail();
+                    drop(consumed_handle);
+                    return Poll::Ready(Err(Refusal::Failed));
+                }
+            }
+        }
+        let result = root.result.take().ok_or(Refusal::Failed);
+        root.state = RootState::Delivered;
+        drop(state);
+        drop(record);
+        drop(consumed_handle);
+        drop(consumed_receiver);
+        Poll::Ready(result)
+    }
+    fn spawn_root<Fut, T>(
+        &self,
+        context: &JobContext,
+        capture_bytes: usize,
+        future: Fut,
+        convert: fn(T) -> RootResult,
+    ) -> Result<(), Refusal>
+    where
+        Fut: Future<Output = T> + Send + 'static,
+        T: Send + 'static,
+    {
+        context.check_job()?;
+        let (sender, receiver) = {
+            let layout = actual_future_layout(RootWork::<Fut, T>::run);
+            let bytes = capture_bytes
+                .checked_add(layout.size())
+                .and_then(|value| value.checked_add(std::mem::size_of::<RootResult>()))
+                .ok_or(Refusal::Bounds)?;
+            if bytes > ROOT_PAYLOAD_LIMIT || layout.align() > 16 {
+                context.fail();
+                return Err(Refusal::Bounds);
+            }
+            context.charge_task_payload(bytes)?;
+            context.charge_owned(channel_bound::<RootResult>()?)?;
+            tokio::sync::oneshot::channel()
+        };
+        let work = RootWork {
+            future,
+            sender,
+            convert,
+            control: context.control.clone(),
+            publication: Publication::new(&self.record(context.token)?, context.token, None),
+        };
+        let record = self.record(context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let root = Self::root(&mut state, context.token)?;
+        if root.state != RootState::Reserved || root.handle.is_some() || root.receiver.is_some() {
+            return Err(Refusal::Busy);
+        }
+        if matches!(context.role, JobRole::Forward(_)) {
+            context.control.check()?;
+        }
+        root.receiver = Some(receiver);
+        // The canonical shared host domain is independent of the actor's
+        // dedicated lease runtime. No ambient-runtime task admission is used.
+        root.handle = Some(crate::asyncrt::spawn(work.run()));
+        root.state = RootState::Running;
+        drop(state);
+        self.wake_actor();
+        Ok(())
+    }
+}
+impl Drop for OwnedEffectRegistry {
+    fn drop(&mut self) {
+        // A component may lose its final bank Arc. Dropping live handles would
+        // detach work and release origins; retain the exact concrete bank rows.
+        let state = self
+            .bank
+            .get_mut()
+            .unwrap_or_else(|error| error.into_inner());
+        for record in &mut state.records {
+            if let Some(record) = record.take() {
+                record.control.fail();
+                std::mem::forget(record);
+            }
+        }
+    }
+}
+
+impl JobContext {
+    fn registry(&self) -> Result<Arc<OwnedEffectRegistry>, Refusal> {
+        self.registry.upgrade().ok_or(Refusal::Failed)
+    }
+    pub(crate) fn check_identity(&self) -> Result<(), Refusal> {
+        self.control.check_identity()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        if record.cell != self.cell || !record.control.same_owner(&self.control) {
+            return Err(Refusal::Invalid);
+        }
+        let mut state = lock_owned(&record.state)?;
+        let index = usize::from(self.role == JobRole::Forward(ForwardLane::AuxProof));
+        if self.request != state.activities[index].request
+            || self.deadline != self.control.deadline()?
+        {
+            return Err(Refusal::Invalid);
+        }
+        if self.token.lane == u8::MAX {
+            if self.role != JobRole::Forward(ForwardLane::Driver) || self.token.sequence != 0 {
+                return Err(Refusal::Invalid);
+            }
+        } else {
+            if self.role.index() != self.token.lane as usize {
+                return Err(Refusal::Invalid);
+            }
+            OwnedEffectRegistry::root(&mut state, self.token)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn check_job(&self) -> Result<(), Refusal> {
+        self.check_identity()?;
+        if matches!(self.role, JobRole::Forward(_)) {
+            self.check_forward()?;
+        }
+        Ok(())
+    }
+    pub(crate) fn check_forward(&self) -> Result<(), Refusal> {
+        self.check_identity()?;
+        self.control.check()?;
+        #[cfg(test)]
+        tests::forward_observation_barrier()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let state = lock_owned(&record.state)?;
+        if state.tainted || state.retiring {
+            return Err(Refusal::Failed);
+        }
+        drop(state);
+        drop(record);
+        self.control.check()
+    }
+    pub(crate) fn require_role(&self, role: JobRole) -> Result<(), Refusal> {
+        if self.role != role {
+            return Err(Refusal::Invalid);
+        }
+        self.check_job()
+    }
+    pub(crate) fn role(&self) -> JobRole {
+        self.role
+    }
+    pub(crate) fn original_deadline(&self) -> Instant {
+        self.deadline
+    }
+    pub(crate) fn forward_remaining(&self) -> Result<Duration, Refusal> {
+        self.check_forward()?;
+        self.deadline
+            .checked_duration_since(Instant::now())
+            .filter(|value| !value.is_zero())
+            .ok_or(Refusal::Expired)
+    }
+    // This is the original A0 acceptance Instant, not a renewable execution-
+    // domain budget. The canonical timer facade has no absolute std Instant.
+    #[allow(clippy::disallowed_methods)]
+    pub(crate) async fn bound_forward<F: Future>(&self, future: F) -> Result<F::Output, Refusal> {
+        self.check_forward()?;
+        match tokio::time::timeout_at(tokio::time::Instant::from_std(self.deadline), future).await {
+            Ok(value) => {
+                self.check_forward()?;
+                Ok(value)
+            }
+            Err(_) => {
+                self.fail();
+                Err(Refusal::Expired)
+            }
+        }
+    }
+    pub(crate) fn fail(&self) {
+        self.control.fail();
+        if let Ok(registry) = self.registry() {
+            registry.quarantine(self.token);
+        }
+    }
+    pub(crate) fn cell(&self) -> &'static str {
+        self.cell
+    }
+    pub(crate) fn request(&self) -> u64 {
+        self.request
+    }
+    pub(crate) fn epoch(&self) -> Option<u64> {
+        let registry = self.registry().ok()?;
+        let record = registry.record(self.token).ok()?;
+        let state = lock_owned(&record.state).ok()?;
+        state.epoch
+    }
+    pub(crate) fn generation(&self) -> Option<crate::generation::GenerationId> {
+        let registry = self.registry().ok()?;
+        let record = registry.record(self.token).ok()?;
+        let state = lock_owned(&record.state).ok()?;
+        state.generation
+    }
+    pub(crate) fn fresh(&self) -> Option<bool> {
+        let registry = self.registry().ok()?;
+        let record = registry.record(self.token).ok()?;
+        let state = lock_owned(&record.state).ok()?;
+        state.fresh
+    }
+    pub(crate) fn root_token(&self) -> RootToken {
+        self.token
+    }
+    pub(crate) fn same_invocation(&self, other: &Self) -> bool {
+        self.token.slot == other.token.slot
+            && self.token.invocation == other.token.invocation
+            && Weak::ptr_eq(&self.registry, &other.registry)
+            && self.control.same_owner(&other.control)
+            && self.cell == other.cell
+    }
+    pub(crate) fn bind_generation(
+        &self,
+        generation: crate::generation::GenerationId,
+    ) -> Result<(), Refusal> {
+        self.require_role(JobRole::Forward(ForwardLane::Activation))?;
+        if generation == 0 {
+            return Err(Refusal::Invalid);
+        }
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        match state.generation {
+            Some(actual) if actual != generation => Err(Refusal::Invalid),
+            _ => {
+                state.generation = Some(generation);
+                Ok(())
+            }
+        }
+    }
+    pub(crate) fn charge_owned(&self, bytes: usize) -> Result<(), Refusal> {
+        self.check_job()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let root = OwnedEffectRegistry::root(&mut state, self.token)?;
+        let next = root.owned_used.checked_add(bytes).ok_or(Refusal::Bounds)?;
+        if next > ROOT_OWNED_LIMIT {
+            record.control.fail();
+            state.tainted = true;
+            return Err(Refusal::Bounds);
+        }
+        if matches!(self.role, JobRole::Forward(_)) {
+            self.control.charge(bytes)?;
+        }
+        root.owned_used = next;
+        Ok(())
+    }
+    fn charge_task_payload(&self, bytes: usize) -> Result<(), Refusal> {
+        if bytes > ROOT_PAYLOAD_LIMIT {
+            self.fail();
+            return Err(Refusal::Bounds);
+        }
+        if matches!(self.role, JobRole::Forward(_)) {
+            self.control.charge(bytes)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn eviction_abandon(
+        &self,
+        op: OpId,
+    ) -> Result<Option<Arc<crate::replication::EvictionAbandon>>, Refusal> {
+        self.require_role(JobRole::Cleanup(CleanupLane::Stop))?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let root = OwnedEffectRegistry::root(&mut state, self.token)?;
+        if root.op != Some(op) {
+            return Err(Refusal::Invalid);
+        }
+        Ok(root.abandon.clone())
+    }
+}
