+struct B2HLockObservation {
+    contended: bool,
+    pending: bool,
+    joined: Result<(), Refusal>,
+}
+
+fn b2_h_owned_lock<T, F>(mutex: &Mutex<T>, operation: F) -> B2HLockObservation
+where
+    T: Send,
+    F: FnOnce() -> Result<(), Refusal> + Send,
+{
+    std::thread::scope(|scope| {
+        let guard = match mutex.lock() {
+            Ok(guard) => guard,
+            Err(poisoned) => {
+                drop(poisoned);
+                return B2HLockObservation {
+                    contended: false,
+                    pending: false,
+                    joined: Err(Refusal::Failed),
+                };
+            }
+        };
+        let (notice, observed) = std::sync::mpsc::sync_channel(1);
+        let (finished, completion) = std::sync::mpsc::sync_channel(1);
+        let helper = std::thread::Builder::new().spawn_scoped(scope, move || {
+            let _notice = control::contention_notice(notice);
+            let result = operation();
+            let _ = finished.try_send(());
+            result
+        });
+        let Ok(helper) = helper else {
+            drop(guard);
+            return B2HLockObservation {
+                contended: false,
+                pending: false,
+                joined: Err(Refusal::Failed),
+            };
+        };
+        // The selected lock helper emits only at actual WouldBlock. A thread
+        // startup message cannot establish this regression's ordering.
+        let contended = observed.recv_timeout(Duration::from_secs(5)).is_ok();
+        let pending = matches!(
+            completion.try_recv(),
+            Err(std::sync::mpsc::TryRecvError::Empty)
+        );
+        drop(guard);
+        let joined = helper.join().unwrap_or(Err(Refusal::Failed));
+        B2HLockObservation {
+            contended,
+            pending,
+            joined,
+        }
+    })
+}
+
+struct B2HWake(AtomicBool);
+impl futures_util::task::ArcWake for B2HWake {
+    fn wake_by_ref(this: &Arc<Self>) {
+        this.0.store(true, Ordering::SeqCst);
+    }
+}
