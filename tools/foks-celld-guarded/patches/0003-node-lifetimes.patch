+impl OwnedEffectRegistry {
+    fn poll_child(
+        &self,
+        context: &JobContext,
+        token: ChildToken,
+        cx: &mut Context<'_>,
+    ) -> Poll<Result<NativeResult, Refusal>> {
+        let record = match self.poll_record(token.root, cx) {
+            Poll::Ready(Ok(record)) => record,
+            Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+            Poll::Pending => return Poll::Pending,
+        };
+        let incoming = cx.waker().clone();
+        let mut previous = DeferredWaker(None);
+        let mut consumed_handle = None;
+        let mut consumed_receiver = None;
+        let mut state = match poll_owned(&record.state, cx) {
+            Poll::Ready(Ok(state)) => state,
+            Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+            Poll::Pending => return Poll::Pending,
+        };
+        let root = match Self::root(&mut state, context.token) {
+            Ok(root) => root,
+            Err(error) => return Poll::Ready(Err(error)),
+        };
+        let child = &mut root.child;
+        if token.root != context.token
+            || child.sequence != token.sequence
+            || !child.consumer
+            || child.delivered
+        {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        previous.0 = child.waker.replace(incoming);
+        if let Some(handle) = child.handle.as_mut() {
+            match Pin::new(handle).poll_guarded(cx) {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Ok(())) => {
+                    consumed_handle = child.handle.take();
+                    child.joined = true;
+                }
+                Poll::Ready(Err(error)) => {
+                    let handle = child.handle.take();
+                    state.tainted = true;
+                    drop(state);
+                    drop(record);
+                    context.fail();
+                    drop(handle);
+                    drop(error);
+                    return Poll::Ready(Err(Refusal::Failed));
+                }
+            }
+        }
+        if !child.joined {
+            return Poll::Pending;
+        }
+        if child.result.is_none() {
+            let Some(receiver) = child.receiver.as_mut() else {
+                return Poll::Ready(Err(Refusal::Failed));
+            };
+            match receiver.try_recv() {
+                Ok(value) => {
+                    consumed_receiver = child.receiver.take();
+                    child.result = Some(value);
+                }
+                Err(_) => {
+                    state.tainted = true;
+                    drop(state);
+                    drop(record);
+                    context.fail();
+                    drop(consumed_handle);
+                    return Poll::Ready(Err(Refusal::Failed));
+                }
+            }
+        }
+        child.delivered = true;
+        let result = child.result.take().ok_or(Refusal::Failed);
+        drop(state);
+        drop(record);
+        drop(consumed_handle);
+        drop(consumed_receiver);
+        Poll::Ready(result)
+    }
+    fn finish_child(&self, context: &JobContext, token: ChildToken) -> Result<(), Refusal> {
+        let record = self.record(token.root)?;
+        let mut state = lock_owned(&record.state)?;
+        let root = Self::root(&mut state, context.token)?;
+        let child = &mut root.child;
+        if token.root != context.token
+            || child.sequence != token.sequence
+            || !child.delivered
+            || !child.joined
+            || child.handle.is_some()
+            || child.receiver.is_some()
+            || child.result.is_some()
+        {
+            return Err(Refusal::Invalid);
+        }
+        let sequence = child.sequence;
+        let old = std::mem::replace(
+            child,
+            NativeChildCell {
+                sequence,
+                ..NativeChildCell::new()
+            },
+        );
+        drop(state);
+        drop(record);
+        drop(old);
+        Ok(())
+    }
+}
