+impl OwnedEffectRegistry {
+    fn start_cancel_if_needed(self: &Arc<Self>, origin: &JobContext) -> Result<(), Refusal> {
+        let record = self.record(origin.token)?;
+        {
+            let mut state = lock_owned(&record.state)?;
+            if state.roots[ForwardLane::Driver as usize].disposed() {
+                return Ok(());
+            }
+            state.cancel_requested = true;
+            record.control.fail();
+            if let Some(runtime) = &state.runtime {
+                runtime.cancel();
+            }
+            let cancel = &state.roots[JobRole::Cleanup(CleanupLane::Cancel).index()];
+            if cancel.state != RootState::Empty {
+                return Ok(());
+            }
+        }
+        origin
+            .claim_control(CleanupLane::Cancel)?
+            .submit_node(crate::runtime::guarded_cancel)?
+            .park_cancel()
+    }
