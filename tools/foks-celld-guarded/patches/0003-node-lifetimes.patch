+pub(crate) struct OwnedNodeNativeCompletion {
+    value: Option<NodeNativeCompletion>,
+    context: JobContext,
+    child: ChildToken,
+    consumed: bool,
+}
+impl NativePermit {
+    pub(crate) fn submit_node<F>(mut self, work: F) -> Result<NodeNativeWait, Refusal>
+    where
+        F: FnOnce() -> NodeNativeCompletion + Send + 'static,
+    {
+        self.context.check_job()?;
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let child = &mut OwnedEffectRegistry::root(&mut state, self.context.token)?.child;
+        if child.sequence != self.child.sequence
+            || child.handle.is_some()
+            || !child.consumer
+            || !matches!(
+                child.kind,
+                Some(
+                    NativeKind::RestoredAlarm | NativeKind::WorkerBuild | NativeKind::WorkerDestroy
+                )
+            )
+        {
+            return Err(Refusal::Invalid);
+        }
+        let bytes = std::mem::size_of::<NativeWork<F, NodeNativeCompletion>>()
+            .checked_add(std::mem::size_of::<NativeResult>())
+            .and_then(|value| value.checked_add(channel_bound::<NativeResult>().ok()?))
+            .ok_or(Refusal::Bounds)?;
+        if bytes > NATIVE_LIMIT
+            || std::mem::align_of::<F>() > 16
+            || std::mem::align_of::<NativeResult>() > 16
+        {
+            self.context.control.fail();
+            return Err(Refusal::Bounds);
+        }
+        if matches!(self.context.role, JobRole::Forward(_)) {
+            self.context.control.charge(bytes)?;
+        }
+        if matches!(self.context.role, JobRole::Forward(_)) {
+            self.context.control.check()?;
+        }
+        let (sender, receiver) = tokio::sync::oneshot::channel();
+        let work = NativeWork {
+            work,
+            sender,
+            convert: NativeResult::Node,
+            control: self.context.control.clone(),
+            publication: Publication::new(&record, self.context.token, Some(self.child.sequence)),
+        };
+        child.receiver = Some(receiver);
+        child.handle = Some(crate::asyncrt::blocking(move || work.run()));
+        self.submitted = true;
+        Ok(NodeNativeWait {
+            context: self.context.clone(),
+            child: self.child,
+            active: true,
+        })
+    }
+}
+impl Future for NodeNativeWait {
+    type Output = Result<OwnedNodeNativeCompletion, Refusal>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        if !self.active {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        let registry = match self.context.registry() {
+            Ok(value) => value,
+            Err(error) => return Poll::Ready(Err(error)),
+        };
+        match registry.poll_child(&self.context, self.child, cx) {
+            Poll::Ready(Ok(NativeResult::Node(value))) => {
+                self.active = false;
+                Poll::Ready(Ok(OwnedNodeNativeCompletion {
+                    value: Some(value),
+                    context: self.context.clone(),
+                    child: self.child,
+                    consumed: false,
+                }))
+            }
+            Poll::Ready(Ok(other)) => {
+                self.context.fail();
+                std::mem::forget(other);
+                Poll::Ready(Err(Refusal::Invalid))
+            }
+            Poll::Ready(Err(error)) => {
+                self.context.fail();
+                Poll::Ready(Err(error))
+            }
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+impl Drop for NodeNativeWait {
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        let disposition = (|| {
+            let registry = self.context.registry()?;
+            let record = registry.record(self.context.token)?;
+            let mut state = lock_owned(&record.state)?;
+            let root = OwnedEffectRegistry::root(&mut state, self.context.token)?;
+            if root.child.sequence != self.child.sequence {
+                return Err(Refusal::Invalid);
+            }
+            root.child.consumer = false;
+            let wake = root.child.waker.take();
+            drop(state);
+            drop(record);
+            if let Some(wake) = wake {
+                wake.wake();
+            }
+            Ok::<(), Refusal>(())
+        })();
+        if disposition.is_err() {
+            self.context.fail();
+        }
+    }
+}
