+    #[cfg(test)]
+    fn admitted_lock_contention<T, F>(mutex: &Mutex<T>, operation: F) -> Result<(), Refusal>
+    where
+        T: Send,
+        F: FnOnce() -> Result<(), Refusal> + Send,
+    {
+        std::thread::scope(|scope| {
+            let guard = mutex.lock().map_err(|_| Refusal::Failed)?;
+            let (witness, observed) = std::sync::mpsc::sync_channel(1);
+            let (finished, completion) = std::sync::mpsc::sync_channel(1);
+            let helper = scope.spawn(move || {
+                let _witness = LockContentionWitness::install(witness)?;
+                let result = operation();
+                let _ = finished.try_send(());
+                result
+            });
+            // This notification is emitted only after the actual production
+            // helper saw WouldBlock, not merely when this thread started.
+            let contended = observed.recv_timeout(Duration::from_secs(5)).is_ok();
+            let pending = matches!(
+                completion.try_recv(),
+                Err(std::sync::mpsc::TryRecvError::Empty)
+            );
+            drop(guard);
+            // Every observation failure still releases and joins the owned
+            // helper before an assertion/error leaves this fixture.
+            let joined = helper.join().map_err(|_| Refusal::Failed)?;
+            check_component(contended && pending)?;
+            joined
+        })
+    }
