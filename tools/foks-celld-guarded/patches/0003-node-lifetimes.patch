+    impl LtxRootCompletion {
+        pub(crate) fn retirement_result(
+            self,
+            context: &JobContext,
+            attachment: &EpochAttachment,
+        ) -> Result<(), Refusal> {
+            context.require_role(JobRole::Cleanup(CleanupLane::Retirement))?;
+            if self.role != ReplicaRole::Retirement
+                || self.token != context.root_token()
+                || !Arc::ptr_eq(&self.attachment.0, &attachment.0)
+                || !context.same_invocation(attachment.0.owner())
+                || context.epoch() != Some(attachment.0.epoch)
+                || (self.result.is_ok() && !attachment.retired())
+            {
+                std::mem::forget(self);
+                return Err(refusal(context, Refusal::Invalid));
+            }
+            self.result
+        }
+    }
+
+    fn native_resource(
+        context: &JobContext,
+        input: NativeInput,
+    ) -> Result<Box<NativeResource>, Refusal> {
+        if std::mem::align_of::<NativeResource>() > 16 {
+            return Err(refusal(context, Refusal::Bounds));
+        }
+        context.charge_owned(std::mem::size_of::<NativeResource>())?;
+        Ok(Box::new(NativeResource {
+            input,
+            output: NativeOutput::Empty,
+        }))
+    }
+
+    impl NativeWork {
+        fn into_job(self) -> impl FnOnce() -> LtxNativeCompletion {
+            move || self.run()
+        }
+
+        fn run(mut self) -> LtxNativeCompletion {
+            let status = self.attachment.0.context(self.token).and_then(|context| {
+                let kind = match &self.resource.input {
+                    NativeInput::Open(_) => NativeKind::DbOpen,
+                    NativeInput::HydratorOpen { .. } => NativeKind::HydratorOpen,
+                    NativeInput::HydratorStep(_) => NativeKind::HydratorStep,
+                    NativeInput::Sync(_) => NativeKind::SyncCapture,
+                    NativeInput::Snapshot { .. } => NativeKind::Snapshot,
+                    NativeInput::Close { .. } => NativeKind::LocalClose,
+                    NativeInput::Read { .. } => NativeKind::ReadFile,
+                    NativeInput::Opaque(_) => NativeKind::OpaqueLowerJob,
+                    NativeInput::Empty => return Err(refusal(&context, Refusal::Invalid)),
+                };
+                if kind != self.kind {
+                    return Err(refusal(&context, Refusal::Invalid));
+                }
+                Ok(())
+            });
+            if status.is_ok() {
+                let input = std::mem::replace(&mut self.resource.input, NativeInput::Empty);
+                self.resource.output = match input {
+                    NativeInput::Open(work) => NativeOutput::Open(
+                        work.ok_or_else(|| anyhow!("missing managed open input"))
+                            .and_then(OpenDbWork::run),
+                    ),
+                    NativeInput::HydratorOpen { name, path } => NativeOutput::Hydrator(
+                        celld_ltx::paged_vfs::Hydrator::open(&name, &path).map_err(Into::into),
+                    ),
+                    NativeInput::HydratorStep(mut hydrator) => match hydrator.take() {
+                        Some(mut hydrator) => {
+                            let result = hydrator.step(HYDRATE_STEP_PAGES).map_err(Into::into);
+                            NativeOutput::HydratorStep { hydrator, result }
+                        }
+                        None => NativeOutput::Empty,
+                    },
+                    NativeInput::Sync(handle) => NativeOutput::Sync(capture_sync(&handle)),
+                    NativeInput::Snapshot { handle, budget } => {
+                        NativeOutput::Snapshot(capture_snapshot(&handle, budget))
+                    }
+                    NativeInput::Close {
+                        handle,
+                        path,
+                        filesystem,
+                        disposition,
+                    } => NativeOutput::Close(close_guarded_local(
+                        &handle,
+                        &path,
+                        filesystem.as_ref(),
+                        disposition,
+                    )),
+                    NativeInput::Read { filesystem, path } => {
+                        NativeOutput::Read(filesystem.read(&path))
+                    }
+                    NativeInput::Opaque(mut job) => match job.take() {
+                        Some(job) => {
+                            job();
+                            NativeOutput::Opaque
+                        }
+                        None => NativeOutput::Empty,
+                    },
+                    NativeInput::Empty => NativeOutput::Empty,
+                };
+            }
+            LtxNativeCompletion {
+                resource: self.resource,
+                kind: self.kind,
+                token: self.token,
+                status,
+                attachment: self.attachment,
+            }
+        }
+    }
+
+    async fn native(
+        context: &JobContext,
+        attachment: EpochAttachment,
+        kind: NativeKind,
+        resource: Box<NativeResource>,
+    ) -> Result<Box<NativeResource>, Refusal> {
+        attachment.0.bind(context)?;
+        let permit = context.claim_native(kind)?;
+        let work = NativeWork {
+            resource,
+            kind,
+            token: context.root_token(),
+            attachment: attachment.clone(),
+        };
+        // The actual JoinHandle/result is held by the bank, including when this
+        // borrowing wait is dropped. Do not put a timeout around this join.
+        let joined = permit.submit_ltx(work.into_job())?.await?;
+        let mut transferred = None;
+        let mut status = Ok(());
+        joined.consume_ltx(|completion| {
+            if completion.kind != kind
+                || completion.token != context.root_token()
+                || !Arc::ptr_eq(&completion.attachment.0, &attachment.0)
+            {
+                status = Err(refusal(context, Refusal::Invalid));
+                std::mem::forget(completion);
+                return;
+            }
+            status = completion.status;
+            transferred = Some(completion.resource);
+        })?;
+        status?;
+        transferred.ok_or_else(|| refusal(context, Refusal::Invalid))
+    }
