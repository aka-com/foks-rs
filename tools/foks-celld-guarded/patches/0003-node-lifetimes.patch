+    fn same_epoch(context: &JobContext, epoch: u64) -> Result<(), Refusal> {
+        context.check_job()?;
+        if context.epoch() != Some(epoch) {
+            return Err(refused(context, Refusal::Invalid));
+        }
+        Ok(())
+    }
+
+    fn canonical_path(path: &Path, data_dir: &Path, cell: &str, epoch: u64) -> bool {
+        use std::path::Component;
+        let Ok(relative) = path.strip_prefix(data_dir) else {
+            return false;
+        };
+        let mut components = relative.components();
+        let normal = |component, text: &str| matches!(component, Some(Component::Normal(value)) if value == text);
+        if !normal(components.next(), cell) || !normal(components.next(), "ltx") {
+            return false;
+        }
+        let Some(Component::Normal(epoch_name)) = components.next() else {
+            return false;
+        };
+        let Some(digits) = epoch_name
+            .to_str()
+            .and_then(|value| value.strip_prefix('e'))
+        else {
+            return false;
+        };
+        if digits.is_empty()
+            || (digits.len() > 1 && digits.starts_with('0'))
+            || !digits.bytes().all(|byte| byte.is_ascii_digit())
+            || digits.parse::<u64>() != Ok(epoch)
+        {
+            return false;
+        }
+        normal(components.next(), "db.sqlite") && components.next().is_none()
+    }
