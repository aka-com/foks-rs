+impl OwnedEffectRegistry {
+    fn register_component(
+        self: &Arc<Self>,
+        owner: control::OriginalOwner,
+        slot: usize,
+    ) -> Result<GuardedEnvelope, Refusal> {
+        owner.check()?;
+        if slot >= 2 {
+            return Err(Refusal::Invalid);
+        }
+        owner.charge(control::arc_bytes::<InvocationRecord>()?)?;
+        // Fixed initial/auxiliary/retirement scope images and native direct
+        // resources are separately charged before their actual construction.
+        owner.charge(
+            CELL_SCOPES[slot]
+                .len()
+                .checked_mul(4)
+                .ok_or(Refusal::Bounds)?,
+        )?;
+        let control = owner.node_control();
+        let a2_control = super::Capacity::node_control(&control, slot as u8)?;
+        let lease = self
+            .capacity
+            .try_admit(program::TENANT_IDS[slot], a2_control)
+            .map_err(|_| Refusal::Capacity)?;
+        let request = crate::asyncrt::next_core_request();
+        let auxiliary = crate::asyncrt::next_core_request();
+        let eviction_request = crate::asyncrt::next_core_request();
+        if request == 0 || auxiliary <= request || eviction_request <= auxiliary {
+            return Err(Refusal::Exhausted);
+        }
+        let mut bank = self.bank.try_lock().map_err(|_| Refusal::Contended)?;
+        if bank.records[slot].is_some() || bank.held[slot].is_some() {
+            return Err(Refusal::Busy);
+        }
+        bank.next = bank.next.checked_add(1).ok_or(Refusal::Exhausted)?;
+        let sequence = bank.next;
+        let record = Arc::new(InvocationRecord {
+            state: Mutex::new(InvocationState {
+                roots: std::array::from_fn(|_| RootCell::new()),
+                activities: [
+                    ActivityCompletion::new(request),
+                    ActivityCompletion::new(auxiliary),
+                ],
+                controls: std::array::from_fn(|_| ControlCell::new()),
+                epoch: None,
+                generation: None,
+                fresh: None,
+                attachment: None,
+                runtime: None,
+                final_alarm: None,
+                generation_pin: None,
+                activation: None,
+                primary_proof: None,
+                auxiliary_proof: None,
+                tainted: false,
+                retiring: false,
+                cancel_requested: false,
+                eviction_request,
+                eviction_result: None,
+                lease: Some(lease),
+            }),
+            sequence,
+            cell: CELL_SCOPES[slot],
+            control,
+            owner: Mutex::new(Some(owner)),
+        });
+        bank.records[slot] = Some(record.clone());
+        drop(bank);
+        let context = self.inline_context(&record, slot)?;
+        Ok(GuardedEnvelope {
+            context,
+            scope: Some(record.cell.to_owned()),
+            begun: false,
+        })
+    }
