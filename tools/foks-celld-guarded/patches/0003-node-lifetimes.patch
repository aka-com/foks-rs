+/// A non-issuing lifetime witness. It cannot create an owner or renew its clock.
+#[derive(Clone)]
+pub(crate) struct NodeControl {
+    control: Arc<Control>,
+    registry: Weak<Registry>,
+    slot: Option<usize>,
+    generation: u64,
+}
+
+// Already-admitted fixed bookkeeping only. External owner/header/pin admission
+// keeps its separate try-lock contract. No guard may cross native work/await.
+pub(super) fn lock_owned<T>(mutex: &Mutex<T>) -> Result<std::sync::MutexGuard<'_, T>, Refusal> {
+    match mutex.try_lock() {
+        Ok(guard) => Ok(guard),
+        Err(std::sync::TryLockError::Poisoned(_)) => Err(Refusal::Failed),
+        Err(std::sync::TryLockError::WouldBlock) => {
+            #[cfg(test)]
+            CONTENTION_NOTICE.with(|notice| {
+                if let Some(sender) = notice.borrow_mut().take() {
+                    let _ = sender.try_send(());
+                }
+            });
+            mutex.lock().map_err(|_| Refusal::Failed)
+        }
+    }
+}
+#[cfg(test)]
+thread_local! {
+    static CONTENTION_NOTICE: std::cell::RefCell<Option<std::sync::mpsc::SyncSender<()>>> = const { std::cell::RefCell::new(None) };
+}
+#[cfg(test)]
+pub(super) struct ContentionNotice;
+#[cfg(test)]
+impl Drop for ContentionNotice {
+    fn drop(&mut self) {
+        CONTENTION_NOTICE.with(|notice| {
+            notice.borrow_mut().take();
+        });
+    }
+}
+#[cfg(test)]
+pub(super) fn contention_notice(sender: std::sync::mpsc::SyncSender<()>) -> ContentionNotice {
+    CONTENTION_NOTICE.with(|notice| {
+        assert!(notice.borrow_mut().replace(sender).is_none());
+    });
+    ContentionNotice
+}
