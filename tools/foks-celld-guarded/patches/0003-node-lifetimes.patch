+                if let Some(directory) = component.directory.take() {
+                    let _retained = directory.keep();
+                }
+                // The bank still owns any admitted handles/results. Keeping
+                // the process fixture too avoids interpreting uncertain work
+                // or an unwind as a database/VFS disposal witness.
+                std::mem::forget(component);
