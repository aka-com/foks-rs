+                    })?;
+            }
+            let start = usize::try_from(pgno.saturating_sub(1)).unwrap() * 4096;
+            let bytes = self
+                .image
+                .get(start..start + 4096)
+                .ok_or_else(|| celld_ltx::Error::Other("component page absent".into()))?;
+            Ok(vec![(pgno, bytes.to_vec())])
