+// Host results below are core component inputs. They never install a native
+// runtime, publish a Worker, or certify ownership/storage outside this model.
+fn b2_core(fixture: &mut lifetimes::ActorFixture) -> (State, ActorJobPermit, JobContext) {
+    let mut core = State::new("node", model_config(false));
+    on_event(
+        &mut core,
+        Event::GenerationChanged {
+            generation: 1,
+            now_mono_ms: 0,
+            max_age_ms: 1000,
+            eager_classes: vec![],
+        },
+    );
+    let admission = fixture.begin_core_for_test(0).unwrap();
+    let request = fixture.primary_request(0);
+    let effects = on_event(&mut core, admission.into_event(0));
+    let epoch = activate_from_effects(&mut core, fixture.cell(0), request, 1, effects);
+    let permit = fixture.claim_cas_for_component(0, epoch).unwrap();
+    permit.context().bind_generation(1).unwrap();
+    let driver = b2_root(fixture, JobRole::Forward(ForwardLane::Driver));
+    (core, permit, driver)
+}
+fn b2_sync_origin(
+    context: &JobContext,
+    sample: crate::actor::GateTicket,
+) -> Result<OwnedGateOrigin, Refusal> {
+    context.require_role(JobRole::Forward(ForwardLane::Driver))?;
+    let registry = context.registry()?;
+    let record = registry.record(context.token)?;
+    let mut state = record.state.lock().unwrap();
+    let result = context.reserve_sync(&mut state, sample);
+    drop(state);
+    drop(record);
+    result.map(|(origin, retired)| {
+        drop(retired);
+        origin
+    })
+}
+fn b2_ticket(epoch: u64, position: u64) -> crate::actor::GateTicket {
+    crate::actor::GateTicket {
+        channel: Channel::Sync,
+        position: Some(position),
+        observed: None,
+        epoch: Some(epoch),
+    }
+}
+fn b2_request_transition(fixture: &lifetimes::ActorFixture, core: &mut State) -> Vec<Effect> {
+    let record = b2_record(fixture, 0);
+    match fixture.registry().poll_inputs(0, &record).unwrap() {
+        GuardedActorInput::Request(request) => {
+            request.apply(1, |event| on_event(core, event)).unwrap()
+        }
+        _ => panic!("exact optional request expected"),
+    }
+}
+fn b2_deliver(fixture: &lifetimes::ActorFixture, effects: Vec<Effect>) {
+    for effect in effects {
+        match fixture.registry().claim_actor(&effect) {
+            ActorClaim::Inline(permit) => permit.deliver(effect).unwrap(),
+            _ => panic!("expected real fixed reply effect"),
+        }
+    }
+}
+fn b2_prove(core: &mut State, op: u64, position: u64) -> Vec<Effect> {
+    let effects = on_event(
+        core,
+        Event::DurableReached {
+            op,
+            result: Ok(position),
+            source: celld_logic::ProofSource::Bucket,
+        },
+    );
+    assert!(effects.iter().any(
+        |effect| matches!(effect, Effect::VerifyOwnership { op: actual, .. } if *actual == op)
+    ));
+    on_event(core, Event::OwnershipVerified { op, result: Ok(()) })
+}
+async fn b2_finish_component(
+    fixture: &lifetimes::ActorFixture,
+    core: &mut State,
+    activity: GuardedActivity,
+) {
+    let request = activity.request();
+    let wait = activity.finish(celld_logic::wake::AlarmSnapshot::without_wake(None), false);
+    let record = b2_record(fixture, 0);
+    let control = match fixture.registry().poll_inputs(0, &record).unwrap() {
+        GuardedActorInput::Control(control) => control,
+        _ => panic!("actual prepaid finish"),
+    };
+    assert_eq!(control.request(), request);
+    on_event(core, Event::ActivityFinished { request });
+    control.processed(core);
+    use futures_util::FutureExt as _;
+    assert_eq!(
+        wait.now_or_never(),
+        Some(Ok(())),
+        "processed finish must be actually inactive"
+    );
+    fixture.registry().observe_inactive(core);
+}
