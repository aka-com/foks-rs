+#[test]
+fn b2_forward_saturation_preserves_cleanup() {
+    use futures_util::FutureExt as _;
+    crate::actor::guarded_test_runtime().block_on(async {
+        let mut fixture = b2_fixture();
+        let mut pending = Vec::new();
+        let checks = std::panic::AssertUnwindSafe(async {
+            for index in 0..FORWARD_COUNT {
+                let context = b2_root(&fixture, role_for_index(index).unwrap());
+                context
+                    .charge_owned(channel_bound::<()>().unwrap() * 2)
+                    .unwrap();
+                let (release, wait) = tokio::sync::oneshot::channel();
+                let (entered, ready) = tokio::sync::oneshot::channel();
+                b2_consumer(&fixture, &context);
+                let future = async move {
+                    let _ = entered.send(());
+                    wait.await.map_err(|_| Refusal::Cancelled)
+                };
+                fixture
+                    .registry()
+                    .spawn_root(&context, 0, future, RootResult::Control)
+                    .unwrap();
+                pending.push((context, Some(release)));
+                assert!(matches!(
+                    tokio::time::timeout(Duration::from_secs(5), ready).await,
+                    Ok(Ok(()))
+                ));
+            }
+            assert!(fixture.occupied_roots(0).unwrap()[..8]
+                .iter()
+                .all(|occupied| *occupied));
+            assert!(matches!(
+                fixture.registry().reserve(
+                    0,
+                    JobRole::Forward(ForwardLane::Activation),
+                    RootKind::Terminal,
+                    None
+                ),
+                Err(Refusal::Busy)
+            ));
+            crate::actor::assert_guarded_actor_case_for_test(
+                crate::actor::GuardedActorCase::ForwardSaturation,
+                &mut fixture,
+            )
+            .await;
+        })
+        .catch_unwind()
+        .await;
+        // Setup and observation failures both release every actual helper,
+        // then attempt each exact retained join before propagating assertions.
+        for (_, release) in &mut pending {
+            if let Some(release) = release.take() {
+                let _ = release.send(());
+            }
+        }
+        let mut joined = true;
+        for (context, _) in pending {
+            joined &= b2_join_control(&fixture, &context).await.is_ok();
+        }
+        if let Err(panic) = checks {
+            std::panic::resume_unwind(panic);
+        }
+        assert!(joined);
+        assert!(fixture.occupied_roots(0).unwrap()[..8]
+            .iter()
+            .all(|occupied| !*occupied));
+    });
+}
