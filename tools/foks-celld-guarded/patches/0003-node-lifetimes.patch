+    impl Drop for NodeRuntime {
+        fn drop(&mut self) {
+            if let Some(resources) = self.resources.take() {
+                // An unexpected drop does not prove SQLite closure, isolate
+                // destruction, or the backing store's last reference. Keep the
+                // exact resources and capacity, even during panic unwinding.
+                self.origin.fail();
+                self.witness.fail();
+                std::mem::forget(resources);
+            }
+        }
+    }
+
+    enum NativeInput {
+        Alarm(GuardedActivation),
+        Build {
+            activation: GuardedActivation,
+            config: Arc<WorkerConfig>,
+            permit: crate::js::guarded_node::NodeBuildPermit,
+            witness: RuntimeWitness,
+            replicated_wake: bool,
+        },
+        Destroy(NodeRuntime),
+        Empty,
+    }
+    enum NativeOutput {
+        Alarm {
+            activation: GuardedActivation,
+            persisted: Option<(i64, i64, u32, u32)>,
+        },
+        Built(NodeRuntime),
+        Destroyed,
+        Failed(Refusal),
+        Empty,
+    }
+    struct NativeResource {
+        input: NativeInput,
+        output: NativeOutput,
+        origin: JobContext,
+    }
+    struct NodeNativeWork {
+        resource: Box<NativeResource>,
+        kind: NativeKind,
+        token: RootToken,
+    }
+    pub(crate) struct NodeNativeCompletion {
+        resource: Option<Box<NativeResource>>,
+        kind: NativeKind,
+        token: RootToken,
+    }
+    impl Drop for NodeNativeCompletion {
+        fn drop(&mut self) {
+            if let Some(resource) = self.resource.take() {
+                resource.origin.fail();
+                std::mem::forget(resource);
+            }
+        }
+    }
+    impl NodeNativeWork {
+        fn into_job(self) -> impl FnOnce() -> NodeNativeCompletion {
+            move || self.run()
+        }
+        fn run(mut self) -> NodeNativeCompletion {
+            let context = self.resource.origin.clone();
+            let checked = context.check_job().and_then(|()| {
+                let kind = match &self.resource.input {
+                    NativeInput::Alarm(_) => NativeKind::RestoredAlarm,
+                    NativeInput::Build { .. } => NativeKind::WorkerBuild,
+                    NativeInput::Destroy(_) => NativeKind::WorkerDestroy,
+                    NativeInput::Empty => return Err(Refusal::Invalid),
+                };
+                if kind != self.kind || context.root_token() != self.token {
+                    return Err(Refusal::Invalid);
+                }
+                Ok(())
+            });
+            self.resource.output = match checked {
+                Err(reason) => NativeOutput::Failed(refused(&context, reason)),
+                Ok(()) => match std::mem::replace(&mut self.resource.input, NativeInput::Empty) {
+                    NativeInput::Alarm(activation) => {
+                        let result = activation.attachment().validate(&context).and_then(|()| {
+                            let path = activation.path().to_str().ok_or(Refusal::Invalid)?;
+                            Ok(crate::storage::persisted_alarm(
+                                path,
+                                context.cell(),
+                                activation.vfs(),
+                            ))
+                        });
+                        match result {
+                            Ok(persisted) => NativeOutput::Alarm {
+                                activation,
+                                persisted,
+                            },
+                            Err(error) => NativeOutput::Failed(refused(&context, error)),
+                        }
+                    }
+                    NativeInput::Build {
+                        activation,
+                        config,
+                        permit,
+                        witness,
+                        replicated_wake,
+                    } => {
+                        match build_runtime(
+                            &context,
+                            activation,
+                            config,
+                            permit,
+                            witness,
+                            replicated_wake,
+                        ) {
+                            Ok(runtime) => NativeOutput::Built(runtime),
+                            Err(error) => NativeOutput::Failed(refused(&context, error)),
+                        }
+                    }
+                    NativeInput::Destroy(runtime) => match destroy_runtime(&context, runtime) {
+                        Ok(()) => NativeOutput::Destroyed,
+                        Err(error) => NativeOutput::Failed(refused(&context, error)),
+                    },
+                    NativeInput::Empty => NativeOutput::Failed(refused(&context, Refusal::Invalid)),
+                },
+            };
+            NodeNativeCompletion {
+                resource: Some(self.resource),
+                kind: self.kind,
+                token: self.token,
+            }
+        }
+    }
+
+    async fn native(
+        context: &JobContext,
+        kind: NativeKind,
+        input: NativeInput,
+    ) -> Result<NativeOutput, Refusal> {
+        context.check_job()?;
+        context.charge_owned(std::mem::size_of::<NativeResource>())?;
+        let resource = Box::new(NativeResource {
+            input,
+            output: NativeOutput::Empty,
+            origin: context.clone(),
+        });
+        let permit = context.claim_native(kind)?;
+        let work = NodeNativeWork {
+            resource,
+            kind,
+            token: context.root_token(),
+        };
+        let joined = permit.submit_node(work.into_job())?.await?;
+        let mut resource = None;
+        let mut status = Ok(());
+        joined.consume_node(|mut completion| {
+            if completion.kind != kind
+                || completion.token != context.root_token()
+                || completion
+                    .resource
+                    .as_ref()
+                    .is_none_or(|value| !value.origin.same_invocation(context))
+            {
+                status = Err(refused(context, Refusal::Invalid));
+                return;
+            }
+            resource = completion.resource.take();
+        })?;
+        status?;
+        let mut resource = resource.ok_or_else(|| refused(context, Refusal::Invalid))?;
+        let output = std::mem::replace(&mut resource.output, NativeOutput::Empty);
+        match output {
+            NativeOutput::Failed(error) => Err(error),
+            NativeOutput::Empty => Err(refused(context, Refusal::Invalid)),
+            output => Ok(output),
+        }
+    }
+
+    fn build_runtime(
+        context: &JobContext,
+        activation: GuardedActivation,
+        config: Arc<WorkerConfig>,
+        permit: crate::js::guarded_node::NodeBuildPermit,
+        witness: RuntimeWitness,
+        replicated_wake: bool,
+    ) -> Result<NodeRuntime, Refusal> {
+        context.require_role(JobRole::Forward(ForwardLane::Activation))?;
+        activation.attachment().validate(context)?;
+        let epoch = context.epoch().ok_or(Refusal::Invalid)?;
+        let generation = context.generation().ok_or(Refusal::Invalid)?;
+        witness.check()?;
+        // These are the actual two allocations in Slot::outside_pool. V8 and
+        // SQLite internals remain separately named native runtime overhead.
+        let bytes = arc_bytes::<crate::pool::Slot>()?
+            .checked_add(arc_bytes::<tokio::sync::Notify>()?)
+            .ok_or(Refusal::Bounds)?;
+        context.charge_owned(bytes)?;
+        let worker = Worker::load_guarded_node(config, &permit)
+            .map_err(|_| refused(context, Refusal::Failed))?;
+        witness.worker_built()?;
+        let (slot, residency) = crate::pool::Slot::guarded(worker);
+        let runtime = NodeRuntime {
+            resources: Some(RuntimeResources {
+                slot,
+                residency: Some(residency),
+                probe: None,
+                activation,
+                adopted: false,
+            }),
+            alarm: AlarmSnapshot::without_wake(None),
+            published: false,
+            #[cfg(test)]
+            driver_started: false,
+            epoch,
+            generation,
+            witness,
+            origin: context.clone(),
+        };
+        // The already-retained blocking child owns both V8 construction and
+        // the real adoption future. This starts no extra task or native child.
+        crate::asyncrt::block_on(async move {
+            let mut runtime = runtime;
+            let resources = runtime.resources.as_mut().ok_or(Refusal::Invalid)?;
+            let residency = resources.residency.take().ok_or(Refusal::Invalid)?;
+            let adopted = residency
+                .adopt(
+                    runtime.origin.cell(),
+                    CellStorage {
+                        path: resources
+                            .activation
+                            .path()
+                            .to_str()
+                            .ok_or(Refusal::Invalid)?,
+                        epoch,
+                        replicated_wake,
+                        vfs: resources.activation.vfs(),
+                    },
+                )
+                .await
+                .map_err(|_| refused(&runtime.origin, Refusal::Failed))?;
+            resources.residency = Some(adopted.0);
+            resources.adopted = true;
+            runtime.alarm = adopted.1;
+            runtime.witness.running()?;
+            runtime.origin.check_forward()?;
+            Ok(runtime)
+        })
+    }
+
+    fn destroy_runtime(context: &JobContext, mut runtime: NodeRuntime) -> Result<(), Refusal> {
+        context.require_role(JobRole::Cleanup(CleanupLane::Stop))?;
+        if !runtime.same_origin(context) {
+            return Err(refused(context, Refusal::Invalid));
+        }
+        runtime.witness.check()?;
+        runtime.witness.begin_retire()?;
+        let scope = context.cell();
+        // Driver and all affiliations must already be joined. The one retained
+        // native child includes closure of the actual SQLite connection.
+        runtime = crate::asyncrt::block_on(async move {
+            let resources = runtime.resources.as_mut().ok_or(Refusal::Invalid)?;
+            if resources.adopted {
+                resources
+                    .slot
+                    .turn(|worker| worker.own_cell(scope, None))
+                    .await
+                    .map_err(|_| refused(&runtime.origin, Refusal::Failed))?;
+                resources.adopted = false;
+                runtime.witness.cell_closed()?;
+            }
+            drop(resources.residency.take());
+            Ok::<_, Refusal>(runtime)
+        })?;
+        let resources = runtime.resources.take().ok_or(Refusal::Invalid)?;
+        let RuntimeResources {
+            slot,
+            residency,
+            probe,
+            activation,
+            adopted,
+        } = resources;
+        if residency.is_some() || adopted {
+            return Err(refused(context, Refusal::Invalid));
+        }
+        let worker = match slot.guarded_consume() {
+            Ok(worker) => worker,
+            Err(slot) => {
+                runtime.witness.hold_slot(slot);
+                if let Some(probe) = probe {
+                    std::mem::forget(probe);
+                }
+                std::mem::forget(activation);
+                return Err(refused(context, Refusal::Failed));
+            }
+        };
+        runtime.witness.slot_consumed()?;
+        drop(worker);
+        runtime.witness.worker_destroyed()?;
+        if let Some(probe) = probe {
+            probe.finish();
+            runtime.witness.probe_dropped()?;
+        }
+        runtime.witness.memory_released()?;
+        drop(activation);
+        Ok(())
+    }
+
+    impl RuntimeManager {
+        pub(crate) async fn restore_guarded(
+            &self,
+            context: &JobContext,
+            spec: &celld_logic::RestoreSpec,
+        ) -> anyhow::Result<celld_logic::RestoreOutcome> {
+            context.require_role(JobRole::Forward(ForwardLane::Activation))?;
+            same_epoch(context, spec.epoch)?;
+            if context.fresh() != Some(spec.fresh) {
+                return Err(refused(context, Refusal::Invalid).into());
+            }
+            let replication = self
+                .replication
+                .as_ref()
+                .ok_or_else(|| refused(context, Refusal::Invalid))?;
+            let attachment = replication.attach_guarded(context, context.cell(), spec.epoch)?;
+            context.install_attachment(attachment.clone())?;
+            let activation = replication
+                .restore_guarded(context, &attachment, spec, true)
+                .await?;
+            // Compare the same canonical db_path components without creating
+            // a second chain of temporary PathBuf allocations.
+            if !canonical_path(
+                activation.path(),
+                self.data_dir.as_path(),
+                context.cell(),
+                spec.epoch,
+            ) {
+                return Err(refused(context, Refusal::Invalid).into());
+            }
+            let (activation, persisted) = match native(
+                context,
+                NativeKind::RestoredAlarm,
+                NativeInput::Alarm(activation),
+            )
+            .await?
+            {
+                NativeOutput::Alarm {
+                    activation,
+                    persisted,
+                } => (activation, persisted),
+                _ => return Err(refused(context, Refusal::Invalid).into()),
+            };
+            let outcome = celld_logic::RestoreOutcome {
+                restored: activation.restored(),
+                alarm: restored_alarm_from_persisted(context.cell(), persisted, |at_ms| {
+                    self.alarm_covered(context.cell(), AlarmSnapshot::without_wake(Some(at_ms)))
+                }),
+            };
+            context.check_forward()?;
+            context.install_activation(activation)?;
+            Ok(outcome)
+        }
+
+        pub(crate) async fn start_guarded(
+            &self,
+            context: &JobContext,
+            epoch: u64,
+            fresh: bool,
+        ) -> anyhow::Result<(celld_logic::isolate::HeapId, GenerationId)> {
+            context.require_role(JobRole::Forward(ForwardLane::Activation))?;
+            same_epoch(context, epoch)?;
+            if context.fresh() != Some(fresh) {
+                return Err(refused(context, Refusal::Invalid).into());
+            }
+            let mut pin = self.core.pin_guarded_generation(context)?;
+            let generation = pin.generation().id;
+            let config = match pin.generation().cell_config(crate::js::guarded_node::CLASS) {
+                Some(config) => config,
+                None => {
+                    pin.release_unstarted()?;
+                    return Err(refused(context, Refusal::Invalid).into());
+                }
+            };
+            let permit = match crate::js::guarded_node::NodeBuildPermit::new(context) {
+                Ok(permit) => permit,
+                Err(error) => {
+                    pin.release_unstarted()?;
+                    return Err(refused(context, error).into());
+                }
+            };
+            // From here the exact pin cannot be released as an unstarted pin.
+            pin.mark_started();
+            context.install_generation_pin(pin)?;
+            let activation = context.take_activation()?;
+            let witness = context.runtime_witness()?;
+            let runtime = match native(
+                context,
+                NativeKind::WorkerBuild,
+                NativeInput::Build {
+                    activation,
+                    config,
+                    permit,
+                    witness,
+                    replicated_wake: self.wake.is_some(),
+                },
+            )
+            .await?
+            {
+                NativeOutput::Built(runtime) => runtime,
+                _ => return Err(refused(context, Refusal::Invalid).into()),
+            };
+            let heap = runtime.heap()?;
+            context.check_forward()?;
+            context.install_runtime(runtime)?;
+            Ok((heap, generation))
+        }
+
+        pub(crate) fn publish_guarded(
+            &self,
+            context: &JobContext,
+            epoch: u64,
+        ) -> anyhow::Result<()> {
+            context.require_role(JobRole::Forward(ForwardLane::Activation))?;
+            same_epoch(context, epoch)?;
+            context.with_runtime_mut(NodeRuntime::publish)??;
+            context.check_forward()?;
+            Ok(())
+        }
+
+        pub(crate) async fn await_durable_guarded(
+            &self,
+            context: &JobContext,
+            epoch: u64,
+            position: u64,
+        ) -> anyhow::Result<(u64, celld_logic::ProofSource)> {
+            if !matches!(
+                context.role(),
+                JobRole::Forward(ForwardLane::PrimaryProof | ForwardLane::AuxProof)
+            ) {
+                return Err(refused(context, Refusal::Invalid).into());
+            }
+            same_epoch(context, epoch)?;
+            let replication = self
+                .replication
+                .as_ref()
+                .ok_or_else(|| refused(context, Refusal::Invalid))?;
+            let attachment = context.attachment()?;
+            let proof = replication.begin_proof_guarded(context, &attachment, position)?;
+            context.store_proof(proof.clone())?;
+            replication
+                .await_durable_guarded(context, &attachment, &proof)
+                .await
+        }
+
+        pub(crate) async fn ensure_durable_guarded(
+            &self,
+            context: &JobContext,
+            epoch: u64,
+            revocable: bool,
+        ) -> anyhow::Result<()> {
+            context.require_role(JobRole::Cleanup(CleanupLane::EnsureDurable))?;
+            same_epoch(context, epoch)?;
+            let replication = self
+                .replication
+                .as_ref()
+                .ok_or_else(|| refused(context, Refusal::Invalid))?;
+            let attachment = context.attachment()?;
+            replication
+                .ensure_durable_guarded(context, &attachment, revocable)
+                .await
+        }
+
+        pub(crate) async fn stop_guarded(
+            &self,
+            context: &JobContext,
+            mode: StopMode,
+        ) -> anyhow::Result<()> {
+            context.require_role(JobRole::Cleanup(CleanupLane::Stop))?;
+            let replication = self
+                .replication
+                .clone()
+                .ok_or_else(|| refused(context, Refusal::Invalid))?;
+            let attachment = context.attachment()?;
+            // This either observes an already-disposed F3 or consumes the one
+            // existing C7 result. It cannot acquire another C7 cleanup credit.
+            context.cancel_driver_and_join().await?;
+            let runtime = context.take_runtime_for_stop()?;
+            match native(
+                context,
+                NativeKind::WorkerDestroy,
+                NativeInput::Destroy(runtime),
+            )
+            .await?
+            {
+                NativeOutput::Destroyed => {}
+                _ => return Err(refused(context, Refusal::Invalid).into()),
+            }
+            // C6 owns storage background joins, final capture/publication,
+            // managed close and VFS unregister after the actual Worker drop.
+            let permit = context.claim_replica(
+                crate::guarded_execution::node::ReplicaRole::Retirement,
+                &attachment,
+            )?;
+            let cleanup = permit.context().clone();
+            let work = LocalRetirementWork {
+                replication,
+                attachment: attachment.clone(),
+                mode,
+            };
+            let joined = permit.submit_ltx(move |cleanup| work.run(cleanup))?.await?;
+            let mut result = Err(Refusal::Invalid);
+            joined.consume_ltx(|completion| {
+                result = completion.retirement_result(&cleanup, &attachment);
+            })?;
+            result?;
+            context.check_job()?;
+            Ok(())
+        }
+
+        pub(crate) async fn maintain_wake_guarded(
+            &self,
+            context: &JobContext,
+            alarm: AlarmSnapshot,
+            ownership: &crate::actor::Ownership,
+            node: &str,
+        ) -> anyhow::Result<()> {
+            if !matches!(
+                context.role(),
+                JobRole::Forward(ForwardLane::Wake) | JobRole::Cleanup(CleanupLane::Wake)
+            ) {
+                return Err(refused(context, Refusal::Invalid).into());
+            }
+            context.check_job()?;
+            let host = BoundAlarmHost {
+                manager: self,
+                context,
+            };
+            crate::js::maintain_wake_entry(context.cell(), alarm, &host, ownership, node).await?;
+            context.check_job()?;
+            Ok(())
+        }
+    }
+
+    struct BoundAlarmHost<'a> {
+        manager: &'a RuntimeManager,
+        context: &'a JobContext,
+    }
+    impl crate::wake::AlarmHost for BoundAlarmHost<'_> {
+        fn alarm_snapshot(&self, cell: &str) -> anyhow::Result<AlarmSnapshot> {
+            self.context.check_job()?;
+            if cell != self.context.cell() {
+                return Err(refused(self.context, Refusal::Invalid).into());
+            }
+            Ok(self.context.wake_snapshot()?)
+        }
+        async fn prove_alarm(
+            &self,
+            cell: &str,
+            epoch: u64,
+            position: u64,
+        ) -> anyhow::Result<(u64, celld_logic::ProofSource)> {
+            if cell != self.context.cell() {
+                return Err(refused(self.context, Refusal::Invalid).into());
+            }
+            same_epoch(self.context, epoch)?;
+            let replication = self
+                .manager
+                .replication
+                .as_ref()
+                .ok_or_else(|| refused(self.context, Refusal::Invalid))?;
+            replication.prove_existing_guarded(self.context, &self.context.attachment()?, position)
+        }
+    }
+}
