+impl OwnedEffectRegistry {
+    fn retirement_eligible(state: &InvocationState) -> bool {
+        !(state.tainted
+            || !state.activities[0].finish_processed
+            || !state.activities[0].inactive
+            || !state.activities[0].finish_disposed
+            || state.activities[1].issued
+                && (!state.activities[1].finish_processed
+                    || !state.activities[1].inactive
+                    || !state.activities[1].finish_disposed
+                    || !state.activities[1].sync_disposed)
+            || (state.primary_proof.is_some() || state.auxiliary_proof.is_some())
+                && state.roots[JobRole::Cleanup(CleanupLane::TerminalProof).index()].state
+                    != RootState::Spent
+            || !state.roots[ForwardLane::Driver as usize].disposed()
+            || state
+                .activities
+                .iter()
+                .any(|activity| activity.output.as_ref().is_some_and(|output| !output.done))
+            || state.runtime.is_none())
+    }
+    #[cfg(test)]
+    fn request_retirement(&self, context: &JobContext) -> Result<(), Refusal> {
+        let record = self.record(context.token)?;
+        let state = lock_owned(&record.state)?;
+        if !Self::retirement_eligible(&state) {
+            return Err(Refusal::Busy);
+        }
+        drop(state);
+        drop(record);
+        self.schedule_control(context, ActorControlKind::Retirement, None)
+    }
+}
