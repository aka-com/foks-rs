+impl RuntimeWitness {
+    pub(crate) fn check(&self) -> Result<(), Refusal> {
+        let ledger = lock_owned(&self.capacity.ledger)?;
+        let record = ledger
+            .records
+            .get(self.token.index)
+            .ok_or(Refusal::Invalid)?;
+        if record.generation != self.token.generation
+            || record.state == super::State::Free
+            || !record
+                .control
+                .as_ref()
+                .is_some_and(|value| Arc::ptr_eq(value, &self.control))
+        {
+            return Err(Refusal::Invalid);
+        }
+        Ok(())
+    }
+    fn change(
+        &self,
+        kind: super::EventKind,
+        update: impl FnOnce(&mut super::Record) -> Result<(), Refusal>,
+    ) -> Result<(), Refusal> {
+        let mut ledger = lock_owned(&self.capacity.ledger)?;
+        if ledger.observation_failed
+            || ledger.events.len() >= super::EVENT_LIMIT
+            || ledger.event_counts[kind as usize] == u32::MAX
+        {
+            return Err(Refusal::Exhausted);
+        }
+        let record = ledger
+            .records
+            .get_mut(self.token.index)
+            .ok_or(Refusal::Invalid)?;
+        if record.generation != self.token.generation
+            || record.state == super::State::Free
+            || !record
+                .control
+                .as_ref()
+                .is_some_and(|value| Arc::ptr_eq(value, &self.control))
+        {
+            return Err(Refusal::Invalid);
+        }
+        update(record)?;
+        ledger.event(self.token, kind);
+        Ok(())
+    }
+    pub(crate) fn worker_built(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::WorkerBuilt, |record| {
+            if record.worker_live || record.state != super::State::Building {
+                return Err(Refusal::Invalid);
+            }
+            record.worker_live = true;
+            Ok(())
+        })
+    }
+    pub(crate) fn running(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::Adopted, |record| {
+            if !record.worker_live || record.state != super::State::Building || record.tainted {
+                return Err(Refusal::Invalid);
+            }
+            record.state = super::State::Running;
+            Ok(())
+        })
+    }
+    pub(crate) fn backing_observed(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::BackingObserved, |record| {
+            record.store_live = true;
+            Ok(())
+        })
+    }
+    pub(crate) fn driver_started(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::DriverStarted, |_| Ok(()))
+    }
+    pub(crate) fn driver_joined(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::DriverJoined, |_| Ok(()))
+    }
+    pub(crate) fn begin_retire(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::Retiring, |record| {
+            if !record.tainted {
+                record.state = super::State::Retiring;
+            }
+            Ok(())
+        })
+    }
+    pub(crate) fn cell_closed(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::CellClosed, |_| Ok(()))
+    }
+    pub(crate) fn worker_destroyed(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::WorkerDropped, |record| {
+            record.worker_live = false;
+            Ok(())
+        })
+    }
+    pub(crate) fn memory_released(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::MemoryReleased, |record| {
+            if record.worker_live {
+                return Err(Refusal::Busy);
+            }
+            record.store_live = false;
+            record.memory = false;
+            record.runtime_done = true;
+            Ok(())
+        })
+    }
+    pub(crate) fn output_disposed(&self) -> Result<(), Refusal> {
+        self.change(super::EventKind::OutputDropped, |record| {
+            record.output_done = true;
+            Ok(())
+        })
+    }
+    pub(crate) fn cancel(&self) {
+        self.control.cancelled.store(true, Ordering::Release);
+    }
+    pub(crate) fn fail(&self) {
+        self.cancel();
+        if let Some(control) = &self.control.node {
+            control.fail();
+        }
+        self.capacity.quarantine(self.token);
+    }
+    pub(crate) fn hold_slot(&self, slot: Arc<crate::pool::Slot>) {
+        self.fail();
+        match lock_owned(&self.capacity.ledger) {
+            Ok(mut ledger) => {
+                let record = &mut ledger.records[self.token.index];
+                if record.generation == self.token.generation && record.uncertain_slot.is_none() {
+                    record.uncertain_slot = Some(slot);
+                } else {
+                    std::mem::forget(slot);
+                }
+            }
+            Err(_) => std::mem::forget(slot),
+        }
+    }
+}
+impl JobContext {
+    pub(crate) fn runtime_witness(&self) -> Result<RuntimeWitness, Refusal> {
+        self.check_identity()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let state = lock_owned(&record.state)?;
+        let lease = state.lease.as_ref().ok_or(Refusal::Invalid)?;
+        let ledger = lock_owned(&lease.capacity.ledger)?;
+        let a2 = ledger
+            .records
+            .get(lease.token.index)
+            .ok_or(Refusal::Invalid)?;
+        if a2.generation != lease.token.generation || a2.state == super::State::Free {
+            return Err(Refusal::Invalid);
+        }
+        let control = a2.control.as_ref().ok_or(Refusal::Invalid)?;
+        if !control
+            .node
+            .as_ref()
+            .is_some_and(|node| node.same_owner(&self.control))
+        {
+            return Err(Refusal::Invalid);
+        }
+        Ok(RuntimeWitness {
+            capacity: lease.capacity.clone(),
+            token: lease.token,
+            control: control.clone(),
+        })
+    }
+    pub(crate) fn attachment(&self) -> Result<crate::ltx_repl::EpochAttachment, Refusal> {
+        self.check_identity()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let state = lock_owned(&record.state)?;
+        state.attachment.clone().ok_or(Refusal::NotReady)
+    }
+    pub(crate) fn install_attachment(
+        &self,
+        attachment: crate::ltx_repl::EpochAttachment,
+    ) -> Result<(), Refusal> {
+        self.require_role(JobRole::Forward(ForwardLane::Activation))?;
+        attachment.validate(self)?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        if state.attachment.is_some() {
+            return Err(Refusal::Busy);
+        }
+        state.attachment = Some(attachment);
+        Ok(())
+    }
+    pub(crate) fn install_activation(
+        &self,
+        activation: crate::ltx_repl::GuardedActivation,
+    ) -> Result<(), Refusal> {
+        self.require_role(JobRole::Forward(ForwardLane::Activation))?;
+        activation.attachment().validate(self)?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        if state.activation.is_some() || state.runtime.is_some() {
+            return Err(Refusal::Busy);
+        }
+        state.activation = Some(activation);
+        Ok(())
+    }
+    pub(crate) fn take_activation(&self) -> Result<crate::ltx_repl::GuardedActivation, Refusal> {
+        self.require_role(JobRole::Forward(ForwardLane::Activation))?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        state.activation.take().ok_or(Refusal::NotReady)
+    }
+    pub(crate) fn install_generation_pin(
+        &self,
+        mut pin: crate::generation::GenerationPin,
+    ) -> Result<(), Refusal> {
+        let admitted = (|| {
+            self.require_role(JobRole::Forward(ForwardLane::Activation))?;
+            let registry = self.registry()?;
+            let record = registry.record(self.token)?;
+            let mut state = lock_owned(&record.state)?;
+            if state.generation != Some(pin.generation().id) || state.generation_pin.is_some() {
+                return Err(Refusal::Invalid);
+            }
+            self.control.check()?;
+            pin.mark_started();
+            state.generation_pin = Some(pin);
+            Ok(())
+        })();
+        // The closure consumes the pin only at the successful store. Its Drop
+        // on every unexpected failure retains the actual generation/count.
+        admitted
+    }
+    pub(crate) fn install_runtime(&self, runtime: NodeRuntime) -> Result<(), Refusal> {
+        let result = (|| {
+            self.require_role(JobRole::Forward(ForwardLane::Activation))?;
+            let registry = self.registry()?;
+            let record = registry.record(self.token)?;
+            let mut state = lock_owned(&record.state)?;
+            if state.runtime.is_some() || state.generation_pin.is_none() {
+                return Err(Refusal::Busy);
+            }
+            let (cell, epoch, generation) = runtime.binding();
+            if cell != record.cell
+                || state.epoch != Some(epoch)
+                || state.generation != Some(generation)
+                || !runtime.same_origin(self)
+            {
+                return Err(Refusal::Invalid);
+            }
+            self.control.check()?;
+            state.runtime = Some(runtime);
+            Ok(())
+        })();
+        if result.is_err() {
+            self.fail();
+        }
+        result
+    }
+    pub(crate) fn with_runtime<T>(
+        &self,
+        read: impl FnOnce(&NodeRuntime) -> T,
+    ) -> Result<T, Refusal> {
+        self.check_identity()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let state = lock_owned(&record.state)?;
+        let runtime = state.runtime.as_ref().ok_or(Refusal::NotReady)?;
+        let (cell, epoch, generation) = runtime.binding();
+        if cell != record.cell
+            || state.epoch != Some(epoch)
+            || state.generation != Some(generation)
+            || !runtime.same_origin(self)
+        {
+            return Err(Refusal::Invalid);
+        }
+        Ok(read(runtime))
+    }
+    pub(crate) fn take_runtime_for_stop(&self) -> Result<NodeRuntime, Refusal> {
+        self.require_role(JobRole::Cleanup(CleanupLane::Stop))?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        if !state.roots[ForwardLane::Driver as usize].disposed() {
+            return Err(Refusal::Busy);
+        }
+        let runtime = state.runtime.as_ref().ok_or(Refusal::NotReady)?;
+        let (cell, epoch, generation) = runtime.binding();
+        if cell != record.cell
+            || state.epoch != Some(epoch)
+            || state.generation != Some(generation)
+            || !runtime.same_origin(self)
+        {
+            return Err(Refusal::Invalid);
+        }
+        state.final_alarm = Some(FinalAlarm {
+            epoch,
+            generation,
+            alarm: runtime.alarm_snapshot()?,
+        });
+        state.retiring = true;
+        state.runtime.take().ok_or(Refusal::NotReady)
+    }
+    pub(crate) fn store_proof(&self, proof: crate::ltx_repl::GuardedProof) -> Result<(), Refusal> {
+        self.check_job()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let slot = match self.role {
+            JobRole::Forward(ForwardLane::PrimaryProof) => &mut state.primary_proof,
+            JobRole::Forward(ForwardLane::AuxProof) => &mut state.auxiliary_proof,
+            _ => return Err(Refusal::Invalid),
+        };
+        if slot.is_some() {
+            return Err(Refusal::Busy);
+        }
+        *slot = Some(proof);
+        Ok(())
+    }
+    pub(crate) fn proofs(&self) -> Result<[Option<crate::ltx_repl::GuardedProof>; 2], Refusal> {
+        self.check_identity()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let state = lock_owned(&record.state)?;
+        Ok([state.primary_proof.clone(), state.auxiliary_proof.clone()])
+    }
+}
