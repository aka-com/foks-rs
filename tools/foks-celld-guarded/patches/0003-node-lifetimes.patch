+/// Named guarded constructors. The registry owns each actual task, its result
+/// channel, and any registered native child until joined consumption. None of
+/// these futures enters the ordinary detached StepOutput queue.
+#[cfg(feature = "foks-guarded-node-qualification")]
+pub(in crate::actor) mod guarded {
+    use super::super::*;
+    use crate::guarded_execution::node::{ActorJobResult, JobContext, JobRole};
+
+    fn completed(event: Event) -> ActorJobResult {
+        ActorJobResult::Transition(CompletedEffect::plain(event))
+    }
+
+    async fn run_job<T>(
+        context: &JobContext,
+        future: impl Future<Output = Result<T, Failure>>,
+    ) -> Result<T, Failure> {
+        context.check_job().map_err(|_| Failure::Definite)?;
+        match context.role() {
+            JobRole::Forward(_) => context
+                .bound_forward(future)
+                .await
+                .map_err(|_| Failure::Ambiguous)?,
+            // Cleanup spends its original consumed partition. It gets no new
+            // publication deadline, and an unjoined operation stays owned.
+            JobRole::Cleanup(_) => future.await,
+        }
+    }
+
+    fn keep_capacity(
+        context: &JobContext,
+        capacities: impl IntoIterator<Item = usize>,
+    ) -> Result<(), Failure> {
+        let result = capacities
+            .into_iter()
+            .try_fold(0usize, usize::checked_add)
+            .ok_or(Failure::Definite)
+            .and_then(|bytes| context.charge_owned(bytes).map_err(|_| Failure::Definite));
+        if result.is_err() {
+            context.fail();
+        }
+        result
+    }
+
+    pub(in crate::actor) struct OwnerReadWork {
+        pub(in crate::actor) op: OpId,
+        pub(in crate::actor) ownership: Ownership,
+    }
+    impl OwnerReadWork {
+        pub(in crate::actor) async fn run(self, context: JobContext) -> ActorJobResult {
+            let mut result = run_job(&context, self.ownership.read_owner(context.cell())).await;
+            if let Ok(Some(record)) = &result {
+                if keep_capacity(
+                    &context,
+                    [
+                        record.node.as_ref().map_or(0, String::capacity),
+                        record.etag.capacity(),
+                    ],
+                )
+                .is_err()
+                {
+                    context.fail();
+                    result = Err(Failure::Definite);
+                }
+            }
+            completed(Event::OwnerRead {
+                op: self.op,
+                now_ms: now_ms(),
+                result,
+            })
+        }
+    }
+
+    pub(in crate::actor) struct NodeLeaseReadWork {
+        pub(in crate::actor) op: OpId,
+        pub(in crate::actor) ownership: Ownership,
+        pub(in crate::actor) owner: String,
+    }
+    impl NodeLeaseReadWork {
+        pub(in crate::actor) async fn run(self, context: JobContext) -> ActorJobResult {
+            let mut result = run_job(&context, self.ownership.read_node_lease(&self.owner)).await;
+            if let Ok(Some(record)) = &result {
+                if keep_capacity(
+                    &context,
+                    [
+                        record.node.capacity(),
+                        record.addr.capacity(),
+                        record.generation.capacity(),
+                        record.etag.capacity(),
+                    ],
+                )
+                .is_err()
+                {
+                    context.fail();
+                    result = Err(Failure::Definite);
+                }
+            }
+            completed(Event::NodeLeaseRead {
+                op: self.op,
+                now_ms: now_ms(),
+                result,
+            })
+        }
+    }
+
+    pub(in crate::actor) struct CapacityReadWork {
+        pub(in crate::actor) op: OpId,
+        pub(in crate::actor) ownership: Ownership,
+    }
+    impl CapacityReadWork {
+        pub(in crate::actor) async fn run(self, context: JobContext) -> ActorJobResult {
+            let result = run_job(&context, self.ownership.read_capacity_view()).await;
+            let (sample_ms, result) = match result {
+                Ok((sample_ms, peers)) => {
+                    let vector = peers
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<CapacityPeer>());
+                    let charged = vector.ok_or(Failure::Definite).and_then(|vector| {
+                        keep_capacity(
+                            &context,
+                            std::iter::once(vector).chain(
+                                peers
+                                    .iter()
+                                    .flat_map(|peer| [peer.node.capacity(), peer.addr.capacity()]),
+                            ),
+                        )
+                    });
+                    match charged {
+                        Ok(()) => (sample_ms, Ok(peers)),
+                        Err(error) => {
+                            context.fail();
+                            (sample_ms, Err(error))
+                        }
+                    }
+                }
+                Err(error) => (now_ms(), Err(error)),
+            };
+            completed(Event::CapacityPeersRead {
+                op: self.op,
+                now_ms: sample_ms,
+                result,
+            })
+        }
+    }
+
+    pub(in crate::actor) struct OwnerCasWork {
+        pub(in crate::actor) op: OpId,
+        pub(in crate::actor) ownership: Ownership,
+        pub(in crate::actor) guard: CasGuard,
+        pub(in crate::actor) epoch: u64,
+    }
+    impl OwnerCasWork {
+        pub(in crate::actor) async fn run(self, context: JobContext) -> ActorJobResult {
+            let result = run_job(
+                &context,
+                self.ownership
+                    .cas_owner(context.cell(), self.guard, self.epoch),
+            )
+            .await;
+            completed(Event::OwnerCasCompleted {
+                op: self.op,
+                result,
+            })
+        }
+    }
+
+    pub(in crate::actor) struct RestoreWork {
+        pub(in crate::actor) op: OpId,
+        pub(in crate::actor) runtime: RuntimeManager,
