+impl JobContext {
+    pub(crate) fn claim_control(&self, lane: CleanupLane) -> Result<ControlPermit, Refusal> {
+        self.check_identity()?;
+        if !matches!(lane, CleanupLane::TerminalProof | CleanupLane::Cancel) {
+            return Err(Refusal::Invalid);
+        }
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        if lane == CleanupLane::TerminalProof {
+            if self.role != JobRole::Forward(ForwardLane::Driver) {
+                return Err(Refusal::Invalid);
+            }
+            let mut state = lock_owned(&record.state)?;
+            let driver = OwnedEffectRegistry::root(&mut state, self.token)?;
+            if driver.kind != Some(RootKind::Driver)
+                || driver.state != RootState::Delivered
+                || !driver.consumer
+            {
+                return Err(Refusal::Invalid);
+            }
+            if !state.roots[ForwardLane::PrimaryProof as usize].disposed()
+                || !state.roots[ForwardLane::AuxProof as usize].disposed()
+            {
+                return Err(Refusal::Busy);
+            }
+        } else if self.role != JobRole::Cleanup(CleanupLane::Stop) {
+            let state = lock_owned(&record.state)?;
+            if self.token.lane != u8::MAX || !state.cancel_requested {
+                return Err(Refusal::Invalid);
+            }
+        }
+        let context = registry.reserve(
+            self.token.slot as usize,
+            JobRole::Cleanup(lane),
+            RootKind::Terminal,
+            None,
+        )?;
+        Ok(ControlPermit {
+            context,
+            submitted: false,
+        })
+    }
+    pub(crate) fn driver_disposed(&self) -> Result<bool, Refusal> {
+        self.check_identity()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let state = lock_owned(&record.state)?;
+        Ok(state.roots[ForwardLane::Driver as usize].disposed())
+    }
+    pub(crate) async fn take_driver_for_cancel(
+        &self,
+    ) -> Result<OwnedNodeDriverCompletion, Refusal> {
+        self.require_role(JobRole::Cleanup(CleanupLane::Cancel))?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let driver = std::future::poll_fn(|cx| {
+            let incoming = cx.waker().clone();
+            let mut deferred = DeferredWaker(None);
+            let mut state = match poll_owned(&record.state, cx) {
+                Poll::Ready(Ok(state)) => state,
+                Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+                Poll::Pending => return Poll::Pending,
+            };
+            let root = &mut state.roots[ForwardLane::Driver as usize];
+            if root.disposed() {
+                return Poll::Ready(Err(Refusal::NotReady));
+            }
+            if root.kind != Some(RootKind::Driver) {
+                return Poll::Ready(Err(Refusal::Invalid));
+            }
+            if root.consumer || root.state == RootState::Delivered {
+                deferred.0 = root.waker.replace(incoming);
+                drop(state);
+                return Poll::Pending;
+            }
+            root.consumer = true;
+            let sequence = root.sequence;
+            Poll::Ready(registry.context_locked(
+                &record,
+                &state,
+                self.token.slot as usize,
+                JobRole::Forward(ForwardLane::Driver),
+                sequence,
+            ))
+        })
+        .await?;
+        NodeDriverWait {
+            context: driver,
+            active: true,
+        }
+        .await
+    }
+    pub(crate) fn with_runtime_mut<T>(
+        &self,
+        update: impl FnOnce(&mut NodeRuntime) -> T,
+    ) -> Result<T, Refusal> {
+        self.check_identity()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let runtime = state.runtime.as_ref().ok_or(Refusal::NotReady)?;
+        let (cell, epoch, generation) = runtime.binding();
+        if cell != record.cell
+            || state.epoch != Some(epoch)
+            || state.generation != Some(generation)
+            || !runtime.same_origin(self)
+        {
+            return Err(Refusal::Invalid);
+        }
+        Ok(update(state.runtime.as_mut().ok_or(Refusal::NotReady)?))
+    }
+}
+impl ControlPermit {
+    pub(crate) fn submit_node<F, Fut>(mut self, factory: F) -> Result<ControlWait, Refusal>
+    where
+        F: FnOnce(JobContext) -> Fut,
+        Fut: Future<Output = Result<(), Refusal>> + Send + 'static,
+    {
+        self.context.check_job()?;
