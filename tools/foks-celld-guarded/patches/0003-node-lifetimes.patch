+        async fn adopt(&self, context: &JobContext) -> Result<AdoptedCell, Failure> {
+            context.check_job().map_err(|_| Failure::Definite)?;
+            if matches!(self.ownership, Ownership::Memory(_)) {
+                return Err(Failure::Definite);
+            }
+            // Take one real canonical directory sample. C4 has no renewable
