+        consume(self.value.take().ok_or(Refusal::Invalid)?);
+        self.context
+            .registry()?
+            .finish_child(&self.context, self.child)?;
+        self.consumed = true;
+        Ok(())
+    }
+}
+impl Drop for OwnedNodeNativeCompletion {
+    fn drop(&mut self) {
+        if !self.consumed {
+            self.context.fail();
+        }
+    }
