+async fn b2_h_admitted_observations() {
+    let fixture = b2_fixture();
+    let context = b2_root(&fixture, JobRole::Forward(ForwardLane::Activation));
+    context
+        .charge_owned(channel_bound::<()>().unwrap() * 2)
+        .unwrap();
+    let (release, wait) = tokio::sync::oneshot::channel();
+    let (entered, ready) = tokio::sync::oneshot::channel();
+    b2_consumer(&fixture, &context);
+    fixture
+        .registry()
+        .spawn_root(
+            &context,
+            0,
+            async move {
+                let _ = entered.send(());
+                wait.await.map_err(|_| Refusal::Cancelled)
+            },
+            RootResult::Control,
+        )
+        .unwrap();
+    let started = matches!(
+        crate::asyncrt::timeout(Duration::from_secs(5), ready).await,
+        Ok(Ok(()))
+    );
+    let deadline = context.original_deadline();
+    let checks = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let record = fixture.registry().record(context.token).unwrap();
+        b2_h_actor_poll_under_lock(&record.state, fixture.registry());
+        b2_h_actor_poll_under_lock(&fixture.registry().bank, fixture.registry());
+        let debt = b2_debt(&fixture);
+        let epoch = context.epoch(); // None is real component state; no epoch minted.
+        let observed = b2_h_owned_lock(&record.state, || {
+            context.check_identity()?;
+            if context.epoch() != epoch {
+                return Err(Refusal::Invalid);
+            }
+            context.charge_owned(0)?;
+            context.check_forward()
+        });
+
+        let wake = Arc::new(B2HWake(AtomicBool::new(false)));
+        let waker = futures_util::task::waker(wake.clone());
+        let mut cx = Context::from_waker(&waker);
+        let (state_pending, state_woke, root_retained) = {
+            let state = record.state.lock().unwrap();
+            wake.0.store(false, Ordering::SeqCst);
+            let pending = fixture
+                .registry()
+                .poll_root(&context, &mut cx, false)
+                .is_pending();
+            let retained = state.roots[context.role.index()].handle.is_some()
+                && state.roots[context.role.index()].receiver.is_some();
+            (pending, wake.0.load(Ordering::SeqCst), retained)
+        };
+        let (bank_pending, bank_woke, admission_refused) = {
+            let bank = fixture.registry().bank.lock().unwrap();
+            wake.0.store(false, Ordering::SeqCst);
+            let pending = fixture
+                .registry()
+                .poll_root(&context, &mut cx, false)
+                .is_pending();
+            let refused = matches!(
+                fixture
+                    .registry()
+                    .reserve(0, context.role, RootKind::Terminal, None),
+                Err(Refusal::Contended)
+            );
+            drop(bank);
+            (pending, wake.0.load(Ordering::SeqCst), refused)
+        };
+        drop(record);
+        (
+            observed,
+            state_pending,
+            state_woke,
+            root_retained,
+            bank_pending,
+            bank_woke,
+            admission_refused,
+            debt,
+        )
+    }));
+    let sent = release.send(()).is_ok();
+    // No assertion occurs while a root or bounded helper is parked behind a
+    // fixture barrier. Even an earlier bad observation still reaches this join.
+    let mut join = std::pin::pin!(std::future::poll_fn(|cx| {
+        fixture.registry().poll_root(&context, cx, false)
+    }));
+    let (join_bounded, joined) =
+        match crate::asyncrt::timeout(Duration::from_secs(5), &mut join).await {
+            Ok(result) => (true, result),
+            // The observation deadline cannot dispose the actual root. This
+            // known finite fixture has already received its release signal.
+            Err(_) => (false, join.await),
+        };
+    let joined = match joined {
+        Ok(RootResult::Control(value)) => {
+            value.and_then(|()| fixture.registry().finish_root(&context))
+        }
+        Ok(other) => {
+            context.fail();
+            drop(other);
+            Err(Refusal::Invalid)
