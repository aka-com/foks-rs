+#[derive(Default)]
+struct B2HPanicObservation {
+    dropped: AtomicBool,
+    unlocked: AtomicBool,
+    reentered: AtomicBool,
+    released: AtomicBool,
+}
+
+struct B2HReentrantPanic {
+    context: JobContext,
+    record: Weak<InvocationRecord>,
+    observation: Arc<B2HPanicObservation>,
+}
+impl Drop for B2HReentrantPanic {
+    fn drop(&mut self) {
+        // Check the exact locks before the real reentrant call. An old
+        // under-lock JoinError drop fails this oracle without wedging the test
+        // process. All probe guards end before context.fail is invoked.
+        let unlocked = match (self.context.registry(), self.record.upgrade()) {
+            (Ok(registry), Some(record)) => {
+                let bank_clear = registry.bank.try_lock().map(drop).is_ok();
+                let state_clear = record.state.try_lock().map(drop).is_ok();
+                bank_clear && state_clear
+            }
+            _ => false,
+        };
+        self.observation.unlocked.store(unlocked, Ordering::SeqCst);
+        if unlocked {
+            self.context.fail();
+            self.observation.reentered.store(true, Ordering::SeqCst);
+        }
+        self.observation.dropped.store(true, Ordering::SeqCst);
+    }
+}
