+fn b2_h_finish_after_disposal(fixture: &lifetimes::ActorFixture, context: &JobContext) {
+    // The caller has already dropped its actual delivered RootResult. Retain
+    // the original no-reuse-before-disposal assertion in that existing test.
+    let record = fixture.registry().record(context.token).unwrap();
+    let observed = b2_h_owned_lock(&record.state, || fixture.registry().finish_root(context));
+    drop(record);
+    assert!(observed.contended && observed.pending && observed.joined.is_ok());
