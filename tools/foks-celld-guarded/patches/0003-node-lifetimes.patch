+                .extend(layout)
+                .unwrap();
+            value.pad_to_align().size()
+        } else {
+            0
+        };
+        assert!(
+            layout.size().max(arc) <= rule["ceiling_bytes"].as_u64().unwrap() as usize,
+            "fixed {id}"
+        );
+        assert!(fixed.insert(id.to_owned(), json!({"bytes":layout.size(), "alignment":layout.align(), "arc_bytes":arc, "bucket":rule["bucket"]})).is_none());
+    }
+    assert_eq!(fixed.len(), 16);
+    let mut constructors = Map::new();
+    let mut diagnostics = Vec::new();
+    let mut failures = Vec::new();
+    let mut visit = |row: lifetimes::ConstructorLayout| {
+        assert!(diagnostics.len() < 36, "constructor diagnostic bound");
+        let rule = &policy["constructor_policy"][row.id];
+        assert!(rule.is_object(), "unlisted constructor {}", row.id);
+        let future = row.future.unwrap_or(Layout::new::<()>());
+        let channel = row.channel_payload.unwrap_or(Layout::new::<()>());
+        let mut rejected = Vec::new();
+        if [row.capture, future, row.result, channel]
+            .iter()
+            .any(|layout| layout.align() > 16)
+        {
+            rejected.push("maximum_alignment");
+        }
+        let typed = row
+            .capture
+            .size()
+            .checked_add(future.size())
+            .and_then(|bytes| bytes.checked_add(row.result.size()));
+        if typed.is_none() {
+            rejected.push("typed_sum_overflow");
+        }
+        let channel_bound = if row.channel_payload.is_some() {
+            channel
+                .size()
+                .checked_add(15)
+                .and_then(|bytes| 80usize.checked_add(bytes & !15))
+        } else {
+            Some(0)
+        };
+        if channel_bound.is_none() {
+            rejected.push("channel_bound_overflow");
+        }
+        let (owned, overlap) = match rule["rule"].as_str().unwrap() {
+            "R" => {
+                if row.future.is_none() {
+                    rejected.push("required_future_missing");
+                }
+                if row.channel_payload.is_none() {
+                    rejected.push("required_channel_missing");
+                }
+                if !matches!(typed, Some(bytes) if bytes <= ROOT_PAYLOAD_LIMIT) {
+                    rejected.push("typed_root_payload_limit");
+                }
+                let owned = channel_bound.and_then(|bytes| ROOT_OWNED_LIMIT.checked_sub(bytes));
+                if owned.is_none() {
+                    rejected.push("channel_owned_partition_limit");
+                }
+                (
+                    owned,
+                    typed
+                        .zip(channel_bound)
+                        .and_then(|(typed, channel)| typed.checked_add(channel))
+                        .zip(owned)
+                        .and_then(|(bytes, owned)| bytes.checked_add(owned)),
+                )
+            }
+            "N" => {
+                if row.future.is_some() {
+                    rejected.push("unexpected_native_future");
+                }
+                if row.channel_payload.is_none() {
+                    rejected.push("required_channel_missing");
+                }
+                (
+                    Some(0),
+                    typed
+                        .zip(channel_bound)
+                        .and_then(|(typed, channel)| typed.checked_add(channel)),
+                )
+            }
+            "I" => {
+                if row.channel_payload.is_some() {
+                    rejected.push("unexpected_inline_channel");
+                }
+                if !matches!(typed, Some(bytes) if bytes <= 8192) {
+                    rejected.push("typed_root_payload_limit");
+                }
+                (Some(0), Some(0))
+            }
+            _ => panic!("unlisted rule"),
+        };
+        let ceiling = rule["ceiling_bytes"].as_u64().unwrap() as usize;
+        if !matches!(overlap, Some(bytes) if bytes <= ceiling) {
+            rejected.push("admitted_overlap_limit");
+        }
+        let measurement = json!({
+            "capture_bytes":row.capture.size(),"capture_alignment":row.capture.align(),
+            "future_bytes":future.size(),"future_alignment":future.align(),
+            "result_bytes":row.result.size(),"result_alignment":row.result.align(),
+            "channel_payload_bytes":channel.size(),"channel_payload_alignment":channel.align(),
+            "channel_bound_bytes":channel_bound,"owned_capacity_bound_bytes":owned,"admitted_overlap_bytes":overlap,
+            "ceiling_bytes":rule["ceiling_bytes"],"creation_limit":rule["creation_limit"],"lanes":rule["lanes"],"bucket":rule["bucket"],
+        });
+        if constructors
+            .insert(row.id.to_owned(), measurement.clone())
+            .is_some()
+        {
+            rejected.push("duplicate_constructor");
+        }
+        diagnostics.push(json!({
+            "id":row.id,"rule":rule["rule"],"has_future":row.future.is_some(),
+            "has_channel":row.channel_payload.is_some(),"typed_bytes":typed,
+            "measurement":measurement,
+        }));
+        if !rejected.is_empty() {
+            failures.push(json!({"id":row.id,"checks":rejected}));
+        }
+    };
+    crate::actor::visit_guarded_layouts_for_test(&mut visit);
+    crate::runtime::visit_guarded_layouts_for_test(&mut visit);
+    crate::ltx_repl::visit_guarded_layouts_for_test(&mut visit);
+    crate::js::visit_guarded_sync_layouts_for_test(&mut visit);
+    crate::cell_dispatch::visit_guarded_layouts_for_test(&mut visit);
+    assert_eq!(constructors.len(), 36);
+    assert!(policy["constructor_policy"]
+        .as_object()
+        .unwrap()
+        .keys()
+        .all(|id| constructors.contains_key(id)));
+    if !failures.is_empty() {
+        assert_eq!(diagnostics.len(), 36);
+        assert!(failures.len() <= 36);
+        let record = json!({
+            "format":1,"claim":"b2-constructor-layout-rejection-diagnostics-only",
+            "rows":diagnostics,"failures":failures,
+        });
+        // This prefix is deliberately distinct from the successful layout
+        // evidence. A rejected ledger always fails before that record exists.
+        let mut line = b"FOKS_B2_LAYOUT_REJECTED ".to_vec();
+        serde_json::to_writer(&mut line, &record).expect("serialize rejected constructor layouts");
+        line.push(b'\n');
+        assert!(line.len() <= 65536);
+        let mut stderr = std::io::stderr().lock();
+        std::io::Write::write_all(&mut stderr, &line).expect("record rejected constructor layouts");
+        std::io::Write::flush(&mut stderr).expect("flush rejected constructor layouts");
+        drop(stderr);
+        panic!("constructor layout ledger rejected; see bounded per-row diagnostics");
+    }
+    let mut controls = Map::new();
+    for id in ["cancel", "primary_finish", "aux_finish", "retirement"] {
+        let layout = Layout::new::<ActorControl>();
+        assert!(layout.size() <= 2048 && layout.align() <= 16);
+        controls.insert(
+            id.to_owned(),
+            json!({"bytes":layout.size(),"alignment":layout.align(),"ceiling_bytes":2048}),
+        );
+    }
+    assert_eq!(control::CLEANUP_BYTES, 8 * (57344 + 16 * 512) + 4 * 2048);
+    let record = json!({"format":1,"claim":"b2-constructor-layouts-only","arc_convention":"repr-c-two-atomic-usize","fixed":fixed,"constructors":constructors,"controls":controls,"limits":policy["limits"]});
+    // Match B1's direct bounded stderr path: normal successful libtest
+    // capture must not hide the separately tagged numeric evidence.
+    let mut line = b"FOKS_B2_LAYOUT ".to_vec();
+    serde_json::to_writer(&mut line, &record).expect("serialize constructor layouts");
+    line.push(b'\n');
+    assert!(line.len() <= 65536);
+    let mut stderr = std::io::stderr().lock();
+    std::io::Write::write_all(&mut stderr, &line).expect("record constructor layouts");
+    std::io::Write::flush(&mut stderr).expect("flush constructor layouts");
+}
