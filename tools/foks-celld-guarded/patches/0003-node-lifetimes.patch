+impl ControlWait {
+    fn park_cancel(mut self) -> Result<(), Refusal> {
+        self.context
+            .require_role(JobRole::Cleanup(CleanupLane::Cancel))?;
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let root = OwnedEffectRegistry::root(&mut state, self.context.token)?;
+        if !root.consumer {
+            return Err(Refusal::Invalid);
+        }
+        root.consumer = false;
+        let wake = root.waker.take();
+        drop(state);
+        drop(record);
+        if let Some(wake) = wake {
+            wake.wake();
+        }
+        self.active = false;
+        Ok(())
+    }
+}
+impl JobContext {
+    pub(crate) async fn cancel_driver_and_join(&self) -> Result<(), Refusal> {
+        self.require_role(JobRole::Cleanup(CleanupLane::Stop))?;
+        let registry = self.registry()?;
+        if self.driver_disposed()? {
+            return Ok(());
+        }
+        registry.start_cancel_if_needed(self)?;
+        let record = registry.record(self.token)?;
+        let context = {
+            let mut state = lock_owned(&record.state)?;
+            let root = &mut state.roots[JobRole::Cleanup(CleanupLane::Cancel).index()];
+            if root.state == RootState::Spent {
+                return if state.roots[ForwardLane::Driver as usize].disposed() {
+                    Ok(())
+                } else {
+                    Err(Refusal::Failed)
+                };
+            }
+            if root.consumer || !matches!(root.state, RootState::Running | RootState::Joined) {
+                return Err(Refusal::Busy);
+            }
+            root.consumer = true;
+            let sequence = root.sequence;
+            drop(state);
+            registry.context(
+                &record,
+                self.token.slot as usize,
+                JobRole::Cleanup(CleanupLane::Cancel),
+                sequence,
+            )?
+        };
+        ControlWait {
+            context,
+            active: true,
+        }
+        .await?;
+        if !self.driver_disposed()? {
+            return Err(Refusal::Failed);
+        }
+        Ok(())
+    }
