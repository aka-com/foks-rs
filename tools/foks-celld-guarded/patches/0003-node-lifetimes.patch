+struct Publication {
+    record: Weak<InvocationRecord>,
+    token: RootToken,
+    child: Option<u64>,
+}
+impl Publication {
+    fn new(record: &Arc<InvocationRecord>, token: RootToken, child: Option<u64>) -> Self {
+        Self {
+            record: Arc::downgrade(record),
+            token,
+            child,
+        }
+    }
+    fn check(&self, record: &InvocationRecord, state: &mut InvocationState) -> Result<(), Refusal> {
+        if record.sequence != self.token.invocation {
+            return Err(Refusal::Invalid);
+        }
+        let root = OwnedEffectRegistry::root(state, self.token)?;
+        if let Some(sequence) = self.child {
+            if root.child.sequence != sequence
+                || root.child.handle.is_none()
+                || root.child.receiver.is_none()
+            {
+                return Err(Refusal::Invalid);
+            }
+        } else if root.state != RootState::Running
+            || root.handle.is_none()
+            || root.receiver.is_none()
+        {
+            return Err(Refusal::Invalid);
+        }
+        Ok(())
+    }
+    fn wait_native(&self) -> Result<(), Refusal> {
+        let record = self.record.upgrade().ok_or(Refusal::Failed)?;
+        let mut state = lock_owned(&record.state)?;
+        self.check(&record, &mut state)
+    }
+    async fn wait_async(&self) -> Result<(), Refusal> {
+        std::future::poll_fn(|cx| {
+            let Some(record) = self.record.upgrade() else {
+                return Poll::Ready(Err(Refusal::Failed));
+            };
+            let mut state = match poll_owned(&record.state, cx) {
+                Poll::Ready(Ok(state)) => state,
+                Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+                Poll::Pending => return Poll::Pending,
+            };
+            Poll::Ready(self.check(&record, &mut state))
+        })
+        .await
+    }
+}
+// Declare before a state/bank guard: replaced explicit wakers are destroyed
+// after that guard on every return, including early errors.
+struct DeferredWaker(Option<Waker>);
+impl Drop for DeferredWaker {
