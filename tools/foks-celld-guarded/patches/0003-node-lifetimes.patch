+    fn root_completion(
+        context: &JobContext,
+        attachment: EpochAttachment,
+        role: ReplicaRole,
+        result: anyhow::Result<()>,
+    ) -> LtxRootCompletion {
+        let result = result.map_err(|error| {
+            let reason = if error.is::<crate::replication::EvictionAbandoned>() {
+                Refusal::Cancelled
+            } else {
+                Refusal::Failed
+            };
+            refusal(context, reason)
+        });
+        LtxRootCompletion {
+            role,
+            token: context.root_token(),
+            result,
+            attachment,
+        }
+    }
+
+    // The accepted owner uses a real monotonic Instant, independent of the
+    // JavaScript/execution-domain clock. Keep that exact absolute timer and
+    // its inline allocation here, rather than deriving a new domain budget.
+    #[allow(clippy::disallowed_methods)]
+    fn original_deadline(context: &JobContext) -> tokio::time::Sleep {
+        tokio::time::sleep_until(tokio::time::Instant::from_std(context.original_deadline()))
+    }
+
+    async fn pause_forward(
+        context: &JobContext,
+        jobs: &EpochJobs,
+        notify: &Notify,
+        delay: Duration,
+    ) -> Result<bool, Refusal> {
+        let stop = jobs.stop.notified();
+        let wake = notify.notified();
+        if jobs.stopped() {
+            return Ok(false);
+        }
+        context.check_forward()?;
+        asyncrt::select_biased! {
+            "an epoch stop or original deadline that ties a background wake starts no new work";
+            _ = stop => {},
+            _ = original_deadline(context) => {
+                return Err(refusal(context, Refusal::Expired));
+            },
+            _ = wake => {},
+            _ = asyncrt::sleep(delay) => {},
+        }
+        if jobs.stopped() {
+            return Ok(false);
+        }
+        context.check_forward()?;
+        Ok(true)
+    }
+
+    impl HydrationWork {
+        async fn run(self, context: JobContext) -> LtxRootCompletion {
+            let result = self.hydrate(&context).await;
+            root_completion(&context, self.attachment, ReplicaRole::Hydration, result)
+        }
+        async fn hydrate(&self, context: &JobContext) -> anyhow::Result<()> {
+            let jobs = &self.attachment.0;
+            jobs.bind(context)?;
+            context.require_role(JobRole::Forward(ForwardLane::Hydration))?;
+            let Some(hydration) = &self.hydration else {
+                return Ok(());
+            };
+            let stopped = jobs.stop.notified();
+            if jobs.stopped() || hydration.cancelled.load(Ordering::Acquire) {
+                return Ok(());
+            }
+            context.check_forward()?;
+            let permit = asyncrt::select_biased! {
+                "a stop or original deadline that ties hydration admission starts no native open";
+                _ = stopped => return Ok(()),
+                _ = original_deadline(context) => {
+                    return Err(refusal(context, Refusal::Expired).into());
+                },
+                result = self.slots.acquire() => result.map_err(|_| Refusal::Cancelled)?,
+            };
+            if jobs.stopped() || hydration.cancelled.load(Ordering::Acquire) {
+                return Ok(());
+            }
+            context.check_forward()?;
+            context.charge_owned(self.name.len() + self.path.as_os_str().len())?;
+            let mut resource = native_resource(
+                context,
+                NativeInput::HydratorOpen {
+                    name: self.name.clone(),
+                    path: self.path.clone(),
+                },
+            )?;
+            resource = native(
+                context,
+                self.attachment.clone(),
+                NativeKind::HydratorOpen,
+                resource,
+            )
+            .await?;
+            let mut hydrator = match std::mem::replace(&mut resource.output, NativeOutput::Empty) {
+                NativeOutput::Hydrator(result) => result?,
+                _ => return Err(refusal(context, Refusal::Invalid).into()),
+            };
+            loop {
+                if jobs.stopped() || hydration.cancelled.load(Ordering::Acquire) {
+                    break;
+                }
+                context.check_forward()?;
+                resource.input = NativeInput::HydratorStep(Some(hydrator));
+                resource = native(
+                    context,
+                    self.attachment.clone(),
+                    NativeKind::HydratorStep,
+                    resource,
+                )
+                .await?;
+                let progress = match std::mem::replace(&mut resource.output, NativeOutput::Empty) {
+                    NativeOutput::HydratorStep {
+                        hydrator: returned,
+                        result,
+                    } => {
+                        hydrator = returned;
+                        result?
+                    }
+                    _ => return Err(refusal(context, Refusal::Invalid).into()),
+                };
+                if progress.complete() {
+                    hydration.complete.store(true, Ordering::Release);
+                    break;
+                }
+                if !pause_forward(
+                    context,
+                    jobs,
+                    &jobs.sync,
+                    Duration::from_millis(self.step_ms),
+                )
+                .await?
+                {
+                    break;
+                }
+            }
+            // A real normal drop closes this connection before the root join.
+            // C6 cannot unregister its VFS until it consumes that joined root.
+            drop(hydrator);
+            drop(resource);
+            drop(permit);
+            Ok(())
+        }
+    }
+
+    struct SyncClaim(CellHandle);
+    impl SyncClaim {
+        fn new(context: &JobContext, handle: &CellHandle) -> Result<Self, Refusal> {
+            handle
+                .syncing
+                .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+                .map_err(|_| refusal(context, Refusal::Busy))?;
+            Ok(Self(handle.clone()))
+        }
+    }
+    impl Drop for SyncClaim {
+        fn drop(&mut self) {
+            self.0.syncing.store(false, Ordering::Release);
+            self.0.ready.notify_waiters();
+        }
+    }
+
+    async fn sync_owned(
+        context: &JobContext,
+        attachment: &EpochAttachment,
+        handle: &CellHandle,
+        resource: &mut Option<Box<NativeResource>>,
+    ) -> anyhow::Result<bool> {
+        attachment.validate(context)?;
+        context.check_job()?;
+        let _serialized = attachment.0.sync_gate.lock().await;
+        context.check_job()?;
+        let _claim = SyncClaim::new(context, handle)?;
+        let mut slot = match resource.take() {
+            Some(mut slot) => {
+                slot.input = NativeInput::Sync(handle.clone());
+                slot
+            }
+            None => native_resource(context, NativeInput::Sync(handle.clone()))?,
+        };
+        slot = native(context, attachment.clone(), NativeKind::SyncCapture, slot).await?;
+        let staged = match std::mem::replace(&mut slot.output, NativeOutput::Empty) {
+            NativeOutput::Sync(value) => value,
+            _ => return Err(refusal(context, Refusal::Invalid).into()),
+        };
+        *resource = Some(slot);
+        if matches!(context.role(), JobRole::Forward(_)) && attachment.0.stopped() {
+            return Ok(false);
+        }
+        if !matches!(staged, Some(Ok(_))) {
+            return Err(refusal(context, Refusal::Failed).into());
+        }
+        // This is the canonical upload/credit path. Its async work remains
+        // inside this root; no timeout drops a native capture or its result.
+        let result = finish_sync_cell(handle.clone(), staged).await;
+        if !(matches!(context.role(), JobRole::Forward(_)) && attachment.0.stopped()) {
+            context.check_job()?;
+        }
+        Ok(result == Some(true))
+    }
+
+    impl SyncWork {
+        async fn run(self, context: JobContext) -> LtxRootCompletion {
+            let result = self.sync(&context).await;
+            root_completion(&context, self.attachment, ReplicaRole::Sync, result)
+        }
+        async fn sync(&self, context: &JobContext) -> anyhow::Result<()> {
+            let jobs = &self.attachment.0;
+            jobs.bind(context)?;
+            context.require_role(JobRole::Forward(ForwardLane::Sync))?;
+            let mut resource = None;
+            loop {
+                if jobs.stopped() {
+                    return Ok(());
+                }
+                context.check_forward()?;
+                if self.handle.req_seq.load(Ordering::Acquire)
+                    > self.handle.synced_seq.load(Ordering::Acquire)
+                {
+                    if !sync_owned(context, &self.attachment, &self.handle, &mut resource).await?
+                        && !pause_forward(context, jobs, &jobs.sync, Duration::from_millis(50))
+                            .await?
+                    {
+                        return Ok(());
+                    }
+                } else if !pause_forward(context, jobs, &jobs.sync, Duration::from_millis(25))
+                    .await?
+                {
+                    return Ok(());
+                }
+            }
+        }
+    }
+
+    impl CompactionRootWork {
+        async fn run(self, context: JobContext) -> LtxRootCompletion {
+            let result = self.compact(&context).await;
+            root_completion(&context, self.attachment, ReplicaRole::Compaction, result)
+        }
+        async fn compact(&self, context: &JobContext) -> anyhow::Result<()> {
+            let jobs = &self.attachment.0;
+            jobs.bind(context)?;
+            context.require_role(JobRole::Forward(ForwardLane::Compaction))?;
+            let Some(compaction) = &self.handle.compaction else {
+                return Ok(());
+            };
+            let host = jobs.scoped_host(context, &compaction.host)?;
+            loop {
+                if jobs.stopped() {
+                    return Ok(());
+                }
+                context.check_forward()?;
+                if !jobs.compaction_pending.swap(false, Ordering::AcqRel) {
+                    if !pause_forward(context, jobs, &jobs.compaction, Duration::from_millis(25))
+                        .await?
+                    {
+                        return Ok(());
+                    }
+                    continue;
+                }
+                if compaction.halted() {
+                    continue;
+                }
+                let started = asyncrt::mono_ms();
+                // Never cancel/drop this lower future while it owns an opaque
+                // callback. Cancellation stops future admissions; the current
+                // lower call and real native child finish before this root.
+                let outcome = compact_cell_with_host(
+                    self.handle.clone(),
+                    started,
+                    "guarded",
+                    false,
+                    None,
+                    Some(host.clone()),
+                )
+                .await;
+                guarded_compaction_result(context, outcome)?;
+                if jobs.stopped() {
+                    return Ok(());
+                }
+                context.check_forward()?;
+                let pause = match outcome {
+                    CompactionOutcome::Failed => {
+                        unreachable!("guarded failure was latched before stop")
+                    }
+                    CompactionOutcome::Advanced => {
+                        Duration::from_millis(asyncrt::mono_ms().saturating_sub(started))
+                            .min(Duration::from_secs(2))
+                    }
+                    CompactionOutcome::Current | CompactionOutcome::Cancelled => continue,
+                };
+                jobs.compaction_pending.store(true, Ordering::Release);
+                if !pause_forward(context, jobs, &jobs.compaction, pause).await? {
+                    return Ok(());
+                }
+            }
+        }
+    }
+
+    fn guarded_compaction_result(
+        context: &JobContext,
+        outcome: CompactionOutcome,
+    ) -> Result<(), Refusal> {
+        // Lower LtxHost catches an opaque operation panic and compaction
+        // erases its typed cause into Failed. Latch before any stop shortcut.
+        if outcome == CompactionOutcome::Failed {
+            return Err(refusal(context, Refusal::Failed));
+        }
+        Ok(())
+    }
+
+    impl ActivationScope {
+        pub(super) fn start_background(
+            &self,
+            repl: &LtxRepl,
+            handle: CellHandle,
+            path: &Path,
+            name: Option<&str>,
+            hydration: Option<Arc<CellHydration>>,
+        ) -> Result<(), Refusal> {
+            self.check(repl)?;
+            let permit = self
+                .context
+                .claim_replica(ReplicaRole::Hydration, &self.attachment)?;
+            permit.charge_owned(path.as_os_str().len() + name.map_or(0, str::len))?;
+            let work = HydrationWork {
+                path: path.to_path_buf(),
+                name: name.unwrap_or_default().to_owned(),
+                hydration,
+                slots: repl.hydrations.clone(),
+                step_ms: (u64::from(HYDRATE_STEP_PAGES) * 4096 * 1_000
+                    / repl.hydrate_bytes_per_s.max(1))
+                .max(1),
+                attachment: self.attachment.clone(),
+            };
+            let wait = permit.submit_ltx(move |context| work.run(context))?;
+            drop(wait); // only the consumer ticket, never the installed handle
+            let permit = self
+                .context
+                .claim_replica(ReplicaRole::Sync, &self.attachment)?;
+            let work = SyncWork {
+                handle: handle.clone(),
+                attachment: self.attachment.clone(),
+            };
+            let wait = permit.submit_ltx(move |context| work.run(context))?;
+            drop(wait);
+            let permit = self
+                .context
+                .claim_replica(ReplicaRole::Compaction, &self.attachment)?;
+            let work = CompactionRootWork {
+                handle,
+                attachment: self.attachment.clone(),
+            };
+            let wait = permit.submit_ltx(move |context| work.run(context))?;
+            drop(wait);
+            Ok(())
+        }
+    }
+
+    fn capture_snapshot(
+        handle: &CellHandle,
+        budget: usize,
+    ) -> anyhow::Result<Option<HandoffSnapshot>> {
+        if handle.paged_vfs.is_some() || handle.snapshot_declined.load(Ordering::Relaxed) {
+            return Ok(None);
+        }
+        let mut replica_slot = handle
+            .replica
+            .lock()
+            .map_err(|_| anyhow!("snapshot replica lock poisoned"))?;
+        let db = replica_slot
+            .as_mut()
+            .and_then(Replica::db_mut)
+            .ok_or_else(|| anyhow!("snapshot replica is unavailable"))?;
+        db.sync()
+            .map_err(|e| anyhow!("capture handoff database: {e}"))?;
+        let durable_txid = db.pos()?.txid;
+        if durable_txid == TXID(0) {
+            return Ok(None);
+        }
+        let mut data = Vec::new();
+        let position = match db.snapshot_to_writer(&mut BoundedWriter {
+            data: &mut data,
+            budget,
+        }) {
+            Ok(position) => position,
+            Err(_) if data.len() >= budget => {
+                handle.snapshot_declined.store(true, Ordering::Relaxed);
+                return Ok(None);
+            }
+            Err(error) => return Err(anyhow!("create handoff snapshot: {error}")),
+        };
+        anyhow::ensure!(
+            position.txid == durable_txid,
+            "snapshot position changed during capture"
+        );
+        Ok(Some(HandoffSnapshot {
+            max_txid: position.txid,
+            data,
+        }))
+    }
+
+    #[derive(Clone, Copy)]
+    enum LocalDisposition {
+        Keep,
+        Preserve,
+        Remove,
+    }
+
+    fn absent_ok(result: io::Result<()>) -> io::Result<()> {
+        match result {
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+            other => other,
+        }
+    }
+
+    fn close_guarded_local(
+        handle: &CellHandle,
+        path: &Path,
+        filesystem: &dyn celld_ltx::FileSystem,
+        disposition: LocalDisposition,
+    ) -> anyhow::Result<Option<PathBuf>> {
+        // F0/F1/F2 and all direct users were joined before this child. A
+        // failed close does not authorize VFS unregister, rename or removal.
+        close_replica_staged(handle).1?;
+        if let Some(name) = &handle.paged_vfs {
+            celld_ltx::paged_vfs::unregister_paged_vfs(name)?;
+        }
+        if matches!(disposition, LocalDisposition::Keep) {
+            return Ok(None);
+        }
+        let preserved =
+            if matches!(disposition, LocalDisposition::Preserve) && handle.paged_vfs.is_none() {
+                let preserved = path.with_extension("evicted");
+                filesystem.rename(path, &preserved)?;
+                Some(preserved)
+            } else {
+                None
+            };
+        for suffix in ["-wal", "-shm"] {
+            let mut sibling = path.as_os_str().to_owned();
+            sibling.push(suffix);
+            absent_ok(filesystem.remove_file(&PathBuf::from(sibling)))?;
+        }
+        absent_ok(filesystem.remove_dir_all(&Db::meta_path_for_path(path)))?;
+        if preserved.is_none() {
+            absent_ok(filesystem.remove_file(path))?;
+        }
+        Ok(preserved)
+    }
+
+    impl LtxRepl {
+        pub(super) fn refuse_ordinary_epoch(&self, cell: &str, epoch: u64) -> anyhow::Result<()> {
+            let state = self.registration.lock().map_err(|_| Refusal::Failed)?;
+            anyhow::ensure!(
+                !state
+                    .guarded_scopes
+                    .iter()
+                    .flatten()
+                    .any(|&(scope, e)| scope == cell && e == epoch),
+                "guarded epoch requires its original admitted owner"
+            );
+            Ok(())
+        }
+
+        pub(crate) fn attach_guarded(
+            &self,
+            context: &JobContext,
+            cell: &str,
+            epoch: u64,
+        ) -> Result<EpochAttachment, Refusal> {
+            context.require_role(JobRole::Forward(ForwardLane::Activation))?;
+            if context.cell() != cell
+                || context.epoch() != Some(epoch)
+                || self.guarded_backend.is_none()
+                || self.stop.is_stopped()
+            {
+                return Err(refusal(context, Refusal::Invalid));
+            }
+            // Charging touches the original node owner and therefore precedes
+            // this new attachment's deliberately nonblocking admission lock.
+            context.charge_owned(arc_bytes::<EpochJobs>()?)?;
+            let attached = (|| {
+                let mut registration =
+                    self.registration.try_lock().map_err(|error| match error {
+                        TryLockError::WouldBlock => Refusal::Contended,
+                        TryLockError::Poisoned(poisoned) => {
+                            drop(poisoned);
+                            Refusal::Failed
+                        }
+                    })?;
+                // An expired registered Weak is still an installed registration.
+                if registration.current.is_some() || registration.guarded_epochs >= 2 {
+                    return Err(Refusal::Busy);
+                }
+                let registration_slot = registration
+                    .guarded_scopes
+                    .iter()
+                    .position(Option::is_none)
+                    .ok_or(Refusal::Busy)?;
+                if registration
+                    .guarded_scopes
+                    .iter()
+                    .flatten()
+                    .any(|&(scope, attached_epoch)| scope == cell && attached_epoch == epoch)
+                {
+                    return Err(Refusal::Busy);
+                }
+                let mut contexts = std::array::from_fn(|_| None);
+                contexts[role_index(context.role())] = Some(context.clone());
+                let jobs = Arc::new(EpochJobs {
+                    epoch,
+                    registration_slot,
+                    registration: self.registration.clone(),
+                    state: Mutex::new(EpochState {
+                        contexts,
+                        proofs: [None, None],
+                        terminal: None,
+                        installed: false,
+                    }),
+                    stopping: AtomicBool::new(false),
+                    retired: AtomicBool::new(false),
+                    orphaned_registration: AtomicBool::new(false),
+                    sync: Notify::new(),
+                    compaction: Notify::new(),
+                    stop: Notify::new(),
+                    compaction_pending: AtomicBool::new(false),
+                    sync_gate: tokio::sync::Mutex::new(()),
+                    host_scratch: Mutex::new(None),
+                    failed_callback: AtomicBool::new(false),
+                    owner: Some(context.clone()),
+                });
+                registration.guarded_epochs += 1;
+                registration.guarded_scopes[registration_slot] = Some((context.cell(), epoch));
+                Ok(EpochAttachment(jobs))
+            })();
+            attached.map_err(|reason| refusal(context, reason))
+        }
+
+        fn guarded_handle(
+            &self,
+            context: &JobContext,
+            attachment: &EpochAttachment,
+        ) -> Result<CellHandle, Refusal> {
+            attachment.validate(context)?;
+            if !Arc::ptr_eq(&self.registration, &attachment.0.registration)
+                || self.guarded_backend.is_none()
+            {
+                return Err(refusal(context, Refusal::Invalid));
+            }
+            let installed = lock(&attachment.0.state)
+                .map_err(|reason| refusal(context, reason))?
+                .installed;
+            if !installed {
+                return Err(refusal(context, Refusal::Invalid));
+            }
+            context.charge_owned(context.cell().len())?;
+            let key = (context.cell().to_owned(), attachment.0.epoch);
+            let active = lock(&self.cells)
+                .map_err(|reason| refusal(context, reason))?
+                .get(&key)
+                .cloned();
+            let found = match active {
+                Some(handle) => Some(handle),
+                None => lock(&self.stopped_cells)
+                    .map_err(|reason| refusal(context, reason))?
+                    .get(&key)
+                    .cloned(),
+            };
+            let handle = found.ok_or_else(|| refusal(context, Refusal::Invalid))?;
+            if !handle
+                .guarded
+                .as_ref()
+                .is_some_and(|jobs| Arc::ptr_eq(jobs, &attachment.0))
+            {
+                return Err(refusal(context, Refusal::Invalid));
+            }
+            context.check_job()?;
+            Ok(handle)
+        }
+
+        pub(crate) async fn restore_guarded(
+            &self,
+            context: &JobContext,
+            attachment: &EpochAttachment,
+            spec: &celld_logic::RestoreSpec,
+            allow_paged: bool,
+        ) -> anyhow::Result<GuardedActivation> {
+            context.require_role(JobRole::Forward(ForwardLane::Activation))?;
+            attachment.validate(context)?;
+            anyhow::ensure!(
+                spec.epoch == attachment.0.epoch && context.fresh() == Some(spec.fresh),
+                "guarded restore changed its actual ownership decision"
+            );
+            context.charge_owned(spec.prior.as_ref().map_or(0, String::len))?;
+            let options = ActivationOptions {
+                cell: context.cell(),
+                epoch: spec.epoch,
+                fresh: spec.fresh,
+                took_over: spec.took_over,
+                resume_local: spec.resume_local,
+                prior: spec.prior.clone(),
+            };
+            let result = self
+                .activate_owned(
+                    options,
+                    allow_paged,
+                    ActivationMode::Guarded(ActivationScope {
+                        context: context.clone(),
+                        attachment: attachment.clone(),
+                    }),
+                )
+                .await;
+            match result {
+                Ok(result) => {
+                    context.check_forward()?;
+                    Ok(GuardedActivation {
+                        path: result.path,
+                        restored: result.restored,
+                        vfs: result.vfs,
+                        attachment: attachment.clone(),
+                    })
+                }
+                Err(error) => {
+                    context.fail();
+                    Err(error)
+                }
+            }
+        }
+
+        pub(crate) fn begin_proof_guarded(
+            &self,
+            context: &JobContext,
+            attachment: &EpochAttachment,
+            position: u64,
+        ) -> anyhow::Result<GuardedProof> {
+            let slot = match context.role() {
+                JobRole::Forward(ForwardLane::PrimaryProof) => 0,
+                JobRole::Forward(ForwardLane::AuxProof) => 1,
+                _ => return Err(refusal(context, Refusal::Invalid).into()),
+            };
+            context.check_forward()?;
+            let handle = self.guarded_handle(context, attachment)?;
+            let selected = (|| {
+                let mut state = lock(&attachment.0.state)?;
+                if let Some(old) = state.proofs[slot] {
+                    if old.token == context.root_token() {
+                        if old.position != position {
+                            return Err(Refusal::Invalid);
+                        }
+                        return Ok((old, false));
+                    }
+                    if handle.synced_seq.load(Ordering::Acquire) < old.ticket {
+                        return Err(Refusal::Busy);
+                    }
+                }
+                let ticket = handle
+                    .req_seq
+                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| n.checked_add(1))
+                    .map_err(|_| Refusal::Exhausted)?
+                    + 1;
+                let proof = ProofSlot {
+                    ticket,
+                    position,
+                    token: context.root_token(),
+                };
+                state.proofs[slot] = Some(proof);
+                Ok((proof, true))
+            })();
+            let (proof, notify) = selected.map_err(|reason| refusal(context, reason))?;
+            context.check_forward()?;
+            if notify {
+                attachment.0.sync.notify_one();
+            }
+            Ok(GuardedProof {
+                slot,
+                proof,
+                attachment: attachment.clone(),
+            })
+        }
+
+        pub(crate) async fn await_durable_guarded(
+            &self,
+            context: &JobContext,
+            attachment: &EpochAttachment,
+            proof: &GuardedProof,
+        ) -> anyhow::Result<(u64, celld_logic::ProofSource)> {
+            let terminal = match context.role() {
+                JobRole::Forward(ForwardLane::PrimaryProof) if proof.slot == 0 => false,
+                JobRole::Forward(ForwardLane::AuxProof) if proof.slot == 1 => false,
+                JobRole::Cleanup(CleanupLane::TerminalProof) => true,
+                _ => return Err(refusal(context, Refusal::Invalid).into()),
+            };
+            context.check_job()?;
+            let handle = self.guarded_handle(context, attachment)?;
+            if !Arc::ptr_eq(&attachment.0, &proof.attachment.0) || proof.slot >= 2 {
+                return Err(refusal(context, Refusal::Invalid).into());
+            }
+            let recorded = lock(&attachment.0.state)
+                .map_err(|reason| refusal(context, reason))?
+                .proofs[proof.slot];
+            if !recorded.is_some_and(|stored| {
+                stored.ticket == proof.proof.ticket
+                    && stored.position == proof.proof.position
+                    && stored.token == proof.proof.token
+            }) || (!terminal && proof.proof.token != context.root_token())
+            {
+                return Err(refusal(context, Refusal::Invalid).into());
+            }
+            if terminal && handle.synced_seq.load(Ordering::Acquire) < proof.proof.ticket {
+                let mut resource = None;
+                if !sync_owned(context, attachment, &handle, &mut resource).await? {
+                    return Err(refusal(context, Refusal::Failed).into());
+                }
+            }
+            let wait = self.wait_for_durability_ticket(
+                &handle,
+                context.cell(),
+                attachment.0.epoch,
+                proof.proof.ticket,
+            );
+            let source = if terminal {
+                wait.await?
+            } else {
+                context.bound_forward(wait).await??
+            };
+            anyhow::ensure!(
+                matches!(source, celld_logic::ProofSource::Bucket),
+                "guarded epoch acquired a fleet proof"
+            );
+            context.check_job()?;
+            Ok((proof.proof.position, source))
+        }
+
+        pub(crate) async fn ensure_durable_guarded(
+            &self,
+            context: &JobContext,
+            attachment: &EpochAttachment,
+            revocable: bool,
+        ) -> anyhow::Result<()> {
+            context.require_role(JobRole::Cleanup(CleanupLane::EnsureDurable))?;
+            let handle = self.guarded_handle(context, attachment)?;
+            let selected = (|| {
+                let mut state = lock(&attachment.0.state)?;
+                if let Some(ticket) = state.terminal {
+                    if ticket.token != context.root_token() {
+                        return Err(Refusal::Invalid);
+                    }
+                    Ok(ticket.ticket)
+                } else {
+                    let ticket = handle
+                        .req_seq
+                        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| n.checked_add(1))
+                        .map_err(|_| Refusal::Exhausted)?
+                        + 1;
+                    // This signature has no canonical storage-position sample.
+                    // A terminal LTX ticket cannot invent core-position coverage.
+                    state.terminal = Some(ProofSlot {
+                        ticket,
+                        position: 0,
+                        token: context.root_token(),
+                    });
+                    Ok(ticket)
+                }
+            })();
+            let ticket = selected.map_err(|reason| refusal(context, reason))?;
+            let mut resource = None;
+            if handle.synced_seq.load(Ordering::Acquire) < ticket
+                && !sync_owned(context, attachment, &handle, &mut resource).await?
+            {
+                return Err(refusal(context, Refusal::Failed).into());
+            }
+            if handle.synced_seq.load(Ordering::Acquire) < ticket {
+                return Err(refusal(context, Refusal::Failed).into());
+            }
+            if revocable && !handle.client.0.has_any_object().await? {
+                return Err(refusal(context, Refusal::Failed).into());
+            }
+            context.check_job()?;
+            Ok(())
+        }
+
+        pub(crate) fn prove_existing_guarded(
+            &self,
+            context: &JobContext,
+            attachment: &EpochAttachment,
+            position: u64,
+        ) -> anyhow::Result<(u64, celld_logic::ProofSource)> {
+            if !matches!(
+                context.role(),
+                JobRole::Forward(ForwardLane::Wake) | JobRole::Cleanup(CleanupLane::Wake)
+            ) {
+                return Err(refusal(context, Refusal::Invalid).into());
+            }
+            context.check_job()?;
+            let handle = self.guarded_handle(context, attachment)?;
+            let position = {
+                let state = lock(&attachment.0.state).map_err(|reason| refusal(context, reason))?;
+                let synced = handle.synced_seq.load(Ordering::Acquire);
+                state
+                    .proofs
+                    .iter()
+                    .flatten()
+                    .chain(state.terminal.iter())
+                    .filter(|proof| proof.position >= position && synced >= proof.ticket)
+                    .min_by_key(|proof| proof.position)
+                    .map(|proof| proof.position)
+            }
+            .ok_or_else(|| refusal(context, Refusal::Invalid))?;
+            context.check_job()?;
+            Ok((position, celld_logic::ProofSource::Bucket))
+        }
+
+        pub(crate) async fn retire_guarded(
+            &self,
+            context: &JobContext,
+            attachment: &EpochAttachment,
+            mode: StopMode,
+        ) -> anyhow::Result<()> {
+            context.require_role(JobRole::Cleanup(CleanupLane::Retirement))?;
+            attachment.validate(context)?;
+            if attachment.0.orphaned_registration.load(Ordering::Acquire) {
+                return Err(refusal(context, Refusal::Failed).into());
+            }
+            let handle = self.guarded_handle(context, attachment)?;
+            attachment.0.stop_forward();
+            if let Some(hydration) = &handle.hydration {
+                hydration.cancelled.store(true, Ordering::Release);
+            }
+            cancel_compaction(&handle);
+            for role in [
+                ReplicaRole::Hydration,
+                ReplicaRole::Sync,
+                ReplicaRole::Compaction,
+            ] {
+                let joined = context.stop_replica(role, attachment)?.await?;
+                let mut outcome = Err(Refusal::Invalid);
+                joined.consume_ltx(|completion| {
+                    let expected_role = role;
+                    let job_role = match role {
+                        ReplicaRole::Hydration => JobRole::Forward(ForwardLane::Hydration),
+                        ReplicaRole::Sync => JobRole::Forward(ForwardLane::Sync),
+                        ReplicaRole::Compaction => JobRole::Forward(ForwardLane::Compaction),
+                        ReplicaRole::Retirement => JobRole::Cleanup(CleanupLane::Retirement),
+                    };
+                    let token_matches = lock(&attachment.0.state).is_ok_and(|state| {
+                        state.contexts[role_index(job_role)]
+                            .as_ref()
+                            .is_some_and(|bound| bound.root_token() == completion.token)
+                    });
+                    if completion.role != expected_role
+                        || !token_matches
+                        || !Arc::ptr_eq(&completion.attachment.0, &attachment.0)
+                    {
+                        context.fail();
+                        std::mem::forget(completion);
+                        return;
+                    }
+                    outcome = completion.result;
+                })?;
+                outcome?;
+            }
+            // Move the exact resident into the stopped map under close
+            // exclusion. No ordinary close path is allowed to consume it.
+            context.charge_owned(context.cell().len().checked_mul(2).ok_or(Refusal::Bounds)?)?;
+            let key = (context.cell().to_owned(), attachment.0.epoch);
+            let transferred = (|| {
+                let _close = lock(&self.replica_close_gate)?;
+                let mut cells = lock(&self.cells)?;
+                let mut stopped = lock(&self.stopped_cells)?;
+                if let Some(current) = cells.get(&key) {
+                    if !Arc::ptr_eq(current, &handle) || stopped.contains_key(&key) {
+                        return Err(Refusal::Invalid);
+                    }
+                    stopped.insert(key.clone(), cells.remove(&key).ok_or(Refusal::Invalid)?);
+                }
+                if !stopped
+                    .get(&key)
+                    .is_some_and(|current| Arc::ptr_eq(current, &handle))
+                    || Arc::strong_count(&handle) != 2
+                {
+                    return Err(Refusal::Busy);
+                }
+                Ok(())
+            })();
+            transferred.map_err(|reason| refusal(context, reason))?;
+            let mut resource = None;
+            let disposition = match &mode {
+                StopMode::CloseInPlace => LocalDisposition::Keep,
+                StopMode::Discard => LocalDisposition::Remove,
+                StopMode::Rebase => {
+                    if !sync_owned(context, attachment, &handle, &mut resource).await? {
+                        return Err(refusal(context, Refusal::Failed).into());
+                    }
+                    LocalDisposition::Preserve
+                }
+                StopMode::Evict {
+                    preserve_local,
+                    abandon,
+                } => {
+                    let abandoned = || {
+                        anyhow::Error::new(crate::replication::EvictionAbandoned {
+                            cell: context.cell().to_owned(),
+                            epoch: attachment.0.epoch,
+                        })
+                    };
+                    if abandon.as_ref().is_some_and(|signal| signal.requested()) {
+                        return Err(abandoned());
+                    }
+                    let budget =
+                        usize::try_from(self.snapshot_budget_bytes.load(Ordering::Relaxed))
+                            .unwrap_or(usize::MAX);
+                    let slot = native_resource(
+                        context,
+                        NativeInput::Snapshot {
+                            handle: handle.clone(),
+                            budget,
+                        },
+                    )?;
+                    let mut slot =
+                        native(context, attachment.clone(), NativeKind::Snapshot, slot).await?;
+                    let snapshot = match std::mem::replace(&mut slot.output, NativeOutput::Empty) {
+                        NativeOutput::Snapshot(result) => result?,
+                        _ => return Err(refusal(context, Refusal::Invalid).into()),
+                    };
+                    if abandon.as_ref().is_some_and(|signal| signal.requested()) {
+                        return Err(abandoned());
+                    }
+                    let mut durable = false;
+                    if let Some(snapshot) = snapshot {
+                        let publish = async {
+                            let info = handle
+                                .client
+                                .write_ltx_file(
+                                    replica::SNAPSHOT_LEVEL,
+                                    TXID(1),
+                                    snapshot.max_txid,
+                                    &snapshot.data,
+                                )
+                                .await?;
+                            anyhow::ensure!(
+                                info.level == replica::SNAPSHOT_LEVEL
+                                    && info.min_txid == TXID(1)
+                                    && info.max_txid == snapshot.max_txid,
+                                "guarded snapshot metadata changed"
+                            );
+                            anyhow::ensure!(
+                                handle.client.0.has_any_object().await?,
+                                "guarded snapshot is not visible"
+                            );
+                            anyhow::Ok(())
+                        };
+                        // This bounds only the canonical async publication
+                        // attempt. Native capture already joined, and no remote
+                        // PUT-termination or reclamation proof follows.
+                        durable = matches!(
+                            asyncrt::timeout(
+                                Duration::from_millis(self.durability_timeout_ms),
+                                publish
+                            )
+                            .await,
+                            Ok(Ok(()))
+                        );
+                        if durable {
+                            credit_percell_upload(&handle, snapshot.max_txid.0);
+                        } else {
+                            handle.snapshot_declined.store(true, Ordering::Relaxed);
+                        }
+                    }
+                    if !durable
+                        && (!sync_owned(context, attachment, &handle, &mut resource).await?
+                            || !handle.client.0.has_any_object().await?)
+                    {
+                        return Err(refusal(context, Refusal::Failed).into());
+                    }
+                    if *preserve_local {
+                        LocalDisposition::Preserve
+                    } else {
+                        LocalDisposition::Remove
+                    }
+                }
+            };
+            // Bound the epoch's decimal path and all direct sibling copies
+            // before allocating the first owned path for this native job.
+            let path_bytes = self
+                .watch
+                .as_os_str()
+                .len()
+                .checked_add(context.cell().len())
+                .and_then(|n| n.checked_add("/ltx/e18446744073709551615/db.sqlite".len() + 1))
+                .and_then(|n| n.checked_mul(5))
+                .and_then(|n| n.checked_add(64))
+                .ok_or_else(|| refusal(context, Refusal::Bounds))?;
+            context.charge_owned(path_bytes)?;
+            let path = self.db_path(context.cell(), attachment.0.epoch);
+            let slot = native_resource(
+                context,
+                NativeInput::Close {
+                    handle: handle.clone(),
+                    path,
+                    filesystem: self.ltx_host.filesystem(),
+                    disposition,
+                },
+            )?;
+            let mut slot =
+                native(context, attachment.clone(), NativeKind::LocalClose, slot).await?;
+            let preserved = match std::mem::replace(&mut slot.output, NativeOutput::Empty) {
+                NativeOutput::Close(result) => result?,
+                _ => return Err(refusal(context, Refusal::Invalid).into()),
+            };
+            drop(slot);
+            drop(resource);
+            if let Some(path) = preserved {
+                self.preserved
+                    .lock()
+                    .map_err(|_| Refusal::Failed)?
+                    .insert(path)?;
+            }
+            self.note_covered(
+                context.cell(),
+                attachment.0.epoch,
+                percell_coverage(&handle),
+            );
+            let removed = (|| {
+                let mut stopped = lock(&self.stopped_cells)?;
+                if Arc::strong_count(&handle) != 2
+                    || !stopped
+                        .get(&key)
+                        .is_some_and(|current| Arc::ptr_eq(current, &handle))
+                {
+                    return Err(Refusal::Busy);
+                }
+                stopped.remove(&key).ok_or(Refusal::Invalid)
+            })();
+            // The actual Cell/Db/VFS owner is disposed only outside its map.
+            drop(removed.map_err(|reason| refusal(context, reason))?);
+            drop(handle);
+            let scratch = lock(&attachment.0.host_scratch)
+                .map_err(|reason| refusal(context, reason))?
+                .take();
+            if let Some((_, resource)) = scratch {
+                if !matches!(resource.input, NativeInput::Empty)
+                    || !matches!(resource.output, NativeOutput::Empty)
+                {
+                    std::mem::forget(resource);
+                    return Err(refusal(context, Refusal::Invalid).into());
+                }
+                drop(resource);
+            }
+            // Actual native jobs/results and Cell resources have been disposed.
+            // Release registration exclusion only at this final proven cut.
+            let released = (|| {
+                let mut registration = lock(&attachment.0.registration)?;
+                if registration.current.is_some() || registration.guarded_epochs == 0 {
+                    return Err(Refusal::Invalid);
+                }
+                let mut state = lock(&attachment.0.state)?;
+                if registration.guarded_scopes[attachment.0.registration_slot]
+                    != Some((context.cell(), attachment.0.epoch))
+                {
+                    return Err(Refusal::Invalid);
+                }
+                registration.guarded_scopes[attachment.0.registration_slot] = None;
+                registration.guarded_epochs -= 1;
+                attachment.0.retired.store(true, Ordering::Release);
+                Ok(std::mem::replace(
+                    &mut state.contexts,
+                    std::array::from_fn(|_| None),
+                ))
+            })();
+            // JobContext destruction can reach the node's ownership bank.
+            // The fixed context array is moved out before either LTX guard ends.
+            let contexts = released.map_err(|reason| refusal(context, reason))?;
+            drop(contexts);
+            Ok(())
+        }
+
+        pub(crate) async fn retire_job_guarded(
+            self: Arc<Self>,
+            context: JobContext,
+            attachment: EpochAttachment,
+            mode: StopMode,
+        ) -> LtxRootCompletion {
+            let result = self.retire_guarded(&context, &attachment, mode).await;
+            root_completion(&context, attachment, ReplicaRole::Retirement, result)
+        }
+    }
