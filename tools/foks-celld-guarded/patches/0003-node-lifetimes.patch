+        self.sample
+    }
+    pub(crate) fn fail(&self) {
+        self.context.fail();
+    }
+    pub(crate) fn charge_future(
+        &self,
+        capture: usize,
+        future: std::alloc::Layout,
+    ) -> Result<(), Refusal> {
+        self.context.check_forward()?;
+        let typed = capture
+            .checked_add(future.size())
+            .and_then(|value| {
+                value.checked_add(std::mem::size_of::<Result<crate::asyncrt::OpOut, String>>())
+            })
+            .ok_or(Refusal::Bounds)?;
+        if typed > ROOT_PAYLOAD_LIMIT
+            || future.align() > 16
+            || channel_bound::<Result<(), celld_logic::RequestError>>()? > ROOT_OWNED_LIMIT
+        {
+            return Err(Refusal::Bounds);
+        }
+        // This is the separately inventoried boxed OpFuture row, not another
+        // F3 task. Its one live owned/channel partition cannot overlap a second
+        // auxiliary producer; every sequential creation adds original debt.
+        self.context
+            .control
+            .charge(typed.checked_add(ROOT_OWNED_LIMIT).ok_or(Refusal::Bounds)?)
+    }
