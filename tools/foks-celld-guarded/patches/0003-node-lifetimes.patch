+    #[cfg(test)]
+    pub(crate) async fn assert_guarded_adoption_for_test(
+        fixture: &crate::guarded_execution::node::component::ActorFixture,
+        context: &JobContext,
+        activation: GuardedActivation,
+        config: Arc<WorkerConfig>,
+    ) -> Result<(), Refusal> {
+        context.require_role(JobRole::Forward(ForwardLane::Activation))?;
+        context.bind_generation(config.generation)?;
+        // The same process initializer as production, independent of which
+        // earlier component tests happened to reject before loading V8.
+        crate::js::Engine::init();
+        let epoch = context.epoch().ok_or(Refusal::Invalid)?;
+        let generation = config.generation;
+        let permit = crate::js::guarded_node::NodeBuildPermit::new(context)?;
+        let witness = context.runtime_witness()?;
+        let runtime = match native(
+            context,
+            NativeKind::WorkerBuild,
+            NativeInput::Build {
+                activation,
+                config,
+                permit,
+                witness,
+                replicated_wake: false,
+            },
+        )
+        .await?
+        {
+            NativeOutput::Built(runtime) => runtime,
+            _ => return Err(refused(context, Refusal::Invalid)),
+        };
+        // Keep this observation separate from cleanup: even a bad identity or
+        // failed query must go through the actual WorkerDestroy child before
+        // the local fixture may touch its database path or unregister the VFS.
+        let observation = async {
+            if runtime.binding() != (context.cell(), epoch, generation) {
+                return Err(Refusal::Invalid);
+            }
+            let resources = runtime.resources.as_ref().ok_or(Refusal::Invalid)?;
+            if !resources.adopted || resources.activation.vfs().is_none() {
+                return Err(Refusal::Invalid);
+            }
+            let path = resources
+                .activation
+                .path()
+                .to_str()
+                .ok_or(Refusal::Invalid)?;
+            match resources
+                .slot
+                .turn(|worker| {
+                    worker.guarded_node_storage_binding_for_test(context.cell(), path, epoch)
+                })
+                .await
+            {
+                Ok(true) => Ok(()),
+                _ => Err(Refusal::Invalid),
+            }
+        }
+        .await;
+        let destroyed_slot = runtime
+            .resources
+            .as_ref()
+            .map(|resources| Arc::downgrade(&resources.slot));
+        let destruction = fixture
+            .run_component(
+                0,
+                JobRole::Cleanup(CleanupLane::Stop),
+                move |cleanup| async move {
+                    match native(
+                        &cleanup,
+                        NativeKind::WorkerDestroy,
+                        NativeInput::Destroy(runtime),
+                    )
+                    .await?
+                    {
+                        NativeOutput::Destroyed => Ok(()),
+                        _ => Err(refused(&cleanup, Refusal::Invalid)),
+                    }
+                },
+            )
+            .await;
+        let gone = destroyed_slot
+            .as_ref()
+            .is_some_and(|slot| slot.upgrade().is_none());
+        drop(destroyed_slot);
+        destruction?;
+        if !gone {
+            return Err(refused(context, Refusal::Invalid));
+        }
+        observation.map_err(|reason| refused(context, reason))
+    }
+
+    fn arc_bytes<T>() -> Result<usize, Refusal> {
+        let header = std::alloc::Layout::array::<std::sync::atomic::AtomicUsize>(2)
+            .map_err(|_| Refusal::Bounds)?;
+        let (layout, _) = header
+            .extend(std::alloc::Layout::new::<T>())
+            .map_err(|_| Refusal::Bounds)?;
+        if layout.align() > 16 {
+            return Err(Refusal::Bounds);
+        }
+        Ok(layout.pad_to_align().size())
+    }
+
+    struct RuntimeResources {
+        slot: Arc<crate::pool::Slot>,
+        residency: Option<crate::pool::Residency>,
+        probe: Option<crate::js::guarded::Probe>,
+        activation: GuardedActivation,
+        adopted: bool,
+    }
+
+    pub(crate) struct NodeRuntime {
+        resources: Option<RuntimeResources>,
+        alarm: AlarmSnapshot,
+        published: bool,
+        #[cfg(test)]
+        driver_started: bool,
+        epoch: u64,
+        generation: GenerationId,
+        witness: RuntimeWitness,
+        // Non-issuing lifetime witness; resources die before the original owner.
+        origin: JobContext,
+    }
+
+    impl NodeRuntime {
+        pub(crate) fn binding(&self) -> (&'static str, u64, GenerationId) {
+            (self.origin.cell(), self.epoch, self.generation)
+        }
+        pub(crate) fn same_origin(&self, context: &JobContext) -> bool {
+            self.origin.same_invocation(context)
+        }
+        pub(crate) fn published(&self) -> bool {
+            self.published
+        }
+        pub(crate) fn publish(&mut self) -> Result<(), Refusal> {
+            if self.published || self.resources.as_ref().is_none_or(|value| !value.adopted) {
+                return Err(Refusal::Invalid);
+            }
+            self.published = true;
+            Ok(())
+        }
+        pub(crate) fn alarm_snapshot(&self) -> Result<AlarmSnapshot, Refusal> {
+            if self.resources.is_none() {
+                return Err(Refusal::Invalid);
+            }
+            Ok(self.alarm)
+        }
+        pub(crate) fn observe_alarm(&mut self, alarm: AlarmSnapshot) -> Result<(), Refusal> {
+            if self.resources.is_none() {
+                return Err(Refusal::Invalid);
+            }
+            if alarm
+                .source()
+                .is_some_and(|source| source.id.epoch != self.epoch)
+            {
+                return Err(Refusal::Invalid);
+            }
+            self.alarm = alarm;
+            Ok(())
+        }
+        pub(crate) fn cancel(&self) {
+            // The caller signals the original Control before taking its bank
+            // lock. This method must not re-enter that same bank from a closure.
+            self.witness.cancel();
+        }
+        fn heap(&self) -> Result<celld_logic::isolate::HeapId, Refusal> {
+            Ok(self
+                .resources
+                .as_ref()
+                .ok_or(Refusal::Invalid)?
+                .slot
+                .heap_id())
+        }
+        #[cfg(test)]
+        fn driver_parts(
+            &mut self,
+            context: &JobContext,
+        ) -> Result<
+            (
+                Arc<crate::pool::Slot>,
+                crate::pool::Affiliation,
+                RuntimeWitness,
+            ),
+            Refusal,
+        > {
+            if !self.same_origin(context) || !self.published || self.driver_started {
+                return Err(Refusal::Invalid);
+            }
+            let resources = self.resources.as_ref().ok_or(Refusal::Invalid)?;
+            self.driver_started = true;
+            Ok((
+                resources.slot.clone(),
+                resources.slot.affiliate(),
+                self.witness.clone(),
+            ))
+        }
+    }
