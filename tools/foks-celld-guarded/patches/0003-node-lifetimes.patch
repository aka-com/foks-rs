+#[test]
+fn b2_retirement_requires_every_conjunct() {
+    // Poisoned terminal state fails the original process only after leaving
+    // the state-result temporary and bank guard. No ownership is reclaimed.
+    {
+        let fixture = b2_fixture();
+        let registry = fixture.registry();
+        assert!(registry.process.check().is_ok());
+        let record = b2_record(&fixture, 0);
+        let weak = Arc::downgrade(&record);
+        let freed_before = registry.capacity.ledger.lock().unwrap().event_counts
+            [super::super::EventKind::Freed as usize];
+        let poisoned = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _state = record.state.lock().unwrap();
+            panic!("controlled terminal state poison");
+        }))
+        .is_err();
+        drop(record);
+        let sole_record_owner = weak.strong_count() == 1;
+        let wake = Arc::new(B2HWake(AtomicBool::new(false)));
+        let waker = futures_util::task::waker(wake.clone());
+        let mut cx = Context::from_waker(&waker);
+        registry.retire_completed_records_with(Some(&mut cx));
+        let (retained, no_disposal_marker) = {
+            let bank = registry.bank.try_lock().expect("terminal bank released");
+            (
+                bank.records[0]
+                    .as_ref()
+                    .is_some_and(|record| Arc::as_ptr(record) == weak.as_ptr()),
+                bank.held[0].is_none(),
+            )
+        };
+        let freed_after = registry.capacity.ledger.lock().unwrap().event_counts
+            [super::super::EventKind::Freed as usize];
+        assert!(poisoned && sole_record_owner && retained && no_disposal_marker);
+        // The failed process sets stopped; that check reports Cancelled first.
+        assert_eq!(registry.process.check(), Err(Refusal::Cancelled));
+        assert_eq!(freed_before, freed_after);
+        assert!(!wake.0.load(Ordering::SeqCst));
+    }
+    // An actual outstanding route consumer cannot become terminal merely
+    // because no native Worker was ever constructed in this local component.
+    let fixture = b2_fixture();
+    let route = fixture.take_route(0).unwrap();
+    assert!(matches!(fixture.request_retirement(0), Err(Refusal::Busy)));
+    fixture.registry().retire_completed_records();
+    let record = b2_record(&fixture, 0);
+    {
+        let state = record.state.lock().unwrap();
+        assert!(state.activities[0].route_consumer);
+        assert!(!terminal_conjuncts(&state));
+        assert!(state.lease.is_some());
+    }
+    drop(record);
+    drop(route); // The real lost-consumer path retains/fails that component.
+
+    // This second component bypasses ONLY canonical terminal admission. Its
+    // resources are actually empty: no Worker, native task, output or Ready
+    // was created. It exercises the same physical final-disposal helper and
+    // PendingOwner transition after disposing a real boxed payload and pin.
+    let (factory, process) = fixture_factory();
+    let registry = OwnedEffectRegistry::new(process.node_control()).unwrap();
+    let owner = child(&factory, OwnerRole::Invocation);
+    let request = component::request(&owner);
+    let weak = Arc::downgrade(&request);
+    drop(request);
+    let envelope = registry.register_component(owner, 0).unwrap();
+    let admission = envelope.begin(&registry).unwrap();
+    let observer = admission.context.clone();
+    drop(admission); // No core RequestAt event is manufactured or consumed.
+    let generation = crate::generation::Generation::empty_guarded_for_test(17);
+    let mut pin = generation.try_guarded_pin().unwrap();
+    pin.mark_started();
+    let payload_dropped = AtomicBool::new(false);
+    struct Payload<'a>(&'a AtomicBool);
+    impl Drop for Payload<'_> {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::Release);
+        }
+    }
+    observer
+        .control
+        .charge(std::mem::size_of::<Payload<'_>>())
+        .unwrap();
+    let payload = Box::new(Payload(&payload_dropped));
+    let record = registry.record(observer.token).unwrap();
+    let (token, before) = {
+        let mut state = record.state.lock().unwrap();
+        assert!(!terminal_conjuncts(&state));
+        state.generation_pin = Some(pin);
+        let owner = record.owner.lock().unwrap();
+        (
+            state.lease.as_ref().unwrap().token,
+            owner.as_ref().unwrap().observation().unwrap(),
