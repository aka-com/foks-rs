+            () => {
+                match &self.host {
+                    Some(CellHost::Engine(runtime)) => runtime.clone(),
+                    _ => {
+                        permit.context().fail();
+                        Self::refuse_guarded_effect(effect, immediate);
+                        return None;
+                    }
+                }
+            };
+        }
