+impl GuardedEnvelope {
+    pub(crate) fn begin(
+        mut self,
+        registry: &OwnedEffectRegistry,
+    ) -> Result<GuardedAdmission, Refusal> {
+        if !std::ptr::eq(self.context.registry()?.as_ref(), registry) {
+            self.context.fail();
+            return Err(Refusal::Invalid);
+        }
+        self.context.check_forward()?;
+        let record = registry.record(self.context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        if state.activities[0].issued {
+            return Err(Refusal::Busy);
+        }
+        state.activities[0].issued = true;
+        let scope = self.scope.take().ok_or(Refusal::Invalid)?;
+        drop(state);
+        drop(record);
+        self.context.check_forward()?;
+        self.begun = true;
+        Ok(GuardedAdmission {
+            request: self.context.request,
+            scope,
+            context: self.context.clone(),
+        })
+    }
+}
+impl Drop for GuardedEnvelope {
+    fn drop(&mut self) {
+        if !self.begun {
+            self.context.fail();
+        }
+    }
