+fn b2_dedicated_driver_join_precedes_slot_consumption() {
+    crate::actor::guarded_test_runtime().block_on(async {
+        let fixture = b2_fixture();
+        let driver = b2_root(&fixture, JobRole::Forward(ForwardLane::Driver));
+        let cleanup = b2_root(&fixture, JobRole::Cleanup(CleanupLane::Stop));
+        let (release, wait) = tokio::sync::oneshot::channel::<()>();
+        let (entered, ready) = tokio::sync::oneshot::channel();
+        b2_consumer(&fixture, &driver);
+        fixture
+            .registry()
+            .spawn_root(
+                &driver,
+                0,
+                async move {
+                    let _ = entered.send(());
+                    wait.await.map_err(|_| Refusal::Failed)
+                },
+                RootResult::Control,
+            )
+            .unwrap();
+        let entered = tokio::time::timeout(Duration::from_secs(5), ready).await;
+        let before_join = matches!(cleanup.take_runtime_for_stop(), Err(Refusal::Busy));
+        let _ = release.send(());
+        let mut join = std::pin::pin!(std::future::poll_fn(|cx| {
+            fixture.registry().poll_root(&driver, cx, false)
+        }));
+        let (bounded, joined) = match tokio::time::timeout(Duration::from_secs(5), &mut join).await
+        {
+            Ok(joined) => (true, joined),
+            Err(_) => (false, join.await),
+        };
+        let joined = match joined {
+            Ok(joined) => joined,
+            _ => {
+                driver.fail();
+                panic!("actual driver component join failed; bank retains uncertainty");
+            }
+        };
+        let before_dispose = matches!(cleanup.take_runtime_for_stop(), Err(Refusal::Busy));
+        let successful = matches!(joined, RootResult::Control(Ok(())));
+        drop(joined);
+        fixture.registry().finish_root(&driver).unwrap();
+        assert!(
+            bounded && matches!(entered, Ok(Ok(()))) && successful && before_join && before_dispose
+        );
+        // Passing the actual F3 join/disposal prerequisite reveals the honest
+        // component boundary: no NodeRuntime was constructed by this payload.
+        assert!(matches!(
+            cleanup.take_runtime_for_stop(),
+            Err(Refusal::NotReady)
+        ));
+        cleanup.fail();
+    });
+}
