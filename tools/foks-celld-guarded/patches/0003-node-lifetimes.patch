+    EffectInventory,
+    OriginBinding,
+    ForwardSaturation,
+    CompletionDelivery,
+    StaleEpoch,
+    ResidentBinding,
+    ProcessedInactive,
+    LostFinish,
+    FinalEviction,
+}
+
+#[cfg(all(test, feature = "foks-guarded-node-qualification"))]
+struct GuardedActorHarness {
+    actor: Actor,
+    sender: mpsc::UnboundedSender<Message>,
+    receiver: mpsc::UnboundedReceiver<Message>,
+    _fenced: mpsc::UnboundedReceiver<i32>,
+    effects: FuturesUnordered<EffectFuture>,
+    delays: DelayQueue<TimerArm>,
+    timers: TimerSlots<delay_queue::Key>,
+    out: StepOutput,
+}
+
+#[cfg(all(test, feature = "foks-guarded-node-qualification"))]
+impl GuardedActorHarness {
+    async fn new(registry: Arc<OwnedEffectRegistry>) -> Self {
+        let (fence, fenced) = mpsc::unbounded_channel();
+        let mut actor = Actor::from_environment(
+            AdmissionLimits {
+                resident: 2,
+                activations: 1,
+                #[cfg(celld_internal_tests)]
+                evictions: 1,
+                releases: 1,
+                placement_weight: 1,
+            },
+            false,
+            fence,
+            None,
+            None,
+            ActorIdentity {
+                node: "b2-component".to_owned(),
+                advertise: "http://127.0.0.1:1".to_owned(),
+                region: "local".to_owned(),
+            },
+            None,
+        )
+        .await
+        .expect("canonical component Actor constructor");
+        actor.guarded = Some(registry);
+        actor.store_load_sample(crate::host_services::HostMetricsSample::default());
+        let (sender, receiver) = mpsc::unbounded_channel();
+        let mut harness = Self {
+            actor,
+            sender,
+            receiver,
+            _fenced: fenced,
+            effects: FuturesUnordered::new(),
+            delays: DelayQueue::new(),
+            timers: TimerSlots::default(),
+            out: StepOutput::default(),
+        };
+        harness.actor.start(&mut harness.out);
+        harness.drain();
+        // Exercise the real ownership adapter and production selector to
+        // establish authority. No synthetic lease-success event is inserted.
+        for _ in 0..16 {
+            if harness.actor.state.node_authoritative() {
+                return harness;
+            }
+            harness.step_ready().await;
+        }
+        panic!("actual in-memory node lease did not become authoritative");
+    }
+
+    fn drain(&mut self) {
+        drain_step_output(
+            &mut self.out,
+            &mut self.effects,
+            &mut self.delays,
+            &mut self.timers,
+        );
+    }
+
+    async fn step_ready(&mut self) -> bool {
+        let registry = self
+            .actor
+            .guarded
+            .as_ref()
+            .expect("fixture registry")
+            .clone();
+        // A watchdog for a failed deterministic fixture, not a scheduling
+        // sleep or proof that a pending operation has ended.
+        let input = tokio::time::timeout(
+            std::time::Duration::from_secs(2),
+            production::next_guarded(
+                &mut self.receiver,
+                &mut self.effects,
+                &mut self.delays,
+                &mut self.timers,
+                &registry,
+            ),
+        )
+        .await
+        .expect("component input did not become ready");
+        let consumed_guarded_message = matches!(
+            &input,
+            production::ReadyInput::Ordinary(ActorInput::Message(Message::Guarded(_)))
+        );
+        match input {
+            production::ReadyInput::Ordinary(input) => self.actor.step(input, &mut self.out),
+            production::ReadyInput::Guarded(input) => self.actor.step_guarded(input, &mut self.out),
+            production::ReadyInput::MailboxClosed => {
+                panic!("component mailbox unexpectedly closed")
+            }
+        }
+        self.drain();
+        consumed_guarded_message
+    }
+
+    async fn deliver_request(&mut self, request: GuardedRequest) {
+        // This harness enqueues one guarded message at a time. Canonical
+        // startup work and lease timers may win the unbiased selector first;
+        // observe actual mailbox consumption rather than assuming one poll.
+        self.sender
+            .send(Message::Guarded(request))
+            .ok()
+            .expect("live actor mailbox");
+        for _ in 0..16 {
+            if self.step_ready().await {
+                return;
+            }
+        }
+        panic!("guarded component message was not consumed");
+    }
+
+    fn no_ordinary_guarded_state(&self) {
+        assert!(self.actor.pending.is_empty());
+        assert!(self.actor.request_cells.is_empty());
+        assert!(self.actor.gated_responses.is_empty());
+        assert!(self.actor.route_timings.is_empty());
+        assert!(self.actor.pending_evictions.is_empty());
+        assert!(self.actor.eviction_abandons.is_empty());
+        assert!(self.actor.published.is_empty());
+        self.actor
+            .state
+            .validate()
+            .expect("actual guarded core invariants");
+    }
+}
+
+#[cfg(all(test, feature = "foks-guarded-node-qualification"))]
+pub(crate) async fn assert_guarded_actor_case_for_test(
+    case: GuardedActorCase,
+    fixture: &mut guarded_node::component::ActorFixture,
+) {
+    use futures_util::FutureExt as _;
+    use guarded_node::component::{ActivationRootDisposition, ActorFixture};
+    let request = fixture.primary_request(0);
+    let cell = fixture.cell(0);
+
+    if matches!(case, GuardedActorCase::OriginBinding) {
+        let foreign = ActorFixture::new().expect("separate concrete original-owner fixture");
+        assert!(!Arc::ptr_eq(foreign.registry(), fixture.registry()));
+        let mut harness = GuardedActorHarness::new(foreign.registry().clone()).await;
+        harness
+            .deliver_request(fixture.take_request(0).expect("original envelope"))
+            .await;
+        assert!(harness.actor.state.request_inactive(request));
+        assert!(harness.actor.state.phase(cell).is_none());
+        assert_eq!(harness.actor.state.occupied(), 0);
+        assert!(!fixture
+            .occupied_roots(0)
+            .expect("held original observation")
+            .into_iter()
+            .any(|occupied| occupied));
+        harness.no_ordinary_guarded_state();
+        return;
+    }
+
+    let mut harness = GuardedActorHarness::new(fixture.registry().clone()).await;
+    match case {
+        GuardedActorCase::EffectInventory => {
+            // These are refusal inputs, never fabricated successful host
+            // completions. In particular a non-eviction failure must not call
+            // the core's eviction-only restart transition.
+            for (cause, bounded) in [
+                (StopCause::Cleanup, false),
+                (StopCause::Fence, false),
+                (StopCause::Reset, false),
+                (StopCause::Swap, false),
+                (StopCause::Evict { rebalance: false }, true),
+                (StopCause::Evict { rebalance: true }, false),
+            ] {
+                let mut immediate = VecDeque::new();
+                let mut out = StepOutput::default();
+                let effect = Effect::StopRuntime {
+                    op: 900,
+                    cell: cell.to_owned(),
+                    epoch: 1,
+                    cause,
+                    bounded,
+                };
+                harness.actor.execute(effect, &mut immediate, &mut out);
+                assert!(
+                    immediate.is_empty(),
+                    "held stop cannot invent a restart or successful stop"
+                );
+                assert!(
+                    out.effects_is_empty(),
+                    "guarded refusal cannot spawn ordinary work"
+                );
+                assert!(out.timers.is_empty());
+            }
+            assert_eq!(harness.actor.stops, 0);
+            assert!(harness.actor.state.phase(cell).is_none());
+        }
+        GuardedActorCase::ForwardSaturation => {
+            // The caller fills the eight actual forward jobs behind explicit
+            // barriers. Cancellation and finish still have prepaid capacity.
+            assert!(fixture.occupied_roots(0).expect("actual root census")[..8]
+                .iter()
+                .all(|occupied| *occupied));
+            fixture
+                .cancel(0)
+                .expect("prepaid cancel at forward saturation");
+            let finished = fixture
+                .finish_primary(
+                    0,
+                    celld_logic::wake::AlarmSnapshot::without_wake(None),
+                    false,
+                )
+                .expect("prepaid finish at forward saturation");
+            for _ in 0..8 {
+                if fixture
+                    .completion_processed(0, false)
+                    .expect("finish observation")
+                {
+                    break;
+                }
+                harness.step_ready().await;
+            }
+            assert!(fixture
+                .completion_processed(0, false)
+                .expect("finish processed"));
+            assert!(fixture
+                .completion_inactive(0, false)
+                .expect("actual inactive observation"));
+            finished.await.expect("processed and inactive finish");
+            // The caller releases and joins its barriers after this returns.
+            assert!(
+                fixture.occupied_roots(0).expect("retained forward jobs")[..8]
+                    .iter()
+                    .any(|occupied| *occupied)
+            );
+        }
+        GuardedActorCase::FinalEviction => {
+            assert!(
+                fixture.request_retirement(0).is_err(),
+                "no runtime/output disposition yet"
+            );
+            assert!(harness.actor.state.phase(cell).is_none());
+            assert_eq!(harness.actor.state.occupied(), 0);
+            assert!(!fixture.occupied_roots(0).expect("no retirement root")[8..]
+                .iter()
+                .any(|occupied| *occupied));
+        }
+        GuardedActorCase::CompletionDelivery => {
+            let mut route = fixture.take_route(0).expect("actual fixed route waiter");
+            harness
+                .deliver_request(fixture.take_request(0).expect("original envelope"))
+                .await;
+            let mut failed = false;
+            for _ in 0..16 {
+                if let Some(result) = fixture
+                    .primary_route_result(0)
+                    .expect("actual stored route observation")
+                {
+                    assert_eq!(
+                        result,
+                        Err(RequestError::RestoreFailed),
+                        "only the real missing Engine failure may settle this route"
+                    );
+                    assert!(
+                        matches!(
+                            futures_util::poll!(&mut route),
+                            std::task::Poll::Ready(Err(RequestError::NodeFenced))
+                        ),
+                        "the failed original owner must fence delivery of its stored error"
+                    );
+                    failed = true;
+                    break;
+                }
+                harness.step_ready().await;
+            }
+            assert!(
+                failed,
+                "sequential F6 work must reach its actual restore failure"
+            );
+            let owner = harness
+                .actor
+                .ownership
+                .read_owner(cell)
+                .await
+                .expect("actual memory owner read")
+                .expect("actual successful owner CAS");
+            assert!(
+                owner.node.as_deref() == Some("b2-component") && owner.epoch > 0,
+                "owner read/capacity/CAS successors must execute after earlier result disposal"
+            );
+            assert_eq!(
+                harness.actor.state.phase(cell),
+                Some(&Phase::Dormant { epoch: owner.epoch })
+            );
+            assert!(harness.actor.host.is_none());
+            assert!(harness.actor.state.request_inactive(request));
+            assert_eq!(harness.actor.publishes, 0);
+        }
+        GuardedActorCase::ProcessedInactive
+        | GuardedActorCase::LostFinish
+        | GuardedActorCase::StaleEpoch
+        | GuardedActorCase::ResidentBinding => {
+            let memory = match &harness.actor.ownership {
+                Ownership::Memory(memory) => memory.clone(),
+                Ownership::Bucket(_) => panic!("component must use actual in-memory adapter"),
+            };
+            // Deterministic barrier in the actual ownership read. No sleeps or
+            // invented owner-read result make the route pending.
+            let held = memory.lock().await;
+            let outcome = std::panic::AssertUnwindSafe(async {
+                harness
+                    .deliver_request(fixture.take_request(0).expect("original envelope"))
+                    .await;
+                assert!(!harness.actor.state.request_inactive(request));
+                assert!(fixture.occupied_roots(0).expect("actual pending F6 root")[6]);
+                match case {
+                    GuardedActorCase::ProcessedInactive => {
+                        let mut finished = fixture
+                            .finish_primary(
+                                0,
+                                celld_logic::wake::AlarmSnapshot::without_wake(None),
+                                false,
+                            )
+                            .expect("existing prepaid finish");
+                        for _ in 0..8 {
+                            if fixture
+                                .completion_processed(0, false)
+                                .expect("finish observation")
+                            {
+                                break;
+                            }
+                            harness.step_ready().await;
+                        }
+                        assert!(fixture.completion_processed(0, false).expect("processed"));
+                        assert!(!fixture
+                            .completion_inactive(0, false)
+                            .expect("pending route is still active"));
+                        assert!(futures_util::poll!(&mut finished).is_pending());
+                        fixture.cancel(0).expect("existing prepaid cancel");
+                        for _ in 0..8 {
+                            if harness.actor.state.request_inactive(request) {
+                                break;
+                            }
+                            harness.step_ready().await;
+                        }
+                        assert!(harness.actor.state.request_inactive(request));
+                        assert!(fixture
+                            .completion_inactive(0, false)
+                            .expect("inactive after real cancellation"));
+                        finished.await.expect("processed AND inactive");
+                    }
+                    GuardedActorCase::LostFinish => {
+                        drop(
+                            fixture
+                                .take_route(0)
+                                .expect("actual receiver that disappears"),
+                        );
+                        for _ in 0..8 {
+                            if fixture
+                                .completion_processed(0, false)
+                                .expect("retained finish")
+                                && fixture
+                                    .completion_inactive(0, false)
+                                    .expect("actual inactive")
+                            {
+                                break;
+                            }
+                            harness.step_ready().await;
+                        }
+                        assert!(fixture
+                            .completion_processed(0, false)
+                            .expect("lost receiver cannot lose finish"));
+                        assert!(fixture
+                            .completion_inactive(0, false)
+                            .expect("cancelled pending request"));
+                        assert!(harness.actor.state.request_inactive(request));
+                    }
+                    GuardedActorCase::StaleEpoch => {
+                        // Actor integration refusal only: the outer bank test
+                        // covers old-token/new-sequence rejection independently.
+                        let before = harness.actor.state.phase(cell).cloned();
+                        let mut immediate = VecDeque::new();
+                        harness.actor.execute(
+                            Effect::Publish {
+                                op: u64::MAX,
+                                cell: cell.to_owned(),
+                                epoch: u64::MAX,
+                            },
+                            &mut immediate,
+                            &mut harness.out,
+                        );
+                        assert_eq!(
+                            immediate,
+                            VecDeque::from([Event::Published {
+                                op: u64::MAX,
+                                result: Err(Failure::Definite)
+                            }])
+                        );
+                        while let Some(event) = immediate.pop_front() {
+                            harness.actor.drive(event, &mut harness.out);
+                        }
+                        assert_eq!(harness.actor.state.phase(cell), before.as_ref());
+                        assert_eq!(harness.actor.publishes, 0);
+                        fixture.cancel(0).expect("cancel original pending request");
+                    }
+                    GuardedActorCase::ResidentBinding => {
+                        // Actual nonresident core refusal. The outer producer
+                        // tests exercise valid-parent binding field by field.
+                        let auxiliary = fixture.auxiliary_request(0);
+                        let before = harness.actor.state.phase(cell).cloned();
+                        let effects = harness.actor.transition(Event::ResidentGateRequestAt {
+                            request: auxiliary,
+                            parent: request,
+                            cell: cell.to_owned(),
+                            epoch: 0,
+                            generation: harness.actor.state.current_generation(),
+                            now_mono_ms: crate::asyncrt::mono_ms(),
+                        });
+                        assert_eq!(
+                            effects,
+                            vec![Effect::Complete {
+                                request: auxiliary,
+                                result: Err(RequestError::NodeUnavailable)
+                            }]
+                        );
+                        assert!(harness.actor.state.request_inactive(auxiliary));
+                        assert!(!harness.actor.state.request_inactive(request));
+                        assert_eq!(harness.actor.state.phase(cell), before.as_ref());
+                        fixture.cancel(0).expect("cancel original pending request");
+                    }
+                    _ => unreachable!(),
+                }
+            })
+            .catch_unwind()
+            .await;
+            // Always release the real read barrier and drain selectable F6
+            // work before propagating an assertion failure.
+            // A refused, unsubmitted reservation remains held: cancellation
+            // cannot turn it into a successful join or a reusable root.
+            drop(held);
+            let _ = fixture.cancel(0);
+            let cleanup = std::panic::AssertUnwindSafe(async {
+                for _ in 0..16 {
+                    match fixture
+                        .activation_disposition(0)
+                        .expect("actual F6 task/result observation")
+                    {
+                        ActivationRootDisposition::Disposed
+                            if harness.actor.state.request_inactive(request) =>
+                        {
+                            break
+                        }
+                        ActivationRootDisposition::HeldUnsubmitted
+                        | ActivationRootDisposition::HeldUnknown => break,
+                        ActivationRootDisposition::Disposed
+                        | ActivationRootDisposition::Joinable => {
+                            harness.step_ready().await;
+                        }
+                    }
+                }
+                fixture
+                    .activation_disposition(0)
+                    .expect("final F6 disposition observation")
+            })
+            .catch_unwind()
+            .await;
+            // Preserve the first semantic failure. An unknown/unjoined row
+            // remains retained by the fixture registry; a watchdog is never
+            // reported as a join, and cannot overwrite the original panic.
+            if let Err(error) = outcome {
+                std::panic::resume_unwind(error);
+            }
+            let disposition = match cleanup {
+                Ok(disposition) => disposition,
+                Err(error) => std::panic::resume_unwind(error),
+            };
+            assert_eq!(disposition, ActivationRootDisposition::Disposed);
+            assert!(harness.actor.state.request_inactive(request));
+        }
+        GuardedActorCase::OriginBinding => unreachable!(),
+    }
+    harness.no_ordinary_guarded_state();
+}
