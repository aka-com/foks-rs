+impl OwnedEffectRegistry {
+    pub(crate) fn claim_actor(&self, effect: &Effect) -> ActorClaim {
+        match self.try_claim_actor(effect) {
+            Ok(value) => value,
+            Err(error) => ActorClaim::Refused(error),
+        }
+    }
+    fn try_claim_actor(&self, effect: &Effect) -> Result<ActorClaim, Refusal> {
+        use Effect::*;
+        let (cell, request) = match effect {
+            ReadOwner { cell, .. }
+            | ReadNodeLease { cell, .. }
+            | RecoverNodeLog { cell, .. }
+            | ReadCapacityPeers { cell, .. }
+            | CasOwner { cell, .. }
+            | ReconcileWakeEntry { cell, .. }
+            | ReleaseOwner { cell, .. }
+            | AdoptReleased { cell, .. }
+            | CancelCellActivity { cell, .. }
+            | Restore { cell, .. }
+            | StartRuntime { cell, .. }
+            | Publish { cell, .. }
+            | EnsureDurable { cell, .. }
+            | AwaitDurable { cell, .. }
+            | VerifyOwnership { cell, .. }
+            | StopRuntime { cell, .. }
+            | AbandonEvictionStop { cell, .. }
+            | FireAlarm { cell, .. }
+            | CloseWebSocket { cell, .. } => (Some(cell.as_str()), None),
+            Complete { request, .. }
+            | Release { request, .. }
+            | EvictionAdmission { request, .. }
+            | EvictionFinished { request, .. }
+            | CompleteWorker { request, .. } => (None, Some(*request)),
+            _ => return Ok(ActorClaim::Ordinary),
+        };
+        let found = {
+            let records = lock_owned(&self.bank)?.records.clone();
+            let mut found = None;
+            for (slot, entry) in records.iter().enumerate() {
+                let Some(record) = entry else {
+                    continue;
+                };
+                let matches = if let Some(cell) = cell {
+                    record.cell == cell
+                } else {
+                    let state = lock_owned(&record.state)?;
+                    request.is_some_and(|request| {
+                        state.eviction_request == request
+                            || state
+                                .activities
+                                .iter()
+                                .any(|activity| activity.request == request)
+                    })
+                };
+                if matches {
+                    if found.is_some() {
+                        return Err(Refusal::Invalid);
+                    }
+                    found = Some((slot, record.clone()));
+                }
+            }
+            found
+        };
+        let Some((slot, record)) = found else {
+            return if cell.is_some_and(DescriptorPolicy::is_guarded_scope) {
+                Err(Refusal::NotReady)
+            } else {
+                Ok(ActorClaim::Ordinary)
+            };
+        };
+        let registry = self.own.upgrade().ok_or(Refusal::Failed)?;
+        let inline = match effect {
+            Complete { .. } => Some(InlineKind::Complete),
+            Release { .. } => Some(InlineKind::Release),
+            EvictionAdmission { .. } => Some(InlineKind::Admission),
+            EvictionFinished { .. } => Some(InlineKind::Finished),
+            CancelCellActivity { .. } => Some(InlineKind::Cancel),
+            AbandonEvictionStop { .. } => Some(InlineKind::Abandon),
+            _ => None,
+        };
+        if let Some(operation) = inline {
+            let context = registry.inline_context(&record, slot)?;
+            return Ok(ActorClaim::Inline(InlinePermit {
+                context,
+                operation,
+                consumed: false,
+            }));
+        }
+        if let Publish { op, epoch, .. } = effect {
+            let context = registry.reserve(
+                slot,
+                JobRole::Forward(ForwardLane::Activation),
+                RootKind::Actor,
+                Some(*op),
+            )?;
+            if context.epoch() != Some(*epoch) {
+                context.fail();
+                return Err(Refusal::Invalid);
+            }
+            return Ok(ActorClaim::Inline(InlinePermit {
+                context,
+                operation: InlineKind::Publish,
+                consumed: false,
+            }));
+        }
+        let (role, kind, op, epoch) = match effect {
+            ReadOwner { op, .. } | ReadNodeLease { op, .. } | ReadCapacityPeers { op, .. } => (
+                JobRole::Forward(ForwardLane::Activation),
+                RootKind::Actor,
+                *op,
+                None,
+            ),
+            CasOwner {
+                op,
+                epoch,
+                takeover,
+                guard,
+                ..
+            } => {
+                let mut state = lock_owned(&record.state)?;
+                if state.epoch.is_some_and(|actual| actual != *epoch) {
+                    return Err(Refusal::Invalid);
+                }
+                state.epoch = Some(*epoch);
+                state.fresh = Some(!*takeover && matches!(guard, celld_logic::CasGuard::Absent));
+                (
+                    JobRole::Forward(ForwardLane::Activation),
+                    RootKind::Actor,
+                    *op,
+                    Some(*epoch),
+                )
+            }
+            Restore { op, spec, .. } => (
+                JobRole::Forward(ForwardLane::Activation),
+                RootKind::Actor,
+                *op,
+                Some(spec.epoch),
+            ),
+            StartRuntime { op, epoch, .. } => (
+                JobRole::Forward(ForwardLane::Activation),
+                RootKind::Actor,
+                *op,
+                Some(*epoch),
+            ),
+            AwaitDurable {
+                op,
+                epoch,
+                position,
+                ..
+            } => {
+                let state = lock_owned(&record.state)?;
+                let index = state
+                    .activities
+                    .iter()
+                    .position(|activity| activity.proof_op == Some(*op))
+                    .ok_or(Refusal::Invalid)?;
+                if !state.activities[index]
+                    .output
+                    .as_ref()
+                    .is_some_and(|output| {
+                        output.ticket.position.or(output.ticket.observed) == Some(*position)
+                            && output.delivered
+                            && !output.done
+                    })
+                {
+                    return Err(Refusal::Invalid);
+                }
+                (
+                    JobRole::Forward(if index == 0 {
+                        ForwardLane::PrimaryProof
+                    } else {
+                        ForwardLane::AuxProof
+                    }),
+                    RootKind::Actor,
+                    *op,
+                    Some(*epoch),
+                )
+            }
+            VerifyOwnership { op, epoch, .. } => {
+                let state = lock_owned(&record.state)?;
+                let index = state
+                    .activities
+                    .iter()
+                    .position(|activity| activity.proof_op == Some(*op))
+                    .ok_or(Refusal::Invalid)?;
+                (
+                    JobRole::Forward(if index == 0 {
+                        ForwardLane::PrimaryProof
+                    } else {
+                        ForwardLane::AuxProof
+                    }),
+                    RootKind::Actor,
+                    *op,
+                    Some(*epoch),
+                )
+            }
+            EnsureDurable { op, epoch, .. } => (
+                JobRole::Cleanup(CleanupLane::EnsureDurable),
+                RootKind::Actor,
+                *op,
+                Some(*epoch),
+            ),
+            StopRuntime {
+                op, epoch, cause, ..
+            } => {
+                if matches!(cause, celld_logic::StopCause::Swap) {
+                    record.control.fail();
+                    return Err(Refusal::Invalid);
+                }
+                (
+                    JobRole::Cleanup(CleanupLane::Stop),
+                    RootKind::Actor,
+                    *op,
+                    Some(*epoch),
+                )
+            }
+            ReleaseOwner { op, epoch, .. } => (
+                JobRole::Cleanup(CleanupLane::Release),
+                RootKind::Actor,
+                *op,
+                Some(*epoch),
+            ),
+            AdoptReleased {
+                op, released_epoch, ..
+            } => (
+                JobRole::Cleanup(CleanupLane::Adopt),
+                RootKind::Actor,
+                *op,
+                Some(*released_epoch),
+            ),
+            ReconcileWakeEntry { alarm, .. } => {
+                let state = lock_owned(&record.state)?;
+                let role = if state.retiring {
+                    JobRole::Cleanup(CleanupLane::Wake)
+                } else {
+                    JobRole::Forward(ForwardLane::Wake)
+                };
+                let root = &state.roots[role.index()];
+                if !matches!(root.state, RootState::Empty | RootState::Spent) {
+                    if root.wake != Some(*alarm) {
+                        record.control.fail();
+                        return Err(Refusal::Invalid);
+                    }
+                    let sequence = root.sequence;
+                    drop(state);
+                    return Ok(ActorClaim::Inline(InlinePermit {
+                        context: registry.context(&record, slot, role, sequence)?,
+                        operation: InlineKind::Wake,
+                        consumed: false,
+                    }));
+                }
+                (role, RootKind::Wake, 0, state.epoch)
+            }
+            // Fleet log recovery, alarms, sockets and Worker selection are not
+            // reachable authority paths for this exact closed descriptor.
+            _ => {
+                record.control.fail();
+                return Err(Refusal::Invalid);
+            }
+        };
+        if epoch.is_some() {
+            let state = lock_owned(&record.state)?;
+            if state.epoch != epoch {
+                record.control.fail();
+                return Err(Refusal::Invalid);
+            }
+        }
+        let context = registry.reserve(slot, role, kind, Some(op))?;
+        if let ReconcileWakeEntry { alarm, .. } = effect {
+            let mut state = lock_owned(&record.state)?;
+            Self::root(&mut state, context.token)?.wake = Some(*alarm);
+        }
+        if let StopRuntime {
+            cause: celld_logic::StopCause::Evict { .. },
+            bounded: true,
+            ..
+        } = effect
+        {
+            context.charge_owned(control::arc_bytes::<crate::replication::EvictionAbandon>()?)?;
+            let abandon = Arc::new(crate::replication::EvictionAbandon::default());
+            let mut state = lock_owned(&record.state)?;
+            Self::root(&mut state, context.token)?.abandon = Some(abandon);
+        }
+        Ok(ActorClaim::Guarded(ActorJobPermit {
+            context,
+            submitted: false,
+        }))
+    }
+    pub(crate) fn submit_actor<F, Fut>(
+        &self,
+        mut permit: ActorJobPermit,
+        factory: F,
+    ) -> Result<(), Refusal>
+    where
+        F: FnOnce(JobContext) -> Fut,
+        Fut: Future<Output = ActorJobResult> + Send + 'static,
+    {
+        permit.context.check_job()?;
+        let capture = std::mem::size_of::<F>();
+        let future = factory(permit.context.clone());
+        let total = capture
+            .checked_add(std::mem::size_of::<Fut>())
+            .and_then(|value| value.checked_add(std::mem::size_of::<RootResult>()))
+            .ok_or(Refusal::Bounds)?;
+        if total > ROOT_PAYLOAD_LIMIT
+            || std::mem::align_of::<F>() > 16
+            || std::mem::align_of::<Fut>() > 16
+        {
+            return Err(Refusal::Bounds);
+        }
+        self.spawn_root(&permit.context, capture, future, RootResult::Actor)?;
+        permit.submitted = true;
+        Ok(())
+    }
+    pub(crate) fn poll_actor(&self, cx: &mut Context<'_>) -> Poll<GuardedActorInput> {
+        // A poisoned actor bank latches the real process owner failed. The
+        // actor input type has no fabricated failure Event; B3 shutdown must
+        // observe that process latch. No forward readiness is implied.
+        let incoming = cx.waker().clone();
+        let mut previous = DeferredWaker(None);
+        let records = {
+            let mut bank = match poll_owned(&self.bank, cx) {
+                Poll::Ready(Ok(bank)) => bank,
+                Poll::Ready(Err(_)) => {
+                    self.process.fail();
+                    return Poll::Pending;
+                }
+                Poll::Pending => return Poll::Pending,
+            };
+            previous.0 = bank.actor_waker.replace(incoming);
+            bank.records.clone()
+        };
+        let Some(registry) = self.own.upgrade() else {
+            return Poll::Pending;
+        };
+        for (slot, entry) in records.iter().enumerate() {
+            let Some(record) = entry else {
+                continue;
+            };
+            let input = {
+                let mut state = match poll_owned(&record.state, cx) {
+                    Poll::Ready(Ok(state)) => state,
+                    Poll::Ready(Err(_)) => {
+                        record.control.fail();
+                        continue;
+                    }
+                    Poll::Pending => continue,
+                };
+                // Eligibility is a try-only observation. Consuming the one
+                // already-prepaid control is a committed synchronous metadata
+                // action under state -> B1; no work/deadline/credit is renewed.
+                if Self::retirement_eligible(&state) {
+                    if Self::schedule_control_locked(
+                        record,
+                        &mut state,
+                        ActorControlKind::Retirement,
+                        None,
+                    )
+                    .is_err()
+                    {
+                        drop(state);
+                        record.control.fail();
+                        continue;
+                    }
+                }
+                registry.poll_inputs_locked(slot, record, &mut state)
+            };
+            match input {
+                Ok(Some(input)) => return Poll::Ready(input),
+                Ok(None) => {}
+                Err(_) => {
+                    record.control.fail();
+                    continue;
+                }
+            }
+            for lane in 0..ROOT_COUNT {
+                let candidate = {
+                    let state = match poll_owned(&record.state, cx) {
+                        Poll::Ready(Ok(state)) => state,
+                        Poll::Ready(Err(_)) => {
+                            record.control.fail();
+                            continue;
+                        }
+                        Poll::Pending => continue,
+                    };
+                    let root = &state.roots[lane];
+                    if !matches!(root.kind, Some(RootKind::Actor | RootKind::Wake))
+                        || !matches!(root.state, RootState::Running | RootState::Joined)
+                    {
+                        None
+                    } else {
+                        Some(role_for_index(lane).and_then(|role| {
+                            registry.context_locked(record, &state, slot, role, root.sequence)
+                        }))
+                    }
+                };
+                let Some(candidate) = candidate else {
+                    continue;
+                };
+                let context = match candidate {
+                    Ok(context) => context,
+                    Err(_) => {
+                        record.control.fail();
+                        continue;
+                    }
+                };
+                if let Poll::Ready(result) = registry.poll_root(&context, cx, true) {
+                    match result {
+                        Ok(RootResult::Actor(result)) => {
+                            return Poll::Ready(GuardedActorInput::Completion(
+                                OwnedActorCompletion {
+                                    result: Some(result),
+                                    context,
+                                    consumed: false,
+                                },
+                            ))
+                        }
+                        Ok(result) => {
+                            context.fail();
+                            std::mem::forget(result);
+                        }
+                        Err(_) => context.fail(),
+                    }
+                }
+            }
+        }
+        drop(records);
+        registry.retire_completed_records_with(Some(cx));
+        Poll::Pending
+    }
+}
+fn role_for_index(index: usize) -> Result<JobRole, Refusal> {
+    Ok(match index {
+        0 => JobRole::Forward(ForwardLane::Hydration),
+        1 => JobRole::Forward(ForwardLane::Sync),
+        2 => JobRole::Forward(ForwardLane::Compaction),
+        3 => JobRole::Forward(ForwardLane::Driver),
+        4 => JobRole::Forward(ForwardLane::PrimaryProof),
+        5 => JobRole::Forward(ForwardLane::AuxProof),
+        6 => JobRole::Forward(ForwardLane::Activation),
+        7 => JobRole::Forward(ForwardLane::Wake),
+        8 => JobRole::Cleanup(CleanupLane::EnsureDurable),
+        9 => JobRole::Cleanup(CleanupLane::TerminalProof),
+        10 => JobRole::Cleanup(CleanupLane::Stop),
+        11 => JobRole::Cleanup(CleanupLane::Release),
+        12 => JobRole::Cleanup(CleanupLane::Adopt),
+        13 => JobRole::Cleanup(CleanupLane::Wake),
+        14 => JobRole::Cleanup(CleanupLane::Retirement),
+        15 => JobRole::Cleanup(CleanupLane::Cancel),
+        _ => return Err(Refusal::Invalid),
+    })
+}
+fn channel_bound<T>() -> Result<usize, Refusal> {
+    std::mem::size_of::<Option<T>>()
+        .checked_add(15)
+        .map(|bytes| 80 + (bytes & !15))
+        .ok_or(Refusal::Bounds)
+}
