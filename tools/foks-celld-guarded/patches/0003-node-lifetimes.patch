+        let mut pins = self
+            .guarded_pins
+            .try_lock()
+            .map_err(|_| Refusal::Contended)?;
+        if pins.retired {
+            return Err(Refusal::NotReady);
+        }
+        pins.count = pins.count.checked_add(1).ok_or(Refusal::Exhausted)?;
