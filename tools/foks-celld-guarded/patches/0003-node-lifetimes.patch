+impl OwnedEffectRegistry {
+    fn schedule_control(
+        &self,
+        context: &JobContext,
+        kind: ActorControlKind,
+        alarm: Option<(celld_logic::wake::AlarmSnapshot, bool)>,
+    ) -> Result<(), Refusal> {
+        context.control.check_identity()?;
+        let record = self.record(context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        Self::schedule_control_locked(&record, &mut state, kind, alarm)?;
+        drop(state);
+        drop(record);
+        self.wake_actor();
+        Ok(())
+    }
+    fn schedule_control_locked(
+        record: &InvocationRecord,
+        state: &mut InvocationState,
+        kind: ActorControlKind,
+        alarm: Option<(celld_logic::wake::AlarmSnapshot, bool)>,
+    ) -> Result<(), Refusal> {
+        let request = match kind {
+            ActorControlKind::AuxFinish => state.activities[1].request,
+            ActorControlKind::Retirement => state.eviction_request,
+            _ => state.activities[0].request,
+        };
+        let cell = &mut state.controls[kind.index()];
+        if cell.processed {
+            return Ok(());
+        }
+        if cell.pending || cell.delivered {
+            if alarm.is_some() && cell.alarm != alarm {
+                return Err(Refusal::Invalid);
+            }
+            return Ok(());
+        }
+        // Each command consumes its originally prepaid control once. Refusal
+        // traffic cannot borrow this lane or manufacture another Request.
+        if !cell.charged {
+            record
+                .control
+                .cleanup(control::CleanupKind::Control(kind.index() as u8))?;
+            cell.charged = true;
+        }
+        cell.request = request;
+        cell.alarm = alarm;
+        cell.pending = true;
+        Ok(())
+    }
