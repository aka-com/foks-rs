+impl JobContext {
+    #[cfg(test)]
+    pub(crate) fn rejoin_native_for_test(&self) -> Result<NativeWait, Refusal> {
+        self.check_identity()?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let child = &mut OwnedEffectRegistry::root(&mut state, self.token)?.child;
+        if child.kind.is_none()
+            || child.consumer
+            || child.delivered
+            || child.handle.is_none() && child.receiver.is_none() && child.result.is_none()
+        {
+            return Err(Refusal::Invalid);
+        }
+        child.consumer = true;
+        Ok(NativeWait {
+            context: self.clone(),
+            child: ChildToken {
+                root: self.token,
+                sequence: child.sequence,
+            },
+            active: true,
+        })
+    }
+    pub(crate) fn claim_replica(
+        &self,
+        role: ReplicaRole,
+        attachment: &crate::ltx_repl::EpochAttachment,
+    ) -> Result<ReplicaJobPermit, Refusal> {
+        self.check_job()?;
+        attachment.validate(self)?;
+        let expected = if role == ReplicaRole::Retirement {
+            JobRole::Cleanup(CleanupLane::Stop)
+        } else {
+            JobRole::Forward(ForwardLane::Activation)
+        };
+        if self.role != expected {
+            return Err(Refusal::Invalid);
+        }
+        let registry = self.registry()?;
+        let context = registry.reserve(
+            self.token.slot as usize,
+            role.role(),
+            RootKind::Replica,
+            None,
+        )?;
+        Ok(ReplicaJobPermit {
+            context,
+            submitted: false,
+        })
+    }
+    pub(crate) fn stop_replica(
+        &self,
+        role: ReplicaRole,
+        attachment: &crate::ltx_repl::EpochAttachment,
+    ) -> Result<ReplicaWait, Refusal> {
+        self.require_role(JobRole::Cleanup(CleanupLane::Retirement))?;
+        attachment.validate(self)?;
+        if role == ReplicaRole::Retirement {
+            return Err(Refusal::Invalid);
+        }
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let context = {
+            let mut state = lock_owned(&record.state)?;
+            let root = &mut state.roots[role.role().index()];
+            if root.kind != Some(RootKind::Replica)
+                || root.consumer
+                || !matches!(root.state, RootState::Running | RootState::Joined)
+            {
+                return Err(Refusal::Busy);
+            }
+            root.consumer = true;
+            root.cancel = true;
+            let wake = root.waker.take();
+            let sequence = root.sequence;
+            drop(state);
+            if let Some(wake) = wake {
+                wake.wake();
+            }
+            registry.context(&record, self.token.slot as usize, role.role(), sequence)?
+        };
+        Ok(ReplicaWait {
+            context,
+            active: true,
+        })
+    }
+    pub(crate) fn claim_native(&self, kind: NativeKind) -> Result<NativePermit, Refusal> {
+        self.check_job()?;
+        let allowed = match kind {
+            NativeKind::DbOpen | NativeKind::RestoredAlarm | NativeKind::WorkerBuild => {
+                self.role == JobRole::Forward(ForwardLane::Activation)
+            }
+            NativeKind::HydratorOpen | NativeKind::HydratorStep => {
+                self.role == JobRole::Forward(ForwardLane::Hydration)
+            }
+            NativeKind::SyncCapture => matches!(
+                self.role,
+                JobRole::Forward(ForwardLane::Sync)
+                    | JobRole::Cleanup(
+                        CleanupLane::EnsureDurable
+                            | CleanupLane::TerminalProof
+                            | CleanupLane::Retirement
+                    )
+            ),
+            NativeKind::Snapshot | NativeKind::LocalClose => {
+                self.role == JobRole::Cleanup(CleanupLane::Retirement)
+            }
+            NativeKind::WorkerDestroy => self.role == JobRole::Cleanup(CleanupLane::Stop),
+            NativeKind::ReadFile | NativeKind::OpaqueLowerJob => {
+                self.role == JobRole::Forward(ForwardLane::Compaction)
+            }
+        };
+        if !allowed {
+            self.fail();
+            return Err(Refusal::Invalid);
+        }
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let root = OwnedEffectRegistry::root(&mut state, self.token)?;
+        if !root.child.clear() {
+            return Err(Refusal::Busy);
+        }
+        if matches!(self.role, JobRole::Cleanup(_)) {
+            if root.child_creations >= CHILD_CREATIONS {
+                record.control.fail();
+                state.tainted = true;
+                return Err(Refusal::Exhausted);
+            }
+            root.child_creations += 1;
+        }
+        let sequence = root
+            .child
+            .sequence
+            .checked_add(1)
+            .ok_or(Refusal::Exhausted)?;
+        root.child.sequence = sequence;
+        root.child.kind = Some(kind);
+        root.child.consumer = true;
+        Ok(NativePermit {
+            context: self.clone(),
+            child: ChildToken {
+                root: self.token,
+                sequence,
+            },
+            submitted: false,
+        })
+    }
+}
