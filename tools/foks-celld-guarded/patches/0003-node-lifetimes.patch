+impl GuardedAdmission {
+    pub(crate) fn into_event(self, now_mono_ms: u64) -> celld_logic::Event {
+        // Already admitted by begin on the exact actor registry. No fresh
+        // authority, deadline or owner is created by the core clock sample.
