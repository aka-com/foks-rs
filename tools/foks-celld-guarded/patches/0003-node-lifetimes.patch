+#[test]
+fn b2_sync_auxiliary_is_single_flight() {
+    use futures_util::{FutureExt as _, StreamExt as _};
+    crate::actor::guarded_test_runtime().block_on(async {
+        for via_stream in [false, true] {
+            let mut fixture = b2_fixture();
+            let (mut core, _permit, driver) = b2_core(&mut fixture);
+            let sample = b2_ticket(driver.epoch().unwrap(), 7);
+            let origin = b2_sync_origin(&driver, sample).unwrap();
+            let before = b2_debt(&fixture);
+            let (mut future, origin, scalar) =
+                crate::js::guarded_sync_component_for_test(origin).unwrap();
+            assert!(b2_debt(&fixture) > before);
+            let route = origin.submit().unwrap();
+            let effects = b2_request_transition(&fixture, &mut core);
+            b2_deliver(&fixture, effects);
+            let (_, activity) = route
+                .now_or_never()
+                .expect("delivered route ready")
+                .unwrap()
+                .into_parts();
+            let output = activity.output(sample).unwrap();
+            let effects = b2_request_transition(&fixture, &mut core);
+            let op = operation(&effects, |effect| match effect {
+                Effect::AwaitDurable { op, .. } => Some(*op),
+                _ => None,
+            });
+            b2_deliver(&fixture, b2_prove(&mut core, op, 7));
+            assert_eq!(output.now_or_never(), Some(Ok(())));
+            b2_finish_component(&fixture, &mut core, activity).await;
+            assert!(matches!(
+                b2_sync_origin(&driver, sample),
+                Err(Refusal::Busy)
+            ));
+            scalar.send(Ok(())).unwrap();
+            if via_stream {
+                // A fresh work Box is polled exactly once to Ready through the
+                // same selected stream destruction path used by actual Ops.
+                let mut ops = futures_util::stream::FuturesUnordered::new();
+                ops.push(future);
+                assert!(ops
+                    .next()
+                    .now_or_never()
+                    .expect("ready Ops item")
+                    .unwrap()
+                    .is_ok());
+                assert!(ops.is_empty());
+            } else {
+                assert!(future.as_mut().now_or_never().unwrap().is_ok());
+                assert!(matches!(
+                    b2_sync_origin(&driver, sample),
+                    Err(Refusal::Busy)
+                ));
+                drop(future); // never repoll a completed future
+            }
+            let before = b2_debt(&fixture);
+            let successor = b2_sync_origin(&driver, sample).unwrap();
+            let (next, successor, scalar) =
+                crate::js::guarded_sync_component_for_test(successor).unwrap();
+            assert!(
+                b2_debt(&fixture) > before,
+                "sequential producer is freshly charged"
+            );
+            assert!(successor.sequence > 1);
+            drop(scalar);
+            drop(next);
+            drop(successor); // cancellation holds, no fake release
+        }
+    });
+}
