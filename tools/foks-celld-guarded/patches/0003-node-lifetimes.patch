+            waker: None,
+            wake: None,
+            abandon: None,
+            cancel: false,
+        }
+    }
+    fn disposed(&self) -> bool {
+        matches!(self.state, RootState::Empty | RootState::Spent)
+            && self.handle.is_none()
+            && self.receiver.is_none()
+            && self.result.is_none()
+            && self.child.clear()
+    }
+}
