+#[derive(Clone, Copy)]
+struct FinalAlarm {
+    epoch: u64,
+    generation: u64,
+    alarm: celld_logic::wake::AlarmSnapshot,
+}
+struct InvocationState {
+    roots: [RootCell; ROOT_COUNT],
+    activities: [ActivityCompletion; 2],
+    controls: [ControlCell; 4],
+    epoch: Option<u64>,
+    generation: Option<crate::generation::GenerationId>,
+    fresh: Option<bool>,
+    attachment: Option<crate::ltx_repl::EpochAttachment>,
+    runtime: Option<NodeRuntime>,
+    final_alarm: Option<FinalAlarm>,
+    generation_pin: Option<crate::generation::GenerationPin>,
+    activation: Option<crate::ltx_repl::GuardedActivation>,
+    primary_proof: Option<crate::ltx_repl::GuardedProof>,
+    auxiliary_proof: Option<crate::ltx_repl::GuardedProof>,
+    tainted: bool,
+    retiring: bool,
+    cancel_requested: bool,
+    eviction_request: u64,
+    eviction_result: Option<Result<celld_logic::EvictSuccess, celld_logic::EvictError>>,
+    lease: Option<super::Lease>,
+}
+struct InvocationRecord {
+    state: Mutex<InvocationState>,
+    sequence: u64,
+    cell: &'static str,
+    control: NodeControl,
+    // The base owner is last; no payload is permitted to outlive it on success.
+    owner: Mutex<Option<control::OriginalOwner>>,
+}
+struct BankState {
+    records: [Option<Arc<InvocationRecord>>; 2],
+    held: [Option<HeldRetirement>; 2],
+    // B2 keeps the production bank layout; actual admission arrives in B3.
+    #[cfg_attr(not(test), allow(dead_code))]
+    next: u64,
+    actor_waker: Option<Waker>,
+}
+pub(crate) struct OwnedEffectRegistry {
+    own: Weak<OwnedEffectRegistry>,
+    bank: Mutex<BankState>,
+    capacity: Arc<super::Capacity>,
+    process: NodeControl,
+}
