+    // This is the ordinary driver loop with a fixed original cancellation/
+    // deadline signal. The poll interval does not renew that deadline and no
+    // timeout drops the complete driver or its pending native work as a join.
+    pub(super) async fn wake_guarded(
+        ops: &mut Ops,
+        entry: &mut js::InFlight,
+        budget: Duration,
+        context: &JobContext,
+    ) -> Wake {
+        if context.check_forward().is_err() {
+            return Wake::Cancelled { shutdown: false };
+        }
+        crate::asyncrt::select_biased! {
+            "guarded work completion wins a tie; the next turn rechecks its original origin";
+            wake = wake_with_cross_entry_gate(ops, entry, budget) => wake,
+            _ = crate::asyncrt::sleep(CANCELLATION_TICK) => {
+                if context.check_forward().is_err() { Wake::Cancelled { shutdown: false } }
+                else { Wake::Poll }
+            },
+        }
+    }
+
+    struct TerminalProofWork {
+        replication: Replication,
+        attachment: EpochAttachment,
+        proofs: [Option<GuardedProof>; 2],
+    }
+    impl TerminalProofWork {
+        async fn run(self, context: JobContext) -> Result<(), Refusal> {
+            context.require_role(JobRole::Cleanup(CleanupLane::TerminalProof))?;
+            for proof in self.proofs.into_iter().flatten() {
+                self.replication
+                    .await_durable_guarded(&context, &self.attachment, &proof)
+                    .await
+                    .map_err(|_| refused(&context, Refusal::Failed))?;
+            }
+            Ok(())
+        }
+    }
+
+    struct CancelWork {
+        context: JobContext,
+    }
+
+    struct LocalRetirementWork {
+        replication: Replication,
+        attachment: EpochAttachment,
+        mode: StopMode,
+    }
+    impl LocalRetirementWork {
+        fn run(
+            self,
+            context: JobContext,
+        ) -> impl std::future::Future<Output = crate::ltx_repl::LtxRootCompletion> {
+            self.replication
+                .retire_job_guarded(context, self.attachment, self.mode)
+        }
+    }
+    impl CancelWork {
+        async fn run(self) -> Result<(), Refusal> {
+            self.context
+                .require_role(JobRole::Cleanup(CleanupLane::Cancel))?;
+            // The bank signals cancellation before admitting this root. It
+            // only yields a result after the real F3 handle has joined, and
+            // never steals a live normal consumer's completion.
+            match self.context.take_driver_for_cancel().await {
+                Ok(joined) => joined.dispose_node().await?,
+                // The bank proves that no driver exists or its exact result
+                // has already been disposed; this is not a missing join.
+                Err(Refusal::NotReady) => {}
+                Err(error) => return Err(error),
+            }
+            Ok(())
+        }
+    }
+    pub(crate) async fn guarded_cancel(context: JobContext) -> Result<(), Refusal> {
+        CancelWork { context }.run().await
+    }
+
+    pub(crate) struct NodeDriverCompletion {
+        answer: Option<crate::actor::GuardedLocalRequestCompletion<HttpResponse>>,
+        drive_result: Result<(), Refusal>,
+        alarm: Option<AlarmSnapshot>,
+        replication: Replication,
+        attachment: EpochAttachment,
+        witness: RuntimeWitness,
+        disposed: bool,
+        origin: JobContext,
+    }
+    impl NodeDriverCompletion {
+        pub(crate) async fn dispose(mut self, context: &JobContext) -> Result<(), Refusal> {
+            context.check_identity()?;
+            if context.role() != JobRole::Forward(ForwardLane::Driver)
+                || self.origin.root_token() != context.root_token()
+                || !self.origin.same_invocation(context)
+            {
+                return Err(refused(context, Refusal::Invalid));
+            }
+            // Only the sealed bank consumer can call this method, after the
+            // actual F3 TaskHandle joined, not merely after reply delivery.
+            self.witness.driver_joined()?;
+            let proofs = context.proofs()?;
+            if proofs.iter().any(Option::is_some) {
+                // C1 is admitted from this exact delivered F3 result, before
+                // ActivityFinished/Inactive and the later final eviction.
+                let permit = context.claim_control(CleanupLane::TerminalProof)?;
+                let work = TerminalProofWork {
+                    replication: self.replication.clone(),
+                    attachment: self.attachment.clone(),
+                    proofs,
+                };
+                permit
+                    .submit_node(move |cleanup| work.run(cleanup))?
+                    .await?;
+            }
+            let answer = self
+                .answer
+                .take()
+                .ok_or_else(|| refused(context, Refusal::Invalid))?;
+            let covered = answer.result.is_ok() && self.drive_result.is_ok();
+            // B2's sealed component consumer discards the native answer. B3
+            // supplies the consuming socket path; no bytes are published here.
+            drop(answer.result);
+            self.witness.output_disposed()?;
+            let alarm = self
+                .alarm
+                .ok_or_else(|| refused(context, Refusal::Invalid))?;
+            answer.activity.finish(alarm, covered).await?;
+            self.drive_result?;
+            self.disposed = true;
+            Ok(())
+        }
+    }
+    impl Drop for NodeDriverCompletion {
+        fn drop(&mut self) {
+            if !self.disposed {
+                self.origin.fail();
+                if let Some(answer) = self.answer.take() {
+                    std::mem::forget(answer);
+                }
+            }
+        }
+    }
