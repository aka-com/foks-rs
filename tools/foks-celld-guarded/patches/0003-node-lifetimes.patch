+            let vector = peers
+                .capacity()
+                .checked_mul(std::mem::size_of::<CapacityPeer>())
+                .ok_or(Failure::Definite)?;
+            keep_capacity(
+                context,
+                std::iter::once(vector).chain(
+                    peers
+                        .iter()
+                        .flat_map(|peer| [peer.node.capacity(), peer.addr.capacity()]),
+                ),
+            )?;
+            context
+                .charge_owned(context.cell().len())
+                .map_err(|_| Failure::Definite)?;
+            let request = HandoffRequest {
+                cell: context.cell().to_owned(),
+                released_epoch: self.released_epoch,
+            };
+            let mut attempts = 0usize;
+            for peer in peers {
+                let mut target = AdoptedCell {
+                    node: peer.node,
+                    addr: peer.addr,
+                    epoch: 0,
+                    peer_protocol: peer.peer_protocol,
+                };
+                // Inline, finite redirect history: no new set/queue allocation.
+                let mut visited: [Option<String>; 4] = [None, None, None, None];
+                for entry in 0..visited.len() {
+                    context.check_job().map_err(|_| Failure::Definite)?;
+                    if attempts == 4
+                        || target.node == self.source
+                        || target.addr.is_empty()
+                        || target.peer_protocol != peer_auth::PROTOCOL_VERSION
+                        || visited.iter().flatten().any(|node| *node == target.node)
+                    {
+                        break;
+                    }
+                    context
+                        .charge_owned(target.node.len())
+                        .map_err(|_| Failure::Definite)?;
+                    visited[entry] = Some(target.node.clone());
+                    attempts += 1;
+                    match request_peer_handoff(&self.http, &self.auth, &target, &request).await {
+                        Ok(HandoffAttempt::Accepted(adopted))
+                            if adopted.epoch > self.released_epoch =>
+                        {
+                            keep_capacity(
+                                context,
+                                [adopted.node.capacity(), adopted.addr.capacity()],
+                            )?;
+                            return Ok(adopted);
+                        }
+                        Ok(HandoffAttempt::CurrentOwner(owner)) => {
+                            keep_capacity(context, [owner.node.capacity(), owner.addr.capacity()])?;
+                            target = owner;
+                        }
+                        Ok(HandoffAttempt::Accepted(_) | HandoffAttempt::Refused) | Err(_) => break,
+                    }
+                }
+                if attempts == 4 {
+                    break;
+                }
+            }
+            Err(Failure::Definite)
+        }
+    }
