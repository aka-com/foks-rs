+    // The production frontend is intentionally absent in B2. Like the opaque
+    // GuardedRequest constructor, only component code can start this actual
+    // factory until B3 supplies an admitted socket owner.
+    #[cfg(test)]
+    struct NodeDriverWork {
+        slot: Arc<crate::pool::Slot>,
+        affiliation: crate::pool::Affiliation,
+        job: CellJob,
+        receive: tokio::sync::oneshot::Receiver<anyhow::Result<HttpResponse>>,
+        report: AlarmReporter,
+        app: crate::actor::AppHandle,
+        activity: crate::guarded_execution::node::GuardedActivity,
+        replication: Replication,
+        attachment: EpochAttachment,
+        witness: RuntimeWitness,
+    }
+    #[cfg(test)]
+    impl NodeDriverWork {
+        async fn run(self, context: JobContext) -> NodeDriverCompletion {
+            let Self {
+                slot,
+                affiliation,
+                job,
+                receive,
+                report,
+                app,
+                activity,
+                replication,
+                attachment,
+                witness,
+            } = self;
+            let initialized = async {
+                context.require_role(JobRole::Forward(ForwardLane::Driver))?;
+                witness.driver_started()?;
+                slot.turn(|worker| worker.install_guarded_node_origin(context.clone()))
+                    .await?;
+                Ok::<_, Refusal>(())
+            }
+            .await;
+            let driver = async {
+                match initialized {
+                    Err(error) => {
+                        job.fail(anyhow!(error));
+                        Err(error)
+                    }
+                    Ok(()) => {
+                        let budget = context.forward_remaining()?;
+                        drive_cell_inner_owned(
+                            affiliation,
+                            job,
+                            Some(report),
+                            None,
+                            budget,
+                            None,
+                            Some(&context),
+                            #[cfg(celld_internal_tests)]
+                            DriveCellTestObservers::default(),
+                        )
+                        .await
+                        .map(|_| ())
+                        .map_err(|_| refused(&context, Refusal::Failed))
+                    }
+                }
+            };
+            let handler = app.guarded_local_request(activity).run(async {
+                receive
+                    .await
+                    .map_err(|_| anyhow!("guarded cell dropped its response"))?
+            });
+            // The native reply and driver are independent. Retain the reply
+            // while polling all background/final-abandon work through return.
+            let (mut drive_result, answer) = futures_util::future::join(driver, handler).await;
+            if answer.result.as_ref().is_ok_and(|response| {
+                response.status != 200
+                    || response.body.len() != 12
+                    || response.body.capacity() > 512
+                    || response.headers.capacity() != 0
+                    || response.stream.is_some()
+                    || response.websocket.is_some()
+            }) {
+                drive_result = Err(refused(&context, Refusal::Invalid));
+            }
+            let final_state = slot
+                .turn(|worker| {
+                    let alarm = worker.guarded_node_alarm_snapshot(context.cell());
+                    // A throw still allocated the fixture memory before failing.
+                    let probe = worker.guarded_node_probe();
+                    (alarm, probe)
+                })
+                .await;
+            let alarm = match final_state.0 {
+                Ok(alarm) => Some(alarm),
+                Err(_) => {
+                    drive_result = Err(refused(&context, Refusal::Failed));
+                    None
+                }
+            };
+            match final_state.1 {
+                Ok(probe) => {
+                    let mut probe = Some(probe);
+                    let stored = context.with_runtime_mut(|runtime| {
+                        let resources = runtime.resources.as_mut().ok_or(Refusal::Invalid)?;
+                        if resources.probe.is_some() {
+                            return Err(Refusal::Invalid);
+                        }
+                        resources.probe = probe.take();
+                        if let Some(alarm) = alarm {
+                            runtime.observe_alarm(alarm)?;
+                        }
+                        runtime.witness.backing_observed()
+                    });
+                    if !matches!(stored, Ok(Ok(()))) {
+                        if let Some(probe) = probe {
+                            std::mem::forget(probe);
+                        }
+                        drive_result = Err(refused(&context, Refusal::Failed));
+                    }
+                }
+                Err(_) => drive_result = Err(refused(&context, Refusal::Failed)),
+            }
+            drop(slot);
+            NodeDriverCompletion {
+                answer: Some(answer),
+                drive_result,
+                alarm,
+                replication,
+                attachment,
+                witness,
+                disposed: false,
+                origin: context,
+            }
+        }
+    }
+
+    #[cfg(test)]
+    fn report_for_driver(context: &JobContext) -> Result<AlarmReporter, Refusal> {
+        let origin = context.clone();
+        let report = move |cell: String, alarm: AlarmSnapshot| {
+            if cell != origin.cell()
+                || !matches!(
+                    origin.with_runtime_mut(|runtime| runtime.observe_alarm(alarm)),
+                    Ok(Ok(()))
+                )
+            {
+                origin.fail();
+            }
+        };
+        fn charged<T>(context: &JobContext, value: T) -> Result<Arc<T>, Refusal> {
+            context.charge_owned(arc_bytes::<T>()?)?;
+            Ok(Arc::new(value))
+        }
+        Ok(charged(context, report)?)
+    }
