+impl InlinePermit {
+    pub(crate) fn deliver(mut self, effect: Effect) -> Result<(), Refusal> {
+        self.context.check_identity()?;
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let mut wake = None;
+        let mut abandon = None;
+        match (self.operation, effect) {
+            (InlineKind::Complete, Effect::Complete { request, result }) => {
+                let activity = state
+                    .activities
+                    .iter_mut()
+                    .find(|activity| activity.request == request)
+                    .ok_or(Refusal::Invalid)?;
+                if activity.route.is_some() || activity.route_delivered {
+                    return Err(Refusal::Invalid);
+                }
+                activity.route = Some(result);
+                wake = activity.route_waker.take();
+                if !activity.route_consumer {
+                    let index = usize::from(request != state.activities[0].request);
+                    drop(state);
+                    drop(record);
+                    if let Some(wake) = wake {
+                        wake.wake();
+                    }
+                    registry.abandon_activity(&self.context, index, request);
+                    self.consumed = true;
+                    return Ok(());
+                }
+            }
+            (
+                InlineKind::Release,
+                Effect::Release {
+                    request,
+                    channel,
+                    result,
+                },
+            ) => {
+                let activity = state
+                    .activities
+                    .iter_mut()
+                    .find(|activity| activity.request == request)
+                    .ok_or(Refusal::Invalid)?;
+                let output = activity.output.as_mut().ok_or(Refusal::Invalid)?;
+                if output.ticket.channel != channel
+                    || output.result.is_some()
+                    || output.done
+                    || !output.delivered
+                {
+                    return Err(Refusal::Invalid);
+                }
+                output.result = Some(result);
+                wake = output.waker.take();
+            }
+            (InlineKind::Admission, Effect::EvictionAdmission { request, result }) => {
+                if state.eviction_request != request
+                    || !state.controls[3].delivered && !state.controls[3].processed
+                {
+                    return Err(Refusal::Invalid);
+                }
+                match result {
+                    Ok(celld_logic::EvictionAdmission::Pending) => {}
+                    Ok(celld_logic::EvictionAdmission::Absent) => {
+                        state.eviction_result = Some(Ok(celld_logic::EvictSuccess::AlreadyAbsent))
+                    }
+                    Err(error) => {
+                        state.eviction_result = Some(Err(error));
+                        state.tainted = true;
+                        record.control.fail();
+                    }
+                }
+            }
+            (InlineKind::Finished, Effect::EvictionFinished { request, result }) => {
+                if state.eviction_request != request || state.eviction_result.is_some() {
+                    return Err(Refusal::Invalid);
+                }
+                if result.is_err() {
+                    state.tainted = true;
+                    record.control.fail();
+                }
+                state.eviction_result = Some(result);
+            }
+            (
+                InlineKind::Cancel,
+                Effect::CancelCellActivity {
+                    cell,
+                    requests,
+                    websockets,
+                    alarm,
+                    ..
+                },
+            ) => {
+                if cell != record.cell
+                    || !websockets.is_empty()
+                    || alarm.is_some()
+                    || requests.len() > 2
+                    || requests.iter().any(|request| {
+                        !state
+                            .activities
+                            .iter()
+                            .any(|activity| activity.request == *request)
+                    })
+                {
+                    return Err(Refusal::Invalid);
+                }
+                state.cancel_requested = true;
+                state.roots[ForwardLane::Driver as usize].cancel = true;
+                if let Some(runtime) = &state.runtime {
+                    runtime.cancel();
+                }
+                record.control.fail();
+            }
+            (InlineKind::Abandon, Effect::AbandonEvictionStop { cell, op }) => {
+                let root = &state.roots[JobRole::Cleanup(CleanupLane::Stop).index()];
+                if cell != record.cell || root.op != Some(op) {
+                    return Err(Refusal::Invalid);
+                }
+                abandon = Some(root.abandon.as_ref().ok_or(Refusal::Invalid)?.clone());
+            }
+            (InlineKind::Wake, Effect::ReconcileWakeEntry { cell, alarm }) => {
+                if cell != record.cell {
+                    return Err(Refusal::Invalid);
+                }
+                let root = OwnedEffectRegistry::root(&mut state, self.context.token)?;
+                if root.wake != Some(alarm) || root.kind != Some(RootKind::Wake) {
+                    return Err(Refusal::Invalid);
+                }
+            }
+            _ => return Err(Refusal::Invalid),
+        }
+        let cancellation = self.operation == InlineKind::Cancel;
+        drop(state);
+        drop(record);
+        if let Some(wake) = wake {
+            wake.wake();
+        }
+        if let Some(abandon) = abandon {
+            abandon.request();
+        }
+        if cancellation {
+            registry.start_cancel_if_needed(&self.context)?;
+        }
+        self.consumed = true;
+        Ok(())
+    }
+    pub(crate) fn finish_publish(
+        mut self,
+        result: Result<(), celld_logic::Failure>,
+    ) -> Result<(), Refusal> {
+        if self.operation != InlineKind::Publish {
+            return Err(Refusal::Invalid);
+        }
+        self.context
+            .require_role(JobRole::Forward(ForwardLane::Activation))?;
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        {
+            let mut state = lock_owned(&record.state)?;
+            let root = OwnedEffectRegistry::root(&mut state, self.context.token)?;
+            if root.state != RootState::Reserved {
+                return Err(Refusal::Invalid);
+            }
+            root.state = RootState::Delivered;
+            if result.is_err() {
+                state.tainted = true;
+                record.control.fail();
+            }
+        }
+        registry.finish_root(&self.context)?;
+        self.consumed = true;
+        Ok(())
+    }
+}
