+    #[cfg(feature = "foks-guarded-node-qualification")]
+    fn take_guarded_effect(
+        &mut self,
+        effect: Effect,
+        immediate: &mut VecDeque<Event>,
+        _out: &mut StepOutput,
+    ) -> Option<Effect> {
+        use effects::guarded::*;
+        let Some(registry) = self.guarded.as_ref().cloned() else {
+            return Some(effect);
+        };
+        // Classification precedes cloning backends, paths, peers or channels.
+        let permit = match registry.claim_actor(&effect) {
+            ActorClaim::Ordinary => return Some(effect),
+            ActorClaim::Refused(_) => {
+                Self::refuse_guarded_effect(effect, immediate);
+                return None;
+            }
+            ActorClaim::Inline(permit) => {
+                match effect {
+                    Effect::Publish { op, epoch, .. } => {
+                        let result = match &self.host {
+                            Some(CellHost::Engine(runtime)) => {
+                                PublishWork { runtime, epoch }.run(permit.context())
+                            }
+                            _ => {
+                                permit.context().fail();
+                                Err(Failure::Definite)
+                            }
+                        };
+                        let accepted = permit.finish_publish(result);
+                        immediate.push_back(Event::Published {
+                            op,
+                            result: accepted.map_or(Err(Failure::Definite), |_| result),
+                        });
+                    }
+                    effect => {
+                        let _ = permit.deliver(effect);
+                    }
+                }
+                return None;
+            }
+            ActorClaim::Guarded(permit) => permit,
+        };
+        // Charge every retained effect-owned identifier and newly cloned node
+        // name before constructing the capture. Backend result transfers have
+        // their own bounds in the named factory.
+        let owned = match &effect {
+            Effect::ReadNodeLease { owner, .. } => owner.capacity(),
+            Effect::CasOwner {
+                guard: CasGuard::Match(etag),
+                ..
+            } => etag.capacity(),
+            Effect::Restore { spec, .. } => spec.prior.as_ref().map_or(0, String::capacity),
+            Effect::VerifyOwnership { .. }
+            | Effect::ReconcileWakeEntry { .. }
+            | Effect::AdoptReleased { .. } => self.state.node().len(),
+            _ => 0,
+        };
+        if permit.charge_owned(owned).is_err() {
+            permit.context().fail();
+            Self::refuse_guarded_effect(effect, immediate);
+            return None;
+        }
+        macro_rules! submit {
+            ($work:expr, $failure:expr) => {{
+                let work = $work;
+                if registry
+                    .submit_actor(permit, move |context| work.run(context))
+                    .is_err()
