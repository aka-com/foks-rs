+thread_local! {
+    static FORWARD_OBSERVATION_BARRIER: std::cell::RefCell<Option<(
+        std::sync::mpsc::SyncSender<()>, std::sync::mpsc::Receiver<()>
+    )>> = const { std::cell::RefCell::new(None) };
+}
+
+struct B2HForwardBarrier;
+impl Drop for B2HForwardBarrier {
+    fn drop(&mut self) {
+        FORWARD_OBSERVATION_BARRIER.with(|barrier| {
+            barrier.borrow_mut().take();
+        });
+    }
+}
+
+pub(super) fn forward_observation_barrier() -> Result<(), Refusal> {
+    // Test-only one-shot: the actual caller holds no bank/state/B1 guard here.
+    let barrier = FORWARD_OBSERVATION_BARRIER.with(|barrier| barrier.borrow_mut().take());
+    if let Some((notice, release)) = barrier {
+        notice.try_send(()).map_err(|_| Refusal::Failed)?;
+        release
+            .recv_timeout(Duration::from_secs(5))
+            .map_err(|_| Refusal::Failed)?;
+    }
+    Ok(())
+}
