+        let runtime = if matches!(
+            &effect,
+            Effect::Restore { .. }
+                | Effect::StartRuntime { .. }
+                | Effect::EnsureDurable { .. }
+                | Effect::AwaitDurable { .. }
+                | Effect::StopRuntime { .. }
+                | Effect::ReconcileWakeEntry { .. }
