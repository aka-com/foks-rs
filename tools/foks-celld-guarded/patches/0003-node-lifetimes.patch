+impl JobContext {
+    pub(crate) fn gate_origin(
+        &self,
+        sample: crate::actor::GateTicket,
+    ) -> Result<OwnedGateOrigin, Refusal> {
+        self.require_role(JobRole::Forward(ForwardLane::Driver))?;
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let mut state = lock_owned(&record.state)?;
+        // Production requires the actual published runtime. Component tests
+        // exercise only the shared binding/reservation predicate below.
+        if !state.runtime.as_ref().is_some_and(NodeRuntime::published) {
+            return Err(Refusal::Invalid);
+        }
+        let result = self.reserve_sync(&mut state, sample);
+        drop(state);
+        drop(record);
+        let (origin, retired) = result?;
+        drop(retired);
+        self.check_forward()?;
+        Ok(origin)
+    }
+    fn reserve_sync(
+        &self,
+        state: &mut InvocationState,
+        sample: crate::actor::GateTicket,
+    ) -> Result<(OwnedGateOrigin, Option<RetiredAux>), Refusal> {
+        let epoch = state.epoch.ok_or(Refusal::Invalid)?;
+        let generation = state.generation.ok_or(Refusal::Invalid)?;
+        if sample.channel != celld_logic::Channel::Sync
+            || sample.epoch != Some(epoch)
+            || sample.position.is_none()
+            || state.activities[0].request != self.request
+            || state.activities[0].finish_processed
+        {
+            return Err(Refusal::Invalid);
+        }
+        let mut retired = None;
+        if state.activities[1].issued {
+            let old = &state.activities[1];
+            if !old.finish_processed
+                || !old.inactive
+                || !old.finish_disposed
+                || !old.sync_disposed
+                || old.route_consumer
+                || old.route.is_some()
+                || old.route_input.is_some()
+                || old.route_pending
+                || old
+                    .output
+                    .as_ref()
+                    .is_none_or(|output| !output.done || output.result.is_some())
+                || !state.roots[ForwardLane::AuxProof as usize].disposed()
+                || !state.controls[2].processed
+                || state.controls[2].pending
+                || state.controls[2].delivered
+            {
+                return Err(Refusal::Busy);
+            }
+            let sequence = old.sequence.checked_add(1).ok_or(Refusal::Exhausted)?;
+            let request = crate::asyncrt::next_core_request();
+            if request <= old.request {
+                self.control.fail();
+                return Err(Refusal::Exhausted);
+            }
+            // Keep the once-consumed auxiliary control reservation. Only its
+            // fixed command payload and monotonic identity are reused.
+            let charged = state.controls[2].charged;
+            retired = Some(RetiredAux {
+                _control: std::mem::replace(
+                    &mut state.controls[2],
+                    ControlCell {
+                        charged,
+                        ..ControlCell::new()
+                    },
+                ),
+                _activity: std::mem::replace(
+                    &mut state.activities[1],
+                    ActivityCompletion {
+                        sequence,
+                        ..ActivityCompletion::new(request)
+                    },
+                ),
+                _proof: state.auxiliary_proof.take(),
+            });
+        }
+        state.activities[1].issued = true;
+        let sequence = state.activities[1].sequence;
+        Ok((
+            OwnedGateOrigin {
+                context: self.clone(),
+                sequence,
+                submitted: false,
+                sample,
+                epoch,
+                generation,
+            },
+            retired,
+        ))
+    }
+}
