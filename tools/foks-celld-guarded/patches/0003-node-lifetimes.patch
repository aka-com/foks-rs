+    // Retain the entire fixture through every asynchronous boundary, including
+    // its final process-task join. A dropped callback is not proof that the
+    // actual Worker, managed Db or pager has stopped using these local paths.
+    #[cfg(test)]
+    struct LocalActivationFixture {
