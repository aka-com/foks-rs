+impl ActorRequest {
+    pub(crate) fn apply(
+        mut self,
+        now_mono_ms: u64,
+        transition: impl FnOnce(celld_logic::Event) -> Vec<Effect>,
+    ) -> Result<Vec<Effect>, Refusal> {
+        self.context.check_forward()?;
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        let kind = self.kind.take().ok_or(Refusal::Invalid)?;
+        let (event, output) = {
+            let state = lock_owned(&record.state)?;
+            let activity = state
+                .activities
+                .get(self.activity)
+                .ok_or(Refusal::Invalid)?;
+            if activity.request != self.request
+                || activity.sequence != self.sequence
+                || activity.finish_processed
+            {
+                return Err(Refusal::Invalid);
+            }
+            match kind {
+                RequestKind::Route(route) => {
+                    if self.activity != 1
+                        || route.scope != record.cell
+                        || state.epoch != Some(route.epoch)
+                        || state.generation != Some(route.generation)
+                        || state.activities[0].request != route.parent
+                    {
+                        return Err(Refusal::Invalid);
+                    }
+                    (
+                        celld_logic::Event::ResidentGateRequestAt {
+                            request: self.request,
+                            parent: route.parent,
+                            cell: route.scope,
+                            epoch: route.epoch,
+                            generation: route.generation,
+                            now_mono_ms,
+                        },
+                        None,
+                    )
+                }
+                RequestKind::Output(ticket) => {
+                    if !activity.output.as_ref().is_some_and(|output| {
+                        output.ticket == ticket && output.delivered && !output.done
+                    }) {
+                        return Err(Refusal::Invalid);
+                    }
+                    (
+                        celld_logic::Event::OutputAt {
+                            request: self.request,
+                            channel: ticket.channel,
+                            position: ticket.position,
+                            observed: ticket.observed,
+                            epoch: ticket.epoch,
+                            now_mono_ms,
+                        },
+                        Some(ticket),
+                    )
+                }
+            }
+        };
+        // The actual core transition runs once with no bank lock held. Its
+        // resulting operation, not a position comparison, binds proof identity.
+        self.context.check_forward()?;
+        let effects = transition(event);
+        if let Some(ticket) = output {
+            let mut operation = None;
+            for effect in &effects {
+                if let Effect::AwaitDurable {
+                    op,
+                    cell,
+                    epoch,
+                    position,
+                } = effect
+                {
+                    if operation.replace(*op).is_some()
+                        || cell != record.cell
+                        || self.context.epoch() != Some(*epoch)
+                        || ticket.epoch.is_some_and(|sample| sample != *epoch)
+                        || ticket.position.or(ticket.observed) != Some(*position)
+                    {
+                        return Err(Refusal::Invalid);
+                    }
+                }
+            }
+            let mut state = lock_owned(&record.state)?;
+            let activity = &mut state.activities[self.activity];
+            if activity.request != self.request
+                || activity.sequence != self.sequence
+                || activity.proof_op.is_some()
+            {
+                return Err(Refusal::Invalid);
+            }
+            activity.proof_op = operation;
+        }
+        self.context.check_forward()?;
+        self.consumed = true;
+        Ok(effects)
+    }
+}
+impl Drop for ActorRequest {
+    fn drop(&mut self) {
+        if !self.consumed {
+            self.context.fail();
+        }
+    }
+}
