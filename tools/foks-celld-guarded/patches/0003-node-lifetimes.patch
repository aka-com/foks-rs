+impl GuardedActivity {
+    pub(crate) fn request(&self) -> u64 {
+        self.request
+    }
+    pub(crate) fn finish(
+        mut self,
+        alarm: celld_logic::wake::AlarmSnapshot,
+        covered: bool,
+    ) -> ActivityWait {
+        let failed = self
+            .context
+            .registry()
+            .and_then(|registry| {
+                registry.finish_activity(
+                    &self.context,
+                    self.index,
+                    self.request,
+                    Some((alarm, covered)),
+                )
+            })
+            .err();
+        if failed.is_some() {
+            self.context.fail();
+        }
+        self.finished = true;
+        ActivityWait {
+            context: self.context.clone(),
+            index: self.index,
+            request: self.request,
+            completed: false,
+            failed,
+        }
+    }
+    pub(crate) fn output(
+        &self,
+        ticket: crate::actor::GateTicket,
+    ) -> Result<GuardedOutputWait, celld_logic::RequestError> {
+        let result = (|| {
+            self.context.check_forward()?;
+            let registry = self.context.registry()?;
+            let record = registry.record(self.context.token)?;
+            let mut state = lock_owned(&record.state)?;
+            let activity = &mut state.activities[self.index];
+            if activity.request != self.request || activity.finish_processed || activity.inactive {
+                return Err(Refusal::Busy);
+            }
+            match &mut activity.output {
+                Some(output)
+                    if self.index == 1
+                        && !output.pending
+                        && !output.delivered
+                        && !output.done
+                        && output.ticket == ticket =>
+                {
+                    output.pending = true
+                }
+                Some(_) => return Err(Refusal::Busy),
+                None => {
+                    activity.output = Some(OutputCell {
+                        ticket,
+                        pending: true,
+                        delivered: false,
+                        done: false,
+                        result: None,
+                        waker: None,
+                    })
+                }
+            }
+            drop(state);
+            drop(record);
+            self.context.check_forward()?;
+            registry.wake_actor();
+            Ok(GuardedOutputWait {
+                context: self.context.clone(),
+                index: self.index,
+                request: self.request,
+                active: true,
+            })
+        })();
+        result.map_err(|_| {
+            self.context.fail();
+            celld_logic::RequestError::NodeFenced
+        })
+    }
+}
+impl Drop for GuardedActivity {
+    fn drop(&mut self) {
+        if !self.finished {
+            if let Ok(registry) = self.context.registry() {
+                registry.abandon_activity(&self.context, self.index, self.request);
+            } else {
+                self.context.fail();
+            }
+        }
+    }
+}
+impl Future for ActivityWait {
+    type Output = Result<(), Refusal>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let incoming = cx.waker().clone();
+        let mut deferred = DeferredWaker(None);
+        if let Some(error) = self.failed {
+            return Poll::Ready(Err(error));
+        }
+        let registry = match self.context.registry() {
+            Ok(registry) => registry,
+            Err(error) => return Poll::Ready(Err(error)),
+        };
+        let record = match registry.poll_record(self.context.token, cx) {
+            Poll::Ready(Ok(record)) => record,
+            Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+            Poll::Pending => return Poll::Pending,
+        };
+        let mut state = match poll_owned(&record.state, cx) {
+            Poll::Ready(Ok(state)) => state,
+            Poll::Ready(Err(error)) => return Poll::Ready(Err(error)),
+            Poll::Pending => return Poll::Pending,
+        };
+        let activity = &mut state.activities[self.index];
+        if activity.request != self.request {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        if activity.finish_processed && activity.inactive {
+            self.completed = true;
+            Poll::Ready(Ok(()))
+        } else {
+            deferred.0 = activity.finish_waker.replace(incoming);
+            drop(state);
+            drop(record);
+            Poll::Pending
+        }
+    }
+}
+impl OwnedGateOrigin {
+    pub(crate) fn submit(mut self) -> Result<GuardedRouteWait, celld_logic::RequestError> {
+        let result = (|| {
+            self.context.check_forward()?;
+            let registry = self.context.registry()?;
+            let record = registry.record(self.context.token)?;
+            let mut state = lock_owned(&record.state)?;
+            if state.epoch != Some(self.epoch)
+                || state.generation != Some(self.generation)
+                || state.activities[0].finish_processed
+            {
+                return Err(Refusal::Invalid);
+            }
+            let activity = &mut state.activities[1];
+            if !activity.issued
+                || activity.sequence != self.sequence
+                || activity.route_pending
+                || activity.route_consumer
+                || activity.route_delivered
+            {
+                return Err(Refusal::Busy);
+            }
+            // The scope allocation was charged before this producer was built.
+            activity.route_input = Some(RouteInput {
+                scope: self.context.cell.to_owned(),
+                parent: self.context.request,
+                epoch: self.epoch,
+                generation: self.generation,
+            });
+            activity.route_pending = true;
+            activity.route_consumer = true;
+            activity.issued = true;
+            // The exact pre-acquisition sample is retained; output() later must
+            // present this same ticket, never resample a different epoch.
+            activity.output = Some(OutputCell {
+                ticket: self.sample,
+                pending: false,
+                delivered: false,
+                done: false,
+                result: None,
+                waker: None,
+            });
+            let request = activity.request;
+            drop(state);
+            drop(record);
+            self.context.check_forward()?;
+            registry.wake_actor();
+            self.submitted = true;
+            Ok(GuardedRouteWait {
+                context: self.context.clone(),
+                index: 1,
+                request,
+                active: true,
+            })
+        })();
+        result.map_err(|_| {
+            self.context.fail();
+            celld_logic::RequestError::NodeFenced
+        })
+    }
+}
+impl Future for GuardedRouteWait {
+    type Output = Result<GuardedRouted, celld_logic::RequestError>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let incoming = cx.waker().clone();
+        let mut deferred = DeferredWaker(None);
+        if !self.active {
+            return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+        }
+        let registry = match self.context.registry() {
+            Ok(registry) => registry,
+            Err(_) => return Poll::Ready(Err(celld_logic::RequestError::NodeFenced)),
+        };
+        let record = match registry.poll_record(self.context.token, cx) {
+            Poll::Ready(Ok(record)) => record,
+            Poll::Ready(Err(_)) => {
+                self.context.fail();
+                return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+            }
+            Poll::Pending => return Poll::Pending,
+        };
+        let mut state = match poll_owned(&record.state, cx) {
+            Poll::Ready(Ok(state)) => state,
+            Poll::Ready(Err(_)) => {
+                self.context.fail();
+                return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+            }
+            Poll::Pending => return Poll::Pending,
+        };
+        let activity = &mut state.activities[self.index];
+        if activity.request != self.request {
+            return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+        }
+        if let Some(result) = activity.route.take() {
+            let request = activity.request;
+            activity.route_delivered = true;
+            activity.route_consumer = false;
+            self.active = false;
+            drop(state);
+            drop(record);
+            if self.context.check_forward().is_err() {
+                self.context.fail();
+                drop(result);
+                registry.abandon_activity(&self.context, self.index, request);
+                return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+            }
+            return Poll::Ready(result.map(|route| GuardedRouted {
+                routed: crate::actor::Routed { request, route },
+                activity: GuardedActivity {
+                    context: self.context.clone(),
+                    index: self.index,
+                    request,
+                    finished: false,
+                },
+            }));
+        }
+        deferred.0 = activity.route_waker.replace(incoming);
+        drop(state);
+        drop(record);
+        Poll::Pending
+    }
+}
+impl Drop for GuardedRouteWait {
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        if let Ok(registry) = self.context.registry() {
+            if let Ok(record) = registry.record(self.context.token) {
+                if let Ok(mut state) = lock_owned(&record.state) {
+                    if state.activities[self.index].request == self.request {
+                        state.activities[self.index].route_consumer = false;
+                    } else {
+                        return;
+                    }
+                }
+            }
+            registry.abandon_activity(&self.context, self.index, self.request);
+        } else {
+            self.context.fail();
+        }
+    }
+}
+impl Future for GuardedOutputWait {
+    type Output = Result<(), celld_logic::RequestError>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let incoming = cx.waker().clone();
+        let mut deferred = DeferredWaker(None);
+        let registry = match self.context.registry() {
+            Ok(registry) => registry,
+            Err(_) => return Poll::Ready(Err(celld_logic::RequestError::NodeFenced)),
+        };
+        let record = match registry.poll_record(self.context.token, cx) {
+            Poll::Ready(Ok(record)) => record,
+            Poll::Ready(Err(_)) => {
+                self.context.fail();
+                return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+            }
+            Poll::Pending => return Poll::Pending,
+        };
+        let mut state = match poll_owned(&record.state, cx) {
+            Poll::Ready(Ok(state)) => state,
+            Poll::Ready(Err(_)) => {
+                self.context.fail();
+                return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+            }
+            Poll::Pending => return Poll::Pending,
+        };
+        if state.activities[self.index].request != self.request {
+            return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+        }
+        let Some(output) = &mut state.activities[self.index].output else {
+            return Poll::Ready(Err(celld_logic::RequestError::NodeFenced));
+        };
+        if let Some(result) = output.result.take() {
+            output.done = true;
+            self.active = false;
+            drop(state);
+            drop(record);
+            // Even an actual durable Release cannot restore an expired origin.
+            return Poll::Ready(if self.context.check_forward().is_ok() {
+                result
+            } else {
+                self.context.fail();
+                Err(celld_logic::RequestError::NodeFenced)
+            });
+        }
+        deferred.0 = output.waker.replace(incoming);
+        drop(state);
+        drop(record);
+        Poll::Pending
+    }
+}
+impl Drop for GuardedOutputWait {
+    fn drop(&mut self) {
+        if self.active {
+            self.context.fail();
+            if let Ok(registry) = self.context.registry() {
+                registry.abandon_activity(&self.context, self.index, self.request);
+            }
+        }
+    }
+}
