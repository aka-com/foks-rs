+        record: &InvocationRecord,
+    ) -> Option<GuardedActorInput> {
+        let mut state = lock_owned(&record.state).ok()?;
+        self.poll_inputs_locked(slot, record, &mut state)
+            .ok()
+            .flatten()
+    }
+    fn poll_inputs_locked(
+        self: &Arc<Self>,
+        slot: usize,
+        record: &InvocationRecord,
+        state: &mut InvocationState,
+    ) -> Result<Option<GuardedActorInput>, Refusal> {
+        let context = self.inline_context_locked(record, state, slot)?;
+        for index in 0..4 {
+            if state.controls[index].pending {
+                let kind = match index {
+                    0 => ActorControlKind::Cancel,
+                    1 => ActorControlKind::PrimaryFinish,
+                    2 => ActorControlKind::AuxFinish,
+                    _ => ActorControlKind::Retirement,
+                };
+                let request = match kind {
+                    ActorControlKind::AuxFinish => state.activities[1].request,
+                    ActorControlKind::Retirement => state.eviction_request,
+                    _ => state.activities[0].request,
+                };
+                let cell = &mut state.controls[index];
+                cell.pending = false;
+                cell.delivered = true;
+                return Ok(Some(GuardedActorInput::Control(ActorControl {
+                    context,
+                    kind,
+                    request,
+                    alarm: cell.alarm,
+                    consumed: false,
+                })));
+            }
+        }
+        for index in 0..2 {
+            let activity = &mut state.activities[index];
+            if activity.route_pending {
+                activity.route_pending = false;
+                return Ok(Some(GuardedActorInput::Request(ActorRequest {
+                    context,
+                    activity: index,
+                    request: activity.request,
+                    sequence: activity.sequence,
+                    consumed: false,
+                    kind: Some(RequestKind::Route(
+                        activity.route_input.take().ok_or(Refusal::Invalid)?,
+                    )),
+                })));
+            }
+            if let Some(output) = &mut activity.output {
+                if output.pending {
+                    output.pending = false;
+                    output.delivered = true;
+                    return Ok(Some(GuardedActorInput::Request(ActorRequest {
+                        context,
+                        activity: index,
+                        request: activity.request,
+                        sequence: activity.sequence,
+                        consumed: false,
+                        kind: Some(RequestKind::Output(output.ticket)),
+                    })));
+                }
+            }
+        }
+        Ok(None)
+    }
+    pub(crate) fn observe_inactive(&self, core: &celld_logic::State) {
+        let records = match lock_owned(&self.bank) {
+            Ok(bank) => bank.records.clone(),
+            Err(_) => {
+                self.process.fail();
+                return;
+            }
+        };
+        for record in records.into_iter().flatten() {
+            let mut state = match lock_owned(&record.state) {
+                Ok(state) => state,
+                Err(_) => {
+                    record.control.fail();
+                    continue;
+                }
+            };
+            let mut wakes = [None, None];
+            for (index, activity) in state.activities.iter_mut().enumerate() {
+                if activity.finish_processed && core.request_inactive(activity.request) {
+                    activity.inactive = true;
+                    wakes[index] = activity.finish_waker.take();
+                }
+            }
+            drop(state);
+            drop(record);
+            for wake in wakes.into_iter().flatten() {
+                wake.wake();
+            }
+        }
+    }
+    fn finish_activity(
+        &self,
+        context: &JobContext,
+        index: usize,
+        request: u64,
+        alarm: Option<(celld_logic::wake::AlarmSnapshot, bool)>,
+    ) -> Result<(), Refusal> {
+        let record = self.record(context.token)?;
+        {
+            let state = lock_owned(&record.state)?;
+            if state
+                .activities
+                .get(index)
+                .is_none_or(|activity| activity.request != request)
+            {
+                return Err(Refusal::Invalid);
+            }
+        }
+        let kind = if index == 0 {
+            ActorControlKind::PrimaryFinish
+        } else {
+            ActorControlKind::AuxFinish
+        };
+        self.schedule_control(context, kind, alarm)
+    }
+    fn abandon_activity(&self, context: &JobContext, index: usize, request: u64) {
+        let Ok(record) = self.record(context.token) else {
+            context.fail();
+            return;
+        };
+        {
+            let Ok(state) = lock_owned(&record.state) else {
+                context.fail();
+                return;
+            };
+            if state
+                .activities
+                .get(index)
+                .is_none_or(|activity| activity.request != request)
+            {
+                drop(state);
+                drop(record);
+                context.fail();
+                return;
+            }
+        }
+        if self
+            .schedule_control(context, ActorControlKind::Cancel, None)
+            .is_err()
+        {
+            context.fail();
+        }
+        if self.finish_activity(context, index, request, None).is_err() {
+            context.fail();
+        }
+    }
+}
+impl ActorControl {
+    pub(crate) fn kind(&self) -> ActorControlKind {
+        self.kind
+    }
+    pub(crate) fn request(&self) -> u64 {
+        self.request
+    }
+    pub(crate) fn cell(&self) -> &'static str {
+        self.context.cell
+    }
+    pub(crate) fn alarm(&self) -> Option<(celld_logic::wake::AlarmSnapshot, bool)> {
+        self.alarm
+    }
+    pub(crate) fn processed(mut self, core: &celld_logic::State) {
+        let result = (|| {
+            let registry = self.context.registry()?;
+            let record = registry.record(self.context.token)?;
+            let mut state = lock_owned(&record.state)?;
+            let mut wake = None;
+            let control = &mut state.controls[self.kind.index()];
+            if !control.delivered || control.processed || control.request != self.request {
+                return Err(Refusal::Invalid);
+            }
+            control.processed = true;
+            control.delivered = false;
+            if matches!(
+                self.kind,
+                ActorControlKind::PrimaryFinish | ActorControlKind::AuxFinish
+            ) {
+                let index = usize::from(self.kind == ActorControlKind::AuxFinish);
+                let activity = &mut state.activities[index];
+                if activity.request != self.request {
+                    return Err(Refusal::Invalid);
+                }
+                activity.finish_processed = true;
+                if core.request_inactive(activity.request) {
+                    activity.inactive = true;
+                    wake = activity.finish_waker.take();
+                }
+            }
+            drop(state);
+            drop(record);
+            if let Some(wake) = wake {
+                wake.wake();
+            }
+            registry.observe_inactive(core);
+            Ok(())
+        })();
+        if result.is_err() {
+            self.context.fail();
+        } else {
+            self.consumed = true;
+        }
+    }
+}
