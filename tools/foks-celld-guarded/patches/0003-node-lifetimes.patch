+impl OwnedActorCompletion {
+    pub(crate) fn apply(
+        mut self,
+        apply_one: impl FnOnce(Option<crate::actor::CompletedEffect>),
+    ) -> Result<(), Refusal> {
+        self.context.check_identity()?;
+        let registry = self.context.registry()?;
+        let result = self.result.take().ok_or(Refusal::Invalid)?;
+        match result {
+            ActorJobResult::Transition(completed) => apply_one(Some(completed)),
+            ActorJobResult::StopHeld { op, failure } => {
+                if self.context.role != JobRole::Cleanup(CleanupLane::Stop) {
+                    self.context.fail();
+                    return Err(Refusal::Invalid);
+                }
+                let record = registry.record(self.context.token)?;
+                let mut state = lock_owned(&record.state)?;
+                if OwnedEffectRegistry::root(&mut state, self.context.token)?.op != Some(op) {
+                    drop(state);
+                    drop(record);
+                    self.context.fail();
+                    return Err(Refusal::Invalid);
+                }
+                state.tainted = true;
+                drop(state);
+                self.context.fail();
+                // Preserve Cleaning/quarantine: no invented core completion or
+                // same-epoch restart after spent physical cleanup admission.
+                return Err(failure);
+            }
+            ActorJobResult::WakeCompleted(result) => {
+                if !matches!(
+                    self.context.role,
+                    JobRole::Forward(ForwardLane::Wake) | JobRole::Cleanup(CleanupLane::Wake)
+                ) {
+                    self.context.fail();
+                    return Err(Refusal::Invalid);
+                }
+                if let Err(error) = result {
+                    self.context.fail();
+                    return Err(error);
+                }
+                apply_one(None);
+            }
+        }
+        // The callback has consumed its concrete completion, including every
+        // Event-owned String/Vec. Only now can a successor reuse a forward lane.
+        registry.finish_root(&self.context)?;
+        self.consumed = true;
+        Ok(())
+    }
+}
+impl Drop for OwnedActorCompletion {
+    fn drop(&mut self) {
+        if !self.consumed {
+            self.context.fail();
+        }
+    }
+}
