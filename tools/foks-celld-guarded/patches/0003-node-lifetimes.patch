+// Poll the actual named wrapper once at the unpublished boundary, then move
+// that same pending future into the canonical host task. The extra Box here
+// is test instrumentation; production still spawns the measured inline type.
+async fn b2_publication_before_body() {
+    let fixture = b2_fixture();
+    let context = b2_root(&fixture, JobRole::Forward(ForwardLane::Activation));
+    b2_consumer(&fixture, &context);
+    context.charge_task_payload(ROOT_PAYLOAD_LIMIT).unwrap();
+    context
+        .charge_owned(
+            channel_bound::<RootResult>().unwrap() + control::arc_bytes::<AtomicBool>().unwrap(),
+        )
+        .unwrap();
+    let entered = Arc::new(AtomicBool::new(false));
+    let body_entered = entered.clone();
+    let (sender, receiver) = tokio::sync::oneshot::channel();
+    let record = fixture.registry().record(context.token).unwrap();
+    let work = RootWork {
+        future: async move {
+            body_entered.store(true, Ordering::Release);
+            Ok::<(), Refusal>(())
+        },
+        sender,
+        convert: RootResult::Control,
+        control: context.control.clone(),
+        publication: Publication::new(&record, context.token, None),
+    };
+    let mut future = Box::pin(work.run());
+    let mut state = record.state.lock().unwrap();
+    let mut poll = Context::from_waker(futures_util::task::noop_waker_ref());
+    let blocked = future.as_mut().poll(&mut poll).is_pending();
+    let body_early = entered.load(Ordering::Acquire);
+    if !blocked {
+        drop(state);
+        drop(record);
+        drop(future);
+        drop(receiver);
+        context.fail();
+        panic!("publication wrapper ran before its actual handle was installed");
+    }
+    let root = OwnedEffectRegistry::root(&mut state, context.token).unwrap();
+    root.receiver = Some(receiver);
+    root.handle = Some(crate::asyncrt::spawn(future));
+    root.state = RootState::Running;
+    drop(state);
+    drop(record);
+    let joined = b2_join_control(&fixture, &context).await;
+    assert!(blocked && !body_early && entered.load(Ordering::Acquire) && joined.is_ok());
+}
