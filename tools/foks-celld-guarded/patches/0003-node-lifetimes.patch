+    let record = match Arc::try_unwrap(record) {
+        Ok(record) => record,
+        Err(_) => panic!("unexpected component record observer"),
+    };
+    let held = HeldRetirement::dispose_record(record);
+    assert!(held.phase == HeldPhase::PendingOwner);
+    assert!(generation.is_drained()); // Actual counted pin was released once.
+    let after = held.owner.as_ref().unwrap().observation().unwrap();
+    assert_eq!(
+        (
+            after.debt,
+            after.cleanup_tasks_used,
+            after.cleanup_controls_used
+        ),
+        (
+            before.debt,
+            before.cleanup_tasks_used,
+            before.cleanup_controls_used
+        )
+    );
+    {
+        let mut bank = registry.bank.lock().unwrap();
+        let marker = bank.held[0].replace(held);
+        drop(bank);
+        drop(marker);
+    }
+    registry.retire_completed_records();
+    {
+        let bank = registry.bank.lock().unwrap();
+        assert!(bank.records[0].is_none());
+        assert!(bank.held[0]
+            .as_ref()
+            .is_some_and(|held| held.phase == HeldPhase::PendingOwner));
+    }
+    {
+        let ledger = registry.capacity.ledger.lock().unwrap();
+        assert!(ledger.records[token.index].state == super::super::State::Retiring);
+        assert!(!ledger.records[token.index].tainted);
+        assert_eq!(
+            ledger.event_counts[super::super::EventKind::Freed as usize],
+            0
+        );
+    }
+    assert!(weak.upgrade().is_some());
+    drop(observer); // The real last external JobContext/Control witness dies.
+    registry.retire_completed_records();
+    assert!(weak.upgrade().is_none()); // Strong Request lifetime, not Arc allocation reclamation.
+    assert!(registry.bank.lock().unwrap().held[0].is_none());
+    {
+        let ledger = registry.capacity.ledger.lock().unwrap();
+        assert!(ledger.records[token.index].state == super::super::State::Free);
+        assert_eq!(
+            ledger.event_counts[super::super::EventKind::PayloadsDropped as usize],
+            1
+        );
+        assert_eq!(
+            ledger.event_counts[super::super::EventKind::Freed as usize],
+            1
+        );
+    }
+    registry.retire_completed_records();
+    assert_eq!(
+        registry.capacity.ledger.lock().unwrap().event_counts
+            [super::super::EventKind::Freed as usize],
+        1
+    );
+    drop(weak);
+    drop(registry);
+    retire_factory(factory, process);
+    // This is final physical-owner component evidence. Successful canonical
+    // activation/finish/eviction and the full terminal conjunction remain B4.
+}
