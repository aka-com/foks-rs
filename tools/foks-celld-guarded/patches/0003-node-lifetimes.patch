+    #[cfg(test)]
+    impl LocalActivationFixture {
+        fn component(&self) -> Result<&ComponentFixture, Refusal> {
+            self.component.as_ref().ok_or(Refusal::Invalid)
+        }
+
+        async fn finish(mut self) -> Result<(), Refusal> {
+            let component = self.component()?;
+            component.owner.request_stop();
+            component.owner.join().await;
+            // No await after transfer: the actual task owner has joined, so
+            // only the existing synchronous fixture disposition remains.
+            let result = self
+                .component
+                .take()
+                .ok_or(Refusal::Invalid)?
+                .dispose_joined(Ok(()));
+            if result.is_err() {
+                self.origin.fail();
+            }
