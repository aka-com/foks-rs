+            // success body (checked again at disposition). Existing V8 error
+            // formatting is moved without a copy and remains native runtime
+            // overhead; 512 is not a bound on that diagnostic allocation.
+            let payload = std::mem::size_of::<Option<anyhow::Result<HttpResponse>>>();
+            let channel = payload
