+fn b2_h_forward_deadline(fixture: &lifetimes::ActorFixture, context: &JobContext) {
+    let record = fixture.registry().record(context.token).unwrap();
+    let deadline = context.original_deadline();
+    let (reached, sent, blocked, still_live, timed_out, result) = std::thread::scope(|scope| {
+        let (notice, observed) = std::sync::mpsc::sync_channel(1);
+        let (release, resumed) = std::sync::mpsc::sync_channel(1);
+        let (contention, contended) = std::sync::mpsc::sync_channel(1);
+        let (finished, completion) = std::sync::mpsc::sync_channel(1);
+        let helper = std::thread::Builder::new()
+            .spawn_scoped(scope, move || {
+                FORWARD_OBSERVATION_BARRIER.with(|barrier| {
+                    assert!(barrier.borrow_mut().replace((notice, resumed)).is_none());
+                });
+                let _barrier = B2HForwardBarrier;
+                let _notice = control::contention_notice(contention);
+                let result = context.check_forward();
+                let _ = finished.try_send(());
+                result
+            })
+            .expect("deadline observation helper");
+        let reached = observed.recv_timeout(Duration::from_secs(5)).is_ok();
+        let state = record.state.lock().unwrap();
+        let sent = release.try_send(()).is_ok();
+        let blocked = contended.recv_timeout(Duration::from_secs(5)).is_ok();
+        let still_live = Instant::now() < deadline;
+        // The only timer is the unchanged original deadline. This channel has
+        // no completion while the real state guard blocks the second read.
+        let timed_out = matches!(
+            completion.recv_timeout(deadline.saturating_duration_since(Instant::now())),
+            Err(std::sync::mpsc::RecvTimeoutError::Timeout)
+        );
+        drop(state);
+        let result = helper.join().unwrap_or(Err(Refusal::Failed));
+        (reached, sent, blocked, still_live, timed_out, result)
+    });
+    drop(record);
+    assert!(reached && sent && blocked && still_live && timed_out);
+    assert_eq!(result, Err(Refusal::Expired));
+    assert_eq!(context.original_deadline(), deadline);
+}
