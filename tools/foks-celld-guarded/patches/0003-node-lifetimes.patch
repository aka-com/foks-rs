+        Err(panic) => std::panic::resume_unwind(panic),
+    };
+    assert!(started && observed.contended && observed.pending && observed.joined.is_ok());
+    assert!(state_pending && state_woke && bank_pending && bank_woke && admission_refused);
+    assert!(root_retained && sent && join_bounded && joined.is_ok());
+    assert_eq!(context.original_deadline(), deadline);
+    assert_eq!(b2_debt(&fixture), debt);
+    assert!(context.control.check().is_ok());
+    assert!(!b2_record(&fixture, 0).state.lock().unwrap().tainted);
+}
