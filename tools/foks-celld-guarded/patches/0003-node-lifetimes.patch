+                .return_host_resource(&context, resource)
+                .map_err(convert)?;
+            // Construct at most one wrapper diagnostic per callback, after
+            // resource disposition; a failed disposition cannot overlap it.
+            if valid {
+                Ok(())
+            } else {
+                Err(convert(Refusal::Invalid))
+            }
+        }
+    }
