+        let snapshot = state.final_alarm.ok_or(Refusal::NotReady)?;
+        if state.epoch != Some(snapshot.epoch) || state.generation != Some(snapshot.generation) {
+            return Err(Refusal::Invalid);
+        }
+        Ok(snapshot.alarm)
+    }
