+    drop(record);
+    registry.retire_completed_records();
+    assert!(registry.bank.lock().unwrap().records[0].is_some());
+    assert!(!generation.is_drained() && !payload_dropped.load(Ordering::Acquire));
+    drop(payload);
+    assert!(payload_dropped.load(Ordering::Acquire));
+    let witness = observer.runtime_witness().unwrap();
+    witness.begin_retire().unwrap();
+    witness.memory_released().unwrap(); // Observed empty native resource set.
+    witness.output_disposed().unwrap(); // Observed no output payload was made.
+    drop(witness);
+    let record = {
