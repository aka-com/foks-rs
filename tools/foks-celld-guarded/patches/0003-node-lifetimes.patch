+            let mut state = lock_owned(&record.state)?;
+            OwnedEffectRegistry::root(&mut state, self.context.token)?.consumer = true;
+        }
+        let future = factory(self.context.clone());
+        registry.spawn_root(
+            &self.context,
+            std::mem::size_of::<F>(),
+            future,
+            RootResult::Control,
+        )?;
+        self.submitted = true;
+        Ok(ControlWait {
+            context: self.context.clone(),
+            active: true,
+        })
+    }
