+    fn refuse_guarded_effect(effect: Effect, immediate: &mut VecDeque<Event>) {
+        // Preserve the real operation and exact canonical failure shape. The
+        // registry has already held/failed the origin; no fallback may spawn.
+        let event = match effect {
+            Effect::ReadOwner { op, .. } => Event::OwnerRead {
+                op,
+                now_ms: now_ms(),
+                result: Err(Failure::Definite),
+            },
+            Effect::ReadNodeLease { op, .. } => Event::NodeLeaseRead {
+                op,
+                now_ms: now_ms(),
+                result: Err(Failure::Definite),
+            },
+            Effect::ReadCapacityPeers { op, .. } => Event::CapacityPeersRead {
+                op,
+                now_ms: now_ms(),
+                result: Err(Failure::Definite),
+            },
+            Effect::RecoverNodeLog { op, .. } => Event::NodeLogRecovered {
+                op,
+                result: Err(Failure::Definite),
+            },
+            Effect::CasOwner { op, .. } => Event::OwnerCasCompleted {
+                op,
+                result: Err(Failure::Definite),
+            },
+            Effect::Restore { op, .. } => Event::RestoreCompleted {
+                op,
+                result: Err(Failure::Definite),
+            },
+            Effect::StartRuntime { op, .. } => Event::RuntimeStarted {
+                op,
+                isolate: None,
+                generation: 0,
+                result: Err(Failure::Definite),
+            },
+            Effect::Publish { op, .. } => Event::Published {
+                op,
+                result: Err(Failure::Definite),
+            },
+            Effect::EnsureDurable { op, .. } => Event::DurabilityChecked {
+                op,
+                result: Err(Failure::Ambiguous),
+            },
+            Effect::AwaitDurable { op, .. } => Event::DurableReached {
+                op,
+                result: Err(Failure::Ambiguous),
+                source: celld_logic::ProofSource::Bucket,
+            },
+            Effect::VerifyOwnership { op, .. } => Event::OwnershipVerified {
+                op,
+                result: Err(Failure::Definite),
+            },
+            // RuntimeStopFailed/Cancelled restart a bounded eviction. They
+            // assert on other causes, and B2 cannot resurrect spent cleanup
+            // credits/closed background work even for a bounded cancellation.
+            Effect::StopRuntime { .. } => return,
+            Effect::ReleaseOwner { op, .. } => Event::OwnerReleased {
+                op,
+                result: Err(Failure::Definite),
+            },
+            Effect::AdoptReleased { op, .. } => Event::SuccessorAdopted {
+                op,
+                result: Err(Failure::Definite),
+            },
+            Effect::FireAlarm {
+                op, cell, epoch, ..
+            } => Event::AlarmFinished {
+                op,
+                cell,
+                epoch,
+                now_ms: now_ms(),
+                now_mono_ms: crate::asyncrt::mono_ms(),
+                result: Err(Failure::Definite),
+            },
+            // Fixed replies/control and wake errors are retained by the
+            // registry. They have no invented success/no-op core event.
+            _ => return,
+        };
+        immediate.push_back(event);
+    }
