+fn poll_owned<'a, T>(
+    mutex: &'a Mutex<T>,
+    cx: &mut Context<'_>,
+) -> Poll<Result<std::sync::MutexGuard<'a, T>, Refusal>> {
+    match mutex.try_lock() {
+        Ok(guard) => Poll::Ready(Ok(guard)),
+        Err(std::sync::TryLockError::WouldBlock) => {
+            cx.waker().wake_by_ref();
+            Poll::Pending
+        }
+        Err(std::sync::TryLockError::Poisoned(_)) => Poll::Ready(Err(Refusal::Failed)),
+    }
+}
+struct RootWork<Fut, T> {
+    future: Fut,
+    sender: tokio::sync::oneshot::Sender<RootResult>,
+    convert: fn(T) -> RootResult,
+    control: NodeControl,
+    publication: Publication,
+}
+impl<Fut, T> RootWork<Fut, T>
+where
+    Fut: Future<Output = T>,
+{
+    async fn run(self) {
+        if self.publication.wait_async().await.is_err() {
+            self.control.fail();
+            return;
+        }
+        drop(self.publication);
+        let result = (self.convert)(self.future.await);
+        if let Err(result) = self.sender.send(result) {
+            self.control.fail();
+            drop(result);
+        }
+        drop(self.control);
+    }
+}
+struct NativeWork<F, T> {
+    work: F,
+    sender: tokio::sync::oneshot::Sender<NativeResult>,
+    convert: fn(T) -> NativeResult,
+    control: NodeControl,
+    publication: Publication,
+}
+impl<F, T> NativeWork<F, T>
+where
+    F: FnOnce() -> T,
+{
+    fn run(self) {
+        if self.publication.wait_native().is_err() {
+            self.control.fail();
+            return;
+        }
+        drop(self.publication);
+        let result = (self.convert)((self.work)());
+        if let Err(result) = self.sender.send(result) {
+            self.control.fail();
+            drop(result);
+        }
+        drop(self.control);
+    }
+}
