+impl OwnedEffectRegistry {
+    pub(crate) fn wake_snapshot(
+        &self,
+        cell: &str,
+    ) -> Result<celld_logic::wake::AlarmSnapshot, Refusal> {
+        let record = {
+            let bank = lock_owned(&self.bank)?;
