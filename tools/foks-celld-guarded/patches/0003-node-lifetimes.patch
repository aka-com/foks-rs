+    type Output = Result<OwnedReplicaCompletion, Refusal>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        if !self.active {
+            return Poll::Ready(Err(Refusal::Invalid));
+        }
+        let registry = match self.context.registry() {
+            Ok(registry) => registry,
+            Err(error) => return Poll::Ready(Err(error)),
+        };
+        match registry.poll_root(&self.context, cx, false) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(Ok(RootResult::Replica(value))) => {
+                self.active = false;
+                Poll::Ready(Ok(OwnedReplicaCompletion {
+                    value: Some(value),
+                    context: self.context.clone(),
+                    consumed: false,
+                }))
+            }
+            Poll::Ready(Ok(value)) => {
+                self.context.fail();
+                std::mem::forget(value);
+                Poll::Ready(Err(Refusal::Invalid))
+            }
+            Poll::Ready(Err(error)) => {
+                self.context.fail();
+                Poll::Ready(Err(error))
+            }
+        }
+    }
