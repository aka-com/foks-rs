+    pub(crate) fn submit_ltx<F, Fut>(mut self, factory: F) -> Result<ReplicaWait, Refusal>
+    where
+        F: FnOnce(JobContext) -> Fut,
+        Fut: Future<Output = crate::ltx_repl::LtxRootCompletion> + Send + 'static,
+    {
+        self.context.check_job()?;
+        let total = std::mem::size_of::<F>()
+            .checked_add(std::mem::size_of::<Fut>())
+            .and_then(|value| value.checked_add(std::mem::size_of::<RootResult>()))
+            .ok_or(Refusal::Bounds)?;
+        if total > ROOT_PAYLOAD_LIMIT
+            || std::mem::align_of::<F>() > 16
+            || std::mem::align_of::<Fut>() > 16
+        {
+            return Err(Refusal::Bounds);
+        }
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        {
+            let mut state = lock_owned(&record.state)?;
+            OwnedEffectRegistry::root(&mut state, self.context.token)?.consumer = true;
+        }
+        let future = factory(self.context.clone());
+        registry.spawn_root(
+            &self.context,
+            std::mem::size_of::<F>(),
+            future,
+            RootResult::Replica,
+        )?;
+        self.submitted = true;
+        Ok(ReplicaWait {
+            context: self.context.clone(),
+            active: true,
+        })
+    }
+}
+impl Drop for ReplicaJobPermit {
+    fn drop(&mut self) {
+        if !self.submitted {
+            self.context.fail();
+        }
+    }
+}
+impl NativePermit {
+    pub(crate) fn submit_ltx<F>(mut self, work: F) -> Result<NativeWait, Refusal>
+    where
+        F: FnOnce() -> crate::ltx_repl::LtxNativeCompletion + Send + 'static,
+    {
+        self.context.check_job()?;
+        let bytes = std::mem::size_of::<NativeWork<F, crate::ltx_repl::LtxNativeCompletion>>()
+            .checked_add(std::mem::size_of::<NativeResult>())
+            .and_then(|value| value.checked_add(channel_bound::<NativeResult>().ok()?))
+            .ok_or(Refusal::Bounds)?;
+        if bytes > NATIVE_LIMIT
+            || std::mem::align_of::<F>() > 16
+            || std::mem::align_of::<NativeResult>() > 16
+        {
+            self.context.fail();
+            return Err(Refusal::Bounds);
+        }
+        if matches!(self.context.role, JobRole::Forward(_)) {
+            self.context.control.charge(bytes)?;
+        }
+        let registry = self.context.registry()?;
+        let record = registry.record(self.context.token)?;
+        let mut state = lock_owned(&record.state)?;
+        let root = OwnedEffectRegistry::root(&mut state, self.context.token)?;
+        let child = &mut root.child;
+        if child.sequence != self.child.sequence || child.handle.is_some() || !child.consumer {
+            return Err(Refusal::Invalid);
+        }
+        if matches!(self.context.role, JobRole::Forward(_)) {
+            self.context.control.check()?;
+        }
+        let (sender, receiver) = tokio::sync::oneshot::channel();
+        let work = NativeWork {
+            work,
+            sender,
+            convert: NativeResult::Ltx,
+            control: self.context.control.clone(),
+            publication: Publication::new(&record, self.context.token, Some(self.child.sequence)),
+        };
+        child.receiver = Some(receiver);
+        child.handle = Some(crate::asyncrt::blocking(move || work.run()));
+        self.submitted = true;
+        Ok(NativeWait {
+            context: self.context.clone(),
+            child: self.child,
+            active: true,
+        })
+    }
+}
+impl Drop for NativePermit {
+    fn drop(&mut self) {
+        if !self.submitted {
+            self.context.fail();
+        }
+    }
+}
