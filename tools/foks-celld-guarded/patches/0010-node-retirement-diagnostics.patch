+        match self {
+            Self::ClaimReplica => "c6_claim_replica",
+            Self::SubmitLtx => "c6_submit_ltx",
+            Self::Join => "c6_join",
+            Self::QualificationWait17 => "c6_qualification_wait17",
+            Self::ConsumeCompletion => "c6_consume_completion",
+            Self::RetirementResult => "c6_retirement_result",
+            Self::SuccessObservation => "c6_success_observation",
+            Self::FinalJobCheck => "c6_final_job_check",
+            Self::ValidateRoleAttachment => "validate_role_attachment",
+            Self::ResolveHandle => "resolve_handle",
+            Self::JoinHydration => "join_hydration",
+            Self::JoinSync => "join_sync",
+            Self::JoinCompaction => "join_compaction",
+            Self::TransferStoppedCell => "transfer_stopped_cell",
+            Self::SelectDisposition => "select_disposition",
+            Self::RebaseSync => "rebase_sync",
+            Self::EvictSnapshot => "evict_snapshot",
+            Self::EvictPublish => "evict_publish",
+            Self::EvictSyncFallback => "evict_sync_fallback",
+            Self::PrepareLocalClose => "prepare_local_close",
+            Self::JoinLocalClose => "join_local_close",
+            Self::LocalCloseResult => "local_close_result",
+            Self::RegisterPreservedPath => "register_preserved_path",
+            Self::RemoveStoppedCell => "remove_stopped_cell",
+            Self::DisposeHostScratch => "dispose_host_scratch",
+            Self::ReleaseRegistration => "release_registration",
+            Self::ReplicaRootCompletion => "replica_root_completion",
+        }
+    }
+}
+struct RetirementDiagnosticText {
+    bytes: [u8; 256],
+    len: usize,
+    truncated: bool,
+    format_failed: bool,
+}
+impl RetirementDiagnosticText {
+    fn render(error: &(dyn std::error::Error + 'static)) -> Self {
+        let mut text = Self {
+            bytes: [0; 256],
+            len: 0,
+            truncated: false,
+            format_failed: false,
+        };
+        text.format_failed = std::fmt::write(&mut text, format_args!("{error}")).is_err();
+        text
+    }
+    fn as_str(&self) -> &str {
+        // write_str copies only complete UTF-8 prefixes. Diagnostics must not
+        // panic or replace the actual operation error if this invariant fails.
+        std::str::from_utf8(&self.bytes[..self.len]).unwrap_or("")
+    }
+}
+impl std::fmt::Write for RetirementDiagnosticText {
+    fn write_str(&mut self, value: &str) -> std::fmt::Result {
+        if self.truncated {
+            return Err(std::fmt::Error);
+        }
+        let available = self.bytes.len() - self.len;
+        let mut count = value.len().min(available);
+        while !value.is_char_boundary(count) {
+            count -= 1;
+        }
+        self.bytes[self.len..self.len + count].copy_from_slice(&value.as_bytes()[..count]);
+        self.len += count;
+        if count != value.len() {
+            self.truncated = true;
+            // Stop a cooperative formatter at the first overflow; do not
+            // continue traversing discarded text or an unbounded error chain.
+            return Err(std::fmt::Error);
+        }
+        Ok(())
+    }
+}
+struct RetirementFailureDiagnostic {
+    original: RetirementDiagnosticText,
+    source_tail: RetirementDiagnosticText,
+    source_hops: u8,
+    source_depth_limited: bool,
+}
+impl RetirementFailureDiagnostic {
+    fn capture(error: &(dyn std::error::Error + 'static)) -> Self {
+        let mut tail = error;
+        let mut hops = 0;
+        let mut limited = true;
+        for _ in 0..16 {
+            match tail.source() {
+                Some(next) => {
+                    tail = next;
+                    hops += 1;
+                }
+                None => {
+                    limited = false;
+                    break;
+                }
+            }
+        }
+        Self {
+            original: RetirementDiagnosticText::render(error),
+            source_tail: RetirementDiagnosticText::render(tail),
+            source_hops: hops,
+            source_depth_limited: limited,
+        }
+    }
+}
+pub(crate) trait RetirementDiagnosticError {
+    fn diagnostic_error(&self) -> &(dyn std::error::Error + 'static);
+}
+impl RetirementDiagnosticError for Refusal {
+    fn diagnostic_error(&self) -> &(dyn std::error::Error + 'static) {
+        self
+    }
+}
+impl RetirementDiagnosticError for anyhow::Error {
+    fn diagnostic_error(&self) -> &(dyn std::error::Error + 'static) {
+        self.as_ref()
+    }
+}
+fn inspect_retirement_result<T, E: RetirementDiagnosticError>(
+    result: Result<T, E>,
+    emit: impl FnOnce(RetirementFailureDiagnostic),
+) -> Result<T, E> {
+    if let Err(error) = &result {
+        emit(RetirementFailureDiagnostic::capture(
+            error.diagnostic_error(),
+        ));
+    }
+    result
+}
+pub(crate) fn retirement_stage_result<T, E: RetirementDiagnosticError>(
+    context: &JobContext,
+    stage: RetirementFailureStage,
+    result: Result<T, E>,
+) -> Result<T, E> {
+    inspect_retirement_result(result, |diagnostic| {
+        tracing::error!(
+            event = "guarded_retirement_refused",
+            stage = stage.label(),
+            root = ?context.root_token(),
+            job_role = ?context.role(),
+            original = diagnostic.original.as_str(),
+            source_tail = diagnostic.source_tail.as_str(),
+            original_truncated = diagnostic.original.truncated,
+            source_truncated = diagnostic.source_tail.truncated,
+            original_format_failed = diagnostic.original.format_failed,
+            source_format_failed = diagnostic.source_tail.format_failed,
+            source_hops = diagnostic.source_hops,
+            source_depth_limited = diagnostic.source_depth_limited,
+            "actual guarded retirement operation refused"
+        );
+    })
+}
 
