+thread_local! {
+    static BACKGROUND_RESERVE_BARRIER: std::cell::RefCell<Option<(Instant,
+        std::sync::mpsc::SyncSender<()>, std::sync::mpsc::Receiver<()>)>> = const { std::cell::RefCell::new(None) };
+}
+pub(super) fn background_reserve_barrier(role: JobRole) -> Result<(), Refusal> {
+    if role != JobRole::Forward(ForwardLane::Hydration) {
+        return Ok(());
+    }
+    BACKGROUND_RESERVE_BARRIER.with(|slot| {
+        let Some((deadline, entered, release)) = slot.borrow_mut().take() else {
+            return Ok(());
+        };
+        if Instant::now() >= deadline {
+            return Err(Refusal::Expired);
+        }
+        entered.send(()).map_err(|_| Refusal::Failed)?;
+        release
+            .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+            .map_err(|_| Refusal::Expired)?;
+        if Instant::now() >= deadline {
+            return Err(Refusal::Expired);
+        }
+        Ok(())
+    })
+}
+pub(crate) struct BackgroundClaimTest {
+    release: Option<std::sync::mpsc::SyncSender<()>>,
+    worker: Option<std::thread::JoinHandle<Result<ReplicaJobPermit, Refusal>>>,
+    deadline: Instant,
+}
+impl BackgroundClaimTest {
+    pub(crate) fn finish(mut self) -> bool {
+        if let Some(release) = self.release.take() {
+            let _ = release.send(());
+        }
+        let result = self.worker.take().unwrap().join();
+        Instant::now() < self.deadline && matches!(result, Ok(Err(Refusal::Cancelled)))
+    }
+}
+impl Drop for BackgroundClaimTest {
+    fn drop(&mut self) {
+        if let Some(release) = self.release.take() {
+            let _ = release.send(());
+        }
+        if let Some(worker) = self.worker.take() {
+            let _ = worker.join();
+        }
+    }
+}
+impl JobContext {
+    pub(crate) fn background_claim_for_test(
+        &self,
+        attachment: &crate::ltx_repl::EpochAttachment,
+        deadline: Instant,
+    ) -> Result<BackgroundClaimTest, Refusal> {
+        let (entered, observed) = std::sync::mpsc::sync_channel(1);
+        let (release, released) = std::sync::mpsc::sync_channel(1);
+        let context = self.clone();
+        let attachment = attachment.clone();
+        let worker = std::thread::spawn(move || {
+            BACKGROUND_RESERVE_BARRIER.with(|slot| {
+                *slot.borrow_mut() = Some((deadline, entered, released));
+            });
+            let result = context.claim_replica(ReplicaRole::Hydration, &attachment);
+            BACKGROUND_RESERVE_BARRIER.with(|slot| {
+                slot.borrow_mut().take();
+            });
+            result
+        });
+        let held = BackgroundClaimTest {
+            release: Some(release),
+            worker: Some(worker),
+            deadline,
+        };
+        if Instant::now() >= deadline
+            || observed
+                .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                .is_err()
+            || Instant::now() >= deadline
+        {
+            return Err(Refusal::Expired);
+        }
+        Ok(held)
+    }
