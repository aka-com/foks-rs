+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let state = record.state.lock().unwrap();
+        let proof = state.background_stop.ok_or(Refusal::Invalid)?;
+        Ok(proof.joined == 7
+            && !state.retiring
+            && state.runtime.is_none()
+            && proof
+                .tokens
+                .iter()
+                .all(|token| Self::background_disposed(&state, *token)))
