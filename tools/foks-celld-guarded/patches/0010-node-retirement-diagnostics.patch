+                JobRole::Forward(ForwardLane::Hydration),
+                RootKind::Actor,
+                None
+            ),
+            Err(Refusal::Cancelled)
+        );
+        Ok(valid
+            && proof
+                .tokens
+                .iter()
+                .all(|token| Self::background_disposed(&record.state.lock().unwrap(), *token)))
+    }
