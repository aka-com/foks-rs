+impl JobContext {
+    pub(crate) fn background_before_for_test(
+        &self,
+        attachment: &crate::ltx_repl::EpochAttachment,
+        wrong: &crate::ltx_repl::EpochAttachment,
+    ) -> Result<bool, Refusal> {
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let wrong_pointer = wrong.validate(self).is_ok()
+            && self.begin_background_stop(wrong) == Err(Refusal::Invalid);
+        let mut reserved = true;
+        // Actual tasks are all paused on their explicit release channels.
+        for lane in 0..3 {
+            for field in 0..5 {
+                let old = {
+                    let mut state = record.state.lock().unwrap();
+                    let root = &mut state.roots[lane];
+                    let old = (root.state, root.kind, root.sequence, root.consumer);
+                    match field {
+                        0 => root.state = RootState::Reserved,
+                        1 => root.state = RootState::Empty,
+                        2 => root.consumer = true,
+                        3 => root.kind = Some(RootKind::Actor),
+                        _ => root.sequence = 0,
+                    }
+                    old
+                };
+                reserved &= self.begin_background_stop(attachment) == Err(Refusal::Busy);
+                let mut state = record.state.lock().unwrap();
+                let root = &mut state.roots[lane];
+                (root.state, root.kind, root.sequence, root.consumer) = old;
+            }
+        }
+        record.state.lock().unwrap().tainted = true;
+        reserved &= self.begin_background_stop(attachment) == Err(Refusal::Busy);
+        record.state.lock().unwrap().tainted = false;
+        let untouched = record.state.lock().unwrap().background_stop.is_none();
+        Ok(wrong_pointer && reserved && untouched)
+    }
+    pub(crate) fn background_gate_for_test(
+        &self,
+        attachment: &crate::ltx_repl::EpochAttachment,
+        submitted: [RootToken; 3],
+    ) -> Result<bool, Refusal> {
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let proof = record
+            .state
+            .lock()
+            .unwrap()
+            .background_stop
+            .ok_or(Refusal::Invalid)?;
+        let mut denied = self.begin_background_stop(attachment) == Err(Refusal::Busy);
+        for role in [
+            ForwardLane::Hydration,
+            ForwardLane::Sync,
+            ForwardLane::Compaction,
+        ] {
+            for kind in [RootKind::Replica, RootKind::Actor] {
+                denied &= matches!(
+                    registry.reserve(self.token.slot as usize, JobRole::Forward(role), kind, None),
+                    Err(Refusal::Cancelled)
+                );
+            }
+        }
+        Ok(denied
+            && proof.tokens == submitted
+            && proof.tokens.iter().all(|token| token.sequence != 0))
+    }
+    pub(crate) fn background_retained_for_test(&self) -> Result<bool, Refusal> {
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let state = record.state.lock().unwrap();
+        let proof = state.background_stop.ok_or(Refusal::Invalid)?;
+        Ok(proof.joined == 0
+            && !state.retiring
+            && state.runtime.is_none()
+            && proof.tokens.iter().all(|token| {
+                let root = &state.roots[token.lane as usize];
+                root.sequence == token.sequence
+                    && root.kind == Some(RootKind::Replica)
+                    && root.state == RootState::Running
+                    && root.handle.is_some()
+                    && root.receiver.is_some()
+                    && root.result.is_none()
+                    && !root.consumer
+                    && state.observation.roots_disposed & (1 << token.lane) == 0
+            }))
+    }
+    pub(crate) fn background_poison_for_test(
+        &self,
+        attachment: &crate::ltx_repl::EpochAttachment,
+    ) -> Result<bool, Refusal> {
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let before = record
+            .state
+            .lock()
+            .unwrap()
+            .background_stop
+            .ok_or(Refusal::Invalid)?;
+        let poisoned = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _held = record.state.lock().unwrap();
+            panic!("quiescence protocol record poison negative");
+        }))
+        .is_err();
+        let refused = self.begin_background_stop(attachment) == Err(Refusal::Failed)
+            && self.background_joined(attachment, before.tokens[0]) == Err(Refusal::Failed)
+            && self.verify_background_stop(attachment) == Err(Refusal::Failed)
+            && matches!(
+                self.stop_replica(ReplicaRole::Hydration, attachment, before.tokens[0]),
+                Err(Refusal::Failed)
+            );
+        let retained = {
+            let state = match record.state.lock() {
+                Err(poison) => poison.into_inner(),
+                Ok(_) => return Err(Refusal::Invalid),
+            };
+            state.background_stop.is_some_and(|proof| {
+                proof.tokens == before.tokens
+                    && proof.initiator == before.initiator
+                    && proof.joined == 0
+            }) && !state.retiring
+                && state.runtime.is_none()
+                && before.tokens.iter().all(|token| {
+                    let root = &state.roots[token.lane as usize];
+                    root.sequence == token.sequence
+                        && root.state == RootState::Running
+                        && root.handle.is_some()
+                        && root.receiver.is_some()
+                        && !root.consumer
+                })
+        };
+        // TEST CLEANUP ONLY: production has no poison recovery. Clearing this
+        // injected poison permits release/join of the still-owned real tasks;
+        // no error is normalized and no join/disposal bit was manufactured.
+        record.state.clear_poison();
+        Ok(poisoned && refused && retained && self.background_retained_for_test()?)
+    }
+    pub(crate) fn background_expiry_for_test(
+        &self,
+        forward: &JobContext,
+        attachment: &crate::ltx_repl::EpochAttachment,
+        helper_deadline: Instant,
+    ) -> Result<bool, Refusal> {
+        let original = forward.original_deadline();
+        if Instant::now() >= original || original >= helper_deadline {
+            return Err(Refusal::Expired);
+        }
+        let (_held_sender, receiver) = std::sync::mpsc::sync_channel::<()>(1);
+        let elapsed = matches!(
+            receiver.recv_timeout(original.saturating_duration_since(Instant::now())),
+            Err(std::sync::mpsc::RecvTimeoutError::Timeout)
+        );
+        let first = forward.background_continuation(attachment);
+        let later = forward.background_continuation(attachment);
+        Ok(elapsed
+            && Instant::now() >= original
+            && Instant::now() < helper_deadline
+            && first == Err(Refusal::Expired)
+            && later == Err(Refusal::Failed)
+            && forward.original_deadline() == original
+            && self.background_retained_for_test()?)
+    }
+    pub(crate) fn background_complete_for_test(
