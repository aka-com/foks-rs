+// Failure-only stderr diagnostics. These buffers bound their destinations, not
+// arbitrary Display implementations, the tracing subscriber, total stack or RSS.
+// No diagnostic obtains an owner alias, lock, credit or issuing capability.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum RetirementFailureStage {
+    ClaimReplica,
+    SubmitLtx,
+    Join,
+    QualificationWait17,
+    ConsumeCompletion,
+    RetirementResult,
+    SuccessObservation,
+    FinalJobCheck,
+    ValidateRoleAttachment,
+    ResolveHandle,
+    JoinHydration,
+    JoinSync,
+    JoinCompaction,
+    TransferStoppedCell,
+    SelectDisposition,
+    RebaseSync,
+    EvictSnapshot,
+    EvictPublish,
+    EvictSyncFallback,
+    PrepareLocalClose,
+    JoinLocalClose,
+    LocalCloseResult,
+    RegisterPreservedPath,
+    RemoveStoppedCell,
+    DisposeHostScratch,
+    ReleaseRegistration,
+    ReplicaRootCompletion,
+}
+impl RetirementFailureStage {
