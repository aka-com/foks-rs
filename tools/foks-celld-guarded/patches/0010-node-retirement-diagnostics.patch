+    pub(crate) fn background_after_for_test(
+        &self,
+        attachment: &crate::ltx_repl::EpochAttachment,
+    ) -> Result<bool, Refusal> {
+        let registry = self.registry()?;
+        let record = registry.record(self.token)?;
+        let proof = record
+            .state
+            .lock()
+            .unwrap()
+            .background_stop
+            .ok_or(Refusal::Invalid)?;
+        let mut valid = self.verify_background_stop(attachment).is_ok() && proof.joined == 7;
+        record.state.lock().unwrap().background_stop = None;
+        valid &= self.verify_background_stop(attachment) == Err(Refusal::Invalid);
+        record.state.lock().unwrap().background_stop = Some(proof);
+        for field in 0..6 {
+            let mut bad = proof;
+            match field {
+                0 => bad.joined = 3,
+                1 => bad.tokens[0].sequence += 1,
+                2 => bad.epoch += 1,
+                3 => bad.generation = Some(99),
+                4 => bad.initiator.sequence += 1,
+                _ => bad.tokens[0].lane = 7,
+            }
+            record.state.lock().unwrap().background_stop = Some(bad);
+            valid &= self.verify_background_stop(attachment).is_err();
+            record.state.lock().unwrap().background_stop = Some(proof);
+        }
+        for field in 0..3 {
+            {
+                let mut state = record.state.lock().unwrap();
+                let root = &mut state.roots[0];
+                match field {
+                    0 => root.consumer = true,
+                    1 => root.kind = Some(RootKind::Actor),
+                    _ => root.sequence = 0,
+                }
+            }
+            valid &= self.verify_background_stop(attachment).is_err();
+            {
+                let mut state = record.state.lock().unwrap();
+                let root = &mut state.roots[0];
+                root.consumer = false;
+                root.kind = Some(RootKind::Replica);
+                root.sequence = proof.tokens[0].sequence;
+            }
